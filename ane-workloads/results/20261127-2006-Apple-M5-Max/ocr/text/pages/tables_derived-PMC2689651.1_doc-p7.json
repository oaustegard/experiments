702.5, "width": 19.100000000000023, "height": 47.89999999999998}}, {"kind": "text", "text": "0.438", "bbox": {"x": 434.0, "y": 625.9, "width": 16.0, "height": 47.89999999999998}}, {"kind": "text", "text": "0.84（0.67-1.04）", "bbox": {"x": 434.0, "y": 370.4, "width": 16.0, "height": 134.10000000000002}}, {"kind": "text", "text": "0.198", "bbox": {"x": 469.1, "y": 625.9, "width": 16.0, "height": 47.89999999999998}}, {"kind": "text", "text": "0.257", "bbox": {"x": 501.0, "y": 629.1, "width": 19.100000000000023, "height": 44.700000000000045}}, {"kind": "text", "text": "0.205", "bbox": {"x": 536.2, "y": 625.9, "width": 19.100000000000023, "height": 47.89999999999998}}, {"kind": "text", "text": "0.090", "bbox": {"x": 571.3, "y": 625.9, "width": 19.100000000000023, "height": 47.89999999999998}}, {"kind": "text", "text": "0.092", "bbox": {"x": 606.4, "y": 625.9, "width": 19.100000000000023, "height": 47.89999999999998}}, {"kind": "text", "text": "0.199", "bbox": {"x": 641.5, "y": 625.9, "width": 16.0, "height": 47.89999999999998}}, {"kind": "text", "text": "0.482", "bbox": {"x": 434.0, "y": 552.4, "width": 16.0, "height": 47.89999999999998}}, {"kind": "text", "text": "0.250", "bbox": {"x": 465.9, "y": 549.2, "width": 19.100000000000023, "height": 51.10000000000002}}, {"kind": "text", "text": "0.300", "bbox": {"x": 501.0, "y": 552.4, "width": 19.100000000000023, "height": 47.89999999999998}}, {"kind": "text", "text": "0.257", "bbox": {"x": 536.2, "y": 552.4, "width": 19.100000000000023, "height": 47.89999999999998}}, {"kind": "text", "text": "0.166", "bbox": {"x": 571.3, "y": 549.2, "width": 16.0, "height": 51.10000000000002}}, {"kind": "text", "text": "0.74（0.56-0.99）", "bbox": {"x": 469.1, "y": 370.4, "width": 16.0, "height": 134.10000000000002}}, {"kind": "text", "text": "0.161", "bbox": {"x": 606.4, "y": 552.4, "width": 16.0, "height": 47.89999999999998}}, {"kind": "text", "text": "0.256", "bbox": {"x": 638.3, "y": 549.2, "width": 19.100000000000023, "height": 51.10000000000002}}, {"kind": "text", "text": "0.327", "bbox": {"x": 676.6, "y": 549.2, "width": 16.0, "height": 51.10000000000002}}, {"kind": "text", "text": "0.82（0.64-1.06）", "bbox": {"x": 504.2, "y": 370.4, "width": 16.000000000000057, "height": 134.10000000000002}}, {"kind": "text", "text": "0.75 (0.58-0.96)", "bbox": {"x": 536.2, "y": 373.6, "width": 19.100000000000023, "height": 130.89999999999998}}, {"kind": "text", "text": "0.50 （0.36-0.69）", "bbox": {"x": 571.3, "y": 373.6, "width": 19.100000000000023, "height": 130.89999999999998}}, {"kind": "text", "text": "0.53 （0.38-0.74）", "bbox": {"x": 606.4, "y": 373.6, "width": 16.0, "height": 130.89999999999998}}, {"kind": "text", "text": "0.72 (0.55-0.95)", "bbox": {"x": 638.3, "y": 373.6, "width": 19.100000000000023, "height": 130.89999999999998}}, {"kind": "text", "text": "0.284", "bbox": {"x": 676.6, "y": 625.9, "width": 16.0, "height": 47.89999999999998}}, {"kind": "text", "text": "0.82（0.65-1.03）", "bbox": {"x": 676.6, "y": 370.4, "width": 16.0, "height": 134.10000000000002}}, {"kind": "text", "text": "*Refer to Figure 1 for the study design. OT: overtransmitted to affected children allele; OR: odds ratio; Cl: confidence interval.", "bbox": {"x": 721.2, "y": 996.3, "width": 22.299999999999955, "height": 1041.0}}, {"kind": "text", "text": "Asymptotic P-values of the chi-square test for allele frequencies comparison between cases and controls. Asymptotic P-values for combined family and case/control samples computed with the Cochran-Mantel-Haenszel test.", "bbox": {"x": 743.5, "y": 1050.6, "width": 47.89999999999998, "height": 990.0}}, {"kind": "text", "text": "doi:10.1371/journal.pgen.1000528.t003", "bbox": {"x": 794.7, "y": 1718.0, "width": 19.100000000000023, "height": 322.5}}, {"kind": "text", "text": "population stratification. Finally, rs4979459 was located in the", "bbox": {"x": 874.4, "y": 2011.8, "width": 667.0000000000001, "height": 32.299999999999955}}, {"kind": "text", "text": "based design rules out the possible confounding effect of", "bbox": {"x": 871.2, "y": 1983.0, "width": 670.2, "height": 29.0}}, {"kind": "text", "text": "by systematic genotyping error. Secondly, the use of a family-", "bbox": {"x": 874.4, "y": 1954.1, "width": 663.7999999999998, "height": 29.0}}, {"kind": "text", "text": "the identified significant association was unlikely to be explained", "bbox": {"x": 871.2, "y": 1925.1, "width": 667.0, "height": 26.0}}, {"kind": "text", "text": "several additional markers in ID with rs4979459, indicating that", "bbox": {"x": 871.2, "y": 1896.8, "width": 670.2, "height": 28.700000000000045}}, {"kind": "text", "text": "positive finding. Firstly, suggestive association was also found for", "bbox": {"x": 871.2, "y": 1868.1, "width": 670.2, "height": 25.5}}, {"kind": "text", "text": "Several arguments support the assumption that this is a true", "bbox": {"x": 896.7, "y": 1834.9, "width": 641.7, "height": 32.799999999999955}}, {"kind": "text", "text": "for one single tag SNP, rs4979459 (P= 4×10-3).", "bbox": {"x": 874.2, "y": 1803.9, "width": 498.20000000000005, "height": 34.90000000000009}}, {"kind": "text", "text": "correction for multiple testing, significant association was observed", "bbox": {"x": 871.2, "y": 1778.2, "width": 667.0, "height": 26.0}}, {"kind": "text", "text": "linkage, in order to minimize the risk of false negative results. After", "bbox": {"x": 871.2, "y": 1749.9, "width": 667.0, "height": 25.5}}, {"kind": "text", "text": "Our sample set was enriched in families with strong evidence of", "bbox": {"x": 874.4, "y": 1721.2, "width": 667.0000000000001, "height": 26.0}}, {"kind": "text", "text": "dense ID mapping of this 13.1 Mb area, using a tag SNP strategy.", "bbox": {"x": 874.4, "y": 1689.2, "width": 663.7999999999998, "height": 29.0}}, {"kind": "text", "text": "region were associated with SpA we performed a family-based", "bbox": {"x": 871.2, "y": 1663.2, "width": 667.0, "height": 26.0}}, {"kind": "text", "text": "To identify whether one or several loci of the refined SPA2", "bbox": {"x": 896.7, "y": 1628.9, "width": 641.7, "height": 29.200000000000045}}, {"kind": "text", "text": "cantly linked areas.", "bbox": {"x": 870.8, "y": 1600.0, "width": 198.70000000000005, "height": 30.09999999999991}}, {"kind": "text", "text": "between markers D9S279 and D9S112 comprising both signifi-", "bbox": {"x": 871.2, "y": 1574.3, "width": 667.0, "height": 26.0}}, {"kind": "text", "text": "decided to continue our investigations on the 13.1 Mb region", "bbox": {"x": 871.2, "y": 1542.3, "width": 667.0, "height": 29.0}}, {"kind": "text", "text": "characterize linkage localization with high precision [27], we", "bbox": {"x": 871.1, "y": 1512.6, "width": 670.4, "height": 33.0}}, {"kind": "text", "text": "SpA. Since non parametric linkage analyses usually do not", "bbox": {"x": 874.3, "y": 1484.4, "width": 664.1000000000001, "height": 32.09999999999991}}, {"kind": "text", "text": "[12], supporting the validity of linkage between this region and", "bbox": {"x": 874.4, "y": 1456.2, "width": 663.7999999999998, "height": 29.200000000000045}}, {"kind": "text", "text": "suggestive linkage peak reported in AS (D9S1682, P=6×10-1)", "bbox": {"x": 868.1, "y": 1424.2, "width": 670.2000000000002, "height": 32.09999999999991}}, {"kind": "text", "text": "screen. The second statistically significant area was located near a", "bbox": {"x": 871.2, "y": 1398.4, "width": 667.0, "height": 26.0}}, {"kind": "text", "text": "D9S1776, which corresponded to the linkage peak in our former", "bbox": {"x": 874.4, "y": 1369.9, "width": 667.0000000000001, "height": 32.40000000000009}}, {"kind": "text", "text": "(115.9 Mb) from the p-telomere, only 1.3 cM apart from", "bbox": {"x": 874.3, "y": 1337.1, "width": 664.1000000000001, "height": 32.40000000000009}}, {"kind": "text", "text": "highest linkage peak located on the marker D9S1824 at 120.1 cM", "bbox": {"x": 874.4, "y": 1312.4, "width": 667.0000000000001, "height": 26.0}}, {"kind": "text", "text": "revealed two areas of statistically significant linkage, with the", "bbox": {"x": 871.2, "y": 1283.4, "width": 670.2, "height": 26.0}}, {"kind": "text", "text": "microsatellite markers in an extended set of families. The results", "bbox": {"x": 874.3, "y": 1249.9, "width": 667.3, "height": 30.5}}, {"kind": "text", "text": "our first attempt was to refine it using a fine-grained set of 28", "bbox": {"x": 871.2, "y": 1223.0, "width": 670.2, "height": 25.5}}, {"kind": "text", "text": "linkage in this locus was spread over a long distance of 23.95 cM,", "bbox": {"x": 874.4, "y": 1194.3, "width": 663.7999999999998, "height": 25.5}}, {"kind": "text", "text": "SpA on chromosome 9q31-34 called SPA2 [13]. Since initial", "bbox": {"x": 874.4, "y": 1165.5, "width": 663.7999999999998, "height": 26.0}}, {"kind": "text", "text": "previous whole genome linkage screen the susceptibility region for", "bbox": {"x": 874.4, "y": 1136.5, "width": 667.0000000000001, "height": 26.0}}, {"kind": "text", "text": "The basis of our investigations aimed to narrow down from our", "bbox": {"x": 896.8, "y": 1108.1, "width": 644.7, "height": 25.5}}, {"kind": "text", "text": "and association steps.", "bbox": {"x": 871.0, "y": 1076.9, "width": 220.70000000000005, "height": 25.40000000000009}}, {"kind": "text", "text": "This was achieved by a comprehensive study with several linkage", "bbox": {"x": 874.4, "y": 1047.4, "width": 667.0000000000001, "height": 25.5}}, {"kind": "text", "text": "determining a haplotype near the TNFSF15 gene (9q32) and SpA.", "bbox": {"x": 874.4, "y": 1018.5, "width": 663.7999999999998, "height": 26.0}}, {"kind": "text", "text": "We report for the first time an association between several SNPs", "bbox": {"x": 896.8, "y": 989.5, "width": 641.5, "height": 23.0}}, {"kind": "text", "text": "Discussion", "bbox": {"x": 871.2, "y": 938.8, "width": 146.79999999999995, "height": 28.700000000000045}}, {"kind": "text", "text": "as well as in the case/ control one (P= 7.0×10-* at 3 df).", "bbox": {"x": 871.1, "y": 869.3, "width": 590.9, "height": 37.799999999999955}}, {"kind": "text", "text": "family-based sample (P= 4.5×10-5 at 4 degrees-of-freedom (df)),", "bbox": {"x": 874.3, "y": 841.1, "width": 667.3, "height": 37.10000000000002}}, {"kind": "text", "text": "A significant omnibus haplotype association was detected in", "bbox": {"x": 900.0, "y": 820.6, "width": 638.3, "height": 26.0}}, {"kind": "text", "text": "Table S5).", "bbox": {"x": 874.3, "y": 791.5, "width": 108.70000000000005, "height": 26.299999999999955}}, {"kind": "text", "text": "patients, independently of the presence of HLA-B27 (Table S4 and", "bbox": {"x": 871.2, "y": 759.7, "width": 667.0, "height": 29.100000000000023}}, {"kind": "text", "text": "that the frequency of H2 haplotype was significantly decreased in", "bbox": {"x": 874.2, "y": 727.2, "width": 667.3, "height": 34.5}}, {"kind": "text", "text": "controls. Case/control HLA-B27 conditioned analyses showed", "bbox": {"x": 871.2, "y": 702.5, "width": 667.0, "height": 25.5}}, {"kind": "text", "text": "all the other haplotypes being more frequent in cases than in", "bbox": {"x": 871.2, "y": 673.7, "width": 670.2, "height": 26.0}}, {"kind": "text", "text": "frequent in controls than in cases (Table 4; P=8.75×10-), with", "bbox": {"x": 874.3, "y": 638.3, "width": 664.0, "height": 32.60000000000002}}, {"kind": "text", "text": "showed that the rare haplotype H2 was very significantly more", "bbox": {"x": 871.2, "y": 616.3, "width": 670.2, "height": 25.5}}, {"kind": "text", "text": "The case/control haplotype association analysis conversely", "bbox": {"x": 896.8, "y": 587.6, "width": 641.5, "height": 25.5}}, {"kind": "text", "text": "with Bonferroni method was set to 0.013", "bbox": {"x": 871.2, "y": 555.6, "width": 424.5, "height": 22.399999999999977}}, {"kind": "text", "text": "corrected for the multiplicity of tested haplotypes and extrapolated", "bbox": {"x": 871.2, "y": 526.8, "width": 667.0, "height": 29.0}}, {"kind": "text", "text": "three alleles being undertransmitted. The significance threshold", "bbox": {"x": 874.3, "y": 494.4, "width": 664.1000000000001, "height": 32.10000000000002}}, {"kind": "text", "text": "with a high significance level (Table 4; P= 8.81 ×10-°), the other", "bbox": {"x": 874.4, "y": 465.8, "width": 663.7999999999998, "height": 29.19999999999999}}, {"kind": "text", "text": "most frequent allele HI as overtransmitted to affected children", "bbox": {"x": 874.4, "y": 440.7, "width": 667.0000000000001, "height": 22.399999999999977}}, {"kind": "text", "text": "The family-based haplotype association analysis identified the", "bbox": {"x": 896.8, "y": 411.8, "width": 644.7, "height": 26.0}}, {"kind": "text", "text": "0.108", "bbox": {"x": 434.0, "y": 303.4, "width": 16.0, "height": 51.10000000000002}}, {"kind": "text", "text": "0.040", "bbox": {"x": 469.1, "y": 303.4, "width": 16.0, "height": 51.10000000000002}}, {"kind": "text", "text": "0.132", "bbox": {"x": 501.0, "y": 303.4, "width": 19.100000000000023, "height": 51.10000000000002}}, {"kind": "text", "text": "0.023", "bbox": {"x": 536.2, "y": 306.6, "width": 19.100000000000023, "height": 47.89999999999998}}, {"kind": "text", "text": "3x10-05", "bbox": {"x": 563.2, "y": 275.7, "width": 32.5, "height": 80.5}}, {"kind": "text", "text": "2x10-04", "bbox": {"x": 602.3, "y": 276.6, "width": 21.100000000000023, "height": 78.69999999999999}}, {"kind": "text", "text": "0.018", "bbox": {"x": 641.5, "y": 303.4, "width": 16.0, "height": 51.10000000000002}}, {"kind": "text", "text": "0.090", "bbox": {"x": 676.6, "y": 303.4, "width": 16.0, "height": 51.10000000000002}}, {"kind": "text", "text": "Combined", "bbox": {"x": 245.7, "y": 156.5, "width": 19.100000000000023, "height": 99.0}}, {"kind": "text", "text": "Results", "bbox": {"x": 268.1, "y": 185.2, "width": 19.100000000000023, "height": 70.30000000000001}}, {"kind": "text", "text": "9x10-04", "bbox": {"x": 426.0, "y": 180.3, "width": 29.30000000000001, "height": 80.0}}, {"kin
000045, "height": 19.200000000000045}}, {"kind": "text", "text": "0.005 0.355", "bbox": {"x": 1312.3, "y": 1462.3, "width": 60.700000000000045, "height": 61.0}}, {"kind": "text", "text": "0.008", "bbox": {"x": 1433.7, "y": 1427.4, "width": 60.700000000000045, "height": 25.5}}, {"kind": "text", "text": "a NH non-Hispanics, Hisp Hispanics, All non-Hispanics and Hispanics combined • \"Rare haplotypes\" refers to combined group of individual haplotypes with <5 % frequency among controls © 377 childhood ALL cases, 448 controls", "bbox": {"x": 137.0, "y": 1577.4, "width": 1079.7, "height": 99.89999999999986}}, {"kind": "text", "text": "CYPIA2 was significantly associated with an increased risk (OR = 2.19, ₽ = 0.005), while haplotype A-A of CYP1B1 was significantly associated with a decreased risk (OR = 0.11, p = 0.007). The observed significant global haplotype association of CYP2B6 was attributed to rare haplotypes. Among Hispanics, the two SNPs in IDHI showed a haplotype association stronger than either SNP individually", "bbox": {"x": 137.2, "y": 1730.8, "width": 667.7, "height": 239.5}}, {"kind": "text", "text": "(global p = 0.008), and the C-C haplotype was significantly associated with an increased risk of ALL (OR = 6.12, p = 0.005). Two of the most commonly studied xenobiotic metabolism genes to date in childhood ALL are the glutathione S transferase genes GSTMI and GSTTI, whose principal variants are deletions [30]. The GSTMI deletion showed", "bbox": {"x": 846.0, "y": 1730.8, "width": 667.7, "height": 238.60000000000014}}, {"kind": "text", "text": "1 Springer", "bbox": {"x": 1389.6, "y": 2044.6, "width": 125.70000000000005, "height": 44.5}}], "ms": 320.52}
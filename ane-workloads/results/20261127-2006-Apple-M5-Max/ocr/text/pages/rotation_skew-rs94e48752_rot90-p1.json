6, "y": 1357.3, "width": 19.0, "height": 47.299999999999955}}, {"kind": "text", "text": "0.702", "bbox": {"x": 831.0, "y": 1357.3, "width": 15.799999999999955, "height": 47.299999999999955}}, {"kind": "text", "text": "0.397", "bbox": {"x": 796.3, "y": 1357.3, "width": 19.0, "height": 44.200000000000045}}, {"kind": "text", "text": "p-value*", "bbox": {"x": 1983.5, "y": 1450.9, "width": 24.0, "height": 71.70000000000005}}, {"kind": "text", "text": "0.156", "bbox": {"x": 1956.0, "y": 1448.8, "width": 19.0, "height": 50.5}}, {"kind": "text", "text": "0.380", "bbox": {"x": 1763.2, "y": 1448.8, "width": 15.799999999999955, "height": 50.5}}, {"kind": "text", "text": "0.555", "bbox": {"x": 1630.5, "y": 1448.8, "width": 19.0, "height": 47.299999999999955}}, {"kind": "text", "text": "0.036", "bbox": {"x": 1598.9, "y": 1448.8, "width": 19.0, "height": 50.5}}, {"kind": "text", "text": "0.047", "bbox": {"x": 1469.3, "y": 1448.8, "width": 19.0, "height": 47.299999999999955}}, {"kind": "text", "text": "0.816", "bbox": {"x": 1425.1, "y": 1448.8, "width": 19.0, "height": 50.5}}, {"kind": "text", "text": "Table 5. Comparative analysis of baseline characteristics of kidney transplant recipients with and without", "bbox": {"x": 733.1, "y": 432.4, "width": 28.399999999999977, "height": 1060.6}}, {"kind": "text", "text": "SARS-CoV-2 specific T cell immunity response after two doses of inactivated vaccine. Results are expressed", "bbox": {"x": 704.7, "y": 432.4, "width": 28.399999999999977, "height": 1070.0}}, {"kind": "text", "text": "as median (interquartile range) and number (%). Continuous data were compared using the Mann-Whitney", "bbox": {"x": 679.4, "y": 429.3, "width": 25.299999999999955, "height": 1085.8}}, {"kind": "text", "text": "U-test, and categorical variables with the chi-square. KTRs kidney transplant recipients, MMF mycophenolate mofetil, ATG anti-thymocyte globulin. *p-value of Univariate analysis. *p-value of Multiple logistic regression", "bbox": {"x": 622.5, "y": 432.4, "width": 56.89999999999998, "height": 1095.2999999999997}}, {"kind": "text", "text": "analyses.", "bbox": {"x": 597.2, "y": 429.3, "width": 25.299999999999955, "height": 91.49999999999994}}, {"kind": "text", "text": "Recent data indicated the third homologues booster with inactivated vaccine could not further increase the cellular immunity against SARS-CoV-2'º. However, third booster with mRNA vaccine or adenovirus vector", "bbox": {"x": 451.9, "y": 432.4, "width": 53.60000000000002, "height": 1107.9}}, {"kind": "text", "text": "vaccine could further increase the SARS-CoV-2 specific T cells in healthy individuals vaccinated with two doses", "bbox": {"x": 423.4, "y": 429.3, "width": 28.399999999999977, "height": 1111.1}}, {"kind": "text", "text": "of inactivated vaccine®,24. Thus, a third dose with heterologous vaccine might be a better strategy for improving", "bbox": {"x": 395.0, "y": 432.4, "width": 28.399999999999977, "height": 1107.9}}, {"kind": "text", "text": "T cell immunity response in these patients7,27", "bbox": {"x": 367.1, "y": 432.3, "width": 31.19999999999999, "height": 451.7}}, {"kind": "text", "text": "Studies, including our own, have demonstrated that there is a discordance between the humoral and cellular", "bbox": {"x": 341.3, "y": 464.0, "width": 25.30000000000001, "height": 1076.4}}, {"kind": "text", "text": "immunity response after SARS-CoV-2 vaccination in KTRs4. This discordance may be due to the immunosup", "bbox": {"x": 312.8, "y": 429.3, "width": 28.399999999999977, "height": 1104.8}}, {"kind": "text", "text": "pressive drugs these patients are on. The triple immunosuppression regime significantly disturbs the interaction", "bbox": {"x": 284.4, "y": 429.3, "width": 25.30000000000001, "height": 1111.1}}, {"kind": "text", "text": "between T follicular helper (Tfh) cells and B cells in the germinal center, and suppresses the proliferation of activated T and B cells4445. These processes are pivotal to anti-SARS-CoV-2 specific antibody generation 18,46,47", "bbox": {"x": 230.7, "y": 429.3, "width": 53.69999999999999, "height": 1114.2}}, {"kind": "text", "text": "In contrast to our study, Bruminhent et al. have shown that the spike and NP specific T cells were enhanced in healthy people after two doses of inactivated vaccine, but not in KTRs'. They reported that in KTRs the sum", "bbox": {"x": 173.8, "y": 429.3, "width": 53.69999999999999, "height": 1111.1}}, {"kind": "text", "text": "of T cells against spike and NP was 58 SFU/10° PBMCs after two doses of inactivated vaccine. This was lower", "bbox": {"x": 145.4, "y": 432.4, "width": 28.400000000000006, "height": 1111.1}}, {"kind": "text", "text": "than that reported in our study (median SFU/10° PBMCs against spike: 67.5, median SFU/10° PBMCs against", "bbox": {"x": 116.9, "y": 432.4, "width": 28.400000000000006, "height": 1107.9}}, {"kind": "text", "text": "Scientific Reports | (2023) 13:7263 | https://doi.org/10.1038/s41598-023-29669-8", "bbox": {"x": 41.2, "y": 113.4, "width": 29.200000000000003, "height": 934.6}}, {"kind": "text", "text": "nature portfolio", "bbox": {"x": 47.2, "y": 1303.4, "width": 23.89999999999999, "height": 151.9000000000001}}], "ms": 280.93}
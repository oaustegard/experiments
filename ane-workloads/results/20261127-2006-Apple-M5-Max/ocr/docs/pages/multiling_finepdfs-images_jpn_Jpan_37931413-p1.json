96205001, "width": 661.7088235294117, "height": 37.94999999999987}}, {"kind": "text", "text": "薬剤名お分かりでしたら（", "bbox": {"x": 88.50882331867649, "y": 986.6999999783761, "width": 337.1764705882353, "height": 33.73333333333344}}, {"kind": "list", "text": "お薬で薬疹が出たり、気分が悪くなるほど副作用が出たことがありますかはい・いいえ 薬剤名お分かりでしたら（ どんな副作用でしたか（ 女性のかたへ現在、妊娠中あるいは妊娠の可能性、または授乳中ですか", "bbox": {"x": 88.50882173450306, "y": 1071.0333330603764, "width": 1184.3323529411766, "height": 244.5666666666667}}, {"kind": "text", "text": "いいえ・はい【妊娠中（", "bbox": {"x": 88.50882335489665, "y": 1336.6833333069792, "width": 341.3911764705883, "height": 33.73333333333344}}, {"kind": "text", "text": "）週目・妊娠の可能性あり・授乳中】", "bbox": {"x": 501.5500061640072, "y": 1332.4666661395836, "width": 535.2676470588235, "height": 42.166666666666515}}, {"kind": "text", "text": "⑤ 本日の症状に◎をつけて下さい", "bbox": {"x": 88.50881794492659, "y": 1416.7999994729169, "width": 463.61764705882354, "height": 42.16666666666674}}, {"kind": "text", "text": "耳", "bbox": {"x": 139.08529390691177, "y": 1484.2666664257142, "width": 37.932352941176475, "height": 33.73333333333321}}, {"kind": "text", "text": "（右・左・両）・痛い・かゆい・難聴・耳鳴り・ふさがった感じ", "bbox": {"x": 257.0970586149336, "y": 1480.049999990368, "width": 838.7264705882352, "height": 37.95000000000009}}, {"kind": "text", "text": "異物・耳垢・めまい・耳だれ", "bbox": {"x": 244.45294096800131, "y": 1539.0833333129299, "width": 404.61176470588236, "height": 37.95000000000009}}, {"kind": "text", "text": "鼻", "bbox": {"x": 139.08529390691177, "y": 1602.3333330170833, "width": 33.71764705882353, "height": 37.95000000000009}}, {"kind": "text", "text": "痛い・鼻づまり・水鼻・黄色鼻水・鼻水が喉へ落ちる・鼻血・頭痛", "bbox": {"x": 252.8823527544628, "y": 1598.1166666568352, "width": 923.020588235294, "height": 37.94999999999987}}, {"kind": "text", "text": "嗅覚障害・悪臭がする・できもの・くしゃみ・かゆい", "bbox": {"x": 252.8823527211049, "y": 1661.3666666573258, "width": 703.8558823529411, "height": 29.516666666666787}}, {"kind": "text", "text": "痛い・声がれ・せき・たん・異物感・いびき・かゆい", "bbox": {"x": 261.3117644915137, "y": 1720.3999999903065, "width": 754.4323529411765, "height": 33.73333333333344}}, {"kind": "text", "text": "痛い・できもの・舌", "bbox": {"x": 261.31176860033526, "y": 1779.4333337764429, "width": 265.52645451040826, "height": 33.73333232800182}}, {"kind": "text", "text": "首", "bbox": {"x": 809.2235293415197, "y": 1783.64999968375, "width": 50.576470588235274, "height": 37.95000000000009}}, {"kind": "text", "text": "のど", "bbox": {"x": 126.44117627606333, "y": 1724.616666536923, "width": 59.005882352941164, "height": 33.73333333333321}}, {"kind": "text", "text": "口腔", "bbox": {"x": 122.22647067252942, "y": 1783.6499996205002, "width": 67.43529411764706, "height": 37.95000000000009}}, {"kind": "text", "text": "その他", "bbox": {"x": 126.44117625985292, "y": 1851.1166665899998, "width": 92.72352941176472, "height": 33.73333333333344}}, {"kind": "text", "text": "⑥） 本日の症状はいつからですか（", "bbox": {"x": 88.50882328540247, "y": 1927.0166666444738, "width": 472.0470588235294, "height": 42.166666666666515}}, {"kind": "text", "text": "痛い・しこり・腫れ", "bbox": {"x": 927.2352939033997, "y": 1783.6499999718887, "width": 265.5264705882353, "height": 33.73333333333344}}, {"kind": "text", "text": "）", "bbox": {"x": 1066.320587971875, "y": 1842.683332964375, "width": 21.073529411764632, "height": 29.516666666666787}}, {"kind": "text", "text": "）から", "bbox": {"x": 1049.4617650009118, "y": 1927.0166662871668, "width": 80.07941176470591, "height": 37.95000000000009}}], "ms": 423.510042}
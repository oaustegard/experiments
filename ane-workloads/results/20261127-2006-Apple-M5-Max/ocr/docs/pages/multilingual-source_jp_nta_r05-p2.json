ox": {"x": 873.4513270561395, "y": 1369.9062498548826, "width": 69.6902654867256, "height": 23.218750000000163}}, {"kind": "text", "text": "明・大", "bbox": {"x": 873.4513272013276, "y": 1397.7687498548828, "width": 46.4601769911504, "height": 23.21874999999992}}, {"kind": "text", "text": "照平・会", "bbox": {"x": 873.4513272013276, "y": 1420.9874999226042, "width": 69.6902654867256, "height": 23.21874999999992}}, {"kind": "text", "text": "明-大", "bbox": {"x": 873.4513272013276, "y": 1448.8499998839065, "width": 46.4601769911504, "height": 23.21874999999992}}, {"kind": "text", "text": "照平・各", "bbox": {"x": 873.4513272013276, "y": 1472.0687499226042, "width": 69.6902654867256, "height": 23.218750000000163}}, {"kind": "text", "text": "用・大", "bbox": {"x": 873.4513266205753, "y": 1499.931250205297, "width": 41.81415929203546, "height": 13.93124999999995}}, {"kind": "text", "text": "图-平・令", "bbox": {"x": 873.4513271432521, "y": 1518.5062497097656, "width": 69.6902654867256, "height": 23.21874999999992}}, {"kind": "text", "text": "润擊", "bbox": {"x": 1491.3716812126659, "y": 1360.6187498548827, "width": 41.81415929203546, "height": 23.21874999999992}}, {"kind": "text", "text": "別底", "bbox": {"x": 1426.3274333960173, "y": 1458.137499854883, "width": 46.460176991150576, "height": 23.21874999999992}}, {"kind": "text", "text": "16", "bbox": {"x": 1375.2212387522122, "y": 1509.2187497678124, "width": 27.87610619469031, "height": 23.21874999999992}}, {"kind": "text", "text": "詢整", "bbox": {"x": 1491.3716811836282, "y": 1509.218749834152, "width": 41.81415929203546, "height": 23.21874999999992}}, {"kind": "text", "text": "統柄", "bbox": {"x": 817.699114811947, "y": 1583.5187498944604, "width": 51.10619469026551, "height": 23.21874999999992}}, {"kind": "text", "text": "生", "bbox": {"x": 919.9115041924778, "y": 1583.5187497678123, "width": 32.522123893805244, "height": 23.21874999999992}}, {"kind": "text", "text": "明・大", "bbox": {"x": 873.4513269690265, "y": 1606.7374997097654, "width": 46.4601769911504, "height": 23.218750000000163}}, {"kind": "text", "text": "品平", "bbox": {"x": 873.4513272271387, "y": 1629.9562498710068, "width": 46.4601769911504, "height": 23.218750000000163}}, {"kind": "text", "text": "明・大", "bbox": {"x": 873.4513269690265, "y": 1657.8187497097656, "width": 46.4601769911504, "height": 23.21874999999992}}, {"kind": "text", "text": "服平", "bbox": {"x": 873.4513272013276, "y": 1681.0374998548828, "width": 46.4601769911504, "height": 23.21874999999992}}, {"kind": "text", "text": "従事月数・程度・仕事の内容】", "bbox": {"x": 1119.690264776158, "y": 1578.8749999180516, "width": 241.5929203539822, "height": 27.8624999999999}}, {"kind": "text", "text": "専従者給与（控除）飯", "bbox": {"x": 1356.6371679154051, "y": 1583.5187499694491, "width": 181.19469026548666, "height": 23.21874999999992}}, {"kind": "text", "text": "給ケ、 公的年金等以外の 所得に任る住民税の備収方法", "bbox": {"x": 669.0265484338126, "y": 1741.4062499442566, "width": 195.1327433628318, "height": 41.793749999999854}}, {"kind": "text", "text": "自分で統仁", "bbox": {"x": 775.8849548230089, "y": 1787.8437502052968, "width": 83.62831858407075, "height": 13.93124999999995}}, {"kind": "text", "text": "都通府県、市区町村 共同幕金、日素", "bbox": {"x": 882.7433625952557, "y": 1746.0499999603617, "width": 306.6371681415929, "height": 27.86250000000015}}, {"kind": "text", "text": "その他の谷附", "bbox": {"x": 1063.938052874336, "y": 1778.55624996285, "width": 120.79646017699127, "height": 18.574999999999935}}, {"kind": "text", "text": "部滋府保", "bbox": {"x": 1249.778760829646, "y": 1750.6937499274413, "width": 83.62831858407075, "height": 23.21874999999992}}, {"kind": "text", "text": "条例指定寄婚", "bbox": {"x": 1230.849760454898, "y": 1772.3332694884573, "width": 121.48631610701565, "height": 31.020958890020783}}, {"kind": "text", "text": "市区町村", "bbox": {"x": 1417.0353979977874, "y": 1750.6937499274413, "width": 83.62831858407075, "height": 23.21874999999992}}, {"kind": "text", "text": "※例指定寄附", "bbox": {"x": 1398.4513272013273, "y": 1778.5562499553484, "width": 120.7964601769911, "height": 23.218750000000163}}, {"kind": "text", "text": "続柄", "bbox": {"x": 813.0530970896017, "y": 1862.1437498839064, "width": 51.10619469026551, "height": 23.218750000000163}}, {"kind": "text", "text": "老購所待を除く所得金額辣害者", "bbox": {"x": 1091.8141590555108, "y": 1862.1437499788922, "width": 260.17699115044246, "height": 23.21874999999992}}, {"kind": "text", "text": "第-平", "bbox": {"x": 868.8053095022125, "y": 1908.5812498710068, "width": 41.81415929203546, "height": 23.218750000000163}}, {"kind": "text", "text": "特局", "bbox": {"x": 1319.4690263163716, "y": 1899.293749854883, "width": 37.16814159292036, "height": 23.21874999999992}}, {"kind": "text", "text": "その他「赤婦・ひとり袋", "bbox": {"x": 1370.575221006637, "y": 1862.1437499677518, "width": 167.2566371681415, "height": 23.218750000000163}}, {"kind": "text", "text": "胡整", "bbox": {"x": 1375.2212389961282, "y": 1899.2937497097655, "width": 41.81415929203546, "height": 23.218750000000163}}, {"kind": "text", "text": "寡刻", "bbox": {"x": 1435.6194687942477, "y": 1899.293749854883, "width": 37.16814159292036, "height": 23.21874999999992}}, {"kind": "text", "text": "第（廃）茶", "bbox": {"x": 1221.9026550608407, "y": 1955.0187498065104, "width": 78.98230088495582, "height": 23.21874999999992}}, {"kind": "text", "text": "開始・爽止", "bbox": {"x": 1300.652892683069, "y": 1944.7148836818606, "width": 98.03049669856519, "height": 25.251481173932437}}, {"kind": "text", "text": "他都道府服の水務所等", "bbox": {"x": 1217.2566369415065, "y": 1992.1687499716843, "width": 195.1327433628318, "height": 23.218750000000163}}, {"kind": "text", "text": "事楽用資産の選渡損失など", "bbox": {"x": 673.6725661346397, "y": 1992.1687499763075, "width": 232.30088495575217, "height": 23.21874999999992}}, {"kind": "text", "text": "国外", "bbox": {"x": 743.3628317190264, "y": 2038.6062497678124, "width": 41.81415929203546, "height": 23.21874999999992}}, {"kind": "text", "text": "所得税で控除対象配偶格以", "bbox": {"x": 789.375524002796, "y": 2024.5673241129437, "width": 214.8327523628167, "height": 32.95351013541213}}, {"kind": "text", "text": "なくこしたゃ、イィ", "bbox": {"x": 794.4690262665929, "y": 2057.1812499751227, "width": 204.42477876106184, "height": 13.93124999999995}}, {"kind": "text", "text": "税理士箸名•電話番号", "bbox": {"x": 1068.5840705641594, "y": 2085.0437499716845, "width": 199.7787610619469, "height": 23.21874999999992}}, {"kind": "text", "text": "令和五年分以路用）", "bbox": {"x": 1547.1238836618115, "y": 283.2687470976562, "width": 23.23010843412019, "height": 232.18750000000017}}, {"kind": "text", "text": "●第二表は、 第一表と一 水に是出し", "bbox": {"x": 1547.1238803096833, "y": 529.3874984917488, "width": 23.23011508030162, "height": 320.4187499999999}}, {"kind": "text", "text": "●口民午金保", "bbox": {"x": 1547.123889142221, "y": 965.8999980651043, "width": 23.230097357150672, "height": 116.09375000000009}}, {"kind": "text", "text": "など中告", "bbox": {"x": 1547.1238902499178, "y": 1360.618748606875, "width": 23.230095141756806, "height": 83.58749999999995}}, {"kind": "text", "text": "ればならな、", "bbox": {"x": 1547.1238890841457, "y": 1583.5187486649218, "width": 23.230097357150846, "height": 106.80625000000012}}, {"kind": "text", "text": "貼ってください", "bbox": {"x": 1542.477870381869, "y": 1936.443748606875, "width": 27.876117271659652, "height": 139.3125}}], "ms": 749.030334}
8673215, "width": 69.69026548672578, "height": 37.15000000000011}}, {"kind": "text", "text": "000", "bbox": {"x": 1356.637167919392, "y": 1801.774999919239, "width": 111.50442477876106, "height": 37.15000000000011}}, {"kind": "text", "text": "等籍「支肉", "bbox": {"x": 1398.4513271084072, "y": 1857.4999995820629, "width": 78.98230088495565, "height": 41.793749999999854}}, {"kind": "text", "text": "各+※+幼+团", "bbox": {"x": 181.19469003318585, "y": 2089.6874999668307, "width": 171.90265486725664, "height": 23.21874999999992}}, {"kind": "text", "text": "この中告書を提出される方は、住民税・事業税の中合書を提出 する必要がありません。", "bbox": {"x": 129.87194567921014, "y": 2116.810527425678, "width": 655.5604276403916, "height": 52.82751445174235}}, {"kind": "text", "text": "三取", "bbox": {"x": 813.05309704646, "y": 1885.3624998009823, "width": 41.81415929203546, "height": 27.8624999999999}}, {"kind": "text", "text": "郵便局", "bbox": {"x": 850.2212387057522, "y": 1899.293749922604, "width": 69.6902654867256, "height": 23.218750000000163}}, {"kind": "text", "text": "口座番号", "bbox": {"x": 854.8672564048674, "y": 1950.374999917076, "width": 65.04424778761066, "height": 23.21874999999992}}, {"kind": "text", "text": "粒額", "bbox": {"x": 1142.920353285398, "y": 1922.512499535625, "width": 51.10619469026551, "height": 27.86250000000015}}, {"kind": "text", "text": "新所路精", "bbox": {"x": 813.0530955641593, "y": 1955.0187504879898, "width": 106.85840707964596, "height": 37.149998892843904}}, {"kind": "text", "text": "公金受取口座登録の同意", "bbox": {"x": 817.699114811947, "y": 2001.4562499772367, "width": 236.94690265486727, "height": 23.21874999999992}}, {"kind": "text", "text": "公金受取口座の利用", "bbox": {"x": 1180.088495348728, "y": 2001.4562499651718, "width": 190.48672566371687, "height": 27.8624999999999}}, {"kind": "text", "text": "収受本実を健認されたい方は、収受日付印を押なつ しますので、申告書出時に請潔してください（内容 を証明するものではありません。）。", "bbox": {"x": 826.4984528865509, "y": 2035.9556825122752, "width": 530.5701559623785, "height": 79.62427910566316}}, {"kind": "text", "text": "※用で焼を額の証明が必要な方は、納供証明書をご利", "bbox": {"x": 822.3451325090242, "y": 2112.906249977596, "width": 534.2920353982302, "height": 51.08125000000007}}, {"kind": "text", "text": "第", "bbox": {"x": 1491.3716811836282, "y": 130.02499965171876, "width": 37.16814159292036, "height": 41.793749999999854}}, {"kind": "text", "text": "〇この用紙は控用です。", "bbox": {"x": 1491.5190896021338, "y": 273.5641458468966, "width": 41.957069920227724, "height": 391.04749064445497}}, {"kind": "text", "text": "・（・⑤又は図の記入をお忘れなく。", "bbox": {"x": 1490.4856760724672, "y": 1332.3737075289375, "width": 42.973404015059906, "height": 460.641917037964}}], "ms": 708.911542}
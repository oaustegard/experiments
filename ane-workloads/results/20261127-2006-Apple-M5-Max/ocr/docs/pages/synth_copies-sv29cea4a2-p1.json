715.9764703505043, "y": 546.4666666318155, "width": 209.43529411764706, "height": 29.274999999999896}}, {"kind": "text", "text": "(M):9975155699, 9326804516", "bbox": {"x": 638.04705858, "y": 580.6208333172834, "width": 370.1647058823529, "height": 24.395833333333506}}, {"kind": "text", "text": "Email: drshivjosh 93@gmai.com", "bbox": {"x": 623.1047067847568, "y": 609.6464625549013, "width": 400.0310227338006, "height": 36.09140209754315}}, {"kind": "text", "text": "Chairman", "bbox": {"x": 1275.9953511173094, "y": 302.03942966831363, "width": 136.574001940559, "height": 30.212806975841627}}, {"kind": "text", "text": "IMA JDN Standing Committee", "bbox": {"x": 1139.7176467928637, "y": 336.66249998074005, "width": 404.2588235294118, "height": 29.275000000000155}}, {"kind": "text", "text": "Dr. K. M. Abul Hasan", "bbox": {"x": 1193.2941173223528, "y": 370.81666663413887, "width": 301.97647058823514, "height": 29.275000000000155}}, {"kind": "text", "text": "(M):9843025300,9443320505", "bbox": {"x": 1159.1999997564708, "y": 404.97083331706955, "width": 365.29411764705884, "height": 24.395833333333247}}, {"kind": "text", "text": "Email: drkmabulhasan@yahoo.com", "bbox": {"x": 1125.1058821094118, "y": 439.1249999835533, "width": 433.4823529411764, "height": 29.275000000000155}}, {"kind": "text", "text": "National Secretary", "bbox": {"x": 1212.7764701599594, "y": 478.15833328285925, "width": 258.1411764705882, "height": 29.274999999999896}}, {"kind": "text", "text": "IMA JDN National Council", "bbox": {"x": 1168.941176227059, "y": 512.3124999830585, "width": 350.68235294117653, "height": 24.395833333333247}}, {"kind": "text", "text": "Dr. Karan Juneja", "bbox": {"x": 1222.5176466935293, "y": 546.4666666209246, "width": 243.52941176470594, "height": 29.274999999999896}}, {"kind": "text", "text": "(M): 7017497457", "bbox": {"x": 1232.258823291294, "y": 580.6208333062268, "width": 224.04705882352934, "height": 24.395833333333247}}, {"kind": "text", "text": "Email: junejakaran@yahoo.com", "bbox": {"x": 1144.219799285852, "y": 609.5757361545577, "width": 400.01214563706344, "height": 38.51644903421402}}, {"kind": "text", "text": "31.05.2021", "bbox": {"x": 1373.5058821022492, "y": 741.6333332902819, "width": 170.47058823529406, "height": 29.274999999999896}}, {"kind": "text", "text": "Press Release", "bbox": {"x": 871.835293749647, "y": 873.3708332791201, "width": 340.9411764705881, "height": 48.79166666666701}}, {"kind": "text", "text": "The modern medicine doctors have been fighting upfront during the", "bbox": {"x": 472.4470585412293, "y": 1009.9874999902903, "width": 1144.5882352941176, "height": 39.033333333333196}}, {"kind": "text", "text": "COVID 19 pandemic and we have not backed out even after seeing our colleagues getting infected and getting infected ourselves.", "bbox": {"x": 472.4470585233054, "y": 1058.779166655959, "width": 1144.5882352941176, "height": 87.8250000000002}}, {"kind": "text", "text": "Indian Medical Association Junior Doctors' Network condemns the insulting remarks made by Mr Ram Krishna Yadav alias Baba Ramdev and declare a Nationwide Black Day Protest on 1st June 2021 without hampering the patient care to voice our protest against such derogatory comments made on our profession.", "bbox": {"x": 462.4927427181194, "y": 1194.2556848697602, "width": 1154.8600885727826, "height": 245.85205729007717}}, {"kind": "text", "text": "We also support all the RDAs at the National and the state levels who have come together to demonstrate their anguish through a black day protest.", "bbox": {"x": 467.57647037082086, "y": 1483.266666579257, "width": 1149.4588235294118, "height": 136.6166666666667}}, {"kind": "text", "text": "Thanking You", "bbox": {"x": 924.5423086862614, "y": 1662.2337418346615, "width": 235.76351165771484, "height": 60.870863223075766}}, {"kind": "text", "text": "Yours Sincerely", "bbox": {"x": 910.1704746670705, "y": 1754.717763104274, "width": 269.0944817935719, "height": 59.20908878644315}}, {"kind": "text", "text": "Dr KM Abul Hasan", "bbox": {"x": 569.8588232554412, "y": 1966.3041666361719, "width": 370.16470588235285, "height": 39.033333333333196}}, {"kind": "text", "text": "Chairman, IMAJDN Standing Committee", "bbox": {"x": 491.9294115289486, "y": 2010.2166666459043, "width": 530.8941176470588, "height": 39.033333333333196}}, {"kind": "text", "text": "Dr. Parul Vedgama", "bbox": {"x": 1144.5882349826265, "y": 1961.4249999375922, "width": 355.5529411764706, "height": 53.67083333333314}}, {"kind": "text", "text": "Secretary, IMA JDN Standing Committee", "bbox": {"x": 1061.4368026624638, "y": 2000.3981950600607, "width": 526.8096044203813, "height": 55.416429360707774}}, {"kind": "text", "text": "Dr Shiv Joshi", "bbox": {"x": 633.176470344706, "y": 2161.470833287591, "width": 253.27058823529404, "height": 43.9125000000001}}, {"kind": "text", "text": "Convener IMA JDN, National Council", "bbox": {"x": 516.2823529159838, "y": 2205.3833332660342, "width": 482.1882352941177, "height": 39.03333333333345}}, {"kind": "text", "text": "Dr Karan Juneja", "bbox": {"x": 1168.207998424085, "y": 2159.724060289966, "width": 317.97659373563874, "height": 51.54726307392126}}, {"kind": "text", "text": "Secretary, IMAJDN, National Council", "bbox": {"x": 1081.2705880775145, "y": 2205.383333302409, "width": 487.0588235294117, "height": 43.912499999999845}}], "ms": 356.676916}
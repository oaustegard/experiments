    # ---- BaseStemmer runtime (snowballstemmer/basestemmer.py), code-point based

    def in_grouping(mut self, g: Int) -> Bool:
        if self.cursor >= self.limit:
            return False
        if not self.has(g, self.current[self.cursor]):
            return False
        self.cursor += 1
        return True

    def in_grouping_b(mut self, g: Int) -> Bool:
        if self.cursor <= self.limit_backward:
            return False
        if not self.has(g, self.current[self.cursor - 1]):
            return False
        self.cursor -= 1
        return True

    def go_in_grouping(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor < self.limit:
            if not self.has(g, cur[unsafe_offset=self.cursor]):
                return True
            self.cursor += 1
        return False

    def go_in_grouping_b(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor > self.limit_backward:
            if not self.has(g, cur[unsafe_offset=self.cursor - 1]):
                return True
            self.cursor -= 1
        return False

    def out_grouping(mut self, g: Int) -> Bool:
        if self.cursor >= self.limit:
            return False
        if not self.has(g, self.current[self.cursor]):
            self.cursor += 1
            return True
        return False

    def go_out_grouping(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor < self.limit:
            if self.has(g, cur[unsafe_offset=self.cursor]):
                return True
            self.cursor += 1
        return False

    def out_grouping_b(mut self, g: Int) -> Bool:
        if self.cursor <= self.limit_backward:
            return False
        if not self.has(g, self.current[self.cursor - 1]):
            self.cursor -= 1
            return True
        return False

    def go_out_grouping_b(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor > self.limit_backward:
            if self.has(g, cur[unsafe_offset=self.cursor - 1]):
                return True
            self.cursor -= 1
        return False

    def eq_s(mut self, s: StaticString) -> Bool:
        var n = s.count_codepoints()
        if self.cursor + n > self.limit:
            return False
        var j = self.cursor
        for cp in s.codepoints():
            if self.current[j] != UInt32(Int(cp)):
                return False
            j += 1
        self.cursor += n
        return True

    def eq_s_b(mut self, s: StaticString) -> Bool:
        var n = s.count_codepoints()
        if self.cursor - n < self.limit_backward:
            return False
        var j = self.cursor - n
        for cp in s.codepoints():
            if self.current[j] != UInt32(Int(cp)):
                return False
            j += 1
        self.cursor -= n
        return True

    def find_among(mut self, t: Int) -> Int:
        var cur = self.current.unsafe_ptr()
        var pool = self.pool.unsafe_ptr()
        var elen = self.ent_len.unsafe_ptr()
        var eoff = self.ent_off.unsafe_ptr()
        var esub = self.ent_sub.unsafe_ptr()
        var eres = self.ent_res.unsafe_ptr()
        var base = self.tab_base[t]
        var i = 0
        var j = self.tab_size[t]
        var c = self.cursor
        var l = self.limit
        var common_i = 0
        var common_j = 0
        var first_key_inspected = False
        while True:
            var k = i + ((j - i) >> 1)
            var diff = 0
            var common = min(common_i, common_j)
            var wl = elen[unsafe_offset=base + k]
            var wo = eoff[unsafe_offset=base + k]
            for i2 in range(common, wl):
                if c + common == l:
                    diff = -1
                    break
                diff = Int(cur[unsafe_offset=c + common]) - Int(pool[unsafe_offset=wo + i2])
                if diff != 0:
                    break
                common += 1
            if diff < 0:
                j = k
                common_j = common
            else:
                i = k
                common_i = common
            if j - i <= 1:
                if i > 0:
                    break
                if j == i:
                    break
                if first_key_inspected:
                    break
                first_key_inspected = True
        while True:
            var wl = elen[unsafe_offset=base + i]
            if common_i >= wl:
                self.cursor = c + wl
                return eres[unsafe_offset=base + i]
            i = esub[unsafe_offset=base + i]
            if i < 0:
                return 0

    def find_among_b(mut self, t: Int) -> Int:
        var cur = self.current.unsafe_ptr()
        var pool = self.pool.unsafe_ptr()
        var elen = self.ent_len.unsafe_ptr()
        var eoff = self.ent_off.unsafe_ptr()
        var esub = self.ent_sub.unsafe_ptr()
        var eres = self.ent_res.unsafe_ptr()
        var base = self.tab_base[t]
        var i = 0
        var j = self.tab_size[t]
        var c = self.cursor
        var lb = self.limit_backward
        var common_i = 0
        var common_j = 0
        var first_key_inspected = False
        while True:
            var k = i + ((j - i) >> 1)
            var diff = 0
            var common = min(common_i, common_j)
            var wl = elen[unsafe_offset=base + k]
            var wo = eoff[unsafe_offset=base + k]
            for i2 in range(wl - 1 - common, -1, -1):
                if c - common == lb:
                    diff = -1
                    break
                diff = Int(cur[unsafe_offset=c - 1 - common]) - Int(pool[unsafe_offset=wo + i2])
                if diff != 0:
                    break
                common += 1
            if diff < 0:
                j = k
                common_j = common
            else:
                i = k
                common_i = common
            if j - i <= 1:
                if i > 0:
                    break
                if j == i:
                    break
                if first_key_inspected:
                    break
                first_key_inspected = True
        while True:
            var wl = elen[unsafe_offset=base + i]
            if common_i >= wl:
                self.cursor = c - wl
                return eres[unsafe_offset=base + i]
            i = esub[unsafe_offset=base + i]
            if i < 0:
                return 0

    def has(self, g: Int, cp: UInt32) -> Bool:
        var i = Int(cp)
        if i >= len(self.grp_mask):
            return False
        return ((self.grp_mask[i] >> UInt32(g)) & 1) == 1

    def add_group(mut self, s: StaticString):
        """Group g is bit g of grp_mask[cp]; the group index is the call order."""
        var cps = to_cps(s)
        var g = self.n_groups
        self.n_groups += 1
        var mx = 0
        for c in cps:
            if Int(c) > mx:
                mx = Int(c)
        while len(self.grp_mask) <= mx:
            self.grp_mask.append(0)
        for c in cps:
            self.grp_mask[Int(c)] = self.grp_mask[Int(c)] | (UInt32(1) << UInt32(g))

    def begin_table(mut self):
        self.tab_base.append(len(self.ent_off))
        self.tab_size.append(0)

    def add_entry(mut self, s: StaticString, sub: Int, res: Int):
        var cps = to_cps(s)
        self.ent_off.append(len(self.pool))
        self.ent_len.append(len(cps))
        for c in cps:
            self.pool.append(c)
        self.ent_sub.append(sub)
        self.ent_res.append(res)
        self.tab_size[len(self.tab_size) - 1] += 1

    def eq_s_a(mut self, s: StaticString) -> Bool:
        var n = s.byte_length()
        if self.cursor + n > self.limit:
            return False
        var j = self.cursor
        for b in s.as_bytes():
            if self.current[j] != UInt32(b):
                return False
            j += 1
        self.cursor += n
        return True

    def eq_s_b_a(mut self, s: StaticString) -> Bool:
        var n = s.byte_length()
        if self.cursor - n < self.limit_backward:
            return False
        var j = self.cursor - n
        for b in s.as_bytes():
            if self.current[j] != UInt32(b):
                return False
            j += 1
        self.cursor -= n
        return True

    def slice_from_a(mut self, s: StaticString):
        var bra = self.bra
        var ket = self.ket
        var n = s.byte_length()
        self.adjust_region(bra, ket, n - (ket - bra))
        var j = bra
        for b in s.as_bytes():
            self.current[j] = UInt32(b)
            j += 1
        self.ket = bra + n

    def adjust_region(mut self, c_bra: Int, c_ket: Int, adj: Int):
        """Resize the buffer by adj at [c_bra, c_ket); the tail moves with it."""
        var old_len = len(self.current)
        if adj > 0:
            for _ in range(adj):
                self.current.append(0)
            var j = old_len - 1
            while j >= c_ket:
                self.current[j + adj] = self.current[j]
                j -= 1
        elif adj < 0:
            for j in range(c_ket, old_len):
                self.current[j + adj] = self.current[j]
            self.current.shrink(old_len + adj)
        self.limit += adj
        if self.cursor >= c_ket:
            self.cursor += adj
        elif self.cursor > c_bra:
            self.cursor = c_bra

    def slice_from(mut self, s: StaticString):
        var bra = self.bra
        var ket = self.ket
        var n = s.count_codepoints()
        self.adjust_region(bra, ket, n - (ket - bra))
        var j = bra
        for cp in s.codepoints():
            self.current[j] = UInt32(Int(cp))
            j += 1
        self.ket = bra + n

    def slice_del(mut self):
        self.adjust_region(self.bra, self.ket, self.bra - self.ket)
        self.ket = self.bra

    def r_mark_regions(mut self) -> Bool:
        var v_1: Int = 0
        var v_2: Int = 0
        var v_3: Int = 0
        var v_4: Int = 0
        var v_5: Int = 0
        var _jmp: Int = 0
        self.I_pV = self.limit
        self.I_p1 = self.limit
        self.I_p2 = self.limit
        v_1 = self.cursor
        while True:
            v_2 = self.cursor
            if (not self.in_grouping(Self.GR_g_v)):
                _jmp = 2
            if _jmp == 0:
                while True:
                    v_3 = self.cursor
                    if (not self.out_grouping(Self.GR_g_v)):
                        _jmp = 3
                    if _jmp == 0:
                        if (not self.go_out_grouping(Self.GR_g_v)):
                            _jmp = 3
                    if _jmp == 0:
                        self.cursor += 1
                    if _jmp == 0:
                        break
                    if _jmp == 3:
                        _jmp = 0
                    self.cursor = v_3
                    if (not self.in_grouping(Self.GR_g_v)):
                        _jmp = 2
                    if _jmp == 0:
                        if (not self.go_in_grouping(Self.GR_g_v)):
                            _jmp = 2
                    if _jmp == 0:
                        self.cursor += 1
                    if _jmp == 0:
                        break
                    if _jmp != 0:
                        break
            if _jmp == 0:
                break
            if _jmp == 2:
                _jmp = 0
            self.cursor = v_2
            if (not self.out_grouping(Self.GR_g_v)):
                _jmp = 1
            if _jmp == 0:
                while True:
                    v_4 = self.cursor
                    if (not self.out_grouping(Self.GR_g_v)):
                        _jmp = 4
                    if _jmp == 0:
                        if (not self.go_out_grouping(Self.GR_g_v)):
                            _jmp = 4
                    if _jmp == 0:
                        self.cursor += 1
                    if _jmp == 0:
                        break
                    if _jmp == 4:
                        _jmp = 0
                    self.cursor = v_4
                    if (not self.in_grouping(Self.GR_g_v)):
                        _jmp = 1
                    if _jmp == 0:
                        if (self.cursor >= self.limit):
                            _jmp = 1
                    if _jmp == 0:
                        self.cursor += 1
                    if _jmp == 0:
                        break
                    if _jmp != 0:
                        break
            if _jmp == 0:
                break
            if _jmp != 0:
                break
        if _jmp == 0:
            self.I_pV = self.cursor
        if _jmp == 1:
            _jmp = 0
        self.cursor = v_1
        v_5 = self.cursor
        if (not self.go_out_grouping(Self.GR_g_v)):
            _jmp = 5
        if _jmp == 0:
            self.cursor += 1
        if _jmp == 0:
            if (not self.go_in_grouping(Self.GR_g_v)):
                _jmp = 5
        if _jmp == 0:
            self.cursor += 1
        if _jmp == 0:
            self.I_p1 = self.cursor
        if _jmp == 0:
            if (not self.go_out_grouping(Self.GR_g_v)):
                _jmp = 5
        if _jmp == 0:
            self.cursor += 1
        if _jmp == 0:
            if (not self.go_in_grouping(Self.GR_g_v)):
                _jmp = 5
        if _jmp == 0:
            self.cursor += 1
        if _jmp == 0:
            self.I_p2 = self.cursor
        if _jmp == 5:
            _jmp = 0
        self.cursor = v_5
        return True
    def r_postlude(mut self) -> Bool:
        var among_var: Int = 0
        var v_1: Int = 0
        var _jmp: Int = 0
        while True:
            v_1 = self.cursor
            self.bra = self.cursor
            among_var = self.find_among(Self.TB_a_0)
            self.ket = self.cursor
            if (among_var == 1):
                self.slice_from_a("a")
            elif (among_var == 2):
                self.slice_from_a("e")
            elif (among_var == 3):
                self.slice_from_a("i")
            elif (among_var == 4):
                self.slice_from_a("o")
            elif (among_var == 5):
                self.slice_from_a("u")
            else:
                if (self.cursor >= self.limit):
                    _jmp = 1
                if _jmp == 0:
                    self.cursor += 1
            if _jmp == 0:
                continue
            if _jmp == 1:
                _jmp = 0
            self.cursor = v_1
            break
        return True
    def r_RV(mut self) -> Bool:
        return (self.I_pV <= self.cursor)
    def r_R2(mut self) -> Bool:
        return (self.I_p2 <= self.cursor)
    def r_attached_pronoun(mut self) -> Bool:
        var among_var: Int = 0
        self.ket = self.cursor
        if (self.find_among_b(Self.TB_a_1) == 0):
            return False
        self.bra = self.cursor
        among_var = self.find_among_b(Self.TB_a_2)
        if (among_var == 0):
            return False
        if (not self.r_RV()):
            return False
        if (among_var == 1):
            self.bra = self.cursor
            self.slice_from_a("iendo")
        elif (among_var == 2):
            self.bra = self.cursor
            self.slice_from_a("ando")
        elif (among_var == 3):
            self.bra = self.cursor
            self.slice_from_a("ar")
        elif (among_var == 4):
            self.bra = self.cursor
            self.slice_from_a("er")
        elif (among_var == 5):
            self.bra = self.cursor
            self.slice_from_a("ir")
        elif (among_var == 6):
            self.slice_del()
        else:
            if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 117)):
                return False
            self.cursor -= 1
            self.slice_del()
        return True
    def r_standard_suffix(mut self) -> Bool:
        var among_var: Int = 0
        var v_1: Int = 0
        var v_2: Int = 0
        var v_3: Int = 0
        var v_4: Int = 0
        var v_5: Int = 0
        var _jmp: Int = 0
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_6)
        if (among_var == 0):
            return False
        self.bra = self.cursor
        if (among_var == 1):
            if (not self.r_R2()):
                return False
            self.slice_del()
        elif (among_var == 2):
            if (not self.r_R2()):
                return False
            self.slice_del()
            v_1 = (self.limit - self.cursor)
            self.ket = self.cursor
            if (not self.eq_s_b_a("ic")):
                self.cursor = (self.limit - v_1)
                _jmp = 1
            if _jmp == 0:
                self.bra = self.cursor
            if _jmp == 0:
                if (not self.r_R2()):
                    self.cursor = (self.limit - v_1)
                    _jmp = 1
            if _jmp == 0:
                self.slice_del()
            if _jmp == 1:
                _jmp = 0
        elif (among_var == 3):
            if (not self.r_R2()):
                return False
            self.slice_from_a("log")
        elif (among_var == 4):
            if (not self.r_R2()):
                return False
            self.slice_from_a("u")
        elif (among_var == 5):
            if (not self.r_R2()):
                return False
            self.slice_from_a("ente")
        elif (among_var == 6):
            if (self.I_p1 > self.cursor):
                return False
            self.slice_del()
            v_2 = (self.limit - self.cursor)
            self.ket = self.cursor
            among_var = self.find_among_b(Self.TB_a_3)
            if (among_var == 0):
                self.cursor = (self.limit - v_2)
                _jmp = 2
            if _jmp == 0:
                self.bra = self.cursor
            if _jmp == 0:
                if (not self.r_R2()):
                    self.cursor = (self.limit - v_2)
                    _jmp = 2
            if _jmp == 0:
                self.slice_del()
            if _jmp == 0:
                if (among_var == 1):
                    self.ket = self.cursor
                    if (not self.eq_s_b_a("at")):
                        self.cursor = (self.limit - v_2)
                        _jmp = 2
                    if _jmp == 0:
                        self.bra = self.cursor
                    if _jmp == 0:
                        if (not self.r_R2()):
                            self.cursor = (self.limit - v_2)
                            _jmp = 2
                    if _jmp == 0:
                        self.slice_del()
            if _jmp == 2:
                _jmp = 0
        elif (among_var == 7):
            if (not self.r_R2()):
                return False
            self.slice_del()
            v_3 = (self.limit - self.cursor)
            self.ket = self.cursor
            if (self.find_among_b(Self.TB_a_4) == 0):
                self.cursor = (self.limit - v_3)
                _jmp = 3
            if _jmp == 0:
                self.bra = self.cursor
            if _jmp == 0:
                if (not self.r_R2()):
                    self.cursor = (self.limit - v_3)
                    _jmp = 3
            if _jmp == 0:
                self.slice_del()
            if _jmp == 3:
                _jmp = 0
        elif (among_var == 8):
            if (not self.r_R2()):
                return False
            self.slice_del()
            v_4 = (self.limit - self.cursor)
            self.ket = self.cursor
            if (self.find_among_b(Self.TB_a_5) == 0):
                self.cursor = (self.limit - v_4)
                _jmp = 4
            if _jmp == 0:
                self.bra = self.cursor
            if _jmp == 0:
                if (not self.r_R2()):
                    self.cursor = (self.limit - v_4)
                    _jmp = 4
            if _jmp == 0:
                self.slice_del()
            if _jmp == 4:
                _jmp = 0
        else:
            if (not self.r_R2()):
                return False
            self.slice_del()
            v_5 = (self.limit - self.cursor)
            self.ket = self.cursor
            if (not self.eq_s_b_a("at")):
                self.cursor = (self.limit - v_5)
                _jmp = 5
            if _jmp == 0:
                self.bra = self.cursor
            if _jmp == 0:
                if (not self.r_R2()):
                    self.cursor = (self.limit - v_5)
                    _jmp = 5
            if _jmp == 0:
                self.slice_del()
            if _jmp == 5:
                _jmp = 0
        return True
    def r_y_verb_suffix(mut self) -> Bool:
        var v_2: Int = 0
        if (self.cursor < self.I_pV):
            return False
        v_2 = self.limit_backward
        self.limit_backward = self.I_pV
        self.ket = self.cursor
        if (self.find_among_b(Self.TB_a_7) == 0):
            self.limit_backward = v_2
            return False
        self.bra = self.cursor
        self.limit_backward = v_2
        if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 117)):
            return False
        self.cursor -= 1
        self.slice_del()
        return True
    def r_verb_suffix(mut self) -> Bool:
        var among_var: Int = 0
        var v_2: Int = 0
        var v_3: Int = 0
        var v_4: Int = 0
        var _jmp: Int = 0
        if (self.cursor < self.I_pV):
            return False
        v_2 = self.limit_backward
        self.limit_backward = self.I_pV
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_8)
        if (among_var == 0):
            self.limit_backward = v_2
            return False
        self.bra = self.cursor
        self.limit_backward = v_2
        if (among_var == 1):
            v_3 = (self.limit - self.cursor)
            if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 117)):
                self.cursor = (self.limit - v_3)
                _jmp = 1
            if _jmp == 0:
                self.cursor -= 1
            if _jmp == 0:
                v_4 = (self.limit - self.cursor)
            if _jmp == 0:
                if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 103)):
                    self.cursor = (self.limit - v_3)
                    _jmp = 1
            if _jmp == 0:
                self.cursor -= 1
            if _jmp == 0:
                self.cursor = (self.limit - v_4)
            if _jmp == 1:
                _jmp = 0
            self.bra = self.cursor
            self.slice_del()
        else:
            self.slice_del()
        return True
    def r_residual_suffix(mut self) -> Bool:
        var among_var: Int = 0
        var v_1: Int = 0
        var v_2: Int = 0
        var _jmp: Int = 0
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_9)
        if (among_var == 0):
            return False
        self.bra = self.cursor
        if (among_var == 1):
            if (not self.r_RV()):
                return False
            self.slice_del()
        else:
            if (not self.r_RV()):
                return False
            self.slice_del()
            v_1 = (self.limit - self.cursor)
            self.ket = self.cursor
            if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 117)):
                self.cursor = (self.limit - v_1)
                _jmp = 1
            if _jmp == 0:
                self.cursor -= 1
            if _jmp == 0:
                self.bra = self.cursor
            if _jmp == 0:
                v_2 = (self.limit - self.cursor)
            if _jmp == 0:
                if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 103)):
                    self.cursor = (self.limit - v_1)
                    _jmp = 1
            if _jmp == 0:
                self.cursor -= 1
            if _jmp == 0:
                self.cursor = (self.limit - v_2)
            if _jmp == 0:
                if (not self.r_RV()):
                    self.cursor = (self.limit - v_1)
                    _jmp = 1
            if _jmp == 0:
                self.slice_del()
            if _jmp == 1:
                _jmp = 0
        return True
    def stem_impl(mut self) -> Bool:
        var v_1: Int = 0
        var v_2: Int = 0
        var v_3: Int = 0
        var v_4: Int = 0
        var v_5: Int = 0
        var _jmp: Int = 0
        _ = self.r_mark_regions()
        self.limit_backward = self.cursor
        self.cursor = self.limit
        v_1 = (self.limit - self.cursor)
        _ = self.r_attached_pronoun()
        self.cursor = (self.limit - v_1)
        v_2 = (self.limit - self.cursor)
        while True:
            v_3 = (self.limit - self.cursor)
            if (not self.r_standard_suffix()):
                _jmp = 2
            if _jmp == 0:
                break
            if _jmp == 2:
                _jmp = 0
            self.cursor = (self.limit - v_3)
            if (not self.r_y_verb_suffix()):
                _jmp = 3
            if _jmp == 0:
                break
            if _jmp == 3:
                _jmp = 0
            self.cursor = (self.limit - v_3)
            if (not self.r_verb_suffix()):
                _jmp = 1
            if _jmp == 0:
                break
            if _jmp != 0:
                break
        if _jmp == 1:
            _jmp = 0
        self.cursor = (self.limit - v_2)
        v_4 = (self.limit - self.cursor)
        _ = self.r_residual_suffix()
        self.cursor = (self.limit - v_4)
        self.cursor = self.limit_backward
        v_5 = self.cursor
        _ = self.r_postlude()
        self.cursor = v_5
        return True

    def run(
        mut self,
        n: Int,
        src: Pointer[UInt32, MutAnyOrigin],
        lens: Pointer[UInt32, MutAnyOrigin],
        dst: Pointer[UInt32, MutAnyOrigin],
        cap: Int,
    ) raises -> Int:
        """Stem n words. Input lengths are overwritten with output lengths."""
        var pos = 0
        var out = 0
        for i in range(n):
            var length = Int(lens[unsafe_offset=i])
            self.current.clear()
            for j in range(length):
                self.current.append(src[unsafe_offset=pos + j])
            pos += length
            self.cursor = 0
            self.limit = length
            self.limit_backward = 0
            self.bra = 0
            self.ket = length
            _ = self.stem_impl()
            var ol = len(self.current)
            if out + ol > cap:
                raise Error("msnowball: output buffer too small")
            for j in range(ol):
                dst[unsafe_offset=out + j] = self.current[j]
            out += ol
            lens[unsafe_offset=i] = UInt32(ol)
        return out


def new_spanish() raises -> PythonObject:
    """Allocate and initialise a SpanishStemmer on the heap; return its address."""
    var a = alloc(Layout[SpanishStemmer](count=1))
    var p = a^.unsafe_leak()
    p.unsafe_write(SpanishStemmer())
    return PythonObject(Int(p))


def stem_spanish(
    handle: PythonObject,
    n: PythonObject,
    src: PythonObject,
    lens: PythonObject,
    dst: PythonObject,
    cap: PythonObject,
) raises -> PythonObject:
    var st = Pointer[SpanishStemmer, MutAnyOrigin](unsafe_from_address=Int(py=handle))
    var src_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=src))
    var lens_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=lens))
    var dst_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=dst))
    return PythonObject(st[].run(Int(py=n), src_p, lens_p, dst_p, Int(py=cap)))


struct SwedishStemmer(Movable):
    var current: List[UInt32]
    var cursor: Int
    var limit: Int
    var limit_backward: Int
    var bra: Int
    var ket: Int
    var grp_mask: List[UInt32]
    var pool: List[UInt32]
    var ent_off: List[Int]
    var ent_len: List[Int]
    var ent_sub: List[Int]
    var ent_res: List[Int]
    var n_groups: Int
    var tab_base: List[Int]
    var tab_size: List[Int]
    var I_p1: Int
    comptime GR_g_v = 0
    comptime GR_g_s_ending = 1
    comptime GR_g_ost_ending = 2
    comptime TB_a_0 = 0
    comptime TB_a_1 = 1
    comptime TB_a_2 = 2
    comptime TB_a_3 = 3

    def __init__(out self):
        self.current = List[UInt32]()
        self.cursor = 0
        self.limit = 0
        self.limit_backward = 0
        self.bra = 0
        self.ket = 0
        self.grp_mask = List[UInt32]()
        self.pool = List[UInt32]()
        self.ent_off = List[Int]()
        self.ent_len = List[Int]()
        self.ent_sub = List[Int]()
        self.ent_res = List[Int]()
        self.tab_base = List[Int]()
        self.tab_size = List[Int]()
        self.n_groups = 0
        self.I_p1 = 0
        self.add_group("aeiouyäåö")
        self.add_group("bcdfghjklmnoprtvy")
        self.add_group("iklnprtuv")
        self.begin_table()
        self.add_entry("fab", -1, -1)
        self.add_entry("h", -1, -1)
        self.add_entry("pak", -1, -1)
        self.add_entry("rak", -1, -1)
        self.add_entry("stak", -1, -1)
        self.add_entry("kom", -1, -1)
        self.add_entry("iet", -1, -1)
        self.add_entry("cit", -1, -1)
        self.add_entry("dit", -1, -1)
        self.add_entry("alit", -1, -1)
        self.add_entry("ilit", -1, -1)
        self.add_entry("mit", -1, -1)
        self.add_entry("nit", -1, -1)
        self.add_entry("pit", -1, -1)
        self.add_entry("rit", -1, -1)
        self.add_entry("sit", -1, -1)
        self.add_entry("tit", -1, -1)
        self.add_entry("uit", -1, -1)
        self.add_entry("ivit", -1, -1)
        self.add_entry("kvit", -1, -1)
        self.add_entry("xit", -1, -1)
        self.begin_table()
        self.add_entry("a", -1, 1)
        self.add_entry("arna", 0, 1)
        self.add_entry("erna", 0, 1)
        self.add_entry("heterna", 2, 1)
        self.add_entry("orna", 0, 1)
        self.add_entry("ad", -1, 1)
        self.add_entry("e", -1, 1)
        self.add_entry("ade", 6, 1)
        self.add_entry("ande", 6, 1)
        self.add_entry("arne", 6, 1)
        self.add_entry("are", 6, 1)
        self.add_entry("aste", 6, 1)
        self.add_entry("en", -1, 1)
        self.add_entry("anden", 12, 1)
        self.add_entry("aren", 12, 1)
        self.add_entry("heten", 12, 1)
        self.add_entry("ern", -1, 1)
        self.add_entry("ar", -1, 1)
        self.add_entry("er", -1, 1)
        self.add_entry("heter", 18, 1)
        self.add_entry("or", -1, 1)
        self.add_entry("s", -1, 2)
        self.add_entry("as", 21, 1)
        self.add_entry("arnas", 22, 1)
        self.add_entry("ernas", 22, 1)
        self.add_entry("ornas", 22, 1)
        self.add_entry("es", 21, 1)
        self.add_entry("ades", 26, 1)
        self.add_entry("andes", 26, 1)
        self.add_entry("ens", 21, 1)
        self.add_entry("arens", 29, 1)
        self.add_entry("hetens", 29, 1)
        self.add_entry("erns", 21, 1)
        self.add_entry("at", -1, 1)
        self.add_entry("et", -1, 3)
        self.add_entry("andet", 34, 1)
        self.add_entry("het", 34, 1)
        self.add_entry("ast", -1, 1)
        self.begin_table()
        self.add_entry("dd", -1, -1)
        self.add_entry("gd", -1, -1)
        self.add_entry("nn", -1, -1)
        self.add_entry("dt", -1, -1)
        self.add_entry("gt", -1, -1)
        self.add_entry("kt", -1, -1)
        self.add_entry("tt", -1, -1)
        self.begin_table()
        self.add_entry("ig", -1, 1)
        self.add_entry("lig", 0, 1)
        self.add_entry("els", -1, 1)
        self.add_entry("fullt", -1, 3)
        self.add_entry("öst", -1, 2)

    # ---- BaseStemmer runtime (snowballstemmer/basestemmer.py), code-point based

    def in_grouping(mut self, g: Int) -> Bool:
        if self.cursor >= self.limit:
            return False
        if not self.has(g, self.current[self.cursor]):
            return False
        self.cursor += 1
        return True

    def in_grouping_b(mut self, g: Int) -> Bool:
        if self.cursor <= self.limit_backward:
            return False
        if not self.has(g, self.current[self.cursor - 1]):
            return False
        self.cursor -= 1
        return True

    def go_in_grouping(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor < self.limit:
            if not self.has(g, cur[unsafe_offset=self.cursor]):
                return True
            self.cursor += 1
        return False

    def go_in_grouping_b(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor > self.limit_backward:
            if not self.has(g, cur[unsafe_offset=self.cursor - 1]):
                return True
            self.cursor -= 1
        return False

    def out_grouping(mut self, g: Int) -> Bool:
        if self.cursor >= self.limit:
            return False
        if not self.has(g, self.current[self.cursor]):
            self.cursor += 1
            return True
        return False

    def go_out_grouping(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor < self.limit:
            if self.has(g, cur[unsafe_offset=self.cursor]):
                return True
            self.cursor += 1
        return False

    def out_grouping_b(mut self, g: Int) -> Bool:
        if self.cursor <= self.limit_backward:
            return False
        if not self.has(g, self.current[self.cursor - 1]):
            self.cursor -= 1
            return True
        return False

    def go_out_grouping_b(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor > self.limit_backward:
            if self.has(g, cur[unsafe_offset=self.cursor - 1]):
                return True
            self.cursor -= 1
        return False

    def eq_s(mut self, s: StaticString) -> Bool:
        var n = s.count_codepoints()
        if self.cursor + n > self.limit:
            return False
        var j = self.cursor
        for cp in s.codepoints():
            if self.current[j] != UInt32(Int(cp)):
                return False
            j += 1
        self.cursor += n
        return True

    def eq_s_b(mut self, s: StaticString) -> Bool:
        var n = s.count_codepoints()
        if self.cursor - n < self.limit_backward:
            return False
        var j = self.cursor - n
        for cp in s.codepoints():
            if self.current[j] != UInt32(Int(cp)):
                return False
            j += 1
        self.cursor -= n
        return True

    def find_among(mut self, t: Int) -> Int:
        var cur = self.current.unsafe_ptr()
        var pool = self.pool.unsafe_ptr()
        var elen = self.ent_len.unsafe_ptr()
        var eoff = self.ent_off.unsafe_ptr()
        var esub = self.ent_sub.unsafe_ptr()
        var eres = self.ent_res.unsafe_ptr()
        var base = self.tab_base[t]
        var i = 0
        var j = self.tab_size[t]
        var c = self.cursor
        var l = self.limit
        var common_i = 0
        var common_j = 0
        var first_key_inspected = False
        while True:
            var k = i + ((j - i) >> 1)
            var diff = 0
            var common = min(common_i, common_j)
            var wl = elen[unsafe_offset=base + k]
            var wo = eoff[unsafe_offset=base + k]
            for i2 in range(common, wl):
                if c + common == l:
                    diff = -1
                    break
                diff = Int(cur[unsafe_offset=c + common]) - Int(pool[unsafe_offset=wo + i2])
                if diff != 0:
                    break
                common += 1
            if diff < 0:
                j = k
                common_j = common
            else:
                i = k
                common_i = common
            if j - i <= 1:
                if i > 0:
                    break
                if j == i:
                    break
                if first_key_inspected:
                    break
                first_key_inspected = True
        while True:
            var wl = elen[unsafe_offset=base + i]
            if common_i >= wl:
                self.cursor = c + wl
                return eres[unsafe_offset=base + i]
            i = esub[unsafe_offset=base + i]
            if i < 0:
                return 0

    def find_among_b(mut self, t: Int) -> Int:
        var cur = self.current.unsafe_ptr()
        var pool = self.pool.unsafe_ptr()
        var elen = self.ent_len.unsafe_ptr()
        var eoff = self.ent_off.unsafe_ptr()
        var esub = self.ent_sub.unsafe_ptr()
        var eres = self.ent_res.unsafe_ptr()
        var base = self.tab_base[t]
        var i = 0
        var j = self.tab_size[t]
        var c = self.cursor
        var lb = self.limit_backward
        var common_i = 0
        var common_j = 0
        var first_key_inspected = False
        while True:
            var k = i + ((j - i) >> 1)
            var diff = 0
            var common = min(common_i, common_j)
            var wl = elen[unsafe_offset=base + k]
            var wo = eoff[unsafe_offset=base + k]
            for i2 in range(wl - 1 - common, -1, -1):
                if c - common == lb:
                    diff = -1
                    break
                diff = Int(cur[unsafe_offset=c - 1 - common]) - Int(pool[unsafe_offset=wo + i2])
                if diff != 0:
                    break
                common += 1
            if diff < 0:
                j = k
                common_j = common
            else:
                i = k
                common_i = common
            if j - i <= 1:
                if i > 0:
                    break
                if j == i:
                    break
                if first_key_inspected:
                    break
                first_key_inspected = True
        while True:
            var wl = elen[unsafe_offset=base + i]
            if common_i >= wl:
                self.cursor = c - wl
                return eres[unsafe_offset=base + i]
            i = esub[unsafe_offset=base + i]
            if i < 0:
                return 0

    def has(self, g: Int, cp: UInt32) -> Bool:
        var i = Int(cp)
        if i >= len(self.grp_mask):
            return False
        return ((self.grp_mask[i] >> UInt32(g)) & 1) == 1

    def add_group(mut self, s: StaticString):
        """Group g is bit g of grp_mask[cp]; the group index is the call order."""
        var cps = to_cps(s)
        var g = self.n_groups
        self.n_groups += 1
        var mx = 0
        for c in cps:
            if Int(c) > mx:
                mx = Int(c)
        while len(self.grp_mask) <= mx:
            self.grp_mask.append(0)
        for c in cps:
            self.grp_mask[Int(c)] = self.grp_mask[Int(c)] | (UInt32(1) << UInt32(g))

    def begin_table(mut self):
        self.tab_base.append(len(self.ent_off))
        self.tab_size.append(0)

    def add_entry(mut self, s: StaticString, sub: Int, res: Int):
        var cps = to_cps(s)
        self.ent_off.append(len(self.pool))
        self.ent_len.append(len(cps))
        for c in cps:
            self.pool.append(c)
        self.ent_sub.append(sub)
        self.ent_res.append(res)
        self.tab_size[len(self.tab_size) - 1] += 1

    def eq_s_a(mut self, s: StaticString) -> Bool:
        var n = s.byte_length()
        if self.cursor + n > self.limit:
            return False
        var j = self.cursor
        for b in s.as_bytes():
            if self.current[j] != UInt32(b):
                return False
            j += 1
        self.cursor += n
        return True

    def eq_s_b_a(mut self, s: StaticString) -> Bool:
        var n = s.byte_length()
        if self.cursor - n < self.limit_backward:
            return False
        var j = self.cursor - n
        for b in s.as_bytes():
            if self.current[j] != UInt32(b):
                return False
            j += 1
        self.cursor -= n
        return True

    def slice_from_a(mut self, s: StaticString):
        var bra = self.bra
        var ket = self.ket
        var n = s.byte_length()
        self.adjust_region(bra, ket, n - (ket - bra))
        var j = bra
        for b in s.as_bytes():
            self.current[j] = UInt32(b)
            j += 1
        self.ket = bra + n

    def adjust_region(mut self, c_bra: Int, c_ket: Int, adj: Int):
        """Resize the buffer by adj at [c_bra, c_ket); the tail moves with it."""
        var old_len = len(self.current)
        if adj > 0:
            for _ in range(adj):
                self.current.append(0)
            var j = old_len - 1
            while j >= c_ket:
                self.current[j + adj] = self.current[j]
                j -= 1
        elif adj < 0:
            for j in range(c_ket, old_len):
                self.current[j + adj] = self.current[j]
            self.current.shrink(old_len + adj)
        self.limit += adj
        if self.cursor >= c_ket:
            self.cursor += adj
        elif self.cursor > c_bra:
            self.cursor = c_bra

    def slice_from(mut self, s: StaticString):
        var bra = self.bra
        var ket = self.ket
        var n = s.count_codepoints()
        self.adjust_region(bra, ket, n - (ket - bra))
        var j = bra
        for cp in s.codepoints():
            self.current[j] = UInt32(Int(cp))
            j += 1
        self.ket = bra + n

    def slice_del(mut self):
        self.adjust_region(self.bra, self.ket, self.bra - self.ket)
        self.ket = self.bra

    def r_mark_regions(mut self) -> Bool:
        var I_x: Int = 0
        var v_1: Int = 0
        var _jmp: Int = 0
        self.I_p1 = self.limit
        v_1 = self.cursor
        if ((self.cursor + 3) > self.limit):
            return False
        self.cursor += 3
        I_x = self.cursor
        self.cursor = v_1
        if (not self.go_out_grouping(Self.GR_g_v)):
            return False
        self.cursor += 1
        if (not self.go_in_grouping(Self.GR_g_v)):
            return False
        self.cursor += 1
        self.I_p1 = self.cursor
        if (self.I_p1 >= I_x):
            _jmp = 1
        if _jmp == 0:
            self.I_p1 = I_x
        if _jmp == 1:
            _jmp = 0
        return True
    def r_et_condition(mut self) -> Bool:
        var v_1: Int = 0
        var v_2: Int = 0
        var _jmp: Int = 0
        v_1 = (self.limit - self.cursor)
        if (not self.out_grouping_b(Self.GR_g_v)):
            return False
        if (not self.in_grouping_b(Self.GR_g_v)):
            return False
        if (self.cursor <= self.limit_backward):
            return False
        self.cursor = (self.limit - v_1)
        v_2 = (self.limit - self.cursor)
        if (self.find_among_b(Self.TB_a_0) == 0):
            _jmp = 1
        if _jmp == 0:
            return False
        if _jmp == 1:
            _jmp = 0
        self.cursor = (self.limit - v_2)
        return True
    def r_main_suffix(mut self) -> Bool:
        var among_var: Int = 0
        var v_2: Int = 0
        var v_3: Int = 0
        var _jmp: Int = 0
        if (self.cursor < self.I_p1):
            return False
        v_2 = self.limit_backward
        self.limit_backward = self.I_p1
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_1)
        if (among_var == 0):
            self.limit_backward = v_2
            return False
        self.bra = self.cursor
        self.limit_backward = v_2
        if (among_var == 1):
            self.slice_del()
        elif (among_var == 2):
            while True:
                v_3 = (self.limit - self.cursor)
                if (not self.eq_s_b_a("et")):
                    _jmp = 1
                if _jmp == 0:
                    if (not self.r_et_condition()):
                        _jmp = 1
                if _jmp == 0:
                    self.bra = self.cursor
                if _jmp == 0:
                    break
                if _jmp == 1:
                    _jmp = 0
                self.cursor = (self.limit - v_3)
                if (not self.in_grouping_b(Self.GR_g_s_ending)):
                    return False
                break
            self.slice_del()
        else:
            if (not self.r_et_condition()):
                return False
            self.slice_del()
        return True
    def r_consonant_pair(mut self) -> Bool:
        var v_2: Int = 0
        var v_3: Int = 0
        if (self.cursor < self.I_p1):
            return False
        v_2 = self.limit_backward
        self.limit_backward = self.I_p1
        v_3 = (self.limit - self.cursor)
        if (self.find_among_b(Self.TB_a_2) == 0):
            self.limit_backward = v_2
            return False
        self.cursor = (self.limit - v_3)
        self.ket = self.cursor
        if (self.cursor <= self.limit_backward):
            self.limit_backward = v_2
            return False
        self.cursor -= 1
        self.bra = self.cursor
        self.slice_del()
        self.limit_backward = v_2
        return True
    def r_other_suffix(mut self) -> Bool:
        var among_var: Int = 0
        var v_2: Int = 0
        if (self.cursor < self.I_p1):
            return False
        v_2 = self.limit_backward
        self.limit_backward = self.I_p1
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_3)
        if (among_var == 0):
            self.limit_backward = v_2
            return False
        self.bra = self.cursor
        self.limit_backward = v_2
        if (among_var == 1):
            self.slice_del()
        elif (among_var == 2):
            if (not self.in_grouping_b(Self.GR_g_ost_ending)):
                return False
            self.slice_from("ös")
        else:
            self.slice_from_a("full")
        return True
    def stem_impl(mut self) -> Bool:
        var v_1: Int = 0
        var v_2: Int = 0
        var v_3: Int = 0
        var v_4: Int = 0
        v_1 = self.cursor
        _ = self.r_mark_regions()
        self.cursor = v_1
        self.limit_backward = self.cursor
        self.cursor = self.limit
        v_2 = (self.limit - self.cursor)
        _ = self.r_main_suffix()
        self.cursor = (self.limit - v_2)
        v_3 = (self.limit - self.cursor)
        _ = self.r_consonant_pair()
        self.cursor = (self.limit - v_3)
        v_4 = (self.limit - self.cursor)
        _ = self.r_other_suffix()
        self.cursor = (self.limit - v_4)
        self.cursor = self.limit_backward
        return True

    def run(
        mut self,
        n: Int,
        src: Pointer[UInt32, MutAnyOrigin],
        lens: Pointer[UInt32, MutAnyOrigin],
        dst: Pointer[UInt32, MutAnyOrigin],
        cap: Int,
    ) raises -> Int:
        """Stem n words. Input lengths are overwritten with output lengths."""
        var pos = 0
        var out = 0
        for i in range(n):
            var length = Int(lens[unsafe_offset=i])
            self.current.clear()
            for j in range(length):
                self.current.append(src[unsafe_offset=pos + j])
            pos += length
            self.cursor = 0
            self.limit = length
            self.limit_backward = 0
            self.bra = 0
            self.ket = length
            _ = self.stem_impl()
            var ol = len(self.current)
            if out + ol > cap:
                raise Error("msnowball: output buffer too small")
            for j in range(ol):
                dst[unsafe_offset=out + j] = self.current[j]
            out += ol
            lens[unsafe_offset=i] = UInt32(ol)
        return out


def new_swedish() raises -> PythonObject:
    """Allocate and initialise a SwedishStemmer on the heap; return its address."""
    var a = alloc(Layout[SwedishStemmer](count=1))
    var p = a^.unsafe_leak()
    p.unsafe_write(SwedishStemmer())
    return PythonObject(Int(p))


def stem_swedish(
    handle: PythonObject,
    n: PythonObject,
    src: PythonObject,
    lens: PythonObject,
    dst: PythonObject,
    cap: PythonObject,
) raises -> PythonObject:
    var st = Pointer[SwedishStemmer, MutAnyOrigin](unsafe_from_address=Int(py=handle))
    var src_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=src))
    var lens_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=lens))
    var dst_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=dst))
    return PythonObject(st[].run(Int(py=n), src_p, lens_p, dst_p, Int(py=cap)))


struct YiddishStemmer(Movable):
    var current: List[UInt32]
    var cursor: Int
    var limit: Int
    var limit_backward: Int
    var bra: Int
    var ket: Int
    var grp_mask: List[UInt32]
    var pool: List[UInt32]
    var ent_off: List[Int]
    var ent_len: List[Int]
    var ent_sub: List[Int]
    var ent_res: List[Int]
    var n_groups: Int
    var tab_base: List[Int]
    var tab_size: List[Int]
    var I_p1: Int
    var ST_as_3: List[StaticString]
    comptime GR_g_niked = 0
    comptime GR_g_vowel = 1
    comptime GR_g_consonant = 2
    comptime TB_a_0 = 0
    comptime TB_a_1 = 1
    comptime TB_a_2 = 2
    comptime TB_a_3 = 3
    comptime TB_a_4 = 4
    comptime TB_a_5 = 5
    comptime TB_a_6 = 6

    def __init__(out self):
        self.current = List[UInt32]()
        self.cursor = 0
        self.limit = 0
        self.limit_backward = 0
        self.bra = 0
        self.ket = 0
        self.grp_mask = List[UInt32]()
        self.pool = List[UInt32]()
        self.ent_off = List[Int]()
        self.ent_len = List[Int]()
        self.ent_sub = List[Int]()
        self.ent_res = List[Int]()
        self.tab_base = List[Int]()
        self.tab_size = List[Int]()
        self.n_groups = 0
        self.ST_as_3 = List[StaticString]()
        self.I_p1 = 0

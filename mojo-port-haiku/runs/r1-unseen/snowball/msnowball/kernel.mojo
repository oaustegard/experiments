        self.add_entry("छौ", -1, 1)
        self.add_entry("इछौ", 59, 1)
        self.add_entry("एछौ", 59, 1)
        self.add_entry("िछौ", 59, 1)
        self.add_entry("ेछौ", 59, 1)
        self.add_entry("नेछौ", 63, 1)
        self.add_entry("यौ", -1, 1)
        self.add_entry("थियौ", 65, 1)
        self.add_entry("छ्यौ", 65, 1)
        self.add_entry("थ्यौ", 65, 1)
        self.add_entry("छन्", -1, 1)

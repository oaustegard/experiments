    def r_mark_regions(mut self) -> Bool:
        var v_1: Int = 0
        var v_2: Int = 0
        var v_3: Int = 0
        var _jmp: Int = 0
        self.B_no_diacritics = True
        v_1 = self.cursor
        if (not self.go_out_grouping(Self.GR_g_sa)):
            _jmp = 1
        if _jmp == 0:
            self.cursor += 1
        if _jmp == 0:
            self.B_no_diacritics = False
        if _jmp == 1:
            _jmp = 0
        self.cursor = v_1
        self.I_p1 = self.limit
        v_2 = self.cursor
        if (not self.go_out_grouping(Self.GR_g_v)):
            _jmp = 2
        if _jmp == 0:
            self.cursor += 1
        if _jmp == 0:
            self.I_p1 = self.cursor
        if _jmp == 0:
            if (self.I_p1 >= 2):
                _jmp = 2
        if _jmp == 0:
            if (not self.go_in_grouping(Self.GR_g_v)):
                _jmp = 2
        if _jmp == 0:
            self.cursor += 1
        if _jmp == 0:
            self.I_p1 = self.cursor
        if _jmp == 2:
            _jmp = 0
        self.cursor = v_2
        v_3 = self.cursor
        while True:
            if ((self.cursor == self.limit) or (self.current[self.cursor] != 114)):
                _jmp = 4
            if _jmp == 0:
                self.cursor += 1
            if _jmp == 0:
                break
            if _jmp == 4:
                _jmp = 0
            if (self.cursor >= self.limit):
                _jmp = 3
            if _jmp == 0:
                self.cursor += 1
            if _jmp != 0:
                break
        if _jmp == 0:
            while True:
                if (self.cursor < 2):
                    _jmp = 5
                if _jmp == 0:
                    break
                if _jmp == 5:
                    _jmp = 0
                if (not self.go_in_grouping(Self.GR_g_rg)):
                    _jmp = 3
                if _jmp == 0:
                    self.cursor += 1
                if _jmp == 0:
                    break
                if _jmp != 0:
                    break
        if _jmp == 0:
            if ((self.I_p1 - self.cursor) <= 1):
                _jmp = 3
        if _jmp == 0:
            self.I_p1 = self.cursor
        if _jmp == 3:
            _jmp = 0
        self.cursor = v_3
        return True
    def r_R1(mut self) -> Bool:
        return (self.I_p1 <= self.cursor)

    # ---- BaseStemmer runtime (snowballstemmer/basestemmer.py), code-point based

    def in_grouping(mut self, g: Int) -> Bool:
        if self.cursor >= self.limit:
            return False
        if not self.has(g, self.current[self.cursor]):
            return False
        self.cursor += 1
        return True

    def in_grouping_b(mut self, g: Int) -> Bool:
        if self.cursor <= self.limit_backward:
            return False
        if not self.has(g, self.current[self.cursor - 1]):
            return False
        self.cursor -= 1
        return True

    def go_in_grouping(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor < self.limit:
            if not self.has(g, cur[unsafe_offset=self.cursor]):
                return True
            self.cursor += 1
        return False

    def go_in_grouping_b(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor > self.limit_backward:
            if not self.has(g, cur[unsafe_offset=self.cursor - 1]):
                return True
            self.cursor -= 1
        return False

    def out_grouping(mut self, g: Int) -> Bool:
        if self.cursor >= self.limit:
            return False
        if not self.has(g, self.current[self.cursor]):
            self.cursor += 1
            return True
        return False

    def go_out_grouping(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor < self.limit:
            if self.has(g, cur[unsafe_offset=self.cursor]):
                return True
            self.cursor += 1
        return False

    def out_grouping_b(mut self, g: Int) -> Bool:
        if self.cursor <= self.limit_backward:
            return False
        if not self.has(g, self.current[self.cursor - 1]):
            self.cursor -= 1
            return True
        return False

    def go_out_grouping_b(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor > self.limit_backward:
            if self.has(g, cur[unsafe_offset=self.cursor - 1]):
                return True
            self.cursor -= 1
        return False

    def eq_s(mut self, s: StaticString) -> Bool:
        var n = s.count_codepoints()
        if self.cursor + n > self.limit:
            return False
        var j = self.cursor
        for cp in s.codepoints():
            if self.current[j] != UInt32(Int(cp)):
                return False
            j += 1
        self.cursor += n
        return True

    def eq_s_b(mut self, s: StaticString) -> Bool:
        var n = s.count_codepoints()
        if self.cursor - n < self.limit_backward:
            return False
        var j = self.cursor - n
        for cp in s.codepoints():
            if self.current[j] != UInt32(Int(cp)):
                return False
            j += 1
        self.cursor -= n
        return True

    def find_among(mut self, t: Int) -> Int:
        var cur = self.current.unsafe_ptr()
        var pool = self.pool.unsafe_ptr()
        var elen = self.ent_len.unsafe_ptr()
        var eoff = self.ent_off.unsafe_ptr()
        var esub = self.ent_sub.unsafe_ptr()
        var eres = self.ent_res.unsafe_ptr()
        var base = self.tab_base[t]
        var i = 0
        var j = self.tab_size[t]
        var c = self.cursor
        var l = self.limit
        var common_i = 0
        var common_j = 0
        var first_key_inspected = False
        while True:
            var k = i + ((j - i) >> 1)
            var diff = 0
            var common = min(common_i, common_j)
            var wl = elen[unsafe_offset=base + k]
            var wo = eoff[unsafe_offset=base + k]
            for i2 in range(common, wl):
                if c + common == l:
                    diff = -1
                    break
                diff = Int(cur[unsafe_offset=c + common]) - Int(pool[unsafe_offset=wo + i2])
                if diff != 0:
                    break
                common += 1
            if diff < 0:
                j = k
                common_j = common
            else:
                i = k
                common_i = common
            if j - i <= 1:
                if i > 0:
                    break
                if j == i:
                    break
                if first_key_inspected:
                    break
                first_key_inspected = True
        while True:
            var wl = elen[unsafe_offset=base + i]
            if common_i >= wl:
                self.cursor = c + wl
                return eres[unsafe_offset=base + i]
            i = esub[unsafe_offset=base + i]
            if i < 0:
                return 0

    def find_among_b(mut self, t: Int) -> Int:
        var cur = self.current.unsafe_ptr()
        var pool = self.pool.unsafe_ptr()
        var elen = self.ent_len.unsafe_ptr()
        var eoff = self.ent_off.unsafe_ptr()
        var esub = self.ent_sub.unsafe_ptr()
        var eres = self.ent_res.unsafe_ptr()
        var base = self.tab_base[t]
        var i = 0
        var j = self.tab_size[t]
        var c = self.cursor
        var lb = self.limit_backward
        var common_i = 0
        var common_j = 0
        var first_key_inspected = False
        while True:
            var k = i + ((j - i) >> 1)
            var diff = 0
            var common = min(common_i, common_j)
            var wl = elen[unsafe_offset=base + k]
            var wo = eoff[unsafe_offset=base + k]
            for i2 in range(wl - 1 - common, -1, -1):
                if c - common == lb:
                    diff = -1
                    break
                diff = Int(cur[unsafe_offset=c - 1 - common]) - Int(pool[unsafe_offset=wo + i2])
                if diff != 0:
                    break
                common += 1
            if diff < 0:
                j = k
                common_j = common
            else:
                i = k
                common_i = common
            if j - i <= 1:
                if i > 0:
                    break
                if j == i:
                    break
                if first_key_inspected:
                    break
                first_key_inspected = True
        while True:
            var wl = elen[unsafe_offset=base + i]
            if common_i >= wl:
                self.cursor = c - wl
                return eres[unsafe_offset=base + i]
            i = esub[unsafe_offset=base + i]
            if i < 0:
                return 0

    def has(self, g: Int, cp: UInt32) -> Bool:
        var i = Int(cp)
        if i >= len(self.grp_mask):
            return False
        return ((self.grp_mask[i] >> UInt32(g)) & 1) == 1

    def add_group(mut self, s: StaticString):
        """Group g is bit g of grp_mask[cp]; the group index is the call order."""
        var cps = to_cps(s)
        var g = self.n_groups
        self.n_groups += 1
        var mx = 0
        for c in cps:
            if Int(c) > mx:
                mx = Int(c)
        while len(self.grp_mask) <= mx:
            self.grp_mask.append(0)
        for c in cps:
            self.grp_mask[Int(c)] = self.grp_mask[Int(c)] | (UInt32(1) << UInt32(g))

    def begin_table(mut self):
        self.tab_base.append(len(self.ent_off))
        self.tab_size.append(0)

    def add_entry(mut self, s: StaticString, sub: Int, res: Int):
        var cps = to_cps(s)
        self.ent_off.append(len(self.pool))
        self.ent_len.append(len(cps))
        for c in cps:
            self.pool.append(c)
        self.ent_sub.append(sub)
        self.ent_res.append(res)
        self.tab_size[len(self.tab_size) - 1] += 1

    def eq_s_a(mut self, s: StaticString) -> Bool:
        var n = s.byte_length()
        if self.cursor + n > self.limit:
            return False
        var j = self.cursor
        for b in s.as_bytes():
            if self.current[j] != UInt32(b):
                return False
            j += 1
        self.cursor += n
        return True

    def eq_s_b_a(mut self, s: StaticString) -> Bool:
        var n = s.byte_length()
        if self.cursor - n < self.limit_backward:
            return False
        var j = self.cursor - n
        for b in s.as_bytes():
            if self.current[j] != UInt32(b):
                return False
            j += 1
        self.cursor -= n
        return True

    def slice_from_a(mut self, s: StaticString):
        var bra = self.bra
        var ket = self.ket
        var n = s.byte_length()
        self.adjust_region(bra, ket, n - (ket - bra))
        var j = bra
        for b in s.as_bytes():
            self.current[j] = UInt32(b)
            j += 1
        self.ket = bra + n

    def adjust_region(mut self, c_bra: Int, c_ket: Int, adj: Int):
        """Resize the buffer by adj at [c_bra, c_ket); the tail moves with it."""
        var old_len = len(self.current)
        if adj > 0:
            for _ in range(adj):
                self.current.append(0)
            var j = old_len - 1
            while j >= c_ket:
                self.current[j + adj] = self.current[j]
                j -= 1
        elif adj < 0:
            for j in range(c_ket, old_len):
                self.current[j + adj] = self.current[j]
            self.current.shrink(old_len + adj)
        self.limit += adj
        if self.cursor >= c_ket:
            self.cursor += adj
        elif self.cursor > c_bra:
            self.cursor = c_bra

    def slice_from(mut self, s: StaticString):
        var bra = self.bra
        var ket = self.ket
        var n = s.count_codepoints()
        self.adjust_region(bra, ket, n - (ket - bra))
        var j = bra
        for cp in s.codepoints():
            self.current[j] = UInt32(Int(cp))
            j += 1
        self.ket = bra + n

    def slice_del(mut self):
        self.adjust_region(self.bra, self.ket, self.bra - self.ket)
        self.ket = self.bra

    def r_mark_regions(mut self) -> Bool:
        var v_1: Int = 0
        var v_2: Int = 0
        var _jmp: Int = 0
        self.I_p1 = self.limit
        while True:
            v_1 = self.cursor
            if (not self.in_grouping(Self.GR_g_v)):
                _jmp = 1
            if _jmp == 0:
                v_2 = self.cursor
            if _jmp == 0:
                if (not self.go_in_grouping(Self.GR_g_v)):
                    _jmp = 2
                if _jmp == 0:
                    self.cursor += 1
                if _jmp == 0:
                    self.I_p1 = self.cursor
                if _jmp == 2:
                    _jmp = 0
            if _jmp == 0:
                self.cursor = v_2
            if _jmp == 0:
                break
            if _jmp == 1:
                _jmp = 0
            self.cursor = v_1
            if (not self.go_out_grouping(Self.GR_g_v)):
                return False
            self.cursor += 1
            self.I_p1 = self.cursor
            break
        return True
    def r_R1(mut self) -> Bool:
        return (self.I_p1 <= self.cursor)
    def r_v_ending(mut self) -> Bool:
        var among_var: Int = 0
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_0)
        if (among_var == 0):
            return False
        self.bra = self.cursor
        if (not self.r_R1()):
            return False
        self.slice_from(self.ST_as_0[(among_var - 1)])
        return True
    def r_double(mut self) -> Bool:
        var v_1: Int = 0
        v_1 = (self.limit - self.cursor)
        if (self.find_among_b(Self.TB_a_1) == 0):
            return False
        self.cursor = (self.limit - v_1)
        return True
    def r_undouble(mut self) -> Bool:
        if (self.cursor <= self.limit_backward):
            return False
        self.cursor -= 1
        self.ket = self.cursor
        if (self.cursor <= self.limit_backward):
            return False
        self.cursor -= 1
        self.bra = self.cursor
        self.slice_del()
        return True
    def r_instrum(mut self) -> Bool:
        self.ket = self.cursor
        if (self.find_among_b(Self.TB_a_2) == 0):
            return False
        self.bra = self.cursor
        if (not self.r_R1()):
            return False
        if (not self.r_double()):
            return False
        self.slice_del()
        return self.r_undouble()
    def r_case(mut self) -> Bool:
        self.ket = self.cursor
        if (self.find_among_b(Self.TB_a_3) == 0):
            return False
        self.bra = self.cursor
        if (not self.r_R1()):
            return False
        self.slice_del()
        return self.r_v_ending()
    def r_case_special(mut self) -> Bool:
        var among_var: Int = 0
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_4)
        if (among_var == 0):
            return False
        self.bra = self.cursor
        if (not self.r_R1()):
            return False
        self.slice_from(self.ST_as_4[(among_var - 1)])
        return True
    def r_case_other(mut self) -> Bool:
        var among_var: Int = 0
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_5)
        if (among_var == 0):
            return False
        self.bra = self.cursor
        if (not self.r_R1()):
            return False
        self.slice_from(self.ST_as_5[(among_var - 1)])
        return True
    def r_factive(mut self) -> Bool:
        self.ket = self.cursor
        if (self.find_among_b(Self.TB_a_6) == 0):
            return False
        self.bra = self.cursor
        if (not self.r_R1()):
            return False
        if (not self.r_double()):
            return False
        self.slice_del()
        return self.r_undouble()
    def r_plural(mut self) -> Bool:
        var among_var: Int = 0
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_7)
        if (among_var == 0):
            return False
        self.bra = self.cursor
        if (not self.r_R1()):
            return False
        self.slice_from(self.ST_as_7[(among_var - 1)])
        return True
    def r_owned(mut self) -> Bool:
        var among_var: Int = 0
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_8)
        if (among_var == 0):
            return False
        self.bra = self.cursor
        if (not self.r_R1()):
            return False
        self.slice_from(self.ST_as_8[(among_var - 1)])
        return True
    def r_sing_owner(mut self) -> Bool:
        var among_var: Int = 0
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_9)
        if (among_var == 0):
            return False
        self.bra = self.cursor
        if (not self.r_R1()):
            return False
        self.slice_from(self.ST_as_9[(among_var - 1)])
        return True
    def r_plur_owner(mut self) -> Bool:
        var among_var: Int = 0
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_10)
        if (among_var == 0):
            return False
        self.bra = self.cursor
        if (not self.r_R1()):
            return False
        self.slice_from(self.ST_as_10[(among_var - 1)])
        return True
    def stem_impl(mut self) -> Bool:
        var v_1: Int = 0
        var v_10: Int = 0
        var v_2: Int = 0
        var v_3: Int = 0
        var v_4: Int = 0
        var v_5: Int = 0
        var v_6: Int = 0
        var v_7: Int = 0
        var v_8: Int = 0
        var v_9: Int = 0
        v_1 = self.cursor
        _ = self.r_mark_regions()
        self.cursor = v_1
        self.limit_backward = self.cursor
        self.cursor = self.limit
        v_2 = (self.limit - self.cursor)
        _ = self.r_instrum()
        self.cursor = (self.limit - v_2)
        v_3 = (self.limit - self.cursor)
        _ = self.r_case()
        self.cursor = (self.limit - v_3)
        v_4 = (self.limit - self.cursor)
        _ = self.r_case_special()
        self.cursor = (self.limit - v_4)
        v_5 = (self.limit - self.cursor)
        _ = self.r_case_other()
        self.cursor = (self.limit - v_5)
        v_6 = (self.limit - self.cursor)
        _ = self.r_factive()
        self.cursor = (self.limit - v_6)
        v_7 = (self.limit - self.cursor)
        _ = self.r_owned()
        self.cursor = (self.limit - v_7)
        v_8 = (self.limit - self.cursor)
        _ = self.r_sing_owner()
        self.cursor = (self.limit - v_8)
        v_9 = (self.limit - self.cursor)
        _ = self.r_plur_owner()
        self.cursor = (self.limit - v_9)
        v_10 = (self.limit - self.cursor)
        _ = self.r_plural()
        self.cursor = (self.limit - v_10)
        self.cursor = self.limit_backward
        return True

    def run(
        mut self,
        n: Int,
        src: Pointer[UInt32, MutAnyOrigin],
        lens: Pointer[UInt32, MutAnyOrigin],
        dst: Pointer[UInt32, MutAnyOrigin],
        cap: Int,
    ) raises -> Int:
        """Stem n words. Input lengths are overwritten with output lengths."""
        var pos = 0
        var out = 0
        for i in range(n):
            var length = Int(lens[unsafe_offset=i])
            self.current.clear()
            for j in range(length):
                self.current.append(src[unsafe_offset=pos + j])
            pos += length
            self.cursor = 0
            self.limit = length
            self.limit_backward = 0
            self.bra = 0
            self.ket = length
            _ = self.stem_impl()
            var ol = len(self.current)
            if out + ol > cap:
                raise Error("msnowball: output buffer too small")
            for j in range(ol):
                dst[unsafe_offset=out + j] = self.current[j]
            out += ol
            lens[unsafe_offset=i] = UInt32(ol)
        return out


def new_hungarian() raises -> PythonObject:
    """Allocate and initialise a HungarianStemmer on the heap; return its address."""
    var a = alloc(Layout[HungarianStemmer](count=1))
    var p = a^.unsafe_leak()
    p.unsafe_write(HungarianStemmer())
    return PythonObject(Int(p))


def stem_hungarian(
    handle: PythonObject,
    n: PythonObject,
    src: PythonObject,
    lens: PythonObject,
    dst: PythonObject,
    cap: PythonObject,
) raises -> PythonObject:
    var st = Pointer[HungarianStemmer, MutAnyOrigin](unsafe_from_address=Int(py=handle))
    var src_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=src))
    var lens_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=lens))
    var dst_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=dst))
    return PythonObject(st[].run(Int(py=n), src_p, lens_p, dst_p, Int(py=cap)))


struct IndonesianStemmer(Movable):
    var current: List[UInt32]
    var cursor: Int
    var limit: Int
    var limit_backward: Int
    var bra: Int
    var ket: Int
    var grp_mask: List[UInt32]
    var pool: List[UInt32]
    var ent_off: List[Int]
    var ent_len: List[Int]
    var ent_sub: List[Int]
    var ent_res: List[Int]
    var n_groups: Int
    var tab_base: List[Int]
    var tab_size: List[Int]
    var I_prefix: Int
    var I_measure: Int
    comptime GR_g_vowel = 0
    comptime TB_a_0 = 0
    comptime TB_a_1 = 1
    comptime TB_a_2 = 2
    comptime TB_a_3 = 3
    comptime TB_a_4 = 4

    def __init__(out self):
        self.current = List[UInt32]()
        self.cursor = 0
        self.limit = 0
        self.limit_backward = 0
        self.bra = 0
        self.ket = 0
        self.grp_mask = List[UInt32]()
        self.pool = List[UInt32]()
        self.ent_off = List[Int]()
        self.ent_len = List[Int]()
        self.ent_sub = List[Int]()
        self.ent_res = List[Int]()
        self.tab_base = List[Int]()
        self.tab_size = List[Int]()
        self.n_groups = 0
        self.I_prefix = 0
        self.I_measure = 0
        self.add_group("aeiou")
        self.begin_table()
        self.add_entry("kah", -1, 1)
        self.add_entry("lah", -1, 1)
        self.add_entry("pun", -1, 1)
        self.begin_table()
        self.add_entry("nya", -1, 1)
        self.add_entry("ku", -1, 1)
        self.add_entry("mu", -1, 1)
        self.begin_table()
        self.add_entry("i", -1, 2)
        self.add_entry("an", -1, 1)
        self.begin_table()
        self.add_entry("di", -1, 1)
        self.add_entry("ke", -1, 3)
        self.add_entry("me", -1, 1)
        self.add_entry("mem", 2, 5)
        self.add_entry("men", 2, 2)
        self.add_entry("meng", 4, 1)
        self.add_entry("pem", -1, 6)
        self.add_entry("pen", -1, 4)
        self.add_entry("peng", 7, 3)
        self.add_entry("ter", -1, 1)
        self.begin_table()
        self.add_entry("be", -1, 2)
        self.add_entry("pe", -1, 1)

    # ---- BaseStemmer runtime (snowballstemmer/basestemmer.py), code-point based

    def in_grouping(mut self, g: Int) -> Bool:
        if self.cursor >= self.limit:
            return False
        if not self.has(g, self.current[self.cursor]):
            return False
        self.cursor += 1
        return True

    def in_grouping_b(mut self, g: Int) -> Bool:
        if self.cursor <= self.limit_backward:
            return False
        if not self.has(g, self.current[self.cursor - 1]):
            return False
        self.cursor -= 1
        return True

    def go_in_grouping(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor < self.limit:
            if not self.has(g, cur[unsafe_offset=self.cursor]):
                return True
            self.cursor += 1
        return False

    def go_in_grouping_b(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor > self.limit_backward:
            if not self.has(g, cur[unsafe_offset=self.cursor - 1]):
                return True
            self.cursor -= 1
        return False

    def out_grouping(mut self, g: Int) -> Bool:
        if self.cursor >= self.limit:
            return False
        if not self.has(g, self.current[self.cursor]):
            self.cursor += 1
            return True
        return False

    def go_out_grouping(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor < self.limit:
            if self.has(g, cur[unsafe_offset=self.cursor]):
                return True
            self.cursor += 1
        return False

    def out_grouping_b(mut self, g: Int) -> Bool:
        if self.cursor <= self.limit_backward:
            return False
        if not self.has(g, self.current[self.cursor - 1]):
            self.cursor -= 1
            return True
        return False

    def go_out_grouping_b(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor > self.limit_backward:
            if self.has(g, cur[unsafe_offset=self.cursor - 1]):
                return True
            self.cursor -= 1
        return False

    def eq_s(mut self, s: StaticString) -> Bool:
        var n = s.count_codepoints()
        if self.cursor + n > self.limit:
            return False
        var j = self.cursor
        for cp in s.codepoints():
            if self.current[j] != UInt32(Int(cp)):
                return False
            j += 1
        self.cursor += n
        return True

    def eq_s_b(mut self, s: StaticString) -> Bool:
        var n = s.count_codepoints()
        if self.cursor - n < self.limit_backward:
            return False
        var j = self.cursor - n
        for cp in s.codepoints():
            if self.current[j] != UInt32(Int(cp)):
                return False
            j += 1
        self.cursor -= n
        return True

    def find_among(mut self, t: Int) -> Int:
        var cur = self.current.unsafe_ptr()
        var pool = self.pool.unsafe_ptr()
        var elen = self.ent_len.unsafe_ptr()
        var eoff = self.ent_off.unsafe_ptr()
        var esub = self.ent_sub.unsafe_ptr()
        var eres = self.ent_res.unsafe_ptr()
        var base = self.tab_base[t]
        var i = 0
        var j = self.tab_size[t]
        var c = self.cursor
        var l = self.limit
        var common_i = 0
        var common_j = 0
        var first_key_inspected = False
        while True:
            var k = i + ((j - i) >> 1)
            var diff = 0
            var common = min(common_i, common_j)
            var wl = elen[unsafe_offset=base + k]
            var wo = eoff[unsafe_offset=base + k]
            for i2 in range(common, wl):
                if c + common == l:
                    diff = -1
                    break
                diff = Int(cur[unsafe_offset=c + common]) - Int(pool[unsafe_offset=wo + i2])
                if diff != 0:
                    break
                common += 1
            if diff < 0:
                j = k
                common_j = common
            else:
                i = k
                common_i = common
            if j - i <= 1:
                if i > 0:
                    break
                if j == i:
                    break
                if first_key_inspected:
                    break
                first_key_inspected = True
        while True:
            var wl = elen[unsafe_offset=base + i]
            if common_i >= wl:
                self.cursor = c + wl
                return eres[unsafe_offset=base + i]
            i = esub[unsafe_offset=base + i]
            if i < 0:
                return 0

    def find_among_b(mut self, t: Int) -> Int:
        var cur = self.current.unsafe_ptr()
        var pool = self.pool.unsafe_ptr()
        var elen = self.ent_len.unsafe_ptr()
        var eoff = self.ent_off.unsafe_ptr()
        var esub = self.ent_sub.unsafe_ptr()
        var eres = self.ent_res.unsafe_ptr()
        var base = self.tab_base[t]
        var i = 0
        var j = self.tab_size[t]
        var c = self.cursor
        var lb = self.limit_backward
        var common_i = 0
        var common_j = 0
        var first_key_inspected = False
        while True:
            var k = i + ((j - i) >> 1)
            var diff = 0
            var common = min(common_i, common_j)
            var wl = elen[unsafe_offset=base + k]
            var wo = eoff[unsafe_offset=base + k]
            for i2 in range(wl - 1 - common, -1, -1):
                if c - common == lb:
                    diff = -1
                    break
                diff = Int(cur[unsafe_offset=c - 1 - common]) - Int(pool[unsafe_offset=wo + i2])
                if diff != 0:
                    break
                common += 1
            if diff < 0:
                j = k
                common_j = common
            else:
                i = k
                common_i = common
            if j - i <= 1:
                if i > 0:
                    break
                if j == i:
                    break
                if first_key_inspected:
                    break
                first_key_inspected = True
        while True:
            var wl = elen[unsafe_offset=base + i]
            if common_i >= wl:
                self.cursor = c - wl
                return eres[unsafe_offset=base + i]
            i = esub[unsafe_offset=base + i]
            if i < 0:
                return 0

    def has(self, g: Int, cp: UInt32) -> Bool:
        var i = Int(cp)
        if i >= len(self.grp_mask):
            return False
        return ((self.grp_mask[i] >> UInt32(g)) & 1) == 1

    def add_group(mut self, s: StaticString):
        """Group g is bit g of grp_mask[cp]; the group index is the call order."""
        var cps = to_cps(s)
        var g = self.n_groups
        self.n_groups += 1
        var mx = 0
        for c in cps:
            if Int(c) > mx:
                mx = Int(c)
        while len(self.grp_mask) <= mx:
            self.grp_mask.append(0)
        for c in cps:
            self.grp_mask[Int(c)] = self.grp_mask[Int(c)] | (UInt32(1) << UInt32(g))

    def begin_table(mut self):
        self.tab_base.append(len(self.ent_off))
        self.tab_size.append(0)

    def add_entry(mut self, s: StaticString, sub: Int, res: Int):
        var cps = to_cps(s)
        self.ent_off.append(len(self.pool))
        self.ent_len.append(len(cps))
        for c in cps:
            self.pool.append(c)
        self.ent_sub.append(sub)
        self.ent_res.append(res)
        self.tab_size[len(self.tab_size) - 1] += 1

    def eq_s_a(mut self, s: StaticString) -> Bool:
        var n = s.byte_length()
        if self.cursor + n > self.limit:
            return False
        var j = self.cursor
        for b in s.as_bytes():
            if self.current[j] != UInt32(b):
                return False
            j += 1
        self.cursor += n
        return True

    def eq_s_b_a(mut self, s: StaticString) -> Bool:
        var n = s.byte_length()
        if self.cursor - n < self.limit_backward:
            return False
        var j = self.cursor - n
        for b in s.as_bytes():
            if self.current[j] != UInt32(b):
                return False
            j += 1
        self.cursor -= n
        return True

    def slice_from_a(mut self, s: StaticString):
        var bra = self.bra
        var ket = self.ket
        var n = s.byte_length()
        self.adjust_region(bra, ket, n - (ket - bra))
        var j = bra
        for b in s.as_bytes():
            self.current[j] = UInt32(b)
            j += 1
        self.ket = bra + n

    def adjust_region(mut self, c_bra: Int, c_ket: Int, adj: Int):
        """Resize the buffer by adj at [c_bra, c_ket); the tail moves with it."""
        var old_len = len(self.current)
        if adj > 0:
            for _ in range(adj):
                self.current.append(0)
            var j = old_len - 1
            while j >= c_ket:
                self.current[j + adj] = self.current[j]
                j -= 1
        elif adj < 0:
            for j in range(c_ket, old_len):
                self.current[j + adj] = self.current[j]
            self.current.shrink(old_len + adj)
        self.limit += adj
        if self.cursor >= c_ket:
            self.cursor += adj
        elif self.cursor > c_bra:
            self.cursor = c_bra

    def slice_from(mut self, s: StaticString):
        var bra = self.bra
        var ket = self.ket
        var n = s.count_codepoints()
        self.adjust_region(bra, ket, n - (ket - bra))
        var j = bra
        for cp in s.codepoints():
            self.current[j] = UInt32(Int(cp))
            j += 1
        self.ket = bra + n

    def slice_del(mut self):
        self.adjust_region(self.bra, self.ket, self.bra - self.ket)
        self.ket = self.bra

    def r_remove_particle(mut self) -> Bool:
        self.ket = self.cursor
        if (self.find_among_b(Self.TB_a_0) == 0):
            return False
        self.bra = self.cursor
        self.slice_del()
        self.I_measure -= 1
        return True
    def r_remove_possessive_pronoun(mut self) -> Bool:
        self.ket = self.cursor
        if (self.find_among_b(Self.TB_a_1) == 0):
            return False
        self.bra = self.cursor
        self.slice_del()
        self.I_measure -= 1
        return True
    def r_remove_suffix(mut self) -> Bool:
        var among_var: Int = 0
        var v_1: Int = 0
        var _jmp: Int = 0
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_2)
        if (among_var == 0):
            return False
        self.bra = self.cursor
        if (among_var == 1):
            while True:
                v_1 = (self.limit - self.cursor)
                if (self.I_prefix == 3):
                    _jmp = 1
                if _jmp == 0:
                    if (self.I_prefix == 2):
                        _jmp = 1
                if _jmp == 0:
                    if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 107)):
                        _jmp = 1
                if _jmp == 0:
                    self.cursor -= 1
                if _jmp == 0:
                    self.bra = self.cursor
                if _jmp == 0:
                    break
                if _jmp == 1:
                    _jmp = 0
                self.cursor = (self.limit - v_1)
                if (self.I_prefix == 1):
                    return False
                break
        else:
            if (self.I_prefix > 2):
                return False
            if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 115)):
                _jmp = 2
            if _jmp == 0:
                self.cursor -= 1
            if _jmp == 0:
                return False
            if _jmp == 2:
                _jmp = 0
        self.slice_del()
        self.I_measure -= 1
        return True
    def r_remove_first_order_prefix(mut self) -> Bool:
        var among_var: Int = 0
        var v_1: Int = 0
        var v_2: Int = 0
        var v_3: Int = 0
        var v_4: Int = 0
        var v_5: Int = 0
        var v_6: Int = 0
        var v_7: Int = 0
        var v_8: Int = 0
        var _jmp: Int = 0
        self.bra = self.cursor
        among_var = self.find_among(Self.TB_a_3)
        if (among_var == 0):
            return False
        self.ket = self.cursor
        if (among_var == 1):
            self.slice_del()
            self.I_prefix = 1
            self.I_measure -= 1
        elif (among_var == 2):
            while True:
                v_1 = self.cursor
                if ((self.cursor == self.limit) or (self.current[self.cursor] != 121)):
                    _jmp = 1
                if _jmp == 0:
                    self.cursor += 1
                if _jmp == 0:
                    v_2 = self.cursor
                if _jmp == 0:
                    if (not self.in_grouping(Self.GR_g_vowel)):
                        _jmp = 1
                if _jmp == 0:
                    self.cursor = v_2
                if _jmp == 0:
                    self.ket = self.cursor
                if _jmp == 0:
                    self.slice_from_a("s")
                if _jmp == 0:
                    self.I_prefix = 1
                if _jmp == 0:
                    self.I_measure -= 1
                if _jmp == 0:
                    break
                if _jmp == 1:
                    _jmp = 0
                self.cursor = v_1
                self.slice_del()
                self.I_prefix = 1
                self.I_measure -= 1
                break
        elif (among_var == 3):
            self.slice_del()
            self.I_prefix = 3
            self.I_measure -= 1
        elif (among_var == 4):
            while True:
                v_3 = self.cursor
                if ((self.cursor == self.limit) or (self.current[self.cursor] != 121)):
                    _jmp = 2
                if _jmp == 0:
                    self.cursor += 1
                if _jmp == 0:
                    v_4 = self.cursor
                if _jmp == 0:
                    if (not self.in_grouping(Self.GR_g_vowel)):
                        _jmp = 2
                if _jmp == 0:
                    self.cursor = v_4
                if _jmp == 0:
                    self.ket = self.cursor
                if _jmp == 0:
                    self.slice_from_a("s")
                if _jmp == 0:
                    self.I_prefix = 3
                if _jmp == 0:
                    self.I_measure -= 1
                if _jmp == 0:
                    break
                if _jmp == 2:
                    _jmp = 0
                self.cursor = v_3
                self.slice_del()
                self.I_prefix = 3
                self.I_measure -= 1
                break
        elif (among_var == 5):
            self.I_prefix = 1
            self.I_measure -= 1
            while True:
                v_5 = self.cursor
                v_6 = self.cursor
                if (not self.in_grouping(Self.GR_g_vowel)):
                    _jmp = 3
                if _jmp == 0:
                    self.cursor = v_6
                if _jmp == 0:
                    self.slice_from_a("p")
                if _jmp == 0:
                    break
                if _jmp == 3:
                    _jmp = 0
                self.cursor = v_5
                self.slice_del()
                break
        else:
            self.I_prefix = 3
            self.I_measure -= 1
            while True:
                v_7 = self.cursor
                v_8 = self.cursor
                if (not self.in_grouping(Self.GR_g_vowel)):
                    _jmp = 4
                if _jmp == 0:
                    self.cursor = v_8
                if _jmp == 0:
                    self.slice_from_a("p")
                if _jmp == 0:
                    break
                if _jmp == 4:
                    _jmp = 0
                self.cursor = v_7
                self.slice_del()
                break
        return True
    def r_remove_second_order_prefix(mut self) -> Bool:
        var among_var: Int = 0
        var v_1: Int = 0
        var v_2: Int = 0
        var _jmp: Int = 0
        self.bra = self.cursor
        among_var = self.find_among(Self.TB_a_4)
        if (among_var == 0):
            return False
        if (among_var == 1):
            while True:
                v_1 = self.cursor
                if ((self.cursor == self.limit) or (self.current[self.cursor] != 114)):
                    _jmp = 1
                if _jmp == 0:
                    self.cursor += 1
                if _jmp == 0:
                    self.ket = self.cursor
                if _jmp == 0:
                    self.I_prefix = 2
                if _jmp == 0:
                    break
                if _jmp == 1:
                    _jmp = 0
                self.cursor = v_1
                if ((self.cursor == self.limit) or (self.current[self.cursor] != 108)):
                    _jmp = 2
                if _jmp == 0:
                    self.cursor += 1
                if _jmp == 0:
                    self.ket = self.cursor
                if _jmp == 0:
                    if (not self.eq_s_a("ajar")):
                        _jmp = 2
                if _jmp == 0:
                    break
                if _jmp == 2:
                    _jmp = 0
                self.cursor = v_1
                self.ket = self.cursor
                self.I_prefix = 2
                break
        else:
            while True:
                v_2 = self.cursor
                if ((self.cursor == self.limit) or (self.current[self.cursor] != 114)):
                    _jmp = 3
                if _jmp == 0:
                    self.cursor += 1
                if _jmp == 0:
                    self.ket = self.cursor
                if _jmp == 0:
                    break
                if _jmp == 3:
                    _jmp = 0
                self.cursor = v_2
                if ((self.cursor == self.limit) or (self.current[self.cursor] != 108)):
                    _jmp = 4
                if _jmp == 0:
                    self.cursor += 1
                if _jmp == 0:
                    self.ket = self.cursor
                if _jmp == 0:
                    if (not self.eq_s_a("ajar")):
                        _jmp = 4
                if _jmp == 0:
                    break
                if _jmp == 4:
                    _jmp = 0
                self.cursor = v_2
                self.ket = self.cursor
                if (not self.out_grouping(Self.GR_g_vowel)):
                    return False
                if (not self.eq_s_a("er")):
                    return False
                break
            self.I_prefix = 4
        self.I_measure -= 1
        self.slice_del()
        return True
    def stem_impl(mut self) -> Bool:
        var v_1: Int = 0
        var v_10: Int = 0
        var v_2: Int = 0
        var v_3: Int = 0
        var v_4: Int = 0
        var v_5: Int = 0
        var v_6: Int = 0
        var v_7: Int = 0
        var v_8: Int = 0
        var v_9: Int = 0
        var _jmp: Int = 0
        self.I_measure = 0
        v_1 = self.cursor
        while True:
            v_2 = self.cursor
            if (not self.go_out_grouping(Self.GR_g_vowel)):
                _jmp = 2
            if _jmp == 0:
                self.cursor += 1
            if _jmp == 0:
                self.I_measure += 1
            if _jmp == 0:
                continue
            if _jmp == 2:
                _jmp = 0
            self.cursor = v_2
            break
        self.cursor = v_1
        if (self.I_measure <= 2):
            return False
        self.I_prefix = 0
        self.limit_backward = self.cursor
        self.cursor = self.limit
        v_3 = (self.limit - self.cursor)
        _ = self.r_remove_particle()
        self.cursor = (self.limit - v_3)
        if (self.I_measure <= 2):
            return False
        v_4 = (self.limit - self.cursor)
        _ = self.r_remove_possessive_pronoun()
        self.cursor = (self.limit - v_4)
        self.cursor = self.limit_backward
        if (self.I_measure <= 2):
            return False
        while True:
            v_5 = self.cursor
            v_6 = self.cursor
            if (not self.r_remove_first_order_prefix()):
                _jmp = 3
            if _jmp == 0:
                v_7 = self.cursor
            if _jmp == 0:
                v_8 = self.cursor
                if (self.I_measure <= 2):
                    _jmp = 4
                if _jmp == 0:
                    self.limit_backward = self.cursor
                if _jmp == 0:
                    self.cursor = self.limit
                if _jmp == 0:
                    if (not self.r_remove_suffix()):
                        _jmp = 4
                if _jmp == 0:
                    self.cursor = self.limit_backward
                if _jmp == 0:
                    self.cursor = v_8
                if _jmp == 0:
                    if (self.I_measure <= 2):
                        _jmp = 4
                if _jmp == 0:
                    if (not self.r_remove_second_order_prefix()):
                        _jmp = 4
                if _jmp == 4:
                    _jmp = 0
            if _jmp == 0:
                self.cursor = v_7
            if _jmp == 0:
                self.cursor = v_6
            if _jmp == 0:
                break
            if _jmp == 3:
                _jmp = 0
            self.cursor = v_5
            v_9 = self.cursor
            _ = self.r_remove_second_order_prefix()
            self.cursor = v_9
            v_10 = self.cursor
            if (self.I_measure <= 2):
                _jmp = 5
            if _jmp == 0:
                self.limit_backward = self.cursor
            if _jmp == 0:
                self.cursor = self.limit
            if _jmp == 0:
                if (not self.r_remove_suffix()):
                    _jmp = 5
            if _jmp == 0:
                self.cursor = self.limit_backward
            if _jmp == 5:
                _jmp = 0
            self.cursor = v_10
            break
        return True

    def run(
        mut self,
        n: Int,
        src: Pointer[UInt32, MutAnyOrigin],
        lens: Pointer[UInt32, MutAnyOrigin],
        dst: Pointer[UInt32, MutAnyOrigin],
        cap: Int,
    ) raises -> Int:
        """Stem n words. Input lengths are overwritten with output lengths."""
        var pos = 0
        var out = 0
        for i in range(n):
            var length = Int(lens[unsafe_offset=i])
            self.current.clear()
            for j in range(length):
                self.current.append(src[unsafe_offset=pos + j])
            pos += length
            self.cursor = 0
            self.limit = length
            self.limit_backward = 0
            self.bra = 0
            self.ket = length
            _ = self.stem_impl()
            var ol = len(self.current)
            if out + ol > cap:
                raise Error("msnowball: output buffer too small")
            for j in range(ol):
                dst[unsafe_offset=out + j] = self.current[j]
            out += ol
            lens[unsafe_offset=i] = UInt32(ol)
        return out


def new_indonesian() raises -> PythonObject:
    """Allocate and initialise a IndonesianStemmer on the heap; return its address."""
    var a = alloc(Layout[IndonesianStemmer](count=1))
    var p = a^.unsafe_leak()
    p.unsafe_write(IndonesianStemmer())
    return PythonObject(Int(p))


def stem_indonesian(
    handle: PythonObject,
    n: PythonObject,
    src: PythonObject,
    lens: PythonObject,
    dst: PythonObject,
    cap: PythonObject,
) raises -> PythonObject:
    var st = Pointer[IndonesianStemmer, MutAnyOrigin](unsafe_from_address=Int(py=handle))
    var src_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=src))
    var lens_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=lens))
    var dst_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=dst))
    return PythonObject(st[].run(Int(py=n), src_p, lens_p, dst_p, Int(py=cap)))


struct IrishStemmer(Movable):
    var current: List[UInt32]
    var cursor: Int
    var limit: Int
    var limit_backward: Int
    var bra: Int
    var ket: Int
    var grp_mask: List[UInt32]
    var pool: List[UInt32]
    var ent_off: List[Int]
    var ent_len: List[Int]
    var ent_sub: List[Int]
    var ent_res: List[Int]
    var n_groups: Int
    var tab_base: List[Int]
    var tab_size: List[Int]
    var I_p2: Int
    var I_p1: Int
    var I_pV: Int
    var ST_as_0: List[StaticString]
    comptime GR_g_v = 0
    comptime TB_a_0 = 0
    comptime TB_a_1 = 1
    comptime TB_a_2 = 2
    comptime TB_a_3 = 3

    def __init__(out self):
        self.current = List[UInt32]()
        self.cursor = 0
        self.limit = 0
        self.limit_backward = 0
        self.bra = 0
        self.ket = 0
        self.grp_mask = List[UInt32]()
        self.pool = List[UInt32]()
        self.ent_off = List[Int]()
        self.ent_len = List[Int]()
        self.ent_sub = List[Int]()
        self.ent_res = List[Int]()
        self.tab_base = List[Int]()
        self.tab_size = List[Int]()
        self.n_groups = 0
        self.ST_as_0 = List[StaticString]()
        self.I_p2 = 0
        self.I_p1 = 0
        self.I_pV = 0
        self.add_group("aeiouáéíóú")
        self.begin_table()
        self.add_entry("b'", -1, 1)
        self.add_entry("bh", -1, 4)
        self.add_entry("bhf", 1, 2)
        self.add_entry("bp", -1, 8)
        self.add_entry("ch", -1, 5)
        self.add_entry("d'", -1, 1)
        self.add_entry("d'fh", 5, 2)
        self.add_entry("dh", -1, 6)
        self.add_entry("dt", -1, 9)
        self.add_entry("fh", -1, 2)
        self.add_entry("gc", -1, 5)
        self.add_entry("gh", -1, 7)
        self.add_entry("h-", -1, 1)
        self.add_entry("m'", -1, 1)
        self.add_entry("mb", -1, 4)
        self.add_entry("mh", -1, 10)
        self.add_entry("n-", -1, 1)
        self.add_entry("nd", -1, 6)
        self.add_entry("ng", -1, 7)
        self.add_entry("ph", -1, 8)
        self.add_entry("sh", -1, 3)
        self.add_entry("t-", -1, 1)
        self.add_entry("th", -1, 9)
        self.add_entry("ts", -1, 3)
        self.begin_table()
        self.add_entry("íochta", -1, 1)
        self.add_entry("aíochta", 0, 1)
        self.add_entry("ire", -1, 2)
        self.add_entry("aire", 2, 2)
        self.add_entry("abh", -1, 1)
        self.add_entry("eabh", 4, 1)
        self.add_entry("ibh", -1, 1)
        self.add_entry("aibh", 6, 1)
        self.add_entry("amh", -1, 1)
        self.add_entry("eamh", 8, 1)
        self.add_entry("imh", -1, 1)
        self.add_entry("aimh", 10, 1)
        self.add_entry("íocht", -1, 1)
        self.add_entry("aíocht", 12, 1)
        self.add_entry("irí", -1, 2)
        self.add_entry("airí", 14, 2)
        self.begin_table()
        self.add_entry("óideacha", -1, 6)
        self.add_entry("patacha", -1, 5)
        self.add_entry("achta", -1, 1)
        self.add_entry("arcachta", 2, 2)
        self.add_entry("eachta", 2, 1)
        self.add_entry("grafaíochta", -1, 4)
        self.add_entry("paite", -1, 5)
        self.add_entry("ach", -1, 1)
        self.add_entry("each", 7, 1)
        self.add_entry("óideach", 8, 6)
        self.add_entry("gineach", 8, 3)
        self.add_entry("patach", 7, 5)
        self.add_entry("grafaíoch", -1, 4)
        self.add_entry("pataigh", -1, 5)
        self.add_entry("óidigh", -1, 6)
        self.add_entry("achtúil", -1, 1)
        self.add_entry("eachtúil", 15, 1)
        self.add_entry("gineas", -1, 3)
        self.add_entry("ginis", -1, 3)
        self.add_entry("acht", -1, 1)
        self.add_entry("arcacht", 19, 2)
        self.add_entry("eacht", 19, 1)
        self.add_entry("grafaíocht", -1, 4)
        self.add_entry("arcachtaí", -1, 2)
        self.add_entry("grafaíochtaí", -1, 4)
        self.begin_table()
        self.add_entry("imid", -1, 1)
        self.add_entry("aimid", 0, 1)
        self.add_entry("ímid", -1, 1)
        self.add_entry("aímid", 2, 1)
        self.add_entry("adh", -1, 2)
        self.add_entry("eadh", 4, 2)
        self.add_entry("faidh", -1, 1)
        self.add_entry("fidh", -1, 1)
        self.add_entry("áil", -1, 2)
        self.add_entry("ain", -1, 2)
        self.add_entry("tear", -1, 2)
        self.add_entry("tar", -1, 2)
        self.ST_as_0.append("")
        self.ST_as_0.append("f")
        self.ST_as_0.append("s")
        self.ST_as_0.append("b")
        self.ST_as_0.append("c")
        self.ST_as_0.append("d")
        self.ST_as_0.append("g")
        self.ST_as_0.append("p")
        self.ST_as_0.append("t")
        self.ST_as_0.append("m")

    # ---- BaseStemmer runtime (snowballstemmer/basestemmer.py), code-point based

    def in_grouping(mut self, g: Int) -> Bool:
        if self.cursor >= self.limit:
            return False
        if not self.has(g, self.current[self.cursor]):
            return False
        self.cursor += 1
        return True

    def in_grouping_b(mut self, g: Int) -> Bool:
        if self.cursor <= self.limit_backward:
            return False
        if not self.has(g, self.current[self.cursor - 1]):
            return False
        self.cursor -= 1
        return True

    def go_in_grouping(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor < self.limit:
            if not self.has(g, cur[unsafe_offset=self.cursor]):
                return True
            self.cursor += 1
        return False

    def go_in_grouping_b(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor > self.limit_backward:
            if not self.has(g, cur[unsafe_offset=self.cursor - 1]):
                return True
            self.cursor -= 1
        return False

    def out_grouping(mut self, g: Int) -> Bool:
        if self.cursor >= self.limit:
            return False
        if not self.has(g, self.current[self.cursor]):
            self.cursor += 1
            return True
        return False

    def go_out_grouping(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor < self.limit:
            if self.has(g, cur[unsafe_offset=self.cursor]):
                return True
            self.cursor += 1
        return False

    def out_grouping_b(mut self, g: Int) -> Bool:
        if self.cursor <= self.limit_backward:
            return False
        if not self.has(g, self.current[self.cursor - 1]):
            self.cursor -= 1
            return True
        return False

    def go_out_grouping_b(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor > self.limit_backward:
            if self.has(g, cur[unsafe_offset=self.cursor - 1]):
                return True
            self.cursor -= 1
        return False

    def eq_s(mut self, s: StaticString) -> Bool:
        var n = s.count_codepoints()
        if self.cursor + n > self.limit:
            return False
        var j = self.cursor
        for cp in s.codepoints():
            if self.current[j] != UInt32(Int(cp)):
                return False
            j += 1
        self.cursor += n
        return True

    def eq_s_b(mut self, s: StaticString) -> Bool:
        var n = s.count_codepoints()
        if self.cursor - n < self.limit_backward:
            return False
        var j = self.cursor - n
        for cp in s.codepoints():
            if self.current[j] != UInt32(Int(cp)):
                return False
            j += 1
        self.cursor -= n
        return True

    def find_among(mut self, t: Int) -> Int:
        var cur = self.current.unsafe_ptr()
        var pool = self.pool.unsafe_ptr()
        var elen = self.ent_len.unsafe_ptr()
        var eoff = self.ent_off.unsafe_ptr()
        var esub = self.ent_sub.unsafe_ptr()
        var eres = self.ent_res.unsafe_ptr()
        var base = self.tab_base[t]
        var i = 0
        var j = self.tab_size[t]
        var c = self.cursor
        var l = self.limit
        var common_i = 0
        var common_j = 0
        var first_key_inspected = False
        while True:
            var k = i + ((j - i) >> 1)
            var diff = 0
            var common = min(common_i, common_j)
            var wl = elen[unsafe_offset=base + k]
            var wo = eoff[unsafe_offset=base + k]
            for i2 in range(common, wl):
                if c + common == l:
                    diff = -1
                    break
                diff = Int(cur[unsafe_offset=c + common]) - Int(pool[unsafe_offset=wo + i2])
                if diff != 0:
                    break
                common += 1
            if diff < 0:
                j = k
                common_j = common
            else:
                i = k
                common_i = common
            if j - i <= 1:
                if i > 0:
                    break
                if j == i:
                    break
                if first_key_inspected:
                    break
                first_key_inspected = True
        while True:
            var wl = elen[unsafe_offset=base + i]
            if common_i >= wl:
                self.cursor = c + wl
                return eres[unsafe_offset=base + i]
            i = esub[unsafe_offset=base + i]
            if i < 0:
                return 0

    def find_among_b(mut self, t: Int) -> Int:
        var cur = self.current.unsafe_ptr()
        var pool = self.pool.unsafe_ptr()
        var elen = self.ent_len.unsafe_ptr()
        var eoff = self.ent_off.unsafe_ptr()
        var esub = self.ent_sub.unsafe_ptr()
        var eres = self.ent_res.unsafe_ptr()
        var base = self.tab_base[t]
        var i = 0
        var j = self.tab_size[t]
        var c = self.cursor
        var lb = self.limit_backward
        var common_i = 0
        var common_j = 0
        var first_key_inspected = False
        while True:
            var k = i + ((j - i) >> 1)
            var diff = 0
            var common = min(common_i, common_j)
            var wl = elen[unsafe_offset=base + k]
            var wo = eoff[unsafe_offset=base + k]
            for i2 in range(wl - 1 - common, -1, -1):
                if c - common == lb:
                    diff = -1
                    break
                diff = Int(cur[unsafe_offset=c - 1 - common]) - Int(pool[unsafe_offset=wo + i2])
                if diff != 0:
                    break
                common += 1
            if diff < 0:
                j = k
                common_j = common
            else:
                i = k
                common_i = common
            if j - i <= 1:
                if i > 0:
                    break
                if j == i:
                    break
                if first_key_inspected:
                    break
                first_key_inspected = True
        while True:
            var wl = elen[unsafe_offset=base + i]
            if common_i >= wl:
                self.cursor = c - wl
                return eres[unsafe_offset=base + i]
            i = esub[unsafe_offset=base + i]
            if i < 0:
                return 0

    def has(self, g: Int, cp: UInt32) -> Bool:
        var i = Int(cp)
        if i >= len(self.grp_mask):
            return False
        return ((self.grp_mask[i] >> UInt32(g)) & 1) == 1

    def add_group(mut self, s: StaticString):
        """Group g is bit g of grp_mask[cp]; the group index is the call order."""
        var cps = to_cps(s)
        var g = self.n_groups
        self.n_groups += 1
        var mx = 0
        for c in cps:
            if Int(c) > mx:
                mx = Int(c)
        while len(self.grp_mask) <= mx:
            self.grp_mask.append(0)
        for c in cps:
            self.grp_mask[Int(c)] = self.grp_mask[Int(c)] | (UInt32(1) << UInt32(g))

    def begin_table(mut self):
        self.tab_base.append(len(self.ent_off))
        self.tab_size.append(0)

    def add_entry(mut self, s: StaticString, sub: Int, res: Int):
        var cps = to_cps(s)
        self.ent_off.append(len(self.pool))
        self.ent_len.append(len(cps))
        for c in cps:
            self.pool.append(c)
        self.ent_sub.append(sub)
        self.ent_res.append(res)
        self.tab_size[len(self.tab_size) - 1] += 1

    def eq_s_a(mut self, s: StaticString) -> Bool:
        var n = s.byte_length()
        if self.cursor + n > self.limit:
            return False
        var j = self.cursor
        for b in s.as_bytes():
            if self.current[j] != UInt32(b):
                return False
            j += 1
        self.cursor += n
        return True

    def eq_s_b_a(mut self, s: StaticString) -> Bool:
        var n = s.byte_length()
        if self.cursor - n < self.limit_backward:
            return False
        var j = self.cursor - n
        for b in s.as_bytes():
            if self.current[j] != UInt32(b):
                return False
            j += 1
        self.cursor -= n
        return True

    def slice_from_a(mut self, s: StaticString):
        var bra = self.bra
        var ket = self.ket
        var n = s.byte_length()
        self.adjust_region(bra, ket, n - (ket - bra))
        var j = bra
        for b in s.as_bytes():
            self.current[j] = UInt32(b)
            j += 1
        self.ket = bra + n

    def adjust_region(mut self, c_bra: Int, c_ket: Int, adj: Int):
        """Resize the buffer by adj at [c_bra, c_ket); the tail moves with it."""
        var old_len = len(self.current)
        if adj > 0:
            for _ in range(adj):
                self.current.append(0)
            var j = old_len - 1
            while j >= c_ket:
                self.current[j + adj] = self.current[j]
                j -= 1
        elif adj < 0:
            for j in range(c_ket, old_len):
                self.current[j + adj] = self.current[j]
            self.current.shrink(old_len + adj)
        self.limit += adj
        if self.cursor >= c_ket:
            self.cursor += adj
        elif self.cursor > c_bra:
            self.cursor = c_bra

    def slice_from(mut self, s: StaticString):
        var bra = self.bra
        var ket = self.ket
        var n = s.count_codepoints()
        self.adjust_region(bra, ket, n - (ket - bra))
        var j = bra
        for cp in s.codepoints():
            self.current[j] = UInt32(Int(cp))
            j += 1
        self.ket = bra + n

    def slice_del(mut self):
        self.adjust_region(self.bra, self.ket, self.bra - self.ket)
        self.ket = self.bra

    def r_mark_regions(mut self) -> Bool:
        var v_1: Int = 0
        var _jmp: Int = 0
        self.I_pV = self.limit
        self.I_p1 = self.limit
        self.I_p2 = self.limit
        v_1 = self.cursor
        if (not self.go_out_grouping(Self.GR_g_v)):
            _jmp = 1
        if _jmp == 0:
            self.cursor += 1
        if _jmp == 0:
            self.I_pV = self.cursor
        if _jmp == 0:
            if (not self.go_in_grouping(Self.GR_g_v)):
                _jmp = 1
        if _jmp == 0:
            self.cursor += 1
        if _jmp == 0:
            self.I_p1 = self.cursor
        if _jmp == 0:
            if (not self.go_out_grouping(Self.GR_g_v)):
                _jmp = 1
        if _jmp == 0:
            self.cursor += 1
        if _jmp == 0:
            if (not self.go_in_grouping(Self.GR_g_v)):
                _jmp = 1
        if _jmp == 0:
            self.cursor += 1
        if _jmp == 0:
            self.I_p2 = self.cursor
        if _jmp == 1:
            _jmp = 0
        self.cursor = v_1
        return True
    def r_initial_morph(mut self) -> Bool:
        var among_var: Int = 0
        self.bra = self.cursor
        among_var = self.find_among(Self.TB_a_0)
        if (among_var == 0):
            return False
        self.ket = self.cursor
        self.slice_from(self.ST_as_0[(among_var - 1)])
        return True
    def r_R1(mut self) -> Bool:
        return (self.I_p1 <= self.cursor)
    def r_R2(mut self) -> Bool:
        return (self.I_p2 <= self.cursor)
    def r_noun_sfx(mut self) -> Bool:
        var among_var: Int = 0
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_1)
        if (among_var == 0):
            return False
        self.bra = self.cursor
        if (among_var == 1):
            if (not self.r_R1()):
                return False
            self.slice_del()
        else:
            if (not self.r_R2()):
                return False
            self.slice_del()
        return True
    def r_deriv(mut self) -> Bool:
        var among_var: Int = 0
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_2)
        if (among_var == 0):
            return False
        self.bra = self.cursor
        if (among_var == 1):
            if (not self.r_R2()):
                return False
            self.slice_del()
        elif (among_var == 2):
            self.slice_from_a("arc")
        elif (among_var == 3):
            self.slice_from_a("gin")
        elif (among_var == 4):
            self.slice_from_a("graf")
        elif (among_var == 5):
            self.slice_from_a("paite")
        else:
            self.slice_from("óid")
        return True
    def r_verb_sfx(mut self) -> Bool:
        var among_var: Int = 0
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_3)
        if (among_var == 0):
            return False
        self.bra = self.cursor
        if (among_var == 1):
            if (self.I_pV > self.cursor):
                return False
            self.slice_del()
        else:
            if (not self.r_R1()):
                return False
            self.slice_del()
        return True
    def stem_impl(mut self) -> Bool:
        var v_1: Int = 0
        var v_2: Int = 0
        var v_3: Int = 0
        var v_4: Int = 0
        v_1 = self.cursor
        _ = self.r_initial_morph()
        self.cursor = v_1
        _ = self.r_mark_regions()
        self.limit_backward = self.cursor
        self.cursor = self.limit
        v_2 = (self.limit - self.cursor)
        _ = self.r_noun_sfx()
        self.cursor = (self.limit - v_2)
        v_3 = (self.limit - self.cursor)
        _ = self.r_deriv()
        self.cursor = (self.limit - v_3)
        v_4 = (self.limit - self.cursor)
        _ = self.r_verb_sfx()
        self.cursor = (self.limit - v_4)
        self.cursor = self.limit_backward
        return True

    def run(
        mut self,
        n: Int,
        src: Pointer[UInt32, MutAnyOrigin],
        lens: Pointer[UInt32, MutAnyOrigin],
        dst: Pointer[UInt32, MutAnyOrigin],
        cap: Int,
    ) raises -> Int:
        """Stem n words. Input lengths are overwritten with output lengths."""
        var pos = 0
        var out = 0
        for i in range(n):
            var length = Int(lens[unsafe_offset=i])
            self.current.clear()
            for j in range(length):
                self.current.append(src[unsafe_offset=pos + j])
            pos += length
            self.cursor = 0
            self.limit = length
            self.limit_backward = 0
            self.bra = 0
            self.ket = length
            _ = self.stem_impl()
            var ol = len(self.current)
            if out + ol > cap:
                raise Error("msnowball: output buffer too small")
            for j in range(ol):
                dst[unsafe_offset=out + j] = self.current[j]
            out += ol
            lens[unsafe_offset=i] = UInt32(ol)
        return out


def new_irish() raises -> PythonObject:
    """Allocate and initialise a IrishStemmer on the heap; return its address."""
    var a = alloc(Layout[IrishStemmer](count=1))
    var p = a^.unsafe_leak()
    p.unsafe_write(IrishStemmer())
    return PythonObject(Int(p))


def stem_irish(
    handle: PythonObject,
    n: PythonObject,
    src: PythonObject,
    lens: PythonObject,
    dst: PythonObject,
    cap: PythonObject,
) raises -> PythonObject:
    var st = Pointer[IrishStemmer, MutAnyOrigin](unsafe_from_address=Int(py=handle))
    var src_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=src))
    var lens_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=lens))
    var dst_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=dst))
    return PythonObject(st[].run(Int(py=n), src_p, lens_p, dst_p, Int(py=cap)))



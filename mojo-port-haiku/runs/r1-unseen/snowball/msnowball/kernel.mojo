        if _jmp == 4:
            _jmp = 0
        self.cursor = v_3
        return True
    def r_postlude(mut self) -> Bool:
        var among_var: Int = 0
        var v_1: Int = 0
        var _jmp: Int = 0
        while True:
            v_1 = self.cursor
            self.bra = self.cursor
            among_var = self.find_among(Self.TB_a_1)
            self.ket = self.cursor
            if (among_var == 1):
                self.slice_from_a("i")
            elif (among_var == 2):
                self.slice_from_a("u")
            elif (among_var == 3):
                self.slice_from_a("y")
            elif (among_var == 4):
                self.slice_from("ë")
            elif (among_var == 5):
                self.slice_from("ï")
            elif (among_var == 6):
                self.slice_del()
            else:
                if (self.cursor >= self.limit):
                    _jmp = 1
                if _jmp == 0:
                    self.cursor += 1
            if _jmp == 0:
                continue
            if _jmp == 1:
                _jmp = 0
            self.cursor = v_1
            break
        return True
    def r_RV(mut self) -> Bool:
        return (self.I_pV <= self.cursor)
    def r_R1(mut self) -> Bool:
        return (self.I_p1 <= self.cursor)
    def r_R2(mut self) -> Bool:
        return (self.I_p2 <= self.cursor)

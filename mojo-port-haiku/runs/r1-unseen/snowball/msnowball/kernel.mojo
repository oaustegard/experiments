        self.slice_from_a("e")
        return True
    def stem_impl(mut self) -> Bool:
        var v_1: Int = 0
        var v_10: Int = 0
        var v_11: Int = 0
        var v_2: Int = 0
        var v_3: Int = 0
        var v_4: Int = 0
        var v_5: Int = 0
        var v_6: Int = 0
        var v_7: Int = 0
        var v_8: Int = 0
        var v_9: Int = 0
        var _jmp: Int = 0
        v_1 = self.cursor
        _ = self.r_elisions()
        self.cursor = v_1
        v_2 = self.cursor
        _ = self.r_prelude()
        self.cursor = v_2
        _ = self.r_mark_regions()
        self.limit_backward = self.cursor
        self.cursor = self.limit
        v_3 = (self.limit - self.cursor)
        while True:
            v_4 = (self.limit - self.cursor)
            v_5 = (self.limit - self.cursor)
            while True:
                v_6 = (self.limit - self.cursor)
                if (not self.r_standard_suffix()):
                    _jmp = 3
                if _jmp == 0:
                    break
                if _jmp == 3:
                    _jmp = 0
                self.cursor = (self.limit - v_6)
                if (not self.r_i_verb_suffix()):
                    _jmp = 4
                if _jmp == 0:
                    break
                if _jmp == 4:
                    _jmp = 0
                self.cursor = (self.limit - v_6)
                if (not self.r_verb_suffix()):
                    _jmp = 2
                if _jmp == 0:
                    break
                if _jmp != 0:
                    break
            if _jmp == 0:
                self.cursor = (self.limit - v_5)
            if _jmp == 0:
                v_7 = (self.limit - self.cursor)
            if _jmp == 0:
                self.ket = self.cursor
                while True:
                    v_8 = (self.limit - self.cursor)
                    if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 89)):
                        _jmp = 6
                    if _jmp == 0:
                        self.cursor -= 1
                    if _jmp == 0:
                        self.bra = self.cursor
                    if _jmp == 0:
                        self.slice_from_a("i")
                    if _jmp == 0:
                        break
                    if _jmp == 6:
                        _jmp = 0
                    self.cursor = (self.limit - v_8)
                    if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 231)):
                        self.cursor = (self.limit - v_7)
                        _jmp = 5
                    if _jmp == 0:
                        self.cursor -= 1
                    if _jmp == 0:
                        self.bra = self.cursor
                    if _jmp == 0:
                        self.slice_from_a("c")
                    if _jmp == 0:
                        break
                    if _jmp != 0:
                        break
                if _jmp == 5:
                    _jmp = 0
            if _jmp == 0:
                break
            if _jmp == 2:
                _jmp = 0
            self.cursor = (self.limit - v_4)
            if (not self.r_residual_suffix()):
                _jmp = 1
            if _jmp == 0:
                break
            if _jmp != 0:
                break
        if _jmp == 1:
            _jmp = 0
        self.cursor = (self.limit - v_3)
        v_9 = (self.limit - self.cursor)
        _ = self.r_un_double()
        self.cursor = (self.limit - v_9)
        v_10 = (self.limit - self.cursor)
        _ = self.r_un_accent()
        self.cursor = (self.limit - v_10)
        self.cursor = self.limit_backward
        v_11 = self.cursor
        _ = self.r_postlude()
        self.cursor = v_11
        return True

    def run(
        mut self,
        n: Int,
        src: Pointer[UInt32, MutAnyOrigin],
        lens: Pointer[UInt32, MutAnyOrigin],
        dst: Pointer[UInt32, MutAnyOrigin],
        cap: Int,
    ) raises -> Int:
        """Stem n words. Input lengths are overwritten with output lengths."""
        var pos = 0
        var out = 0
        for i in range(n):
            var length = Int(lens[unsafe_offset=i])
            self.current.clear()
            for j in range(length):
                self.current.append(src[unsafe_offset=pos + j])
            pos += length
            self.cursor = 0
            self.limit = length
            self.limit_backward = 0
            self.bra = 0
            self.ket = length
            _ = self.stem_impl()
            var ol = len(self.current)
            if out + ol > cap:
                raise Error("msnowball: output buffer too small")
            for j in range(ol):
                dst[unsafe_offset=out + j] = self.current[j]
            out += ol
            lens[unsafe_offset=i] = UInt32(ol)
        return out


def new_french() raises -> PythonObject:
    """Allocate and initialise a FrenchStemmer on the heap; return its address."""
    var a = alloc(Layout[FrenchStemmer](count=1))
    var p = a^.unsafe_leak()
    p.unsafe_write(FrenchStemmer())
    return PythonObject(Int(p))


def stem_french(
    handle: PythonObject,
    n: PythonObject,
    src: PythonObject,
    lens: PythonObject,
    dst: PythonObject,
    cap: PythonObject,
) raises -> PythonObject:
    var st = Pointer[FrenchStemmer, MutAnyOrigin](unsafe_from_address=Int(py=handle))
    var src_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=src))
    var lens_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=lens))
    var dst_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=dst))
    return PythonObject(st[].run(Int(py=n), src_p, lens_p, dst_p, Int(py=cap)))


struct GermanStemmer(Movable):
    var current: List[UInt32]
    var cursor: Int
    var limit: Int
    var limit_backward: Int
    var bra: Int
    var ket: Int
    var grp_mask: List[UInt32]
    var pool: List[UInt32]
    var ent_off: List[Int]
    var ent_len: List[Int]
    var ent_sub: List[Int]
    var ent_res: List[Int]
    var n_groups: Int
    var tab_base: List[Int]
    var tab_size: List[Int]
    var I_p2: Int
    var I_p1: Int
    comptime GR_g_v = 0
    comptime GR_g_et_ending = 1
    comptime GR_g_s_ending = 2
    comptime GR_g_st_ending = 3
    comptime TB_a_0 = 0
    comptime TB_a_1 = 1
    comptime TB_a_2 = 2
    comptime TB_a_3 = 3
    comptime TB_a_4 = 4
    comptime TB_a_5 = 5
    comptime TB_a_6 = 6
    comptime TB_a_7 = 7

    def __init__(out self):
        self.current = List[UInt32]()
        self.cursor = 0
        self.limit = 0
        self.limit_backward = 0
        self.bra = 0
        self.ket = 0
        self.grp_mask = List[UInt32]()
        self.pool = List[UInt32]()
        self.ent_off = List[Int]()
        self.ent_len = List[Int]()
        self.ent_sub = List[Int]()
        self.ent_res = List[Int]()
        self.tab_base = List[Int]()
        self.tab_size = List[Int]()
        self.n_groups = 0
        self.I_p2 = 0
        self.I_p1 = 0
        self.add_group("aeiouyäöü")
        self.add_group("Udfgklmnrstzä")
        self.add_group("bdfghklmnrt")
        self.add_group("bdfghklmnt")
        self.begin_table()
        self.add_entry("", -1, 5)
        self.add_entry("ae", 0, 2)
        self.add_entry("oe", 0, 3)
        self.add_entry("qu", 0, -1)
        self.add_entry("ue", 0, 4)
        self.add_entry("ß", 0, 1)
        self.begin_table()
        self.add_entry("", -1, 5)
        self.add_entry("U", 0, 2)
        self.add_entry("Y", 0, 1)
        self.add_entry("ä", 0, 3)
        self.add_entry("ö", 0, 4)
        self.add_entry("ü", 0, 2)
        self.begin_table()
        self.add_entry("e", -1, 3)
        self.add_entry("em", -1, 1)
        self.add_entry("en", -1, 3)
        self.add_entry("erinnen", 2, 2)
        self.add_entry("erin", -1, 2)
        self.add_entry("ln", -1, 5)
        self.add_entry("ern", -1, 2)
        self.add_entry("er", -1, 2)
        self.add_entry("s", -1, 4)
        self.add_entry("es", 8, 3)
        self.add_entry("lns", 8, 5)
        self.begin_table()
        self.add_entry("tick", -1, -1)
        self.add_entry("plan", -1, -1)
        self.add_entry("geordn", -1, -1)
        self.add_entry("intern", -1, -1)
        self.add_entry("tr", -1, -1)
        self.begin_table()
        self.add_entry("en", -1, 1)
        self.add_entry("er", -1, 1)
        self.add_entry("et", -1, 3)
        self.add_entry("st", -1, 2)
        self.add_entry("est", 3, 1)
        self.begin_table()
        self.add_entry("ig", -1, 1)
        self.add_entry("lich", -1, 1)
        self.begin_table()
        self.add_entry("end", -1, 1)
        self.add_entry("ig", -1, 2)
        self.add_entry("ung", -1, 1)
        self.add_entry("lich", -1, 3)
        self.add_entry("isch", -1, 2)
        self.add_entry("ik", -1, 2)
        self.add_entry("heit", -1, 3)
        self.add_entry("keit", -1, 4)
        self.begin_table()
        self.add_entry("'", -1, 1)
        self.add_entry("'sch", -1, 1)
        self.add_entry("'s", -1, 1)

    # ---- BaseStemmer runtime (snowballstemmer/basestemmer.py), code-point based

    def in_grouping(mut self, g: Int) -> Bool:
        if self.cursor >= self.limit:
            return False
        if not self.has(g, self.current[self.cursor]):
            return False
        self.cursor += 1
        return True

    def in_grouping_b(mut self, g: Int) -> Bool:
        if self.cursor <= self.limit_backward:
            return False
        if not self.has(g, self.current[self.cursor - 1]):
            return False
        self.cursor -= 1
        return True

    def go_in_grouping(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor < self.limit:
            if not self.has(g, cur[unsafe_offset=self.cursor]):
                return True
            self.cursor += 1
        return False

    def go_in_grouping_b(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor > self.limit_backward:
            if not self.has(g, cur[unsafe_offset=self.cursor - 1]):
                return True
            self.cursor -= 1
        return False

    def out_grouping(mut self, g: Int) -> Bool:
        if self.cursor >= self.limit:
            return False
        if not self.has(g, self.current[self.cursor]):
            self.cursor += 1
            return True
        return False

    def go_out_grouping(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor < self.limit:
            if self.has(g, cur[unsafe_offset=self.cursor]):
                return True
            self.cursor += 1
        return False

    def out_grouping_b(mut self, g: Int) -> Bool:
        if self.cursor <= self.limit_backward:
            return False
        if not self.has(g, self.current[self.cursor - 1]):
            self.cursor -= 1
            return True
        return False

    def go_out_grouping_b(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor > self.limit_backward:
            if self.has(g, cur[unsafe_offset=self.cursor - 1]):
                return True
            self.cursor -= 1
        return False

    def eq_s(mut self, s: StaticString) -> Bool:
        var n = s.count_codepoints()
        if self.cursor + n > self.limit:
            return False
        var j = self.cursor
        for cp in s.codepoints():
            if self.current[j] != UInt32(Int(cp)):
                return False
            j += 1
        self.cursor += n
        return True

    def eq_s_b(mut self, s: StaticString) -> Bool:
        var n = s.count_codepoints()
        if self.cursor - n < self.limit_backward:
            return False
        var j = self.cursor - n
        for cp in s.codepoints():
            if self.current[j] != UInt32(Int(cp)):
                return False
            j += 1
        self.cursor -= n
        return True

    def find_among(mut self, t: Int) -> Int:
        var cur = self.current.unsafe_ptr()
        var pool = self.pool.unsafe_ptr()
        var elen = self.ent_len.unsafe_ptr()
        var eoff = self.ent_off.unsafe_ptr()
        var esub = self.ent_sub.unsafe_ptr()
        var eres = self.ent_res.unsafe_ptr()
        var base = self.tab_base[t]
        var i = 0
        var j = self.tab_size[t]
        var c = self.cursor
        var l = self.limit
        var common_i = 0
        var common_j = 0
        var first_key_inspected = False
        while True:
            var k = i + ((j - i) >> 1)
            var diff = 0
            var common = min(common_i, common_j)
            var wl = elen[unsafe_offset=base + k]
            var wo = eoff[unsafe_offset=base + k]
            for i2 in range(common, wl):
                if c + common == l:
                    diff = -1
                    break
                diff = Int(cur[unsafe_offset=c + common]) - Int(pool[unsafe_offset=wo + i2])
                if diff != 0:
                    break
                common += 1
            if diff < 0:
                j = k
                common_j = common
            else:
                i = k
                common_i = common
            if j - i <= 1:
                if i > 0:
                    break
                if j == i:
                    break
                if first_key_inspected:
                    break
                first_key_inspected = True
        while True:
            var wl = elen[unsafe_offset=base + i]
            if common_i >= wl:
                self.cursor = c + wl
                return eres[unsafe_offset=base + i]
            i = esub[unsafe_offset=base + i]
            if i < 0:
                return 0

    def find_among_b(mut self, t: Int) -> Int:
        var cur = self.current.unsafe_ptr()
        var pool = self.pool.unsafe_ptr()
        var elen = self.ent_len.unsafe_ptr()
        var eoff = self.ent_off.unsafe_ptr()
        var esub = self.ent_sub.unsafe_ptr()
        var eres = self.ent_res.unsafe_ptr()
        var base = self.tab_base[t]
        var i = 0
        var j = self.tab_size[t]
        var c = self.cursor
        var lb = self.limit_backward
        var common_i = 0
        var common_j = 0
        var first_key_inspected = False
        while True:
            var k = i + ((j - i) >> 1)
            var diff = 0
            var common = min(common_i, common_j)
            var wl = elen[unsafe_offset=base + k]
            var wo = eoff[unsafe_offset=base + k]
            for i2 in range(wl - 1 - common, -1, -1):
                if c - common == lb:
                    diff = -1
                    break
                diff = Int(cur[unsafe_offset=c - 1 - common]) - Int(pool[unsafe_offset=wo + i2])
                if diff != 0:
                    break
                common += 1
            if diff < 0:
                j = k
                common_j = common
            else:
                i = k
                common_i = common
            if j - i <= 1:
                if i > 0:
                    break
                if j == i:
                    break
                if first_key_inspected:
                    break
                first_key_inspected = True
        while True:
            var wl = elen[unsafe_offset=base + i]
            if common_i >= wl:
                self.cursor = c - wl
                return eres[unsafe_offset=base + i]
            i = esub[unsafe_offset=base + i]
            if i < 0:
                return 0

    def has(self, g: Int, cp: UInt32) -> Bool:
        var i = Int(cp)
        if i >= len(self.grp_mask):
            return False
        return ((self.grp_mask[i] >> UInt32(g)) & 1) == 1

    def add_group(mut self, s: StaticString):
        """Group g is bit g of grp_mask[cp]; the group index is the call order."""
        var cps = to_cps(s)
        var g = self.n_groups
        self.n_groups += 1
        var mx = 0
        for c in cps:
            if Int(c) > mx:
                mx = Int(c)
        while len(self.grp_mask) <= mx:
            self.grp_mask.append(0)
        for c in cps:
            self.grp_mask[Int(c)] = self.grp_mask[Int(c)] | (UInt32(1) << UInt32(g))

    def begin_table(mut self):
        self.tab_base.append(len(self.ent_off))
        self.tab_size.append(0)

    def add_entry(mut self, s: StaticString, sub: Int, res: Int):
        var cps = to_cps(s)
        self.ent_off.append(len(self.pool))
        self.ent_len.append(len(cps))
        for c in cps:
            self.pool.append(c)
        self.ent_sub.append(sub)
        self.ent_res.append(res)
        self.tab_size[len(self.tab_size) - 1] += 1

    def eq_s_a(mut self, s: StaticString) -> Bool:
        var n = s.byte_length()
        if self.cursor + n > self.limit:
            return False
        var j = self.cursor
        for b in s.as_bytes():
            if self.current[j] != UInt32(b):
                return False
            j += 1
        self.cursor += n
        return True

    def eq_s_b_a(mut self, s: StaticString) -> Bool:
        var n = s.byte_length()
        if self.cursor - n < self.limit_backward:
            return False
        var j = self.cursor - n
        for b in s.as_bytes():
            if self.current[j] != UInt32(b):
                return False
            j += 1
        self.cursor -= n
        return True

    def slice_from_a(mut self, s: StaticString):
        var bra = self.bra
        var ket = self.ket
        var n = s.byte_length()
        self.adjust_region(bra, ket, n - (ket - bra))
        var j = bra
        for b in s.as_bytes():
            self.current[j] = UInt32(b)
            j += 1
        self.ket = bra + n

    def adjust_region(mut self, c_bra: Int, c_ket: Int, adj: Int):
        """Resize the buffer by adj at [c_bra, c_ket); the tail moves with it."""
        var old_len = len(self.current)
        if adj > 0:
            for _ in range(adj):
                self.current.append(0)
            var j = old_len - 1
            while j >= c_ket:
                self.current[j + adj] = self.current[j]
                j -= 1
        elif adj < 0:
            for j in range(c_ket, old_len):
                self.current[j + adj] = self.current[j]
            self.current.shrink(old_len + adj)
        self.limit += adj
        if self.cursor >= c_ket:
            self.cursor += adj
        elif self.cursor > c_bra:
            self.cursor = c_bra

    def slice_from(mut self, s: StaticString):
        var bra = self.bra
        var ket = self.ket
        var n = s.count_codepoints()
        self.adjust_region(bra, ket, n - (ket - bra))
        var j = bra
        for cp in s.codepoints():
            self.current[j] = UInt32(Int(cp))
            j += 1
        self.ket = bra + n

    def slice_del(mut self):
        self.adjust_region(self.bra, self.ket, self.bra - self.ket)
        self.ket = self.bra

    def r_prelude(mut self) -> Bool:
        var among_var: Int = 0
        var v_1: Int = 0
        var v_2: Int = 0
        var v_3: Int = 0
        var v_4: Int = 0
        var v_5: Int = 0
        var _jmp: Int = 0
        v_1 = self.cursor
        while True:
            v_2 = self.cursor
            while True:
                v_3 = self.cursor
                if (not self.in_grouping(Self.GR_g_v)):
                    _jmp = 2
                if _jmp == 0:
                    self.bra = self.cursor
                if _jmp == 0:
                    while True:
                        v_4 = self.cursor
                        if ((self.cursor == self.limit) or (self.current[self.cursor] != 117)):
                            _jmp = 3
                        if _jmp == 0:
                            self.cursor += 1
                        if _jmp == 0:
                            self.ket = self.cursor
                        if _jmp == 0:
                            if (not self.in_grouping(Self.GR_g_v)):
                                _jmp = 3
                        if _jmp == 0:
                            self.slice_from_a("U")
                        if _jmp == 0:
                            break
                        if _jmp == 3:
                            _jmp = 0
                        self.cursor = v_4
                        if ((self.cursor == self.limit) or (self.current[self.cursor] != 121)):
                            _jmp = 2
                        if _jmp == 0:
                            self.cursor += 1
                        if _jmp == 0:
                            self.ket = self.cursor
                        if _jmp == 0:
                            if (not self.in_grouping(Self.GR_g_v)):
                                _jmp = 2
                        if _jmp == 0:
                            self.slice_from_a("Y")
                        if _jmp == 0:
                            break
                        if _jmp != 0:
                            break
                if _jmp == 0:
                    self.cursor = v_3
                if _jmp == 0:
                    break
                if _jmp == 2:
                    _jmp = 0
                self.cursor = v_3
                if (self.cursor >= self.limit):
                    _jmp = 1
                if _jmp == 0:
                    self.cursor += 1
                if _jmp != 0:
                    break
            if _jmp == 0:
                continue
            if _jmp == 1:
                _jmp = 0
            self.cursor = v_2
            break
        self.cursor = v_1
        while True:
            v_5 = self.cursor
            self.bra = self.cursor
            among_var = self.find_among(Self.TB_a_0)
            self.ket = self.cursor
            if (among_var == 1):
                self.slice_from_a("ss")
            elif (among_var == 2):
                self.slice_from("ä")
            elif (among_var == 3):
                self.slice_from("ö")
            elif (among_var == 4):
                self.slice_from("ü")
            elif (among_var == 5):
                if (self.cursor >= self.limit):
                    _jmp = 4
                if _jmp == 0:
                    self.cursor += 1
            if _jmp == 0:
                continue
            if _jmp == 4:
                _jmp = 0
            self.cursor = v_5
            break
        return True
    def r_mark_regions(mut self) -> Bool:
        var I_x: Int = 0
        var v_1: Int = 0
        var _jmp: Int = 0
        self.I_p1 = self.limit
        self.I_p2 = self.limit
        v_1 = self.cursor
        if ((self.cursor + 3) > self.limit):
            return False
        self.cursor += 3
        I_x = self.cursor
        self.cursor = v_1
        if (not self.go_out_grouping(Self.GR_g_v)):
            return False
        self.cursor += 1
        if (not self.go_in_grouping(Self.GR_g_v)):
            return False
        self.cursor += 1
        self.I_p1 = self.cursor
        if (self.I_p1 >= I_x):
            _jmp = 1
        if _jmp == 0:
            self.I_p1 = I_x
        if _jmp == 1:
            _jmp = 0
        if (not self.go_out_grouping(Self.GR_g_v)):
            return False
        self.cursor += 1
        if (not self.go_in_grouping(Self.GR_g_v)):
            return False
        self.cursor += 1
        self.I_p2 = self.cursor
        return True
    def r_postlude(mut self) -> Bool:
        var among_var: Int = 0
        var v_1: Int = 0
        var _jmp: Int = 0
        while True:
            v_1 = self.cursor
            self.bra = self.cursor
            among_var = self.find_among(Self.TB_a_1)
            self.ket = self.cursor
            if (among_var == 1):
                self.slice_from_a("y")
            elif (among_var == 2):
                self.slice_from_a("u")
            elif (among_var == 3):
                self.slice_from_a("a")
            elif (among_var == 4):
                self.slice_from_a("o")
            else:
                if (self.cursor >= self.limit):
                    _jmp = 1
                if _jmp == 0:
                    self.cursor += 1
            if _jmp == 0:
                continue
            if _jmp == 1:
                _jmp = 0
            self.cursor = v_1
            break
        return True
    def r_R1(mut self) -> Bool:
        return (self.I_p1 <= self.cursor)
    def r_R2(mut self) -> Bool:
        return (self.I_p2 <= self.cursor)
    def r_standard_suffix(mut self) -> Bool:
        var among_var: Int = 0
        var v_1: Int = 0
        var v_10: Int = 0
        var v_2: Int = 0
        var v_3: Int = 0
        var v_4: Int = 0
        var v_5: Int = 0
        var v_6: Int = 0
        var v_7: Int = 0
        var v_8: Int = 0
        var v_9: Int = 0
        var _jmp: Int = 0
        v_1 = (self.limit - self.cursor)
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_2)
        if (among_var == 0):
            _jmp = 1
        if _jmp == 0:
            self.bra = self.cursor
        if _jmp == 0:
            if (not self.r_R1()):
                _jmp = 1
        if _jmp == 0:
            if (among_var == 1):
                if (not self.eq_s_b_a("syst")):
                    _jmp = 2
                if _jmp == 0:
                    _jmp = 1
                if _jmp == 2:
                    _jmp = 0
                if _jmp == 0:
                    self.slice_del()
            elif (among_var == 2):
                self.slice_del()
            elif (among_var == 3):
                self.slice_del()
                v_2 = (self.limit - self.cursor)
                self.ket = self.cursor
                if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 115)):
                    self.cursor = (self.limit - v_2)
                    _jmp = 3
                if _jmp == 0:
                    self.cursor -= 1
                if _jmp == 0:
                    self.bra = self.cursor
                if _jmp == 0:
                    if (not self.eq_s_b_a("nis")):
                        self.cursor = (self.limit - v_2)
                        _jmp = 3
                if _jmp == 0:
                    self.slice_del()
                if _jmp == 3:
                    _jmp = 0
            elif (among_var == 4):
                if (not self.in_grouping_b(Self.GR_g_s_ending)):
                    _jmp = 1
                if _jmp == 0:
                    self.slice_del()
            else:
                self.slice_from_a("l")
        if _jmp == 1:
            _jmp = 0
        self.cursor = (self.limit - v_1)
        v_3 = (self.limit - self.cursor)
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_4)
        if (among_var == 0):
            _jmp = 4
        if _jmp == 0:
            self.bra = self.cursor
        if _jmp == 0:
            if (not self.r_R1()):
                _jmp = 4
        if _jmp == 0:
            if (among_var == 1):
                self.slice_del()
            elif (among_var == 2):
                if (not self.in_grouping_b(Self.GR_g_st_ending)):
                    _jmp = 4
                if _jmp == 0:
                    if ((self.cursor - 3) < self.limit_backward):
                        _jmp = 4
                if _jmp == 0:
                    self.cursor -= 3
                if _jmp == 0:
                    self.slice_del()
            else:
                v_4 = (self.limit - self.cursor)
                if (not self.in_grouping_b(Self.GR_g_et_ending)):
                    _jmp = 4
                if _jmp == 0:
                    self.cursor = (self.limit - v_4)
                if _jmp == 0:
                    v_5 = (self.limit - self.cursor)
                if _jmp == 0:
                    if (self.find_among_b(Self.TB_a_3) == 0):
                        _jmp = 5
                    if _jmp == 0:
                        _jmp = 4
                    if _jmp == 5:
                        _jmp = 0
                if _jmp == 0:
                    self.cursor = (self.limit - v_5)
                if _jmp == 0:
                    self.slice_del()
        if _jmp == 4:
            _jmp = 0
        self.cursor = (self.limit - v_3)
        v_6 = (self.limit - self.cursor)
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_6)
        if (among_var == 0):
            _jmp = 6
        if _jmp == 0:
            self.bra = self.cursor
        if _jmp == 0:
            if (not self.r_R2()):
                _jmp = 6
        if _jmp == 0:
            if (among_var == 1):
                self.slice_del()
                v_7 = (self.limit - self.cursor)
                self.ket = self.cursor
                if (not self.eq_s_b_a("ig")):
                    self.cursor = (self.limit - v_7)
                    _jmp = 7
                if _jmp == 0:
                    self.bra = self.cursor
                if _jmp == 0:
                    if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 101)):
                        _jmp = 8
                    if _jmp == 0:
                        self.cursor -= 1
                    if _jmp == 0:
                        self.cursor = (self.limit - v_7)
                    if _jmp == 0:
                        _jmp = 7
                    if _jmp == 8:
                        _jmp = 0
                if _jmp == 0:
                    if (not self.r_R2()):
                        self.cursor = (self.limit - v_7)
                        _jmp = 7
                if _jmp == 0:
                    self.slice_del()
                if _jmp == 7:
                    _jmp = 0
            elif (among_var == 2):
                if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 101)):
                    _jmp = 9
                if _jmp == 0:
                    self.cursor -= 1
                if _jmp == 0:
                    _jmp = 6
                if _jmp == 9:
                    _jmp = 0
                if _jmp == 0:
                    self.slice_del()
            elif (among_var == 3):
                self.slice_del()
                v_8 = (self.limit - self.cursor)
                self.ket = self.cursor
                while True:
                    if (not self.eq_s_b_a("er")):
                        _jmp = 11
                    if _jmp == 0:
                        break
                    if _jmp == 11:
                        _jmp = 0
                    if (not self.eq_s_b_a("en")):
                        self.cursor = (self.limit - v_8)
                        _jmp = 10
                    if _jmp == 0:
                        break
                    if _jmp != 0:
                        break
                if _jmp == 0:
                    self.bra = self.cursor
                if _jmp == 0:
                    if (not self.r_R1()):
                        self.cursor = (self.limit - v_8)
                        _jmp = 10
                if _jmp == 0:
                    self.slice_del()
                if _jmp == 10:
                    _jmp = 0
            else:
                self.slice_del()
                v_9 = (self.limit - self.cursor)
                self.ket = self.cursor
                if (self.find_among_b(Self.TB_a_5) == 0):
                    self.cursor = (self.limit - v_9)
                    _jmp = 12
                if _jmp == 0:
                    self.bra = self.cursor
                if _jmp == 0:
                    if (not self.r_R2()):
                        self.cursor = (self.limit - v_9)
                        _jmp = 12
                if _jmp == 0:
                    self.slice_del()
                if _jmp == 12:
                    _jmp = 0
        if _jmp == 6:
            _jmp = 0
        self.cursor = (self.limit - v_6)
        v_10 = (self.limit - self.cursor)
        self.ket = self.cursor
        if (self.find_among_b(Self.TB_a_7) == 0):
            _jmp = 13
        if _jmp == 0:
            self.bra = self.cursor
        if _jmp == 0:
            if (self.cursor <= self.limit_backward):
                _jmp = 13
        if _jmp == 0:
            self.cursor -= 1
        if _jmp == 0:
            if (self.cursor <= self.limit_backward):
                _jmp = 13
        if _jmp == 0:
            self.slice_del()
        if _jmp == 13:
            _jmp = 0
        self.cursor = (self.limit - v_10)
        return True
    def stem_impl(mut self) -> Bool:
        var v_1: Int = 0
        var v_2: Int = 0
        var v_3: Int = 0
        v_1 = self.cursor
        _ = self.r_prelude()
        self.cursor = v_1
        v_2 = self.cursor
        _ = self.r_mark_regions()
        self.cursor = v_2
        self.limit_backward = self.cursor
        self.cursor = self.limit
        _ = self.r_standard_suffix()
        self.cursor = self.limit_backward
        v_3 = self.cursor
        _ = self.r_postlude()
        self.cursor = v_3
        return True

    def run(
        mut self,
        n: Int,
        src: Pointer[UInt32, MutAnyOrigin],
        lens: Pointer[UInt32, MutAnyOrigin],
        dst: Pointer[UInt32, MutAnyOrigin],
        cap: Int,
    ) raises -> Int:
        """Stem n words. Input lengths are overwritten with output lengths."""
        var pos = 0
        var out = 0
        for i in range(n):
            var length = Int(lens[unsafe_offset=i])
            self.current.clear()
            for j in range(length):
                self.current.append(src[unsafe_offset=pos + j])
            pos += length
            self.cursor = 0
            self.limit = length
            self.limit_backward = 0
            self.bra = 0
            self.ket = length
            _ = self.stem_impl()
            var ol = len(self.current)
            if out + ol > cap:
                raise Error("msnowball: output buffer too small")
            for j in range(ol):
                dst[unsafe_offset=out + j] = self.current[j]
            out += ol
            lens[unsafe_offset=i] = UInt32(ol)
        return out


def new_german() raises -> PythonObject:
    """Allocate and initialise a GermanStemmer on the heap; return its address."""
    var a = alloc(Layout[GermanStemmer](count=1))
    var p = a^.unsafe_leak()
    p.unsafe_write(GermanStemmer())
    return PythonObject(Int(p))


def stem_german(
    handle: PythonObject,
    n: PythonObject,
    src: PythonObject,
    lens: PythonObject,
    dst: PythonObject,
    cap: PythonObject,
) raises -> PythonObject:
    var st = Pointer[GermanStemmer, MutAnyOrigin](unsafe_from_address=Int(py=handle))
    var src_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=src))
    var lens_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=lens))
    var dst_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=dst))
    return PythonObject(st[].run(Int(py=n), src_p, lens_p, dst_p, Int(py=cap)))


struct HungarianStemmer(Movable):
    var current: List[UInt32]
    var cursor: Int
    var limit: Int
    var limit_backward: Int
    var bra: Int
    var ket: Int
    var grp_mask: List[UInt32]
    var pool: List[UInt32]
    var ent_off: List[Int]
    var ent_len: List[Int]
    var ent_sub: List[Int]
    var ent_res: List[Int]
    var n_groups: Int
    var tab_base: List[Int]
    var tab_size: List[Int]
    var I_p1: Int
    var ST_as_0: List[StaticString]
    var ST_as_4: List[StaticString]
    var ST_as_5: List[StaticString]
    var ST_as_7: List[StaticString]
    var ST_as_8: List[StaticString]
    var ST_as_9: List[StaticString]
    var ST_as_10: List[StaticString]
    comptime GR_g_v = 0
    comptime TB_a_0 = 0
    comptime TB_a_1 = 1
    comptime TB_a_2 = 2
    comptime TB_a_3 = 3
    comptime TB_a_4 = 4
    comptime TB_a_5 = 5
    comptime TB_a_6 = 6
    comptime TB_a_7 = 7
    comptime TB_a_8 = 8
    comptime TB_a_9 = 9
    comptime TB_a_10 = 10

    def __init__(out self):
        self.current = List[UInt32]()
        self.cursor = 0
        self.limit = 0
        self.limit_backward = 0
        self.bra = 0
        self.ket = 0
        self.grp_mask = List[UInt32]()
        self.pool = List[UInt32]()
        self.ent_off = List[Int]()
        self.ent_len = List[Int]()
        self.ent_sub = List[Int]()
        self.ent_res = List[Int]()
        self.tab_base = List[Int]()
        self.tab_size = List[Int]()
        self.n_groups = 0
        self.ST_as_0 = List[StaticString]()
        self.ST_as_4 = List[StaticString]()
        self.ST_as_5 = List[StaticString]()
        self.ST_as_7 = List[StaticString]()
        self.ST_as_8 = List[StaticString]()
        self.ST_as_9 = List[StaticString]()
        self.ST_as_10 = List[StaticString]()
        self.I_p1 = 0
        self.add_group("aeiouáéíóöúüőű")
        self.begin_table()
        self.add_entry("á", -1, 1)
        self.add_entry("é", -1, 2)
        self.begin_table()
        self.add_entry("bb", -1, -1)
        self.add_entry("cc", -1, -1)
        self.add_entry("dd", -1, -1)
        self.add_entry("ff", -1, -1)
        self.add_entry("gg", -1, -1)
        self.add_entry("jj", -1, -1)
        self.add_entry("kk", -1, -1)
        self.add_entry("ll", -1, -1)
        self.add_entry("mm", -1, -1)
        self.add_entry("nn", -1, -1)
        self.add_entry("pp", -1, -1)
        self.add_entry("rr", -1, -1)
        self.add_entry("ccs", -1, -1)
        self.add_entry("ss", -1, -1)
        self.add_entry("zzs", -1, -1)
        self.add_entry("tt", -1, -1)
        self.add_entry("vv", -1, -1)
        self.add_entry("ggy", -1, -1)
        self.add_entry("lly", -1, -1)
        self.add_entry("nny", -1, -1)
        self.add_entry("tty", -1, -1)
        self.add_entry("ssz", -1, -1)
        self.add_entry("zz", -1, -1)
        self.begin_table()
        self.add_entry("al", -1, 1)
        self.add_entry("el", -1, 1)
        self.begin_table()
        self.add_entry("ba", -1, -1)
        self.add_entry("ra", -1, -1)
        self.add_entry("be", -1, -1)
        self.add_entry("re", -1, -1)
        self.add_entry("ig", -1, -1)
        self.add_entry("nak", -1, -1)
        self.add_entry("nek", -1, -1)
        self.add_entry("val", -1, -1)
        self.add_entry("vel", -1, -1)
        self.add_entry("ul", -1, -1)

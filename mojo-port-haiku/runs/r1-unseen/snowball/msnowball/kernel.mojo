                    _jmp = 1
            if _jmp == 0:
                self.cursor += 1
            if _jmp == 0:
                break
            if _jmp != 0:
                break
        if _jmp == 0:
            self.I_pV = self.cursor
        if _jmp == 1:
            _jmp = 0
        self.cursor = v_1
        v_3 = self.cursor
        if (not self.go_out_grouping(Self.GR_g_v)):
            _jmp = 4
        if _jmp == 0:

        self.add_entry("aré", -1, 1)
        self.add_entry("eré", -1, 1)
        self.add_entry("iré", -1, 1)
        self.add_entry("í", -1, 1)
        self.add_entry("iï", -1, 1)
        self.add_entry("ió", -1, 1)
        self.begin_table()
        self.add_entry("a", -1, 1)
        self.add_entry("e", -1, 1)
        self.add_entry("i", -1, 1)
        self.add_entry("ïn", -1, 1)
        self.add_entry("o", -1, 1)
        self.add_entry("ir", -1, 1)
        self.add_entry("s", -1, 1)
        self.add_entry("is", 6, 1)
        self.add_entry("os", 6, 1)
        self.add_entry("ïs", 6, 1)
        self.add_entry("it", -1, 1)
        self.add_entry("eu", -1, 1)
        self.add_entry("iu", -1, 1)
        self.add_entry("iqu", -1, 2)
        self.add_entry("itz", -1, 1)
        self.add_entry("à", -1, 1)
        self.add_entry("á", -1, 1)
        self.add_entry("é", -1, 1)
        self.add_entry("ì", -1, 1)
        self.add_entry("í", -1, 1)
        self.add_entry("ï", -1, 1)
        self.add_entry("ó", -1, 1)

    # ---- BaseStemmer runtime (snowballstemmer/basestemmer.py), code-point based

    def in_grouping(mut self, g: Int) -> Bool:
        if self.cursor >= self.limit:
            return False
        if not self.has(g, self.current[self.cursor]):
            return False
        self.cursor += 1
        return True

    def in_grouping_b(mut self, g: Int) -> Bool:
        if self.cursor <= self.limit_backward:
            return False
        if not self.has(g, self.current[self.cursor - 1]):
            return False
        self.cursor -= 1
        return True

    def go_in_grouping(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor < self.limit:
            if not self.has(g, cur[unsafe_offset=self.cursor]):
                return True
            self.cursor += 1
        return False

    def go_in_grouping_b(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor > self.limit_backward:
            if not self.has(g, cur[unsafe_offset=self.cursor - 1]):
                return True
            self.cursor -= 1
        return False

    def out_grouping(mut self, g: Int) -> Bool:
        if self.cursor >= self.limit:
            return False
        if not self.has(g, self.current[self.cursor]):
            self.cursor += 1
            return True
        return False

    def go_out_grouping(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor < self.limit:
            if self.has(g, cur[unsafe_offset=self.cursor]):
                return True
            self.cursor += 1
        return False

    def out_grouping_b(mut self, g: Int) -> Bool:
        if self.cursor <= self.limit_backward:
            return False
        if not self.has(g, self.current[self.cursor - 1]):
            self.cursor -= 1
            return True
        return False

    def go_out_grouping_b(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor > self.limit_backward:
            if self.has(g, cur[unsafe_offset=self.cursor - 1]):
                return True
            self.cursor -= 1
        return False

    def eq_s(mut self, s: StaticString) -> Bool:
        var n = s.count_codepoints()
        if self.cursor + n > self.limit:
            return False
        var j = self.cursor
        for cp in s.codepoints():
            if self.current[j] != UInt32(Int(cp)):
                return False
            j += 1
        self.cursor += n
        return True

    def eq_s_b(mut self, s: StaticString) -> Bool:
        var n = s.count_codepoints()
        if self.cursor - n < self.limit_backward:
            return False
        var j = self.cursor - n
        for cp in s.codepoints():
            if self.current[j] != UInt32(Int(cp)):
                return False
            j += 1
        self.cursor -= n
        return True

    def find_among(mut self, t: Int) -> Int:
        var cur = self.current.unsafe_ptr()
        var pool = self.pool.unsafe_ptr()
        var elen = self.ent_len.unsafe_ptr()
        var eoff = self.ent_off.unsafe_ptr()
        var esub = self.ent_sub.unsafe_ptr()
        var eres = self.ent_res.unsafe_ptr()
        var base = self.tab_base[t]
        var i = 0
        var j = self.tab_size[t]
        var c = self.cursor
        var l = self.limit
        var common_i = 0
        var common_j = 0
        var first_key_inspected = False
        while True:
            var k = i + ((j - i) >> 1)
            var diff = 0
            var common = min(common_i, common_j)
            var wl = elen[unsafe_offset=base + k]
            var wo = eoff[unsafe_offset=base + k]
            for i2 in range(common, wl):
                if c + common == l:
                    diff = -1
                    break
                diff = Int(cur[unsafe_offset=c + common]) - Int(pool[unsafe_offset=wo + i2])
                if diff != 0:
                    break
                common += 1
            if diff < 0:
                j = k
                common_j = common
            else:
                i = k
                common_i = common
            if j - i <= 1:
                if i > 0:
                    break
                if j == i:
                    break
                if first_key_inspected:
                    break
                first_key_inspected = True
        while True:
            var wl = elen[unsafe_offset=base + i]
            if common_i >= wl:
                self.cursor = c + wl
                return eres[unsafe_offset=base + i]
            i = esub[unsafe_offset=base + i]
            if i < 0:
                return 0

    def find_among_b(mut self, t: Int) -> Int:
        var cur = self.current.unsafe_ptr()
        var pool = self.pool.unsafe_ptr()
        var elen = self.ent_len.unsafe_ptr()
        var eoff = self.ent_off.unsafe_ptr()
        var esub = self.ent_sub.unsafe_ptr()
        var eres = self.ent_res.unsafe_ptr()
        var base = self.tab_base[t]
        var i = 0
        var j = self.tab_size[t]
        var c = self.cursor
        var lb = self.limit_backward
        var common_i = 0
        var common_j = 0
        var first_key_inspected = False
        while True:
            var k = i + ((j - i) >> 1)
            var diff = 0
            var common = min(common_i, common_j)
            var wl = elen[unsafe_offset=base + k]
            var wo = eoff[unsafe_offset=base + k]
            for i2 in range(wl - 1 - common, -1, -1):
                if c - common == lb:
                    diff = -1
                    break
                diff = Int(cur[unsafe_offset=c - 1 - common]) - Int(pool[unsafe_offset=wo + i2])
                if diff != 0:
                    break
                common += 1
            if diff < 0:
                j = k
                common_j = common
            else:
                i = k
                common_i = common
            if j - i <= 1:
                if i > 0:
                    break
                if j == i:
                    break
                if first_key_inspected:
                    break
                first_key_inspected = True
        while True:
            var wl = elen[unsafe_offset=base + i]
            if common_i >= wl:
                self.cursor = c - wl
                return eres[unsafe_offset=base + i]
            i = esub[unsafe_offset=base + i]
            if i < 0:
                return 0

    def has(self, g: Int, cp: UInt32) -> Bool:
        var i = Int(cp)
        if i >= len(self.grp_mask):
            return False
        return ((self.grp_mask[i] >> UInt32(g)) & 1) == 1

    def add_group(mut self, s: StaticString):
        """Group g is bit g of grp_mask[cp]; the group index is the call order."""
        var cps = to_cps(s)
        var g = self.n_groups
        self.n_groups += 1
        var mx = 0
        for c in cps:
            if Int(c) > mx:
                mx = Int(c)
        while len(self.grp_mask) <= mx:
            self.grp_mask.append(0)
        for c in cps:
            self.grp_mask[Int(c)] = self.grp_mask[Int(c)] | (UInt32(1) << UInt32(g))

    def begin_table(mut self):
        self.tab_base.append(len(self.ent_off))
        self.tab_size.append(0)

    def add_entry(mut self, s: StaticString, sub: Int, res: Int):
        var cps = to_cps(s)
        self.ent_off.append(len(self.pool))
        self.ent_len.append(len(cps))
        for c in cps:
            self.pool.append(c)
        self.ent_sub.append(sub)
        self.ent_res.append(res)
        self.tab_size[len(self.tab_size) - 1] += 1

    def eq_s_a(mut self, s: StaticString) -> Bool:
        var n = s.byte_length()
        if self.cursor + n > self.limit:
            return False
        var j = self.cursor
        for b in s.as_bytes():
            if self.current[j] != UInt32(b):
                return False
            j += 1
        self.cursor += n
        return True

    def eq_s_b_a(mut self, s: StaticString) -> Bool:
        var n = s.byte_length()
        if self.cursor - n < self.limit_backward:
            return False
        var j = self.cursor - n
        for b in s.as_bytes():
            if self.current[j] != UInt32(b):
                return False
            j += 1
        self.cursor -= n
        return True

    def slice_from_a(mut self, s: StaticString):
        var bra = self.bra
        var ket = self.ket
        var n = s.byte_length()
        self.adjust_region(bra, ket, n - (ket - bra))
        var j = bra
        for b in s.as_bytes():
            self.current[j] = UInt32(b)
            j += 1
        self.ket = bra + n

    def adjust_region(mut self, c_bra: Int, c_ket: Int, adj: Int):
        """Resize the buffer by adj at [c_bra, c_ket); the tail moves with it."""
        var old_len = len(self.current)
        if adj > 0:
            for _ in range(adj):
                self.current.append(0)
            var j = old_len - 1
            while j >= c_ket:
                self.current[j + adj] = self.current[j]
                j -= 1
        elif adj < 0:
            for j in range(c_ket, old_len):
                self.current[j + adj] = self.current[j]
            self.current.shrink(old_len + adj)
        self.limit += adj
        if self.cursor >= c_ket:
            self.cursor += adj
        elif self.cursor > c_bra:
            self.cursor = c_bra

    def slice_from(mut self, s: StaticString):
        var bra = self.bra
        var ket = self.ket
        var n = s.count_codepoints()
        self.adjust_region(bra, ket, n - (ket - bra))
        var j = bra
        for cp in s.codepoints():
            self.current[j] = UInt32(Int(cp))
            j += 1
        self.ket = bra + n

    def slice_del(mut self):
        self.adjust_region(self.bra, self.ket, self.bra - self.ket)
        self.ket = self.bra

    def r_mark_regions(mut self) -> Bool:
        var v_1: Int = 0
        var _jmp: Int = 0
        self.I_p1 = self.limit
        self.I_p2 = self.limit
        v_1 = self.cursor
        if (not self.go_out_grouping(Self.GR_g_v)):
            _jmp = 1
        if _jmp == 0:
            self.cursor += 1
        if _jmp == 0:
            if (not self.go_in_grouping(Self.GR_g_v)):
                _jmp = 1
        if _jmp == 0:
            self.cursor += 1
        if _jmp == 0:
            self.I_p1 = self.cursor
        if _jmp == 0:
            if (not self.go_out_grouping(Self.GR_g_v)):
                _jmp = 1
        if _jmp == 0:
            self.cursor += 1
        if _jmp == 0:
            if (not self.go_in_grouping(Self.GR_g_v)):
                _jmp = 1
        if _jmp == 0:
            self.cursor += 1
        if _jmp == 0:
            self.I_p2 = self.cursor
        if _jmp == 1:
            _jmp = 0
        self.cursor = v_1
        return True
    def r_cleaning(mut self) -> Bool:
        var among_var: Int = 0
        var v_1: Int = 0
        var _jmp: Int = 0
        while True:
            v_1 = self.cursor
            self.bra = self.cursor
            among_var = self.find_among(Self.TB_a_0)
            self.ket = self.cursor
            if (among_var == 1):
                self.slice_from_a("a")
            elif (among_var == 2):
                self.slice_from_a("e")
            elif (among_var == 3):
                self.slice_from_a("i")
            elif (among_var == 4):
                self.slice_from_a("o")
            elif (among_var == 5):
                self.slice_from_a("u")
            elif (among_var == 6):
                self.slice_from_a(".")
            else:
                if (self.cursor >= self.limit):
                    _jmp = 1
                if _jmp == 0:
                    self.cursor += 1
            if _jmp == 0:
                continue
            if _jmp == 1:
                _jmp = 0
            self.cursor = v_1
            break
        return True
    def r_R1(mut self) -> Bool:
        return (self.I_p1 <= self.cursor)
    def r_R2(mut self) -> Bool:
        return (self.I_p2 <= self.cursor)
    def r_attached_pronoun(mut self) -> Bool:
        self.ket = self.cursor
        if (self.find_among_b(Self.TB_a_1) == 0):
            return False
        self.bra = self.cursor
        if (not self.r_R1()):
            return False
        self.slice_del()
        return True
    def r_standard_suffix(mut self) -> Bool:
        var among_var: Int = 0
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_2)
        if (among_var == 0):
            return False
        self.bra = self.cursor
        if (among_var == 1):
            if (not self.r_R1()):
                return False
            self.slice_del()
        elif (among_var == 2):
            if (not self.r_R2()):
                return False
            self.slice_del()
        elif (among_var == 3):
            if (not self.r_R2()):
                return False
            self.slice_from_a("log")
        elif (among_var == 4):
            if (not self.r_R2()):
                return False
            self.slice_from_a("ic")
        else:
            if (not self.r_R1()):
                return False
            self.slice_from_a("c")
        return True
    def r_verb_suffix(mut self) -> Bool:
        var among_var: Int = 0
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_3)
        if (among_var == 0):
            return False
        self.bra = self.cursor
        if (among_var == 1):
            if (not self.r_R1()):
                return False
            self.slice_del()
        else:
            if (not self.r_R2()):
                return False
            self.slice_del()
        return True
    def r_residual_suffix(mut self) -> Bool:
        var among_var: Int = 0
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_4)
        if (among_var == 0):
            return False
        self.bra = self.cursor
        if (among_var == 1):
            if (not self.r_R1()):
                return False
            self.slice_del()
        else:
            if (not self.r_R1()):
                return False
            self.slice_from_a("ic")
        return True
    def stem_impl(mut self) -> Bool:
        var v_1: Int = 0
        var v_2: Int = 0
        var v_3: Int = 0
        var v_4: Int = 0
        var v_5: Int = 0
        var _jmp: Int = 0
        _ = self.r_mark_regions()
        self.limit_backward = self.cursor
        self.cursor = self.limit
        v_1 = (self.limit - self.cursor)
        _ = self.r_attached_pronoun()
        self.cursor = (self.limit - v_1)
        v_2 = (self.limit - self.cursor)
        while True:
            v_3 = (self.limit - self.cursor)
            if (not self.r_standard_suffix()):
                _jmp = 2
            if _jmp == 0:
                break
            if _jmp == 2:
                _jmp = 0
            self.cursor = (self.limit - v_3)
            if (not self.r_verb_suffix()):
                _jmp = 1
            if _jmp == 0:
                break
            if _jmp != 0:
                break
        if _jmp == 1:
            _jmp = 0
        self.cursor = (self.limit - v_2)
        v_4 = (self.limit - self.cursor)
        _ = self.r_residual_suffix()
        self.cursor = (self.limit - v_4)
        self.cursor = self.limit_backward
        v_5 = self.cursor
        _ = self.r_cleaning()
        self.cursor = v_5
        return True

    def run(
        mut self,
        n: Int,
        src: Pointer[UInt32, MutAnyOrigin],
        lens: Pointer[UInt32, MutAnyOrigin],
        dst: Pointer[UInt32, MutAnyOrigin],
        cap: Int,
    ) raises -> Int:
        """Stem n words. Input lengths are overwritten with output lengths."""
        var pos = 0
        var out = 0
        for i in range(n):
            var length = Int(lens[unsafe_offset=i])
            self.current.clear()
            for j in range(length):
                self.current.append(src[unsafe_offset=pos + j])
            pos += length
            self.cursor = 0
            self.limit = length
            self.limit_backward = 0
            self.bra = 0
            self.ket = length
            _ = self.stem_impl()
            var ol = len(self.current)
            if out + ol > cap:
                raise Error("msnowball: output buffer too small")
            for j in range(ol):
                dst[unsafe_offset=out + j] = self.current[j]
            out += ol
            lens[unsafe_offset=i] = UInt32(ol)
        return out


def new_catalan() raises -> PythonObject:
    """Allocate and initialise a CatalanStemmer on the heap; return its address."""
    var a = alloc(Layout[CatalanStemmer](count=1))
    var p = a^.unsafe_leak()
    p.unsafe_write(CatalanStemmer())
    return PythonObject(Int(p))


def stem_catalan(
    handle: PythonObject,
    n: PythonObject,
    src: PythonObject,
    lens: PythonObject,
    dst: PythonObject,
    cap: PythonObject,
) raises -> PythonObject:
    var st = Pointer[CatalanStemmer, MutAnyOrigin](unsafe_from_address=Int(py=handle))
    var src_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=src))
    var lens_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=lens))
    var dst_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=dst))
    return PythonObject(st[].run(Int(py=n), src_p, lens_p, dst_p, Int(py=cap)))


struct DutchPorterStemmer(Movable):
    var current: List[UInt32]
    var cursor: Int
    var limit: Int
    var limit_backward: Int
    var bra: Int
    var ket: Int
    var grp_mask: List[UInt32]
    var pool: List[UInt32]
    var ent_off: List[Int]
    var ent_len: List[Int]
    var ent_sub: List[Int]
    var ent_res: List[Int]
    var n_groups: Int
    var tab_base: List[Int]
    var tab_size: List[Int]
    var I_p2: Int
    var I_p1: Int
    var B_e_found: Bool
    comptime GR_g_v = 0
    comptime GR_g_v_I = 1
    comptime GR_g_v_j = 2
    comptime TB_a_0 = 0
    comptime TB_a_1 = 1
    comptime TB_a_2 = 2
    comptime TB_a_3 = 3
    comptime TB_a_4 = 4
    comptime TB_a_5 = 5

    def __init__(out self):
        self.current = List[UInt32]()
        self.cursor = 0
        self.limit = 0
        self.limit_backward = 0
        self.bra = 0
        self.ket = 0
        self.grp_mask = List[UInt32]()
        self.pool = List[UInt32]()
        self.ent_off = List[Int]()
        self.ent_len = List[Int]()
        self.ent_sub = List[Int]()
        self.ent_res = List[Int]()
        self.tab_base = List[Int]()
        self.tab_size = List[Int]()
        self.n_groups = 0
        self.I_p2 = 0
        self.I_p1 = 0
        self.B_e_found = False
        self.add_group("aeiouyè")
        self.add_group("Iaeiouyè")
        self.add_group("aeijouyè")
        self.begin_table()
        self.add_entry("", -1, 6)
        self.add_entry("á", 0, 1)
        self.add_entry("ä", 0, 1)
        self.add_entry("é", 0, 2)
        self.add_entry("ë", 0, 2)
        self.add_entry("í", 0, 3)
        self.add_entry("ï", 0, 3)
        self.add_entry("ó", 0, 4)
        self.add_entry("ö", 0, 4)
        self.add_entry("ú", 0, 5)
        self.add_entry("ü", 0, 5)
        self.begin_table()
        self.add_entry("", -1, 3)
        self.add_entry("I", 0, 2)
        self.add_entry("Y", 0, 1)
        self.begin_table()
        self.add_entry("dd", -1, -1)
        self.add_entry("kk", -1, -1)
        self.add_entry("tt", -1, -1)
        self.begin_table()
        self.add_entry("ene", -1, 2)
        self.add_entry("se", -1, 3)
        self.add_entry("en", -1, 2)
        self.add_entry("heden", 2, 1)
        self.add_entry("s", -1, 3)
        self.begin_table()
        self.add_entry("end", -1, 1)
        self.add_entry("ig", -1, 2)
        self.add_entry("ing", -1, 1)
        self.add_entry("lijk", -1, 3)
        self.add_entry("baar", -1, 4)
        self.add_entry("bar", -1, 5)
        self.begin_table()
        self.add_entry("aa", -1, -1)
        self.add_entry("ee", -1, -1)
        self.add_entry("oo", -1, -1)
        self.add_entry("uu", -1, -1)

    # ---- BaseStemmer runtime (snowballstemmer/basestemmer.py), code-point based

    def in_grouping(mut self, g: Int) -> Bool:
        if self.cursor >= self.limit:
            return False
        if not self.has(g, self.current[self.cursor]):
            return False
        self.cursor += 1
        return True

    def in_grouping_b(mut self, g: Int) -> Bool:
        if self.cursor <= self.limit_backward:
            return False
        if not self.has(g, self.current[self.cursor - 1]):
            return False
        self.cursor -= 1
        return True

    def go_in_grouping(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor < self.limit:
            if not self.has(g, cur[unsafe_offset=self.cursor]):
                return True
            self.cursor += 1
        return False

    def go_in_grouping_b(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor > self.limit_backward:
            if not self.has(g, cur[unsafe_offset=self.cursor - 1]):
                return True
            self.cursor -= 1
        return False

    def out_grouping(mut self, g: Int) -> Bool:
        if self.cursor >= self.limit:
            return False
        if not self.has(g, self.current[self.cursor]):
            self.cursor += 1
            return True
        return False

    def go_out_grouping(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor < self.limit:
            if self.has(g, cur[unsafe_offset=self.cursor]):
                return True
            self.cursor += 1
        return False

    def out_grouping_b(mut self, g: Int) -> Bool:
        if self.cursor <= self.limit_backward:
            return False
        if not self.has(g, self.current[self.cursor - 1]):
            self.cursor -= 1
            return True
        return False

    def go_out_grouping_b(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor > self.limit_backward:
            if self.has(g, cur[unsafe_offset=self.cursor - 1]):
                return True
            self.cursor -= 1
        return False

    def eq_s(mut self, s: StaticString) -> Bool:
        var n = s.count_codepoints()
        if self.cursor + n > self.limit:
            return False
        var j = self.cursor
        for cp in s.codepoints():
            if self.current[j] != UInt32(Int(cp)):
                return False
            j += 1
        self.cursor += n
        return True

    def eq_s_b(mut self, s: StaticString) -> Bool:
        var n = s.count_codepoints()
        if self.cursor - n < self.limit_backward:
            return False
        var j = self.cursor - n
        for cp in s.codepoints():
            if self.current[j] != UInt32(Int(cp)):
                return False
            j += 1
        self.cursor -= n
        return True

    def find_among(mut self, t: Int) -> Int:
        var cur = self.current.unsafe_ptr()
        var pool = self.pool.unsafe_ptr()
        var elen = self.ent_len.unsafe_ptr()
        var eoff = self.ent_off.unsafe_ptr()
        var esub = self.ent_sub.unsafe_ptr()
        var eres = self.ent_res.unsafe_ptr()
        var base = self.tab_base[t]
        var i = 0
        var j = self.tab_size[t]
        var c = self.cursor
        var l = self.limit
        var common_i = 0
        var common_j = 0
        var first_key_inspected = False
        while True:
            var k = i + ((j - i) >> 1)
            var diff = 0
            var common = min(common_i, common_j)
            var wl = elen[unsafe_offset=base + k]
            var wo = eoff[unsafe_offset=base + k]
            for i2 in range(common, wl):
                if c + common == l:
                    diff = -1
                    break
                diff = Int(cur[unsafe_offset=c + common]) - Int(pool[unsafe_offset=wo + i2])
                if diff != 0:
                    break
                common += 1
            if diff < 0:
                j = k
                common_j = common
            else:
                i = k
                common_i = common
            if j - i <= 1:
                if i > 0:
                    break
                if j == i:
                    break
                if first_key_inspected:
                    break
                first_key_inspected = True
        while True:
            var wl = elen[unsafe_offset=base + i]
            if common_i >= wl:
                self.cursor = c + wl
                return eres[unsafe_offset=base + i]
            i = esub[unsafe_offset=base + i]
            if i < 0:
                return 0

    def find_among_b(mut self, t: Int) -> Int:
        var cur = self.current.unsafe_ptr()
        var pool = self.pool.unsafe_ptr()
        var elen = self.ent_len.unsafe_ptr()
        var eoff = self.ent_off.unsafe_ptr()
        var esub = self.ent_sub.unsafe_ptr()
        var eres = self.ent_res.unsafe_ptr()
        var base = self.tab_base[t]
        var i = 0
        var j = self.tab_size[t]
        var c = self.cursor
        var lb = self.limit_backward
        var common_i = 0
        var common_j = 0
        var first_key_inspected = False
        while True:
            var k = i + ((j - i) >> 1)
            var diff = 0
            var common = min(common_i, common_j)
            var wl = elen[unsafe_offset=base + k]
            var wo = eoff[unsafe_offset=base + k]
            for i2 in range(wl - 1 - common, -1, -1):
                if c - common == lb:
                    diff = -1
                    break
                diff = Int(cur[unsafe_offset=c - 1 - common]) - Int(pool[unsafe_offset=wo + i2])
                if diff != 0:
                    break
                common += 1
            if diff < 0:
                j = k
                common_j = common
            else:
                i = k
                common_i = common
            if j - i <= 1:
                if i > 0:
                    break
                if j == i:
                    break
                if first_key_inspected:
                    break
                first_key_inspected = True
        while True:
            var wl = elen[unsafe_offset=base + i]
            if common_i >= wl:
                self.cursor = c - wl
                return eres[unsafe_offset=base + i]
            i = esub[unsafe_offset=base + i]
            if i < 0:
                return 0

    def has(self, g: Int, cp: UInt32) -> Bool:
        var i = Int(cp)
        if i >= len(self.grp_mask):
            return False
        return ((self.grp_mask[i] >> UInt32(g)) & 1) == 1

    def add_group(mut self, s: StaticString):
        """Group g is bit g of grp_mask[cp]; the group index is the call order."""
        var cps = to_cps(s)
        var g = self.n_groups
        self.n_groups += 1
        var mx = 0
        for c in cps:
            if Int(c) > mx:
                mx = Int(c)
        while len(self.grp_mask) <= mx:
            self.grp_mask.append(0)
        for c in cps:
            self.grp_mask[Int(c)] = self.grp_mask[Int(c)] | (UInt32(1) << UInt32(g))

    def begin_table(mut self):
        self.tab_base.append(len(self.ent_off))
        self.tab_size.append(0)

    def add_entry(mut self, s: StaticString, sub: Int, res: Int):
        var cps = to_cps(s)
        self.ent_off.append(len(self.pool))
        self.ent_len.append(len(cps))
        for c in cps:
            self.pool.append(c)
        self.ent_sub.append(sub)
        self.ent_res.append(res)
        self.tab_size[len(self.tab_size) - 1] += 1

    def eq_s_a(mut self, s: StaticString) -> Bool:
        var n = s.byte_length()
        if self.cursor + n > self.limit:
            return False
        var j = self.cursor
        for b in s.as_bytes():
            if self.current[j] != UInt32(b):
                return False
            j += 1
        self.cursor += n
        return True

    def eq_s_b_a(mut self, s: StaticString) -> Bool:
        var n = s.byte_length()
        if self.cursor - n < self.limit_backward:
            return False
        var j = self.cursor - n
        for b in s.as_bytes():
            if self.current[j] != UInt32(b):
                return False
            j += 1
        self.cursor -= n
        return True

    def slice_from_a(mut self, s: StaticString):
        var bra = self.bra
        var ket = self.ket
        var n = s.byte_length()
        self.adjust_region(bra, ket, n - (ket - bra))
        var j = bra
        for b in s.as_bytes():
            self.current[j] = UInt32(b)
            j += 1
        self.ket = bra + n

    def adjust_region(mut self, c_bra: Int, c_ket: Int, adj: Int):
        """Resize the buffer by adj at [c_bra, c_ket); the tail moves with it."""
        var old_len = len(self.current)
        if adj > 0:
            for _ in range(adj):
                self.current.append(0)
            var j = old_len - 1
            while j >= c_ket:
                self.current[j + adj] = self.current[j]
                j -= 1
        elif adj < 0:
            for j in range(c_ket, old_len):
                self.current[j + adj] = self.current[j]
            self.current.shrink(old_len + adj)
        self.limit += adj
        if self.cursor >= c_ket:
            self.cursor += adj
        elif self.cursor > c_bra:
            self.cursor = c_bra

    def slice_from(mut self, s: StaticString):
        var bra = self.bra
        var ket = self.ket
        var n = s.count_codepoints()
        self.adjust_region(bra, ket, n - (ket - bra))
        var j = bra
        for cp in s.codepoints():
            self.current[j] = UInt32(Int(cp))
            j += 1
        self.ket = bra + n

    def slice_del(mut self):
        self.adjust_region(self.bra, self.ket, self.bra - self.ket)
        self.ket = self.bra

    def r_prelude(mut self) -> Bool:
        var among_var: Int = 0
        var v_1: Int = 0
        var v_2: Int = 0
        var v_3: Int = 0
        var v_4: Int = 0
        var v_5: Int = 0
        var v_6: Int = 0
        var v_7: Int = 0
        var _jmp: Int = 0
        v_1 = self.cursor
        while True:
            v_2 = self.cursor
            self.bra = self.cursor
            among_var = self.find_among(Self.TB_a_0)
            self.ket = self.cursor
            if (among_var == 1):
                self.slice_from_a("a")
            elif (among_var == 2):
                self.slice_from_a("e")
            elif (among_var == 3):
                self.slice_from_a("i")
            elif (among_var == 4):
                self.slice_from_a("o")
            elif (among_var == 5):
                self.slice_from_a("u")
            else:
                if (self.cursor >= self.limit):
                    _jmp = 1
                if _jmp == 0:
                    self.cursor += 1
            if _jmp == 0:
                continue
            if _jmp == 1:
                _jmp = 0
            self.cursor = v_2
            break
        self.cursor = v_1
        v_3 = self.cursor
        self.bra = self.cursor
        if ((self.cursor == self.limit) or (self.current[self.cursor] != 121)):
            self.cursor = v_3
            _jmp = 2
        if _jmp == 0:
            self.cursor += 1
        if _jmp == 0:
            self.ket = self.cursor
        if _jmp == 0:
            self.slice_from_a("Y")
        if _jmp == 2:
            _jmp = 0
        while True:
            v_4 = self.cursor
            if (not self.go_out_grouping(Self.GR_g_v)):
                _jmp = 3
            if _jmp == 0:
                self.cursor += 1
            if _jmp == 0:
                v_5 = self.cursor
            if _jmp == 0:
                self.bra = self.cursor
                while True:
                    v_6 = self.cursor
                    if ((self.cursor == self.limit) or (self.current[self.cursor] != 105)):
                        _jmp = 5
                    if _jmp == 0:
                        self.cursor += 1
                    if _jmp == 0:
                        self.ket = self.cursor
                    if _jmp == 0:
                        v_7 = self.cursor
                    if _jmp == 0:
                        if (not self.in_grouping(Self.GR_g_v)):
                            _jmp = 6
                        if _jmp == 0:
                            self.slice_from_a("I")
                        if _jmp == 6:
                            _jmp = 0
                    if _jmp == 0:
                        self.cursor = v_7
                    if _jmp == 0:
                        break
                    if _jmp == 5:
                        _jmp = 0
                    self.cursor = v_6
                    if ((self.cursor == self.limit) or (self.current[self.cursor] != 121)):
                        self.cursor = v_5
                        _jmp = 4
                    if _jmp == 0:
                        self.cursor += 1
                    if _jmp == 0:
                        self.ket = self.cursor
                    if _jmp == 0:
                        self.slice_from_a("Y")
                    if _jmp == 0:
                        break
                    if _jmp != 0:
                        break
                if _jmp == 4:
                    _jmp = 0
            if _jmp == 0:
                continue
            if _jmp == 3:
                _jmp = 0
            self.cursor = v_4
            break
        return True
    def r_mark_regions(mut self) -> Bool:
        var I_x: Int = 0
        var v_1: Int = 0
        var _jmp: Int = 0
        self.I_p1 = self.limit
        self.I_p2 = self.limit
        v_1 = self.cursor
        if ((self.cursor + 3) > self.limit):
            return False
        self.cursor += 3
        I_x = self.cursor
        self.cursor = v_1
        if (not self.go_out_grouping(Self.GR_g_v)):
            return False
        self.cursor += 1
        if (not self.go_in_grouping(Self.GR_g_v)):
            return False
        self.cursor += 1
        self.I_p1 = self.cursor
        if (self.I_p1 >= I_x):
            _jmp = 1
        if _jmp == 0:
            self.I_p1 = I_x
        if _jmp == 1:
            _jmp = 0
        if (not self.go_out_grouping(Self.GR_g_v)):
            return False
        self.cursor += 1
        if (not self.go_in_grouping(Self.GR_g_v)):
            return False
        self.cursor += 1
        self.I_p2 = self.cursor
        return True
    def r_postlude(mut self) -> Bool:
        var among_var: Int = 0
        var v_1: Int = 0
        var _jmp: Int = 0
        while True:
            v_1 = self.cursor
            self.bra = self.cursor
            among_var = self.find_among(Self.TB_a_1)
            self.ket = self.cursor
            if (among_var == 1):
                self.slice_from_a("y")
            elif (among_var == 2):
                self.slice_from_a("i")
            else:
                if (self.cursor >= self.limit):
                    _jmp = 1
                if _jmp == 0:
                    self.cursor += 1
            if _jmp == 0:
                continue
            if _jmp == 1:
                _jmp = 0
            self.cursor = v_1
            break
        return True
    def r_R1(mut self) -> Bool:
        return (self.I_p1 <= self.cursor)
    def r_R2(mut self) -> Bool:
        return (self.I_p2 <= self.cursor)
    def r_undouble(mut self) -> Bool:
        var v_1: Int = 0
        v_1 = (self.limit - self.cursor)
        if (self.find_among_b(Self.TB_a_2) == 0):
            return False
        self.cursor = (self.limit - v_1)
        self.ket = self.cursor
        if (self.cursor <= self.limit_backward):
            return False
        self.cursor -= 1
        self.bra = self.cursor
        self.slice_del()
        return True
    def r_e_ending(mut self) -> Bool:
        var v_1: Int = 0
        self.B_e_found = False
        self.ket = self.cursor
        if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 101)):
            return False
        self.cursor -= 1
        self.bra = self.cursor
        if (not self.r_R1()):
            return False
        v_1 = (self.limit - self.cursor)
        if (not self.out_grouping_b(Self.GR_g_v)):
            return False
        self.cursor = (self.limit - v_1)
        self.slice_del()
        self.B_e_found = True
        return self.r_undouble()
    def r_en_ending(mut self) -> Bool:
        var v_1: Int = 0
        var _jmp: Int = 0
        if (not self.r_R1()):
            return False
        v_1 = (self.limit - self.cursor)
        if (not self.out_grouping_b(Self.GR_g_v)):
            return False
        self.cursor = (self.limit - v_1)
        if (not self.eq_s_b_a("gem")):
            _jmp = 1
        if _jmp == 0:
            return False
        if _jmp == 1:
            _jmp = 0
        self.slice_del()
        return self.r_undouble()
    def r_standard_suffix(mut self) -> Bool:
        var among_var: Int = 0
        var v_1: Int = 0
        var v_2: Int = 0
        var v_3: Int = 0
        var v_4: Int = 0
        var v_5: Int = 0
        var v_6: Int = 0
        var v_7: Int = 0
        var _jmp: Int = 0
        v_1 = (self.limit - self.cursor)
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_3)
        if (among_var == 0):
            _jmp = 1
        if _jmp == 0:
            self.bra = self.cursor
        if _jmp == 0:
            if (among_var == 1):
                if (not self.r_R1()):
                    _jmp = 1
                if _jmp == 0:
                    self.slice_from_a("heid")
            elif (among_var == 2):
                if (not self.r_en_ending()):
                    _jmp = 1
            else:
                if (not self.r_R1()):
                    _jmp = 1
                if _jmp == 0:
                    if (not self.out_grouping_b(Self.GR_g_v_j)):
                        _jmp = 1
                if _jmp == 0:
                    self.slice_del()
        if _jmp == 1:
            _jmp = 0
        self.cursor = (self.limit - v_1)
        v_2 = (self.limit - self.cursor)
        _ = self.r_e_ending()
        self.cursor = (self.limit - v_2)
        v_3 = (self.limit - self.cursor)
        self.ket = self.cursor
        if (not self.eq_s_b_a("heid")):
            _jmp = 2
        if _jmp == 0:
            self.bra = self.cursor
        if _jmp == 0:
            if (not self.r_R2()):
                _jmp = 2
        if _jmp == 0:
            if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 99)):
                _jmp = 3
            if _jmp == 0:
                self.cursor -= 1
            if _jmp == 0:
                _jmp = 2
            if _jmp == 3:
                _jmp = 0
        if _jmp == 0:
            self.slice_del()
        if _jmp == 0:
            self.ket = self.cursor
        if _jmp == 0:
            if (not self.eq_s_b_a("en")):
                _jmp = 2
        if _jmp == 0:
            self.bra = self.cursor
        if _jmp == 0:
            if (not self.r_en_ending()):
                _jmp = 2
        if _jmp == 2:
            _jmp = 0
        self.cursor = (self.limit - v_3)
        v_4 = (self.limit - self.cursor)
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_4)
        if (among_var == 0):
            _jmp = 4
        if _jmp == 0:
            self.bra = self.cursor
        if _jmp == 0:
            if (among_var == 1):
                if (not self.r_R2()):
                    _jmp = 4
                if _jmp == 0:
                    self.slice_del()
                if _jmp == 0:
                    while True:
                        v_5 = (self.limit - self.cursor)
                        self.ket = self.cursor
                        if (not self.eq_s_b_a("ig")):
                            _jmp = 5
                        if _jmp == 0:
                            self.bra = self.cursor
                        if _jmp == 0:
                            if (not self.r_R2()):
                                _jmp = 5
                        if _jmp == 0:
                            if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 101)):
                                _jmp = 6
                            if _jmp == 0:
                                self.cursor -= 1
                            if _jmp == 0:
                                _jmp = 5
                            if _jmp == 6:
                                _jmp = 0
                        if _jmp == 0:
                            self.slice_del()
                        if _jmp == 0:
                            break
                        if _jmp == 5:
                            _jmp = 0
                        self.cursor = (self.limit - v_5)
                        if (not self.r_undouble()):
                            _jmp = 4
                        if _jmp == 0:
                            break
                        if _jmp != 0:
                            break
            elif (among_var == 2):
                if (not self.r_R2()):
                    _jmp = 4
                if _jmp == 0:
                    if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 101)):
                        _jmp = 7
                    if _jmp == 0:
                        self.cursor -= 1
                    if _jmp == 0:
                        _jmp = 4
                    if _jmp == 7:
                        _jmp = 0
                if _jmp == 0:
                    self.slice_del()
            elif (among_var == 3):
                if (not self.r_R2()):
                    _jmp = 4
                if _jmp == 0:
                    self.slice_del()
                if _jmp == 0:
                    if (not self.r_e_ending()):
                        _jmp = 4
            elif (among_var == 4):
                if (not self.r_R2()):
                    _jmp = 4
                if _jmp == 0:
                    self.slice_del()
            else:
                if (not self.r_R2()):
                    _jmp = 4
                if _jmp == 0:
                    if (not self.B_e_found):
                        _jmp = 4
                if _jmp == 0:
                    self.slice_del()
        if _jmp == 4:
            _jmp = 0
        self.cursor = (self.limit - v_4)
        v_6 = (self.limit - self.cursor)
        if (not self.out_grouping_b(Self.GR_g_v_I)):
            _jmp = 8
        if _jmp == 0:
            v_7 = (self.limit - self.cursor)
        if _jmp == 0:
            if (self.find_among_b(Self.TB_a_5) == 0):
                _jmp = 8
        if _jmp == 0:
            if (not self.out_grouping_b(Self.GR_g_v)):
                _jmp = 8
        if _jmp == 0:
            self.cursor = (self.limit - v_7)
        if _jmp == 0:
            self.ket = self.cursor
        if _jmp == 0:
            if (self.cursor <= self.limit_backward):
                _jmp = 8
        if _jmp == 0:
            self.cursor -= 1
        if _jmp == 0:
            self.bra = self.cursor
        if _jmp == 0:
            self.slice_del()
        if _jmp == 8:
            _jmp = 0
        self.cursor = (self.limit - v_6)
        return True
    def stem_impl(mut self) -> Bool:
        var v_1: Int = 0
        var v_2: Int = 0
        var v_3: Int = 0
        v_1 = self.cursor
        _ = self.r_prelude()
        self.cursor = v_1
        v_2 = self.cursor
        _ = self.r_mark_regions()
        self.cursor = v_2
        self.limit_backward = self.cursor
        self.cursor = self.limit
        _ = self.r_standard_suffix()
        self.cursor = self.limit_backward
        v_3 = self.cursor
        _ = self.r_postlude()
        self.cursor = v_3
        return True

    def run(
        mut self,
        n: Int,
        src: Pointer[UInt32, MutAnyOrigin],
        lens: Pointer[UInt32, MutAnyOrigin],
        dst: Pointer[UInt32, MutAnyOrigin],
        cap: Int,
    ) raises -> Int:
        """Stem n words. Input lengths are overwritten with output lengths."""
        var pos = 0
        var out = 0
        for i in range(n):
            var length = Int(lens[unsafe_offset=i])
            self.current.clear()
            for j in range(length):
                self.current.append(src[unsafe_offset=pos + j])
            pos += length
            self.cursor = 0
            self.limit = length
            self.limit_backward = 0
            self.bra = 0
            self.ket = length
            _ = self.stem_impl()
            var ol = len(self.current)
            if out + ol > cap:
                raise Error("msnowball: output buffer too small")
            for j in range(ol):
                dst[unsafe_offset=out + j] = self.current[j]
            out += ol
            lens[unsafe_offset=i] = UInt32(ol)
        return out


def new_dutch_porter() raises -> PythonObject:
    """Allocate and initialise a DutchPorterStemmer on the heap; return its address."""
    var a = alloc(Layout[DutchPorterStemmer](count=1))
    var p = a^.unsafe_leak()
    p.unsafe_write(DutchPorterStemmer())
    return PythonObject(Int(p))


def stem_dutch_porter(
    handle: PythonObject,
    n: PythonObject,
    src: PythonObject,
    lens: PythonObject,
    dst: PythonObject,
    cap: PythonObject,
) raises -> PythonObject:
    var st = Pointer[DutchPorterStemmer, MutAnyOrigin](unsafe_from_address=Int(py=handle))
    var src_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=src))
    var lens_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=lens))
    var dst_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=dst))
    return PythonObject(st[].run(Int(py=n), src_p, lens_p, dst_p, Int(py=cap)))


struct EnglishStemmer(Movable):
    var current: List[UInt32]
    var cursor: Int
    var limit: Int
    var limit_backward: Int
    var bra: Int
    var ket: Int
    var grp_mask: List[UInt32]
    var pool: List[UInt32]
    var ent_off: List[Int]
    var ent_len: List[Int]
    var ent_sub: List[Int]
    var ent_res: List[Int]
    var n_groups: Int
    var tab_base: List[Int]
    var tab_size: List[Int]
    var B_Y_found: Bool
    var I_p2: Int
    var I_p1: Int
    var ST_as_11: List[StaticString]
    comptime GR_g_aeo = 0
    comptime GR_g_v = 1
    comptime GR_g_v_WXY = 2

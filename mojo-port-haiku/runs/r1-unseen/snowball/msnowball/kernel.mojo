                    self.cursor = (self.limit - v_8)
                    _jmp = 8
            if _jmp == 0:
                self.slice_del()
            if _jmp == 0:
                self.ket = self.cursor
            if _jmp == 0:
                if (not self.eq_s_b_a("ic")):
                    self.cursor = (self.limit - v_8)
                    _jmp = 8
            if _jmp == 0:
                self.bra = self.cursor
            if _jmp == 0:
                while True:
                    v_9 = (self.limit - self.cursor)
                    if (not self.r_R2()):
                        _jmp = 9
                    if _jmp == 0:
                        self.slice_del()
                    if _jmp == 0:
                        break
                    if _jmp == 9:
                        _jmp = 0
                    self.cursor = (self.limit - v_9)
                    self.slice_from_a("iqU")
                    break
            if _jmp == 8:
                _jmp = 0
        elif (among_var == 9):
            self.slice_from_a("eau")
        elif (among_var == 10):
            if (not self.r_R1()):
                return False
            self.slice_from_a("al")
        elif (among_var == 11):
            if (not self.in_grouping_b(Self.GR_g_oux_ending)):
                return False
            self.slice_from_a("ou")
        elif (among_var == 12):
            while True:
                v_10 = (self.limit - self.cursor)
                if (not self.r_R2()):
                    _jmp = 10
                if _jmp == 0:
                    self.slice_del()
                if _jmp == 0:
                    break
                if _jmp == 10:
                    _jmp = 0
                self.cursor = (self.limit - v_10)
                if (not self.r_R1()):
                    return False
                self.slice_from_a("eux")
                break
        elif (among_var == 13):
            if (not self.r_R1()):
                return False
            if (not self.out_grouping_b(Self.GR_g_v)):
                return False
            self.slice_del()
        elif (among_var == 14):
            if (not self.r_RV()):
                return False
            self.slice_from_a("ant")
            return False
        elif (among_var == 15):
            if (not self.r_RV()):
                return False
            self.slice_from_a("ent")
            return False
        else:
            v_11 = (self.limit - self.cursor)
            if (not self.in_grouping_b(Self.GR_g_v)):
                return False
            if (not self.r_RV()):
                return False
            self.cursor = (self.limit - v_11)
            self.slice_del()
            return False
        return True
    def r_i_verb_suffix(mut self) -> Bool:
        var v_2: Int = 0
        var _jmp: Int = 0
        if (self.cursor < self.I_pV):
            return False
        v_2 = self.limit_backward
        self.limit_backward = self.I_pV
        self.ket = self.cursor
        if (self.find_among_b(Self.TB_a_5) == 0):
            self.limit_backward = v_2
            return False
        self.bra = self.cursor
        if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 72)):
            _jmp = 1
        if _jmp == 0:
            self.cursor -= 1
        if _jmp == 0:
            self.limit_backward = v_2
        if _jmp == 0:
            return False
        if _jmp == 1:
            _jmp = 0
        if (not self.out_grouping_b(Self.GR_g_v)):
            self.limit_backward = v_2
            return False
        self.slice_del()
        self.limit_backward = v_2
        return True
    def r_verb_suffix(mut self) -> Bool:
        var among_var: Int = 0
        var v_2: Int = 0
        var v_3: Int = 0
        var v_4: Int = 0
        var _jmp: Int = 0
        if (self.cursor < self.I_pV):
            return False
        v_2 = self.limit_backward
        self.limit_backward = self.I_pV
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_7)
        if (among_var == 0):
            self.limit_backward = v_2
            return False
        self.bra = self.cursor
        self.limit_backward = v_2
        if (among_var == 1):
            if (not self.r_R2()):
                return False
            self.slice_del()
        elif (among_var == 2):
            self.slice_del()
        elif (among_var == 3):
            v_3 = (self.limit - self.cursor)
            if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 101)):
                self.cursor = (self.limit - v_3)
                _jmp = 1
            if _jmp == 0:
                self.cursor -= 1
            if _jmp == 0:
                if (not self.r_RV()):
                    self.cursor = (self.limit - v_3)
                    _jmp = 1
            if _jmp == 0:
                self.bra = self.cursor
            if _jmp == 1:
                _jmp = 0
            self.slice_del()
        else:
            v_4 = (self.limit - self.cursor)
            among_var = self.find_among_b(Self.TB_a_6)
            if (among_var == 0):
                _jmp = 2
            if _jmp == 0:
                if (among_var == 1):
                    if (self.cursor <= self.limit_backward):
                        _jmp = 2
                    if _jmp == 0:
                        self.cursor -= 1
                    if _jmp == 0:
                        if (self.cursor > self.limit_backward):
                            _jmp = 2
            if _jmp == 0:
                return False
            if _jmp == 2:
                _jmp = 0
            self.cursor = (self.limit - v_4)
            self.slice_del()
        return True
    def r_residual_suffix(mut self) -> Bool:
        var among_var: Int = 0
        var v_1: Int = 0
        var v_2: Int = 0
        var v_4: Int = 0
        var _jmp: Int = 0
        v_1 = (self.limit - self.cursor)
        self.ket = self.cursor
        if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 115)):
            self.cursor = (self.limit - v_1)
            _jmp = 1
        if _jmp == 0:
            self.cursor -= 1
        if _jmp == 0:
            self.bra = self.cursor
        if _jmp == 0:
            v_2 = (self.limit - self.cursor)
        if _jmp == 0:
            while True:
                if (not self.eq_s_b_a("Hi")):
                    _jmp = 2
                if _jmp == 0:
                    break
                if _jmp == 2:
                    _jmp = 0
                if (not self.out_grouping_b(Self.GR_g_keep_with_s)):
                    self.cursor = (self.limit - v_1)
                    _jmp = 1
                if _jmp == 0:
                    break
                if _jmp != 0:
                    break
        if _jmp == 0:
            self.cursor = (self.limit - v_2)
        if _jmp == 0:
            self.slice_del()
        if _jmp == 1:
            _jmp = 0
        if (self.cursor < self.I_pV):
            return False
        v_4 = self.limit_backward
        self.limit_backward = self.I_pV
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_8)
        if (among_var == 0):
            self.limit_backward = v_4
            return False
        self.bra = self.cursor
        if (among_var == 1):
            if (not self.r_R2()):
                self.limit_backward = v_4
                return False
            while True:
                if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 115)):
                    _jmp = 3
                if _jmp == 0:
                    self.cursor -= 1
                if _jmp == 0:
                    break
                if _jmp == 3:
                    _jmp = 0
                if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 116)):
                    self.limit_backward = v_4
                    return False
                self.cursor -= 1
                break
            self.slice_del()
        elif (among_var == 2):
            self.slice_from_a("i")
        else:
            self.slice_del()
        self.limit_backward = v_4
        return True
    def r_un_double(mut self) -> Bool:
        var v_1: Int = 0
        v_1 = (self.limit - self.cursor)
        if (self.find_among_b(Self.TB_a_9) == 0):
            return False
        self.cursor = (self.limit - v_1)
        self.ket = self.cursor
        if (self.cursor <= self.limit_backward):
            return False
        self.cursor -= 1
        self.bra = self.cursor
        self.slice_del()
        return True
    def r_un_accent(mut self) -> Bool:
        var v_1: Int = 0
        var _jmp: Int = 0
        v_1 = 1
        while True:
            if (not self.out_grouping_b(Self.GR_g_v)):
                _jmp = 1
            if _jmp == 0:
                v_1 -= 1
            if _jmp == 0:
                continue
            if _jmp == 1:
                _jmp = 0
            break
        if (v_1 > 0):
            return False
        self.ket = self.cursor
        while True:
            if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 233)):
                _jmp = 2
            if _jmp == 0:
                self.cursor -= 1
            if _jmp == 0:
                break
            if _jmp == 2:
                _jmp = 0
            if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 232)):

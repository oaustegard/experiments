        elif (among_var == 12):
            self.slice_from_a("ble")
        elif (among_var == 13):
            self.slice_from_a("og")
        elif (among_var == 14):
            if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 108)):
                return False
            self.cursor -= 1
            self.slice_from_a("og")
        elif (among_var == 15):

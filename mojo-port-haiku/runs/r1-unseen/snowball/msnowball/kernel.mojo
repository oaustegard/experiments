            j += 1
        self.cursor += n
        return True

    def eq_s_b(mut self, s: StaticString) -> Bool:
        var n = s.count_codepoints()
        if self.cursor - n < self.limit_backward:
            return False
        var j = self.cursor - n
        for cp in s.codepoints():
            if self.current[j] != UInt32(Int(cp)):
                return False
            j += 1
        self.cursor -= n
        return True

    def find_among(mut self, t: Int) -> Int:
        var cur = self.current.unsafe_ptr()
        var pool = self.pool.unsafe_ptr()
        var elen = self.ent_len.unsafe_ptr()
        var eoff = self.ent_off.unsafe_ptr()
        var esub = self.ent_sub.unsafe_ptr()
        var eres = self.ent_res.unsafe_ptr()
        var base = self.tab_base[t]
        var i = 0
        var j = self.tab_size[t]
        var c = self.cursor
        var l = self.limit
        var common_i = 0
        var common_j = 0
        var first_key_inspected = False
        while True:
            var k = i + ((j - i) >> 1)
            var diff = 0
            var common = min(common_i, common_j)
            var wl = elen[unsafe_offset=base + k]
            var wo = eoff[unsafe_offset=base + k]
            for i2 in range(common, wl):
                if c + common == l:
                    diff = -1
                    break
                diff = Int(cur[unsafe_offset=c + common]) - Int(pool[unsafe_offset=wo + i2])
                if diff != 0:
                    break
                common += 1
            if diff < 0:
                j = k
                common_j = common
            else:
                i = k
                common_i = common
            if j - i <= 1:
                if i > 0:
                    break
                if j == i:
                    break
                if first_key_inspected:
                    break
                first_key_inspected = True
        while True:
            var wl = elen[unsafe_offset=base + i]
            if common_i >= wl:
                self.cursor = c + wl
                return eres[unsafe_offset=base + i]
            i = esub[unsafe_offset=base + i]
            if i < 0:
                return 0

    def find_among_b(mut self, t: Int) -> Int:
        var cur = self.current.unsafe_ptr()
        var pool = self.pool.unsafe_ptr()
        var elen = self.ent_len.unsafe_ptr()
        var eoff = self.ent_off.unsafe_ptr()
        var esub = self.ent_sub.unsafe_ptr()
        var eres = self.ent_res.unsafe_ptr()
        var base = self.tab_base[t]
        var i = 0
        var j = self.tab_size[t]
        var c = self.cursor
        var lb = self.limit_backward
        var common_i = 0
        var common_j = 0
        var first_key_inspected = False
        while True:
            var k = i + ((j - i) >> 1)
            var diff = 0
            var common = min(common_i, common_j)
            var wl = elen[unsafe_offset=base + k]
            var wo = eoff[unsafe_offset=base + k]
            for i2 in range(wl - 1 - common, -1, -1):
                if c - common == lb:
                    diff = -1
                    break
                diff = Int(cur[unsafe_offset=c - 1 - common]) - Int(pool[unsafe_offset=wo + i2])
                if diff != 0:
                    break
                common += 1
            if diff < 0:
                j = k
                common_j = common
            else:
                i = k
                common_i = common
            if j - i <= 1:
                if i > 0:
                    break
                if j == i:
                    break
                if first_key_inspected:
                    break
                first_key_inspected = True
        while True:
            var wl = elen[unsafe_offset=base + i]
            if common_i >= wl:
                self.cursor = c - wl
                return eres[unsafe_offset=base + i]
            i = esub[unsafe_offset=base + i]
            if i < 0:
                return 0

    def has(self, g: Int, cp: UInt32) -> Bool:
        var i = Int(cp)
        if i >= len(self.grp_mask):
            return False
        return ((self.grp_mask[i] >> UInt32(g)) & 1) == 1

    def add_group(mut self, s: StaticString):
        """Group g is bit g of grp_mask[cp]; the group index is the call order."""
        var cps = to_cps(s)
        var g = self.n_groups
        self.n_groups += 1
        var mx = 0
        for c in cps:
            if Int(c) > mx:
                mx = Int(c)
        while len(self.grp_mask) <= mx:
            self.grp_mask.append(0)
        for c in cps:
            self.grp_mask[Int(c)] = self.grp_mask[Int(c)] | (UInt32(1) << UInt32(g))

    def begin_table(mut self):
        self.tab_base.append(len(self.ent_off))
        self.tab_size.append(0)

    def add_entry(mut self, s: StaticString, sub: Int, res: Int):
        var cps = to_cps(s)
        self.ent_off.append(len(self.pool))
        self.ent_len.append(len(cps))
        for c in cps:
            self.pool.append(c)
        self.ent_sub.append(sub)
        self.ent_res.append(res)
        self.tab_size[len(self.tab_size) - 1] += 1

    def eq_s_a(mut self, s: StaticString) -> Bool:
        var n = s.byte_length()
        if self.cursor + n > self.limit:
            return False
        var j = self.cursor
        for b in s.as_bytes():
            if self.current[j] != UInt32(b):
                return False
            j += 1
        self.cursor += n
        return True

    def eq_s_b_a(mut self, s: StaticString) -> Bool:
        var n = s.byte_length()
        if self.cursor - n < self.limit_backward:
            return False
        var j = self.cursor - n
        for b in s.as_bytes():
            if self.current[j] != UInt32(b):
                return False
            j += 1
        self.cursor -= n
        return True

    def slice_from_a(mut self, s: StaticString):
        var bra = self.bra
        var ket = self.ket
        var n = s.byte_length()
        self.adjust_region(bra, ket, n - (ket - bra))
        var j = bra
        for b in s.as_bytes():
            self.current[j] = UInt32(b)
            j += 1
        self.ket = bra + n

    def adjust_region(mut self, c_bra: Int, c_ket: Int, adj: Int):
        """Resize the buffer by adj at [c_bra, c_ket); the tail moves with it."""
        var old_len = len(self.current)
        if adj > 0:
            for _ in range(adj):
                self.current.append(0)
            var j = old_len - 1
            while j >= c_ket:
                self.current[j + adj] = self.current[j]
                j -= 1
        elif adj < 0:
            for j in range(c_ket, old_len):
                self.current[j + adj] = self.current[j]
            self.current.shrink(old_len + adj)
        self.limit += adj
        if self.cursor >= c_ket:
            self.cursor += adj
        elif self.cursor > c_bra:
            self.cursor = c_bra

    def slice_from(mut self, s: StaticString):
        var bra = self.bra
        var ket = self.ket
        var n = s.count_codepoints()
        self.adjust_region(bra, ket, n - (ket - bra))
        var j = bra
        for cp in s.codepoints():
            self.current[j] = UInt32(Int(cp))
            j += 1
        self.ket = bra + n

    def slice_del(mut self):
        self.adjust_region(self.bra, self.ket, self.bra - self.ket)
        self.ket = self.bra

    def r_mark_regions(mut self) -> Bool:
        var v_1: Int = 0
        var v_2: Int = 0
        var v_3: Int = 0
        var _jmp: Int = 0
        self.I_p1 = self.limit
        v_1 = self.cursor
        while True:
            v_2 = self.cursor
            while True:
                if ((self.cursor == self.limit) or (self.current[self.cursor] != 39)):
                    _jmp = 3
                if _jmp == 0:
                    self.cursor += 1
                if _jmp == 0:
                    break
                if _jmp == 3:
                    _jmp = 0
                if (self.cursor >= self.limit):
                    _jmp = 2
                if _jmp == 0:
                    self.cursor += 1
                if _jmp != 0:
                    break
            if _jmp == 0:
                break
            if _jmp == 2:
                _jmp = 0
            self.cursor = v_2
            if (not self.go_out_grouping(Self.GR_g_v)):
                _jmp = 1
            if _jmp == 0:
                self.cursor += 1
            if _jmp == 0:
                if (not self.go_in_grouping(Self.GR_g_v)):
                    _jmp = 1
            if _jmp == 0:
                self.cursor += 1
            if _jmp == 0:
                break
            if _jmp != 0:
                break
        if _jmp == 0:
            self.I_p1 = self.cursor
        if _jmp == 1:
            _jmp = 0
        self.cursor = v_1
        v_3 = self.cursor
        if ((self.cursor + 3) > self.limit):
            return False
        self.cursor += 3
        if (self.I_p1 >= self.cursor):
            _jmp = 4
        if _jmp == 0:
            self.I_p1 = self.cursor
        if _jmp == 4:
            _jmp = 0
        self.cursor = v_3
        return True
    def r_main_suffix(mut self) -> Bool:
        var among_var: Int = 0
        var v_2: Int = 0
        var v_3: Int = 0
        var _jmp: Int = 0
        if (self.cursor < self.I_p1):
            return False
        v_2 = self.limit_backward
        self.limit_backward = self.I_p1
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_1)
        if (among_var == 0):
            self.limit_backward = v_2
            return False
        self.bra = self.cursor
        self.limit_backward = v_2
        if (among_var == 1):
            self.slice_del()
        elif (among_var == 2):
            among_var = self.find_among_b(Self.TB_a_0)
            if (among_var == 1):
                self.slice_del()
        elif (among_var == 3):
            while True:
                v_3 = (self.limit - self.cursor)
                if (not self.in_grouping_b(Self.GR_g_s_ending)):
                    _jmp = 1
                if _jmp == 0:
                    break
                if _jmp == 1:
                    _jmp = 0
                self.cursor = (self.limit - v_3)
                if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 114)):
                    _jmp = 2
                if _jmp == 0:
                    self.cursor -= 1
                if _jmp == 0:
                    if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 101)):
                        _jmp = 3
                    if _jmp == 0:
                        self.cursor -= 1
                    if _jmp == 0:
                        _jmp = 2
                    if _jmp == 3:
                        _jmp = 0
                if _jmp == 0:
                    break
                if _jmp == 2:
                    _jmp = 0
                self.cursor = (self.limit - v_3)
                if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 107)):
                    return False
                self.cursor -= 1
                if (not self.out_grouping_b(Self.GR_g_v)):
                    return False
                break
            self.slice_del()
        else:
            self.slice_from_a("er")
        return True
    def r_consonant_pair(mut self) -> Bool:
        var v_1: Int = 0
        var v_3: Int = 0
        v_1 = (self.limit - self.cursor)
        if (self.cursor < self.I_p1):
            return False
        v_3 = self.limit_backward
        self.limit_backward = self.I_p1
        self.ket = self.cursor
        if (self.find_among_b(Self.TB_a_2) == 0):
            self.limit_backward = v_3
            return False
        self.bra = self.cursor
        self.limit_backward = v_3
        self.cursor = (self.limit - v_1)
        if (self.cursor <= self.limit_backward):
            return False
        self.cursor -= 1
        self.bra = self.cursor
        self.slice_del()
        return True
    def r_other_suffix(mut self) -> Bool:
        var v_2: Int = 0
        if (self.cursor < self.I_p1):
            return False
        v_2 = self.limit_backward
        self.limit_backward = self.I_p1
        self.ket = self.cursor
        if (self.find_among_b(Self.TB_a_3) == 0):
            self.limit_backward = v_2
            return False
        self.bra = self.cursor
        self.limit_backward = v_2
        self.slice_del()
        return True
    def stem_impl(mut self) -> Bool:
        var v_1: Int = 0
        var v_2: Int = 0
        var v_3: Int = 0
        if (not self.r_mark_regions()):
            return False
        self.limit_backward = self.cursor
        self.cursor = self.limit
        v_1 = (self.limit - self.cursor)
        _ = self.r_main_suffix()
        self.cursor = (self.limit - v_1)
        v_2 = (self.limit - self.cursor)
        _ = self.r_consonant_pair()
        self.cursor = (self.limit - v_2)
        v_3 = (self.limit - self.cursor)
        _ = self.r_other_suffix()
        self.cursor = (self.limit - v_3)
        self.ket = self.cursor
        if ((self.cursor <= self.limit_backward) or (self.current[(self.cursor - 1)] != 39)):
            return False
        self.cursor -= 1
        self.bra = self.cursor
        self.slice_del()
        self.cursor = self.limit_backward
        return True

    def run(
        mut self,
        n: Int,
        src: Pointer[UInt32, MutAnyOrigin],
        lens: Pointer[UInt32, MutAnyOrigin],
        dst: Pointer[UInt32, MutAnyOrigin],
        cap: Int,
    ) raises -> Int:
        """Stem n words. Input lengths are overwritten with output lengths."""
        var pos = 0
        var out = 0
        for i in range(n):
            var length = Int(lens[unsafe_offset=i])
            self.current.clear()
            for j in range(length):
                self.current.append(src[unsafe_offset=pos + j])
            pos += length
            self.cursor = 0
            self.limit = length
            self.limit_backward = 0
            self.bra = 0
            self.ket = length
            _ = self.stem_impl()
            var ol = len(self.current)
            if out + ol > cap:
                raise Error("msnowball: output buffer too small")
            for j in range(ol):
                dst[unsafe_offset=out + j] = self.current[j]
            out += ol
            lens[unsafe_offset=i] = UInt32(ol)
        return out


def new_norwegian() raises -> PythonObject:
    """Allocate and initialise a NorwegianStemmer on the heap; return its address."""
    var a = alloc(Layout[NorwegianStemmer](count=1))
    var p = a^.unsafe_leak()
    p.unsafe_write(NorwegianStemmer())
    return PythonObject(Int(p))


def stem_norwegian(
    handle: PythonObject,
    n: PythonObject,
    src: PythonObject,
    lens: PythonObject,
    dst: PythonObject,
    cap: PythonObject,
) raises -> PythonObject:
    var st = Pointer[NorwegianStemmer, MutAnyOrigin](unsafe_from_address=Int(py=handle))
    var src_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=src))
    var lens_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=lens))
    var dst_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=dst))
    return PythonObject(st[].run(Int(py=n), src_p, lens_p, dst_p, Int(py=cap)))


struct PersianStemmer(Movable):
    var current: List[UInt32]
    var cursor: Int
    var limit: Int
    var limit_backward: Int
    var bra: Int
    var ket: Int
    var grp_mask: List[UInt32]
    var pool: List[UInt32]
    var ent_off: List[Int]
    var ent_len: List[Int]
    var ent_sub: List[Int]
    var ent_res: List[Int]
    var n_groups: Int
    var tab_base: List[Int]
    var tab_size: List[Int]
    var I_p1: Int
    var B_remove_verb_person_endings: Bool
    var B_saw_present_prefix: Bool
    var ST_as_4: List[StaticString]
    comptime TB_a_0 = 0
    comptime TB_a_1 = 1
    comptime TB_a_2 = 2
    comptime TB_a_3 = 3
    comptime TB_a_4 = 4
    comptime TB_a_5 = 5
    comptime TB_a_6 = 6
    comptime TB_a_7 = 7

    def __init__(out self):
        self.current = List[UInt32]()
        self.cursor = 0
        self.limit = 0
        self.limit_backward = 0
        self.bra = 0
        self.ket = 0
        self.grp_mask = List[UInt32]()
        self.pool = List[UInt32]()
        self.ent_off = List[Int]()
        self.ent_len = List[Int]()
        self.ent_sub = List[Int]()
        self.ent_res = List[Int]()
        self.tab_base = List[Int]()
        self.tab_size = List[Int]()
        self.n_groups = 0
        self.ST_as_4 = List[StaticString]()
        self.I_p1 = 0
        self.B_remove_verb_person_endings = False
        self.B_saw_present_prefix = False
        self.begin_table()
        self.add_entry("", -1, 7)
        self.add_entry(" ", 0, 6)
        self.add_entry("أ", 0, 4)
        self.add_entry("ؤ", 0, 5)
        self.add_entry("إ", 0, 4)
        self.add_entry("ئ", 0, 2)
        self.add_entry("ة", 0, 3)
        self.add_entry("ك", 0, 1)
        self.add_entry("ي", 0, 2)
        self.add_entry("ہ", 0, 3)
        self.add_entry("‍", 0, 6)
        self.begin_table()
        self.add_entry("می‌", -1, 2)
        self.add_entry("نمی‌", -1, 1)
        self.begin_table()
        self.add_entry("ستان", -1, -1)
        self.add_entry("ران", -1, -1)
        self.add_entry("سان", -1, -1)
        self.add_entry("وان", -1, -1)
        self.begin_table()
        self.add_entry("آذربایجان", -1, 1)
        self.add_entry("همدان", -1, 1)
        self.add_entry("خاندان", -1, 1)
        self.add_entry("زندان", -1, 1)
        self.add_entry("میزان", -1, 1)
        self.add_entry("درخشان", -1, 1)
        self.add_entry("آتشفشان", -1, 1)
        self.add_entry("نشان", -1, 1)
        self.add_entry("کهکشان", -1, 1)
        self.add_entry("ایشان", -1, 1)
        self.add_entry("پریشان", -1, 1)
        self.add_entry("سلطان", -1, 1)
        self.add_entry("گیلان", -1, 1)
        self.add_entry("ساختمان", -1, 1)
        self.add_entry("رمان", -1, 1)
        self.add_entry("درمان", 14, 1)
        self.add_entry("قهرمان", 14, 1)
        self.add_entry("کرمان", 14, 1)
        self.add_entry("سازمان", -1, 1)
        self.add_entry("همزمان", -1, 1)
        self.add_entry("آسمان", -1, 1)
        self.add_entry("آلمان", -1, 1)
        self.add_entry("مسلمان", -1, 1)
        self.add_entry("ایمان", -1, 1)
        self.add_entry("سلیمان", -1, 1)
        self.add_entry("پیمان", -1, 1)
        self.add_entry("لبنان", -1, 1)
        self.add_entry("یونان", -1, 1)
        self.add_entry("اصفهان", -1, 1)
        self.add_entry("امکان", -1, 1)
        self.add_entry("پایان", -1, 1)
        self.add_entry("بیان", -1, 1)
        self.add_entry("جریان", -1, 1)
        self.begin_table()
        self.add_entry("اساتید", -1, 2)
        self.add_entry("اخبار", -1, 1)
        self.begin_table()
        self.add_entry("ها", -1, 1)
        self.add_entry("ات", -1, 1)
        self.add_entry("یت", -1, 1)
        self.add_entry("مند", -1, 1)
        self.add_entry("وار", -1, 1)
        self.add_entry("گار", -1, 1)
        self.add_entry("تر", -1, 2)
        self.add_entry("اش", -1, 1)
        self.add_entry("ام", -1, 1)
        self.add_entry("ان", -1, 1)
        self.add_entry("بان", 9, 1)
        self.add_entry("گان", 9, 1)
        self.add_entry("یان", 9, 1)
        self.add_entry("ین", -1, 1)
        self.add_entry("ترین", 13, 1)
        self.add_entry("گاه", -1, 1)
        self.add_entry("انه", -1, 1)
        self.add_entry("ناک", -1, 1)
        self.add_entry("های", -1, 1)
        self.add_entry("انی", -1, 1)
        self.add_entry("گی", -1, 1)
        self.add_entry("یی", -1, 1)
        self.begin_table()
        self.add_entry("است", -1, 1)
        self.add_entry("اند", -1, 1)
        self.add_entry("ید", -1, 1)
        self.add_entry("اید", 2, 1)
        self.add_entry("اس", -1, 1)
        self.add_entry("یم", -1, 1)
        self.add_entry("ایم", 5, 1)
        self.add_entry("ای", -1, 1)
        self.begin_table()
        self.add_entry("د", -1, 1)
        self.add_entry("اند", 0, 1)
        self.add_entry("رفتاند", 1, 2)
        self.add_entry("ید", 0, 1)
        self.add_entry("رفتید", 3, 2)
        self.add_entry("م", -1, 1)
        self.add_entry("ام", 5, 1)
        self.add_entry("رفتم", 5, 2)
        self.add_entry("یم", 5, 1)
        self.add_entry("رفتیم", 8, 2)
        self.add_entry("ان", -1, 3)
        self.add_entry("ته", -1, 5)
        self.add_entry("ده", -1, 4)
        self.add_entry("نده", 12, 3)
        self.add_entry("رفتی", -1, 2)
        self.ST_as_4.append("خبر")
        self.ST_as_4.append("استاد")

    # ---- BaseStemmer runtime (snowballstemmer/basestemmer.py), code-point based

    def in_grouping(mut self, g: Int) -> Bool:
        if self.cursor >= self.limit:
            return False
        if not self.has(g, self.current[self.cursor]):
            return False
        self.cursor += 1
        return True

    def in_grouping_b(mut self, g: Int) -> Bool:
        if self.cursor <= self.limit_backward:
            return False
        if not self.has(g, self.current[self.cursor - 1]):
            return False
        self.cursor -= 1
        return True

    def go_in_grouping(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor < self.limit:
            if not self.has(g, cur[unsafe_offset=self.cursor]):
                return True
            self.cursor += 1
        return False

    def go_in_grouping_b(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor > self.limit_backward:
            if not self.has(g, cur[unsafe_offset=self.cursor - 1]):
                return True
            self.cursor -= 1
        return False

    def out_grouping(mut self, g: Int) -> Bool:
        if self.cursor >= self.limit:
            return False
        if not self.has(g, self.current[self.cursor]):
            self.cursor += 1
            return True
        return False

    def go_out_grouping(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor < self.limit:
            if self.has(g, cur[unsafe_offset=self.cursor]):
                return True
            self.cursor += 1
        return False

    def out_grouping_b(mut self, g: Int) -> Bool:
        if self.cursor <= self.limit_backward:
            return False
        if not self.has(g, self.current[self.cursor - 1]):
            self.cursor -= 1
            return True
        return False

    def go_out_grouping_b(mut self, g: Int) -> Bool:
        var cur = self.current.unsafe_ptr()
        while self.cursor > self.limit_backward:
            if self.has(g, cur[unsafe_offset=self.cursor - 1]):
                return True
            self.cursor -= 1
        return False

    def eq_s(mut self, s: StaticString) -> Bool:
        var n = s.count_codepoints()
        if self.cursor + n > self.limit:
            return False
        var j = self.cursor
        for cp in s.codepoints():
            if self.current[j] != UInt32(Int(cp)):
                return False
            j += 1
        self.cursor += n
        return True

    def eq_s_b(mut self, s: StaticString) -> Bool:
        var n = s.count_codepoints()
        if self.cursor - n < self.limit_backward:
            return False
        var j = self.cursor - n
        for cp in s.codepoints():
            if self.current[j] != UInt32(Int(cp)):
                return False
            j += 1
        self.cursor -= n
        return True

    def find_among(mut self, t: Int) -> Int:
        var cur = self.current.unsafe_ptr()
        var pool = self.pool.unsafe_ptr()
        var elen = self.ent_len.unsafe_ptr()
        var eoff = self.ent_off.unsafe_ptr()
        var esub = self.ent_sub.unsafe_ptr()
        var eres = self.ent_res.unsafe_ptr()
        var base = self.tab_base[t]
        var i = 0
        var j = self.tab_size[t]
        var c = self.cursor
        var l = self.limit
        var common_i = 0
        var common_j = 0
        var first_key_inspected = False
        while True:
            var k = i + ((j - i) >> 1)
            var diff = 0
            var common = min(common_i, common_j)
            var wl = elen[unsafe_offset=base + k]
            var wo = eoff[unsafe_offset=base + k]
            for i2 in range(common, wl):
                if c + common == l:
                    diff = -1
                    break
                diff = Int(cur[unsafe_offset=c + common]) - Int(pool[unsafe_offset=wo + i2])
                if diff != 0:
                    break
                common += 1
            if diff < 0:
                j = k
                common_j = common
            else:
                i = k
                common_i = common
            if j - i <= 1:
                if i > 0:
                    break
                if j == i:
                    break
                if first_key_inspected:
                    break
                first_key_inspected = True
        while True:
            var wl = elen[unsafe_offset=base + i]
            if common_i >= wl:
                self.cursor = c + wl
                return eres[unsafe_offset=base + i]
            i = esub[unsafe_offset=base + i]
            if i < 0:
                return 0

    def find_among_b(mut self, t: Int) -> Int:
        var cur = self.current.unsafe_ptr()
        var pool = self.pool.unsafe_ptr()
        var elen = self.ent_len.unsafe_ptr()
        var eoff = self.ent_off.unsafe_ptr()
        var esub = self.ent_sub.unsafe_ptr()
        var eres = self.ent_res.unsafe_ptr()
        var base = self.tab_base[t]
        var i = 0
        var j = self.tab_size[t]
        var c = self.cursor
        var lb = self.limit_backward
        var common_i = 0
        var common_j = 0
        var first_key_inspected = False
        while True:
            var k = i + ((j - i) >> 1)
            var diff = 0
            var common = min(common_i, common_j)
            var wl = elen[unsafe_offset=base + k]
            var wo = eoff[unsafe_offset=base + k]
            for i2 in range(wl - 1 - common, -1, -1):
                if c - common == lb:
                    diff = -1
                    break
                diff = Int(cur[unsafe_offset=c - 1 - common]) - Int(pool[unsafe_offset=wo + i2])
                if diff != 0:
                    break
                common += 1
            if diff < 0:
                j = k
                common_j = common
            else:
                i = k
                common_i = common
            if j - i <= 1:
                if i > 0:
                    break
                if j == i:
                    break
                if first_key_inspected:
                    break
                first_key_inspected = True
        while True:
            var wl = elen[unsafe_offset=base + i]
            if common_i >= wl:
                self.cursor = c - wl
                return eres[unsafe_offset=base + i]
            i = esub[unsafe_offset=base + i]
            if i < 0:
                return 0

    def has(self, g: Int, cp: UInt32) -> Bool:
        var i = Int(cp)
        if i >= len(self.grp_mask):
            return False
        return ((self.grp_mask[i] >> UInt32(g)) & 1) == 1

    def add_group(mut self, s: StaticString):
        """Group g is bit g of grp_mask[cp]; the group index is the call order."""
        var cps = to_cps(s)
        var g = self.n_groups
        self.n_groups += 1
        var mx = 0
        for c in cps:
            if Int(c) > mx:
                mx = Int(c)
        while len(self.grp_mask) <= mx:
            self.grp_mask.append(0)
        for c in cps:
            self.grp_mask[Int(c)] = self.grp_mask[Int(c)] | (UInt32(1) << UInt32(g))

    def begin_table(mut self):
        self.tab_base.append(len(self.ent_off))
        self.tab_size.append(0)

    def add_entry(mut self, s: StaticString, sub: Int, res: Int):
        var cps = to_cps(s)
        self.ent_off.append(len(self.pool))
        self.ent_len.append(len(cps))
        for c in cps:
            self.pool.append(c)
        self.ent_sub.append(sub)
        self.ent_res.append(res)
        self.tab_size[len(self.tab_size) - 1] += 1

    def eq_s_a(mut self, s: StaticString) -> Bool:
        var n = s.byte_length()
        if self.cursor + n > self.limit:
            return False
        var j = self.cursor
        for b in s.as_bytes():
            if self.current[j] != UInt32(b):
                return False
            j += 1
        self.cursor += n
        return True

    def eq_s_b_a(mut self, s: StaticString) -> Bool:
        var n = s.byte_length()
        if self.cursor - n < self.limit_backward:
            return False
        var j = self.cursor - n
        for b in s.as_bytes():
            if self.current[j] != UInt32(b):
                return False
            j += 1
        self.cursor -= n
        return True

    def slice_from_a(mut self, s: StaticString):
        var bra = self.bra
        var ket = self.ket
        var n = s.byte_length()
        self.adjust_region(bra, ket, n - (ket - bra))
        var j = bra
        for b in s.as_bytes():
            self.current[j] = UInt32(b)
            j += 1
        self.ket = bra + n

    def adjust_region(mut self, c_bra: Int, c_ket: Int, adj: Int):
        """Resize the buffer by adj at [c_bra, c_ket); the tail moves with it."""
        var old_len = len(self.current)
        if adj > 0:
            for _ in range(adj):
                self.current.append(0)
            var j = old_len - 1
            while j >= c_ket:
                self.current[j + adj] = self.current[j]
                j -= 1
        elif adj < 0:
            for j in range(c_ket, old_len):
                self.current[j + adj] = self.current[j]
            self.current.shrink(old_len + adj)
        self.limit += adj
        if self.cursor >= c_ket:
            self.cursor += adj
        elif self.cursor > c_bra:
            self.cursor = c_bra

    def slice_from(mut self, s: StaticString):
        var bra = self.bra
        var ket = self.ket
        var n = s.count_codepoints()
        self.adjust_region(bra, ket, n - (ket - bra))
        var j = bra
        for cp in s.codepoints():
            self.current[j] = UInt32(Int(cp))
            j += 1
        self.ket = bra + n

    def slice_del(mut self):
        self.adjust_region(self.bra, self.ket, self.bra - self.ket)
        self.ket = self.bra

    def r_Normalize_Characters(mut self) -> Bool:
        var among_var: Int = 0
        var v_1: Int = 0
        var _jmp: Int = 0
        while True:
            v_1 = self.cursor
            self.bra = self.cursor
            among_var = self.find_among(Self.TB_a_0)
            self.ket = self.cursor
            if (among_var == 1):
                self.slice_from("ک")
            elif (among_var == 2):
                self.slice_from("ی")
            elif (among_var == 3):
                self.slice_from("ه")
            elif (among_var == 4):
                self.slice_from("ا")
            elif (among_var == 5):
                self.slice_from("و")
            elif (among_var == 6):
                self.slice_del()
            else:
                if (self.cursor >= self.limit):
                    _jmp = 1
                if _jmp == 0:
                    self.cursor += 1
            if _jmp == 0:
                continue
            if _jmp == 1:
                _jmp = 0
            self.cursor = v_1
            break
        return True
    def r_Prefixes(mut self) -> Bool:
        var among_var: Int = 0
        self.bra = self.cursor
        among_var = self.find_among(Self.TB_a_1)
        if (among_var == 0):
            return False
        self.ket = self.cursor
        if (among_var == 1):
            if ((self.cursor + 2) > self.limit):
                return False
            self.cursor += 2
            self.B_saw_present_prefix = True
        else:
            if ((self.cursor + 2) > self.limit):
                return False
            self.cursor += 2
            self.slice_del()
            self.B_saw_present_prefix = True
        return True
    def r_Delete_ZWNJ(mut self) -> Bool:
        var v_1: Int = 0
        var v_2: Int = 0
        var _jmp: Int = 0
        while True:
            v_1 = self.cursor
            while True:
                v_2 = self.cursor
                self.bra = self.cursor
                if ((self.cursor == self.limit) or (self.current[self.cursor] != 8204)):
                    _jmp = 2
                if _jmp == 0:
                    self.cursor += 1
                if _jmp == 0:
                    self.ket = self.cursor
                if _jmp == 0:
                    self.slice_del()
                if _jmp == 0:
                    self.cursor = v_2
                if _jmp == 0:
                    break
                if _jmp == 2:
                    _jmp = 0
                self.cursor = v_2
                if (self.cursor >= self.limit):
                    _jmp = 1
                if _jmp == 0:
                    self.cursor += 1
                if _jmp != 0:
                    break
            if _jmp == 0:
                continue
            if _jmp == 1:
                _jmp = 0
            self.cursor = v_1
            break
        return True
    def r_R1(mut self) -> Bool:
        return (self.I_p1 <= self.cursor)
    def r_Protect_Lexical_AN(mut self) -> Bool:
        var v_1: Int = 0
        var v_2: Int = 0
        var _jmp: Int = 0
        v_1 = (self.limit - self.cursor)
        if (not self.r_AN_Exception()):
            _jmp = 1
        if _jmp == 0:
            return False
        if _jmp == 1:
            _jmp = 0
        self.cursor = (self.limit - v_1)
        v_2 = (self.limit - self.cursor)
        if (self.find_among_b(Self.TB_a_2) == 0):
            _jmp = 2
        if _jmp == 0:
            return False
        if _jmp == 2:
            _jmp = 0
        self.cursor = (self.limit - v_2)
        return True
    def r_AN_Exception(mut self) -> Bool:
        if (self.find_among_b(Self.TB_a_3) == 0):
            return False
        if (self.cursor > self.limit_backward):
            return False
        return True
    def r_Irregular_Noun(mut self) -> Bool:
        var among_var: Int = 0
        self.ket = self.cursor
        among_var = self.find_among_b(Self.TB_a_4)
        if (among_var == 0):
            return False
        self.bra = self.cursor
        self.slice_from(self.ST_as_4[(among_var - 1)])
        return True
    def r_Stem_Noun_or_Adjective(mut self) -> Bool:
        var among_var: Int = 0
        var v_1: Int = 0
        var v_3: Int = 0
        var _jmp: Int = 0
        while True:
            v_1 = (self.limit - self.cursor)
            if (not self.r_Irregular_Noun()):
                _jmp = 1
            if _jmp == 0:
                break
            if _jmp == 1:
                _jmp = 0
            self.cursor = (self.limit - v_1)
            if (self.cursor < self.I_p1):
                return False
            v_3 = self.limit_backward
            self.limit_backward = self.I_p1
            self.ket = self.cursor
            among_var = self.find_among_b(Self.TB_a_5)
            if (among_var == 0):
                self.limit_backward = v_3
                return False
            self.bra = self.cursor
            if (among_var == 1):
                self.slice_del()
            else:
                if (self.cursor <= self.limit_backward):
                    self.limit_backward = v_3
                    return False
                self.slice_del()
            self.limit_backward = v_3
            break
        return True
    def r_Stem_Verb(mut self) -> Bool:
        var among_var: Int = 0
        var v_1: Int = 0
        var _jmp: Int = 0
        while True:
            v_1 = (self.limit - self.cursor)
            self.ket = self.cursor
            if (self.find_among_b(Self.TB_a_6) == 0):
                _jmp = 1
            if _jmp == 0:
                self.bra = self.cursor
            if _jmp == 0:
                if (not self.r_R1()):
                    _jmp = 1
            if _jmp == 0:
                self.slice_del()
            if _jmp == 0:
                break
            if _jmp == 1:
                _jmp = 0
            self.cursor = (self.limit - v_1)
            self.ket = self.cursor
            among_var = self.find_among_b(Self.TB_a_7)
            if (among_var == 0):
                return False
            self.bra = self.cursor
            if (among_var == 1):
                if (not self.B_remove_verb_person_endings):
                    return False
                if (not self.r_R1()):
                    return False
                self.slice_del()
            elif (among_var == 2):
                self.slice_from("رفت")
            elif (among_var == 3):
                if (not self.r_R1()):
                    return False
                self.slice_del()
                self.B_remove_verb_person_endings = True
            elif (among_var == 4):
                if (self.cursor <= self.limit_backward):
                    return False
                self.slice_from("د")
                self.B_remove_verb_person_endings = True
            else:
                if (self.cursor <= self.limit_backward):
                    return False
                self.slice_from("ت")
                self.B_remove_verb_person_endings = True
            break
        return True
    def stem_impl(mut self) -> Bool:
        var v_1: Int = 0
        var v_2: Int = 0
        var v_3: Int = 0
        var v_4: Int = 0
        var v_5: Int = 0
        var v_6: Int = 0
        var v_7: Int = 0
        var _jmp: Int = 0
        self.B_saw_present_prefix = False
        v_1 = self.cursor
        _ = self.r_Normalize_Characters()
        self.cursor = v_1
        v_2 = self.cursor
        _ = self.r_Prefixes()
        self.cursor = v_2
        v_3 = self.cursor
        _ = self.r_Delete_ZWNJ()
        self.cursor = v_3
        self.I_p1 = self.limit
        v_4 = self.cursor
        if ((self.cursor + 3) > self.limit):
            _jmp = 1
        if _jmp == 0:
            self.cursor += 3
        if _jmp == 0:
            self.I_p1 = self.cursor
        if _jmp == 1:
            _jmp = 0
        self.cursor = v_4
        self.limit_backward = self.cursor
        self.cursor = self.limit
        while True:
            v_5 = (self.limit - self.cursor)
            v_6 = (self.limit - self.cursor)
            self.B_remove_verb_person_endings = False
            if (not self.B_saw_present_prefix):
                _jmp = 3
            if _jmp == 0:
                self.B_remove_verb_person_endings = True
            if _jmp == 3:
                _jmp = 0
            if (not self.r_Protect_Lexical_AN()):
                _jmp = 2
            if _jmp == 0:
                while True:
                    v_7 = (self.limit - self.cursor)
                    if (not self.r_Stem_Noun_or_Adjective()):
                        _jmp = 4
                    if _jmp == 0:
                        break
                    if _jmp == 4:
                        _jmp = 0
                    self.cursor = (self.limit - v_7)
                    if (not self.r_Stem_Verb()):
                        _jmp = 2
                    if _jmp == 0:
                        break
                    if _jmp != 0:
                        break
            if _jmp == 0:
                self.cursor = (self.limit - v_6)
            if _jmp == 0:
                continue
            if _jmp == 2:
                _jmp = 0
            self.cursor = (self.limit - v_5)
            break
        self.cursor = self.limit_backward
        return True

    def run(
        mut self,
        n: Int,
        src: Pointer[UInt32, MutAnyOrigin],
        lens: Pointer[UInt32, MutAnyOrigin],
        dst: Pointer[UInt32, MutAnyOrigin],
        cap: Int,
    ) raises -> Int:
        """Stem n words. Input lengths are overwritten with output lengths."""
        var pos = 0
        var out = 0
        for i in range(n):
            var length = Int(lens[unsafe_offset=i])
            self.current.clear()
            for j in range(length):
                self.current.append(src[unsafe_offset=pos + j])
            pos += length
            self.cursor = 0
            self.limit = length
            self.limit_backward = 0
            self.bra = 0
            self.ket = length
            _ = self.stem_impl()
            var ol = len(self.current)
            if out + ol > cap:
                raise Error("msnowball: output buffer too small")
            for j in range(ol):
                dst[unsafe_offset=out + j] = self.current[j]
            out += ol
            lens[unsafe_offset=i] = UInt32(ol)
        return out


def new_persian() raises -> PythonObject:
    """Allocate and initialise a PersianStemmer on the heap; return its address."""
    var a = alloc(Layout[PersianStemmer](count=1))
    var p = a^.unsafe_leak()
    p.unsafe_write(PersianStemmer())
    return PythonObject(Int(p))


def stem_persian(
    handle: PythonObject,
    n: PythonObject,
    src: PythonObject,
    lens: PythonObject,
    dst: PythonObject,
    cap: PythonObject,
) raises -> PythonObject:
    var st = Pointer[PersianStemmer, MutAnyOrigin](unsafe_from_address=Int(py=handle))
    var src_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=src))
    var lens_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=lens))
    var dst_p = Pointer[UInt32, MutAnyOrigin](unsafe_from_address=Int(py=dst))
    return PythonObject(st[].run(Int(py=n), src_p, lens_p, dst_p, Int(py=cap)))


struct PortugueseStemmer(Movable):
    var current: List[UInt32]
    var cursor: Int
    var limit: Int
    var limit_backward: Int
    var bra: Int
    var ket: Int
    var grp_mask: List[UInt32]

#!/usr/bin/env python3
"""gate.compat_command: refuse to gate on a compiler other than the pinned one.

    tests/bin/pin-check TREE

Byte matching is only meaningful against the exact gcc the targets were built with
(tests/flags.json gcc_version); a different gcc build would turn every PASS into noise.
Also refuses inline assembly anywhere under TREE/src (the runner rejects it per TU too)."""
import json, re, subprocess, sys
from pathlib import Path
tree = Path(sys.argv[1] if len(sys.argv) > 1 else ".")
flags = json.loads((tree / "tests" / "flags.json").read_text())
got = subprocess.run([flags["cc"], "--version"], capture_output=True, text=True).stdout.splitlines()[0]
if got.strip() != flags["gcc_version"]:
    sys.exit(f"pin-check: {flags['cc']} is '{got}', pinned '{flags['gcc_version']}'")
asm = re.compile(r"\b(__asm__|__asm|asm)\b")
bad = [str(p.relative_to(tree)) for p in (tree / "src").rglob("*.[ch]") if asm.search(p.read_text(errors="replace"))]
if bad:
    sys.exit(f"pin-check: inline assembly in {', '.join(bad[:5])}")

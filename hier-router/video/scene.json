  {
   "id": "vo1",
   "role": "voice",
   "src": "voice/vo1.wav",
   "text": "This is a spiky ball: one small, frozen decision model, with a [[lora]]LoRA adapter for each kind of decision it is good at. Each spike is half a megabyte.",

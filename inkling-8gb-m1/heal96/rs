#!/bin/bash
# rs SESSION 'shell cmd' : run a shell command on a Colab VM over ssh (does not queue behind a busy kernel cell)
s=$1; shift
for i in 1 2 3; do
  out=$(timeout ${RS_TIMEOUT:-150} colab ssh -s "$s" -- "$*" </dev/null 2>&1)
  if ! grep -q "HTTP 429" <<<"$out"; then grep -v -i "keyring\|^warning\|Warning: Could not" <<<"$out"; exit 0; fi
  sleep 10
done
echo "rs: ssh busy (429) on $s"

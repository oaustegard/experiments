diff --git a/hcc/selftest/parse_enum_fwd_typedef_complete.c b/hcc/selftest/parse_enum_fwd_typedef_complete.c
new file mode 100644
index 00000000..c9c7c515
--- /dev/null
+++ b/hcc/selftest/parse_enum_fwd_typedef_complete.c
@@ -0,0 +1,8 @@
+// EXPECT-EXIT: 0
+// A typedef of a forward-declared enum is completed by the later enum body
+// (same type object), so it is usable as a complete parameter type.
+typedef enum E E;
+enum E;
+enum E { A, B };
+static int f(int x, E op) { return x + op; }
+int main(void) { return f(1, B) == 2 ? 0 : 1; }

index 00000000..d54047b2
--- /dev/null
+++ b/hcc/selftest/enums_fwd_complete.c
@@ -0,0 +1,7 @@
+// EXPECT-EXIT: 0
+// A forward-declared enum completed later in the same scope: a typedef and a
+// parameter naming it must see the body.
+typedef enum E E;
+enum E { A, B };
+static int f(int a, E op) { return a + op; }
+int main(void) { return f(1, B) == 2 ? 0 : 1; }

diff --git a/hcc/selftest/codegen_binary_call_order.c b/hcc/selftest/codegen_binary_call_order.c
new file mode 100644
index 00000000..90f73f20
--- /dev/null
+++ b/hcc/selftest/codegen_binary_call_order.c
@@ -0,0 +1,11 @@
+// EXPECT-EXIT: 0
+// Both operands of a binary operator call functions: the left one is evaluated
+// first (as gcc -O0 does), so `next() - next()` is -1 here.
+static int n;
+static int next(void) { return ++n; }
+int main(void) {
+    int r = next() - next();
+    int s = 5;
+    s += next() - next();
+    return (r == -1 && s == 4) ? 0 : 1;
+}
diff --git a/hcc/selftest/parse_enum_fwd_complete.c b/hcc/selftest/parse_enum_fwd_complete.c
new file mode 100644
index 00000000..23f8749c
--- /dev/null
+++ b/hcc/selftest/parse_enum_fwd_complete.c
@@ -0,0 +1,8 @@
+// EXPECT-EXIT: 2
+// `enum e;` forward declaration (typedef'd before) completed by a later body:
+// the typedef'd name must denote the completed enum.
+enum e;
+typedef enum e E;
+enum e { A, B, C };
+static int f(E op) { return (int)op; }
+int main(void) { return f(C); }

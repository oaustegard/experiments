diff --git a/hcc/selftest/parse_enum_fwd_complete.c b/hcc/selftest/parse_enum_fwd_complete.c
new file mode 100644
index 00000000..b128e27a
--- /dev/null
+++ b/hcc/selftest/parse_enum_fwd_complete.c
@@ -0,0 +1,8 @@
+// EXPECT-EXIT: 0
+// `enum E;` followed by `enum E {...}` in the same scope completes that type:
+// a typedef and a parameter declared between them must see the body.
+typedef enum E E;
+static int f(int a, E op);
+enum E { A, B };
+static int f(int a, E op) { return a + (int)op; }
+int main(void) { return f(1, B) - 2; }

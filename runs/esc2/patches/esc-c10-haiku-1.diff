diff --git a/hcc/parser/enums.py b/hcc/parser/enums.py
index 1c1f776f..a654687d 100644
--- a/hcc/parser/enums.py
+++ b/hcc/parser/enums.py
@@ -69,7 +69,14 @@ class EnumMixin:
             if (prev is not None and prev.kind == T.TypeKind.ENUM and id(prev) in def_pos
                     and def_pos[id(prev)] != brace_pos):
                 self.error(f"redeclaration of 'enum {tag.text}'", tag)
-        ty = T.enum_type()
+        # `enum E; ... enum E {..}` in one scope completes the forward-declared
+        # type object in place, so earlier typedefs/declarations of `enum E` see it.
+        fwd = self.scopes[-1].tags.get(tag.text) if tag is not None else None
+        if fwd is not None and fwd.kind == T.TypeKind.ENUM and fwd.enum_consts == "fwd":
+            ty = fwd
+            ty.enum_consts = None
+        else:
+            ty = T.enum_type()
         ty.tag = tag.text if tag else None
         if tag is not None:
             def_pos[id(ty)] = brace_pos
diff --git a/hcc/selftest/enum_fwd_complete_typedef.c b/hcc/selftest/enum_fwd_complete_typedef.c
new file mode 100644
index 00000000..c2f03bed
--- /dev/null
+++ b/hcc/selftest/enum_fwd_complete_typedef.c
@@ -0,0 +1,6 @@
+// EXPECT-EXIT: 0
+// A typedef of a forward-declared enum must see the later definition.
+typedef enum E E;
+enum E { A, B };
+static int f(int x, E op) { return x + (int)op; }
+int main(void) { return f(1, B) - 2; }

diff --git a/hcc/selftest/parser_elvis_complex.c b/hcc/selftest/parser_elvis_complex.c
new file mode 100644
index 00000000..a9dcb018
--- /dev/null
+++ b/hcc/selftest/parser_elvis_complex.c
@@ -0,0 +1,15 @@
+// EXPECT-EXIT: 0
+// GNU `a ?: b` where `a` is complex: the hidden temporary keeps the complex
+// value (only its truth test is reduced), so a nonzero operand is returned as-is.
+int calls;
+_Complex int g(_Complex int v) { calls++; return v; }
+_Complex int doo(void) {
+    _Complex int rhs;
+    return g(1 + 2i) ? : rhs;
+}
+int main(void) {
+    _Complex int r = doo();
+    if (calls != 1) return 2;
+    if (__real__ r != 1 || __imag__ r != 2) return 1;
+    return 0;
+}

diff --git a/hcc/selftest/parser_elvis_complex.c b/hcc/selftest/parser_elvis_complex.c
new file mode 100644
index 00000000..14331bc5
--- /dev/null
+++ b/hcc/selftest/parser_elvis_complex.c
@@ -0,0 +1,12 @@
+// EXPECT-EXIT: 0
+// GNU a ?: b must yield a's value (complex-aware), not its truth value.
+extern void abort(void);
+int main(void) {
+    _Complex double c = 0;
+    _Complex double d = 2.0 + 0.0i;
+    _Complex double z = c ? : d;
+    if (__real__ z != 2.0) abort();
+    int a = 0;
+    if ((a ? : 7) != 7) abort();
+    return 0;
+}

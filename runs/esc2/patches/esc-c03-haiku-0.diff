diff --git a/hcc/selftest/codegen_binary_call_order.c b/hcc/selftest/codegen_binary_call_order.c
new file mode 100644
index 00000000..b1974ff4
--- /dev/null
+++ b/hcc/selftest/codegen_binary_call_order.c
@@ -0,0 +1,10 @@
+// EXPECT-EXIT: 0
+// EXPECT-STDOUT: 12 sub=-1
+// Both operands of a binary operator call functions: lhs is evaluated first (as gcc -O0 does).
+#include <stdio.h>
+static int f(int v) { printf("%d", v); return v; }
+int main(void) {
+    int r = f(1) - f(2);
+    printf(" sub=%d\n", r);
+    return 0;
+}
diff --git a/hcc/selftest/enum_fwd_typedef_complete.c b/hcc/selftest/enum_fwd_typedef_complete.c
new file mode 100644
index 00000000..187c45f7
--- /dev/null
+++ b/hcc/selftest/enum_fwd_typedef_complete.c
@@ -0,0 +1,10 @@
+// EXPECT-EXIT: 0
+// A forward typedef of an enum is completed by a later body in the same scope.
+typedef enum E E;
+static int f(E e);
+enum E { A, B = 5 };
+static int f(E e) { return e == B; }
+int main(void) {
+    E v = B;
+    return f(v) ? 0 : 1;
+}

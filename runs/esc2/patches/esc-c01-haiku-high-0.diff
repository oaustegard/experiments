diff --git a/hcc/parser/complex.py b/hcc/parser/complex.py
index 0cc30cd1..d25ddda8 100644
--- a/hcc/parser/complex.py
+++ b/hcc/parser/complex.py
@@ -287,3 +287,16 @@ def builtin_complex(p, loc, args):
     if cre is not None and cim is not None:
         CC.attach(node, (cre[0], cim[0]), base)
     return node
+
+
+def cond_arms(p, then, els, loc):
+    """`c ? a : b` (or `x ?: b`) where an arm is complex: both arms are converted to
+    the common complex type (C11 6.5.15); arms that are not complex-compatible are
+    returned unchanged for the ordinary conditional rules."""
+    if not (then.ty.is_complex or els.ty.is_complex):
+        return then, els
+    for e in (then, els):
+        if not (e.ty.is_complex or is_integer(e.ty) or is_flonum(e.ty)):
+            return then, els
+    cty = complex_of(_common_base(p, [then, els], loc))
+    return convert(p, then, cty, loc), convert(p, els, cty, loc)

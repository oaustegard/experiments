diff --git a/hcc/selftest/complex_elvis_omitted_middle.c b/hcc/selftest/complex_elvis_omitted_middle.c
new file mode 100644
index 00000000..2a619249
--- /dev/null
+++ b/hcc/selftest/complex_elvis_omitted_middle.c
@@ -0,0 +1,16 @@
+// EXPECT-EXIT: 0
+// GNU `x ?: y` with a complex x: the saved value keeps its imaginary part,
+// the call runs once, and a real arm is converted to complex.
+static int calls;
+_Complex int g(int re, int im) { calls++; return re + im * 1i; }
+_Complex double gd(double re) { calls++; return re; }
+int main(void) {
+    _Complex int a = g(0, 0) ?: (_Complex int)(7 + 9i);
+    _Complex int b = g(3, 4) ?: (_Complex int)(7 + 9i);
+    _Complex double d = gd(0.0) ?: 5.0;
+    if (__real__ a != 7 || __imag__ a != 9) return 1;
+    if (__real__ b != 3 || __imag__ b != 4) return 2;
+    if (__real__ d != 5.0 || __imag__ d != 0.0) return 3;
+    if (calls != 3) return 4;
+    return 0;
+}

diff --git a/hcc/parser/enums.py b/hcc/parser/enums.py
index 1c1f776f..9dd754e1 100644
--- a/hcc/parser/enums.py
+++ b/hcc/parser/enums.py
@@ -72,6 +72,12 @@ class EnumMixin:
         ty = T.enum_type()
         ty.tag = tag.text if tag else None
         if tag is not None:
+            # `enum E; ... enum E {..}` in one scope completes the forward
+            # declaration in place, so earlier typedefs/params see the body.
+            fwd = self.scopes[-1].tags.get(tag.text)
+            if fwd is not None and fwd.kind == T.TypeKind.ENUM and fwd.enum_consts == "fwd":
+                ty = fwd
+                ty.enum_consts = None
             def_pos[id(ty)] = brace_pos
             # The tag is visible from its declaration on, so enumerator
             # expressions may refer to it (GNU: `enum A { B = sizeof(enum A*) }`).
diff --git a/hcc/selftest/parser_enum_fwd_complete.c b/hcc/selftest/parser_enum_fwd_complete.c
new file mode 100644
index 00000000..6c13be5e
--- /dev/null
+++ b/hcc/selftest/parser_enum_fwd_complete.c
@@ -0,0 +1,7 @@
+// EXPECT-EXIT: 0
+// A forward-declared enum completed later in the same scope must be complete
+// for parameters declared through an earlier typedef of it.
+typedef enum E E;
+enum E { X1, X2 };
+static int f(int a, E op) { return a + (int)op; }
+int main(void) { return f(1, X2) == 2 ? 0 : 1; }

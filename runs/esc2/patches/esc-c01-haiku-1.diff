diff --git a/hcc/selftest/parse_elvis_complex.c b/hcc/selftest/parse_elvis_complex.c
new file mode 100644
index 00000000..5fbdbc96
--- /dev/null
+++ b/hcc/selftest/parse_elvis_complex.c
@@ -0,0 +1,11 @@
+// EXPECT-EXIT: 0
+// GNU `a ?: b` with a complex operand: the result is the complex value a, not its truth value.
+_Complex int pick(_Complex int v) { return v; }
+int main(void) {
+    _Complex int rhs = 5 + 6i;
+    _Complex int r = pick(0 + 0i) ? : rhs;
+    _Complex int s = pick(1 + 2i) ? : rhs;
+    if (r != 5 + 6i) return 1;
+    if (s != 1 + 2i) return 2;
+    return 0;
+}

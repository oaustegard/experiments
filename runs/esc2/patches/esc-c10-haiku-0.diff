diff --git a/hcc/selftest/enum_fwd_complete.c b/hcc/selftest/enum_fwd_complete.c
new file mode 100644
index 00000000..2dd871bf
--- /dev/null
+++ b/hcc/selftest/enum_fwd_complete.c
@@ -0,0 +1,8 @@
+// EXPECT-EXIT: 0
+// An enum forward-declared (via typedef) and later defined in the same scope
+// must complete the same type: parameters of the forward type are complete.
+typedef enum E E;
+int f(int x, E op);
+enum E { A, B };
+int g(int x, E op) { return x + (int)op; }
+int main(void) { return g(1, B) - 2; }

diff --git a/hcc/sema/compat.py b/hcc/sema/compat.py
index 2be59045..05f00a7d 100644
--- a/hcc/sema/compat.py
+++ b/hcc/sema/compat.py
@@ -19,6 +19,25 @@ def _enum_as_int(t: Type) -> Type:
     return Type(kind, t.size, t.align, bool(t.is_unsigned))
 
 
+_PROMOTED = (TypeKind.CHAR, TypeKind.SHORT, TypeKind.BOOL, TypeKind.FLOAT)
+
+
+def redecl_compatible(old: Type, new: Type, c23: bool = False) -> bool:
+    """Redeclaration check for a file-scope object or function. Unlike is_compatible,
+    an unprototyped function `f()` only matches a prototype whose parameters are
+    unaffected by default argument promotions (C11 6.7.6.3p15; C23 drops that rule)."""
+    if old.kind != TypeKind.FUNC or new.kind != TypeKind.FUNC:
+        return is_compatible(old, new)
+    if old.has_proto and new.has_proto or c23:
+        return is_compatible(old, new)
+    proto = old if old.has_proto else new
+    if not is_compatible(old.return_ty, new.return_ty):
+        return False
+    if proto.is_variadic:
+        return False
+    return not any(p.kind in _PROMOTED for p in proto.params)
+
+
 def is_compatible(a: Type, b: Type) -> bool:
     if a is b:
         return True

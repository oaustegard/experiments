                 prev = t.text
 
+    def check_string_std_attr_args(self, name: str) -> None:
+        """Validate `[[deprecated(...)]]` / `[[nodiscard(...)]]`: the optional
+        argument list, when written, holds exactly one string literal."""
+        self.expect("(")
+        if self.at(")"):
+            self.error("parentheses must be omitted if attribute argument list is empty")
+        toks = []
+        depth = 0
+        while depth or not self.at(")"):
+            if self.at_eof():
+                self.error("unterminated attribute list")
+            t = self.next()
+            if t.kind == TokenKind.PUNCT and t.text == "(":
+                depth += 1
+            elif t.kind == TokenKind.PUNCT and t.text == ")":
+                depth -= 1
+            toks.append(t)
+        self.expect(")")
+        if len(toks) != 1 or toks[0].kind != TokenKind.STRING:
+            self.error(f"expected string literal in '{name}' attribute")
+

+# Generic (non-_n) forms: 0-based indices of arguments that point at the value/result
+# object (their pointee must be a data type, not a function).
+_PTR_VALUE_ARGS = {
+    "__atomic_exchange": (1, 2), "__atomic_compare_exchange": (1, 2),
+    "__atomic_load": (1,), "__atomic_store": (1,),
+}
+
+
+def _is_ptr_to_function(ty) -> bool:
+    return T.is_pointer_like(ty) and ty.base is not None and ty.base.kind is T.TypeKind.FUNC
+

index 00000000..15326533
--- /dev/null
+++ b/hcc/selftest/struct_too_large.c
@@ -0,0 +1,4 @@
+// EXPECT-ERROR: too large
+// A struct whose size exceeds the maximum object size (PTRDIFF_MAX) is rejected.

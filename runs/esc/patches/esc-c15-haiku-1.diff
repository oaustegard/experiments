@@ -0,0 +1,7 @@
+// EXPECT-ERROR: unavailable
+// __attribute__((unavailable)) on a function: any use of the name is an error.
+void func(void);
+void func(void) __attribute__((unavailable));
+void f(void) {
+    func();
+}

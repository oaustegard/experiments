diff --git a/hcc/parser/atomic_builtins.py b/hcc/parser/atomic_builtins.py
index 9ea27ebe..0401e518 100644
--- a/hcc/parser/atomic_builtins.py
+++ b/hcc/parser/atomic_builtins.py
@@ -42,6 +42,31 @@ ATOMIC_BUILTINS = (_VALUE_RET | _INT_RET | _VOID_RET | _FLAG_BOOL_RET | SYNC_BUI
                    | _LOCK_FREE_NAMES)
 
 
+_GENERIC_PTR_ARGS = {"__atomic_load": 2, "__atomic_store": 2, "__atomic_exchange": 3,
+                     "__atomic_compare_exchange": 3}
+
+
+def _rvalue_array(node) -> bool:
+    """An array that is a member of a call result (an rvalue; it does not decay in C90)."""
+    if node.ty.kind not in (T.TypeKind.ARRAY, T.TypeKind.VLA):
+        return False
+    while type(node).__name__ == "Member_":
+        node = node.operand
+        if type(node).__name__ == "Call":
+            return True
+    return False
+
+
+def _check_generic_ptrs(parser, name, args, tok):
+    for i in range(min(_GENERIC_PTR_ARGS[name], len(args))):
+        a = args[i]
+        if a.ty.kind != T.TypeKind.PTR and not (T.is_pointer_like(a.ty) and not _rvalue_array(a)):
+            what = "a non-void pointer type" if i == 0 else "a pointer type"
+            parser.error(f"argument {i + 1} of '{name}' must be {what}", tok)
+        if i == 0 and a.ty.kind == T.TypeKind.PTR and a.ty.base.unqual().kind is T.TypeKind.VOID:
+            parser.error(f"argument 1 of '{name}' must be a non-void pointer type", tok)
+
+
 def atomic_call(parser, tok):
     """Parse the argument list (the '(' is already consumed) of an __atomic_* call."""

diff --git a/hcc/parser/enums.py b/hcc/parser/enums.py
index 1c1f776f..1bf1b56e 100644
--- a/hcc/parser/enums.py
+++ b/hcc/parser/enums.py
@@ -69,7 +69,14 @@ class EnumMixin:
             if (prev is not None and prev.kind == T.TypeKind.ENUM and id(prev) in def_pos
                     and def_pos[id(prev)] != brace_pos):
                 self.error(f"redeclaration of 'enum {tag.text}'", tag)
-        ty = T.enum_type()
+        # `enum e; typedef enum e e; enum e {...};`: complete the forward-declared
+        # object in place so earlier typedefs/declarations see the definition.
+        fwd = self.scopes[-1].tags.get(tag.text) if tag is not None else None
+        if fwd is not None and fwd.kind == T.TypeKind.ENUM and fwd.enum_consts == "fwd":
+            ty = fwd
+            ty.enum_consts = None
+        else:
+            ty = T.enum_type()
         ty.tag = tag.text if tag else None
         if tag is not None:
             def_pos[id(ty)] = brace_pos
diff --git a/hcc/selftest/parse_enum_fwd_complete.c b/hcc/selftest/parse_enum_fwd_complete.c
new file mode 100644
index 00000000..71550371
--- /dev/null
+++ b/hcc/selftest/parse_enum_fwd_complete.c
@@ -0,0 +1,6 @@
+// EXPECT-EXIT: 0
+// An enum forward-declared through a typedef is completed by a later definition.
+typedef enum OP OP;
+enum OP { OP_A, OP_B = 5 };
+static int f(int a, OP op) { return a + (int)op; }
+int main(void) { return f(1, OP_B) == 6 ? 0 : 1; }

index 00000000..ef57bc05
--- /dev/null
+++ b/hcc/selftest/parser_union_as_condition.c
@@ -0,0 +1,4 @@
+// EXPECT-ERROR: used union type value where scalar is required
+// A union (or struct) value used as a condition or cast to a scalar is an error.
+union u { int x; };
+int f(union u v) { if (v) return 1; return 0; }

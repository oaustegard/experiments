@@ -49,7 +49,7 @@ def _make_scanner(line_comments: bool, u8_chars: bool) -> "re.Pattern[str]":
         # C89/C90 have no `//` comments: drop the `lc` alternative.
         src = src.replace(r"  | (?P<lc>//[^\n]*)" + "\n", "")

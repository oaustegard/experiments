@@ -0,0 +1,12 @@
+// EXPECT-EXIT: 0
+// Bare or unknown #pragma scalar_storage_order args only warn; state is unchanged.
+#pragma scalar_storage_order
+#pragma scalar_storage_order big-endian
+#pragma scalar_storage_order other
+struct S1 { int i; };
+struct S1 a = { 0x12345678 };
+unsigned char be[4] = { 0x12, 0x34, 0x56, 0x78 };
+int main(void) {
+    if (__builtin_memcmp(&a, be, 4)) return 1;
+    return 0;
+}

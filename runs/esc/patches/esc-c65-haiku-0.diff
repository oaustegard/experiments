+    def _check_optional_string_arg(self, name) -> None:
+        """Validate `(...)` after a C23 attribute taking one optional string literal."""
+        start = self.pos
+        self.skip_balanced()
+        args = self.toks[start + 1:self.pos - 1]
+        if not args:
+            self.error("parentheses must be omitted if attribute argument list is empty")
+        if len(args) != 1 or args[0].kind != TokenKind.STRING:
+            self.error(f"expected string literal as argument of '{name}' attribute")

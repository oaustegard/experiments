                    | _LOCK_FREE_NAMES)
 
 
+# Zero-based indices of operands that must be pointers in the generic (non-_n) forms.
+_GENERIC_PTR_ARGS = {
+    "__atomic_load": (1,),
+    "__atomic_store": (1,),
+    "__atomic_exchange": (1, 2),
+    "__atomic_compare_exchange": (1, 2),
+}
+
+
+def _is_pointer_operand(node) -> bool:
+    """A pointer, or an array that decays to one. Array rvalues (e.g. `f().a`) do not decay."""
+    if node.ty.kind is T.TypeKind.PTR:
+        return True
+    if node.ty.kind is not T.TypeKind.ARRAY:
+        return False
+    inner = node
+    while type(inner).__name__ in ("Member_", "Cast"):
+        inner = inner.operand
+    return type(inner).__name__ in ("VarRef", "Deref", "StrLit")
+

@@ -95,10 +97,12 @@ class LocalDeclMixin:
                     return items
                 continue
             if attr.is_extern:
+                self.check_extern_conflict(ty, name)
                 var = self.declare_global_var(ty, name, attr, dattr)
                 self.push_scope_entry(name.text).var = var
                 continue
             if attr.is_static:

@@ -171,6 +176,18 @@ class LocalDeclMixin:
                 items.append(self.cleanup_decl(var, cleanup, name))
         return items
 
+    def reject_local_redecl(self, name) -> None:
+        """An object declared without linkage may not redeclare a name of the same block scope."""
+        if len(self.scopes) > 1 and name.text in self.scopes[-1].vars:
+            self.error(f"redeclaration of '{name.text}' with no linkage", name)
+
+    def check_extern_conflict(self, ty, name) -> None:
+        """A block-scope extern declaration must agree with the file-scope object."""
+        vs = self.scopes[0].vars.get(name.text)
+        old = getattr(vs.var, "ty", None) if vs is not None and vs.var is not None else None
+        if old is not None and not is_compatible(old, ty):
+            self.error(f"conflicting types for '{name.text}'", name)
+
     def cleanup_decl(self, var, handler: str, name):
         """__attribute__((cleanup(f))) on a local: the statement f(&var), which codegen
         runs when the variable's block is left (see codegen/cleanup.py)."""

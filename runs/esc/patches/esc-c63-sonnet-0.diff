+    def check_register_subscript(self, node, t):
+        """Subscripting a `register` array needs its address (rejected before C2Y)."""
+        if node.ty is None or node.ty.kind != TypeKind.ARRAY:
+            return
+        if (getattr(self.opts, "std", None) or "").lower() in ("c2y", "gnu2y", "c26", "gnu26"):
+            return
+        root = node
+        while isinstance(root, N.Member_):
+            root = root.operand
+        if isinstance(root, N.VarRef) and getattr(root.var, "is_register", False):
+            self.error(f"address of register variable '{root.var.name}' requested", t)
+

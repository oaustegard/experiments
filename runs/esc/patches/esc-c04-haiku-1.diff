diff --git a/hcc/parser/enums.py b/hcc/parser/enums.py
index 1c1f776f..89998a87 100644
--- a/hcc/parser/enums.py
+++ b/hcc/parser/enums.py
@@ -69,7 +69,14 @@ class EnumMixin:
             if (prev is not None and prev.kind == T.TypeKind.ENUM and id(prev) in def_pos
                     and def_pos[id(prev)] != brace_pos):
                 self.error(f"redeclaration of 'enum {tag.text}'", tag)
-        ty = T.enum_type()
+        # `enum E;` (or a typedef of it) earlier in this scope is completed in
+        # place, so existing references to the forward type see the body.
+        fwd = self.scopes[-1].tags.get(tag.text) if tag is not None else None
+        if fwd is not None and fwd.kind == T.TypeKind.ENUM and fwd.enum_consts == "fwd":
+            ty = fwd
+            ty.enum_consts = None
+        else:
+            ty = T.enum_type()
         ty.tag = tag.text if tag else None
         if tag is not None:
             def_pos[id(ty)] = brace_pos
diff --git a/hcc/selftest/enum_fwd_typedef_complete.c b/hcc/selftest/enum_fwd_typedef_complete.c
new file mode 100644
index 00000000..69030e24
--- /dev/null
+++ b/hcc/selftest/enum_fwd_typedef_complete.c
@@ -0,0 +1,7 @@
+// EXPECT-EXIT: 0
+// A typedef of a forward-declared enum is completed by the later enum body,
+// so it can be a parameter type of a function definition.
+typedef enum E E;
+enum E { A, B };
+static int f(int x, E op) { return x + (int)op; }
+int main(void) { return f(1, B) - 2; }

@@ -0,0 +1,5 @@
+// EXPECT-ERROR: unknown asm operand name
+// Extended asm with no operands must still substitute '%[name]': an unknown
+// name is a compile error, not text emitted verbatim.
+void h(void) { asm("%[missing]" : : ); }
+int main(void) { return 0; }

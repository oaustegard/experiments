+def _hides_file_scope(parser, name: str) -> bool:
+    """True when `name` is currently declared by a block-scope object (no linkage),
+    hiding any file-scope declaration of the same name."""
+    vs = parser.find_var(name)
+    if vs is None or vs is parser.scopes[0].vars.get(name):
+        return False
+    return isinstance(vs.var, N.Var) and vs.var.is_local
+
+
 def _has_vla_member(ty) -> bool:
     """True when an object of type ty is, or contains by value, a VLA
     (e.g. a struct with a variable-length array member, or an array of such)."""
@@ -95,7 +104,12 @@ class LocalDeclMixin:
                     return items
                 continue
             if attr.is_extern:
-                var = self.declare_global_var(ty, name, attr, dattr)
+                if _hides_file_scope(self, name.text):
+                    # C11 6.2.2p4: the visible prior declaration is a block-scope object,
+                    # so this extern declaration does not take the file-scope object's type.
+                    var = N.Var(name.text, ty, loc=name.loc, align=ty.align, is_extern=True)
+                else:
+                    var = self.declare_global_var(ty, name, attr, dattr)
                 self.push_scope_entry(name.text).var = var

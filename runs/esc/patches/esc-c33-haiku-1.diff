--- /dev/null
+++ b/hcc/selftest/parse_extern_shadowed_local.c
@@ -0,0 +1,11 @@
+// EXPECT-EXIT: 0
+// A block-scope extern declaration whose name is hidden by a block-scope object
+// does not inherit the file-scope array's size.
+int a[1] = { 0 };
+int main(void) {
+    int a = 3;
+    {
+        extern int a[];
+        return sizeof(a[0]) == sizeof(int) ? 0 : 1;
+    }
+}

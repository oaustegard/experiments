diff --git a/hcc/parser/unavailable.py b/hcc/parser/unavailable.py
new file mode 100644
index 00000000..c0dda052
--- /dev/null
+++ b/hcc/parser/unavailable.py
@@ -0,0 +1,26 @@
+"""__attribute__((unavailable("msg"))) on a declaration: its type is marked unusable.
+
+UnavailableMixin.unavailable_decl(ty, attr, name): when the declaration's specifier
+attribute carries `unavailable`, returns a copy of `ty` marked with the message and
+reports "type is unavailable: msg" for an object declaration (typedefs only mark the
+type). typeof() of such a type is rejected in declspec.py.
+"""
+from __future__ import annotations
+
+from hcc import typesys as T
+
+
+class UnavailableMixin:
+
+    def unavailable_decl(self, ty, attr, name):
+        if ty is None or ty.kind == T.TypeKind.FUNC:
+            return ty
+        msg = attr.unavailable if attr is not None and attr.unavailable is not None else ty.unavailable
+        if msg is None:
+            return ty
+        if ty.unavailable != msg:
+            ty = ty.copy()
+            ty.unavailable = msg
+        if attr is None or not attr.is_typedef:
+            self.error(f"type is unavailable: {msg}", name)
+        return ty

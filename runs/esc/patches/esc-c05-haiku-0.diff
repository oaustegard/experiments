+def _is_rvalue_array(node) -> bool:
+    """An array-typed expression that is not an lvalue (e.g. a member of a call result)."""
+    return node.ty.kind is T.TypeKind.ARRAY and is_rvalue_operand(node)
+
+
+def _check_pointer_args(parser, name, args, tok):
+    """gcc: argument 1 must be a non-void pointer; for the generic forms the other
+    operands listed in _POINTER_ARGS must be pointers. A non-lvalue array (e.g. a
+    member of a call result) does not count as a pointer here."""
+    for i in (0,) + _POINTER_ARGS.get(name, ()):
+        if i >= len(args):
+            return
+        ty = args[i].ty
+        if i == 0:
+            if _is_rvalue_array(args[0]) or ty.base.unqual().kind is T.TypeKind.VOID:
+                parser.error(f"argument 1 of '{name}' must be a non-void pointer type", tok)
+        elif not T.is_pointer_like(ty) or _is_rvalue_array(args[i]):
+            parser.error(f"argument {i + 1} of '{name}' must be a pointer type", tok)
+

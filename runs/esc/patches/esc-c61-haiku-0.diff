diff --git a/hcc/selftest/parser_tag_wrong_kind.c b/hcc/selftest/parser_tag_wrong_kind.c
new file mode 100644
index 00000000..fcbb0129
--- /dev/null
+++ b/hcc/selftest/parser_tag_wrong_kind.c
@@ -0,0 +1,4 @@
+// EXPECT-ERROR: wrong kind of tag
+// A qualified empty declaration does not redeclare a tag visible from an outer scope; a different kind is an error.
+union u3 { float v; };
+void h(void) { const struct u3; }

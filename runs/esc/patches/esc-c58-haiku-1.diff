diff --git a/hcc/sema/compat.py b/hcc/sema/compat.py
index 2be59045..17619323 100644
--- a/hcc/sema/compat.py
+++ b/hcc/sema/compat.py
@@ -19,12 +19,24 @@ def _enum_as_int(t: Type) -> Type:
     return Type(kind, t.size, t.align, bool(t.is_unsigned))
 
 
+_SMALL_INTS = (TypeKind.CHAR, TypeKind.SHORT, TypeKind.BOOL)
+
+
+def _promotion_invariant(t: Type) -> bool:
+    """True if default argument promotions leave type `t` unchanged."""
+    if t.kind == TypeKind.FLOAT or t.kind in _SMALL_INTS:
+        return False
+    return True
+
+
 def is_compatible(a: Type, b: Type) -> bool:
     if a is b:
         return True
     if a.is_const != b.is_const or a.is_volatile != b.is_volatile or a.is_atomic != b.is_atomic:
         return False
     if a.kind != b.kind:
+        if {a.kind, b.kind} <= {TypeKind.ARRAY, TypeKind.VLA}:   # VLA vs array: lengths unchecked
+            return is_compatible(a.base, b.base)
         if a.kind == TypeKind.ENUM and b.kind != TypeKind.ENUM:
             return is_compatible(_enum_as_int(a), b)
         if b.kind == TypeKind.ENUM and a.kind != TypeKind.ENUM:
@@ -45,10 +57,15 @@ def is_compatible(a: Type, b: Type) -> bool:
         if not is_compatible(a.return_ty, b.return_ty):
             return False
         if not a.has_proto or not b.has_proto:
-            return True
+            # C11 6.7.6.3p15: an unprototyped declaration is compatible with a
+            # prototype only if no parameter is changed by default promotions.
+            proto = b if not a.has_proto else a
+            return all(_promotion_invariant(p.unqual()) for p in proto.params)
         if a.is_variadic != b.is_variadic or len(a.params) != len(b.params):
             return False
         return all(is_compatible(x.unqual(), y.unqual()) for x, y in zip(a.params, b.params))
+    if k == TypeKind.VLA:
+        return is_compatible(a.base, b.base)
     if k == TypeKind.ARRAY:
         if not is_compatible(a.base, b.base):
             return False

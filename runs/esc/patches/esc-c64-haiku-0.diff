@@ -8,10 +8,19 @@ to (unsigned) long when values don't fit in 32 bits.
 from __future__ import annotations
 
 from hcc.parser.scope import VarAttr
+from hcc.parser.attributes import MODE_SIZES
 from hcc.tokens import TokenKind
 from hcc import typesys as T
 
 
+def values_fit_bytes(lo, hi, size):
+    """True if every enumerator value in [lo, hi] fits a `size`-byte integer mode."""
+    bits = size * 8
+    if lo < 0:
+        return lo >= -(1 << (bits - 1)) and hi < (1 << (bits - 1))
+    return hi < (1 << bits)
+
+
 def fits_type(v, ty):
     """True if integer value v is representable in integer type ty."""
     bits = ty.size * 8

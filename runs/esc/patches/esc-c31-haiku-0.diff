@@ -42,6 +42,19 @@ ATOMIC_BUILTINS = (_VALUE_RET | _INT_RET | _VOID_RET | _FLAG_BOOL_RET | SYNC_BUI
                    | _LOCK_FREE_NAMES)
 
 
+# Generic (size-less) builtins whose arguments after the first are pointers to the value.
+_GENERIC_PTR_ARGS = frozenset(["__atomic_load", "__atomic_store", "__atomic_exchange",
+                               "__atomic_compare_exchange"])
+
+
+def _check_generic_operands(parser, name, args, tok):
+    """gcc: the value pointers of the generic __atomic_* forms must not point to functions."""
+    for i, a in enumerate(args[1:3], start=2):
+        t = a.ty
+        if T.is_pointer_like(t) and t.base is not None and t.base.kind is T.TypeKind.FUNC:
+            parser.error(f"argument {i} of '{name}' must not be a pointer to a function", tok)
+
+
 def atomic_call(parser, tok):
     """Parse the argument list (the '(' is already consumed) of an __atomic_* call."""
     name = tok.text
@@ -69,6 +82,8 @@ def atomic_call(parser, tok):
             # gcc (PR 68966): arithmetic/bitwise RMW on _Bool would break its representation.
             parser.error(f"operand type '{args[0].ty.base}' is incompatible with argument 1 "
                          f"of '{name}'", tok)

+    def _check_aligned_value(self, val, args_start) -> None:
+        """GCC limits aligned(N) on ELF targets to 1 << 28 (MAX_OFILE_ALIGNMENT)
+        and requires a power of two; anything else is a hard error."""
+        tok = self.toks[args_start - 1] if args_start > 0 else None
+        if val > (1 << 28):
+            self.error("requested alignment '%d' exceeds maximum %d" % (val, 1 << 28), tok)
+        elif val > 0 and val & (val - 1):
+            self.error("requested alignment is not a power of 2", tok)

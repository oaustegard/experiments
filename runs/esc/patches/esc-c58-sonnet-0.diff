diff --git a/hcc/sema/compat.py b/hcc/sema/compat.py
index 2be59045..9c6321c3 100644
--- a/hcc/sema/compat.py
+++ b/hcc/sema/compat.py
@@ -19,11 +19,18 @@ def _enum_as_int(t: Type) -> Type:
     return Type(kind, t.size, t.align, bool(t.is_unsigned))
 
 
+def _promotes(t: Type) -> bool:
+    """True if default argument promotion would change `t` (C11 6.7.6.3p15)."""
+    return t.kind in (TypeKind.BOOL, TypeKind.CHAR, TypeKind.SHORT, TypeKind.FLOAT)
+
+
 def is_compatible(a: Type, b: Type) -> bool:
     if a is b:
         return True
     if a.is_const != b.is_const or a.is_volatile != b.is_volatile or a.is_atomic != b.is_atomic:
         return False
+    if TypeKind.VLA in (a.kind, b.kind) and {a.kind, b.kind} <= {TypeKind.VLA, TypeKind.ARRAY}:
+        return is_compatible(a.base, b.base)      # variable length: unknowable statically
     if a.kind != b.kind:
         if a.kind == TypeKind.ENUM and b.kind != TypeKind.ENUM:
             return is_compatible(_enum_as_int(a), b)
@@ -45,6 +52,10 @@ def is_compatible(a: Type, b: Type) -> bool:
         if not is_compatible(a.return_ty, b.return_ty):
             return False
         if not a.has_proto or not b.has_proto:
+            p = b if not a.has_proto else a          # the prototyped side, if any
+            if p.has_proto and (p.is_variadic or any(
+                    _promotes(x) for x in p.params)):
+                return False
             return True
         if a.is_variadic != b.is_variadic or len(a.params) != len(b.params):
             return False

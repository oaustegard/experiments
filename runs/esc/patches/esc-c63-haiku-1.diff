+    def check_register_subscript(self, node, tok) -> None:
+        """Subscripting a `register` array is a pedantic error before C2Y (gcc -pedantic-errors)."""
+        opts = self.opts
+        if opts is None or not getattr(opts, "pedantic_errors", False):
+            return
+        if (opts.std or "").lower() in ("c2y", "gnu2y"):
+            return
+        if not isinstance(node, N.VarRef) or node.var.ty is None:
+            return
+        if node.var.ty.kind == TypeKind.ARRAY and getattr(node.var, "is_register", False):
+            self.error("ISO C forbids subscripting 'register' array before C2Y", tok)
+

diff --git a/hcc/selftest/sema_incdec_incomplete_ptr.c b/hcc/selftest/sema_incdec_incomplete_ptr.c
new file mode 100644
index 00000000..a68ac749
--- /dev/null
+++ b/hcc/selftest/sema_incdec_incomplete_ptr.c
@@ -0,0 +1,4 @@
+// EXPECT-ERROR: [sema] increment of pointer to an incomplete type
+// Pointer ++/-- on a pointer to an incomplete struct is a constraint violation.
+struct a *q;
+void f(void) { q++; }
diff --git a/hcc/sema/arith.py b/hcc/sema/arith.py
index d4dd6206..a085e353 100644
--- a/hcc/sema/arith.py
+++ b/hcc/sema/arith.py
@@ -200,6 +200,19 @@ def _addressed_place(lhs, loc, new_temp):
     return pre, make_place
 
 
+def _check_incdec_pointee(ty, delta: int, loc):
+    """C11 6.5.2.4p1 / 6.5.3.1p1: ++/-- on a pointer needs a complete object
+    pointee (incomplete struct/union/enum or `T[]`). void and function
+    pointees are GNU extensions and stay accepted."""
+    if ty.kind != TypeKind.PTR or ty.base is None:
+        return
+    pointee = ty.base
+    if pointee.kind in (TypeKind.VOID, TypeKind.FUNC) or pointee.is_complete:
+        return
+    what = "increment" if delta > 0 else "decrement"
+    diag.error(loc, f"{what} of pointer to an incomplete type '{pointee}'", "sema")
+
+
 def inc_dec(lhs, delta: int, is_post: bool, loc, new_temp):
     """`++a` / `--a` yield the new value; `a++` / `a--` yield the old value.
 
@@ -207,6 +220,7 @@ def inc_dec(lhs, delta: int, is_post: bool, loc, new_temp):
     afterwards: the store may wrap (e.g. a 1-bit bit-field), so `new - delta`
     is wrong in general.  The lvalue address is evaluated only once."""
     add_type(lhs)
+    _check_incdec_pointee(lhs.ty, delta, loc)
     one = N.IntLit(loc, delta, ty=TY_INT)
     if not is_post:
         return compound_assign("+", lhs, one, loc, new_temp)

+def _has_setjmp(node) -> bool:
+    if type(node).__name__ == "BuiltinCall" and node.name == "setjmp":
+        return True
+    if isinstance(node, list):
+        return any(_has_setjmp(x) for x in node)
+    if not is_dataclass(node):
+        return False
+    return any(_has_setjmp(getattr(node, f.name, None)) for f in fields(node)
+               if f.name not in ("ty", "var", "member", "loc", "scope"))
+

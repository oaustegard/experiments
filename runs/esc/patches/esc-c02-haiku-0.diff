diff --git a/hcc/parser/pragma_sso.py b/hcc/parser/pragma_sso.py
index 79680ed9..cc3ba4ba 100644
--- a/hcc/parser/pragma_sso.py
+++ b/hcc/parser/pragma_sso.py
@@ -24,5 +24,11 @@ def consume_sso_marker(parser) -> None:
         parser.sso_reverse = False
     elif arg == "default":
         parser.sso_reverse = parser.sso_default
+    elif not arg:
+        # GCC: a bare pragma is only a warning; the current state is kept.
+        diag.warn(tok, "missing 'big-endian', 'little-endian', or 'default' "

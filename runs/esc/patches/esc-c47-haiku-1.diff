diff --git a/hcc/parser/local_redecl.py b/hcc/parser/local_redecl.py
new file mode 100644
index 00000000..9e5c7a0a
--- /dev/null
+++ b/hcc/parser/local_redecl.py
@@ -0,0 +1,37 @@
+"""Block-scope redeclaration checks (C11 6.2.1p4, 6.2.2p4, 6.7p3).
+
+* A second declaration of an identifier in the same block scope is an error,
+  unless both are `extern` (or function declarations) with compatible types.
+* A block-scope `extern` object or function declaration must have a type
+  compatible with any visible prior declaration of the same identifier.
+"""
+from __future__ import annotations
+
+from hcc import nodes as N
+from hcc import typesys as T
+from hcc.sema.compat import is_compatible
+
+
+class LocalRedeclMixin:
+
+    def check_local_redecl(self, name, ty, attr) -> None:
+        """Diagnose a conflicting block-scope declaration of `name` with type `ty`."""
+        links = attr.is_extern or (ty.kind == T.TypeKind.FUNC and not attr.is_static
+                                   and not attr.is_typedef)
+        cur = self.scopes[-1].vars.get(name.text)
+        if cur is not None and cur.var is not None:
+            prev = cur.var
+            prev_links = isinstance(prev, N.Function) or getattr(prev, "is_extern", False)
+            if not (links and prev_links and is_compatible(prev.ty, ty)):
+                self.error(f"conflicting types for '{name.text}'", name)
+            return
+        if not links:
+            return
+        for sc in reversed(self.scopes[:-1]):
+            vs = sc.vars.get(name.text)
+            if vs is None:
+                continue
+            if vs.var is not None and isinstance(vs.var, (N.Var, N.Function)):
+                if not is_compatible(vs.var.ty, ty):
+                    self.error(f"conflicting types for '{name.text}'", name)
+            return

diff --git a/hcc/selftest/parser_local_extern_conflict.c b/hcc/selftest/parser_local_extern_conflict.c
new file mode 100644
index 00000000..52189a1b
--- /dev/null
+++ b/hcc/selftest/parser_local_extern_conflict.c
@@ -0,0 +1,7 @@
+// EXPECT-ERROR: conflicting types
+// A block-scope extern declaration must match the file-scope declaration's type.
+extern int foo;
+int main(void) {
+    extern double foo;
+    return 0;
+}
diff --git a/hcc/selftest/parser_local_extern_ok.c b/hcc/selftest/parser_local_extern_ok.c
new file mode 100644
index 00000000..0325d1eb
--- /dev/null
+++ b/hcc/selftest/parser_local_extern_ok.c
@@ -0,0 +1,10 @@
+// EXPECT-EXIT: 3
+// Compatible block-scope extern redeclarations and shadowing by a non-extern local are valid.
+extern int g;
+int g = 3;
+int f(void) { extern int g; return g; }
+int main(void) {
+    extern int g;
+    { double g = 1.0; (void)g; }
+    return f();
+}

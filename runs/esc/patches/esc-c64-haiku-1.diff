 # function attributes hcc records by name only (queried via __builtin_has_attribute)
 RECORDED_FN_ATTRS = frozenset({"leaf", "returns_nonnull"})
 
-MODE_SIZES = {"QI": 1, "HI": 2, "SI": 4, "DI": 8, "TI": 16, "word": 8}

     def stmt_CleanupDecl(self, node) -> None:
         self.cleanup_stack.append(node.call)
+        self.mark_cleanup_state()
+
+    def mark_cleanup_state(self) -> None:
+        """Start a new LSDA call-site region: the pending cleanups changed here."""
+        label = self.new_label()
+        self.label(label)
+        self.cs_regions.append((label, tuple(self.cleanup_stack)))
+
+    def emit_unwind_tables(self, start_idx: int, start: str, end: str, size: int) -> None:
+        """Landing pads + LSDA so a forced/exception unwind runs the pending cleanups.
+        `start_idx` is the index in self.out of the `.cfi_startproc` line."""
+        regions = self.cs_regions
+        if not any(st for _, st in regions):
+            return
+        pads: dict[tuple, str] = {}
+        for _, st in regions:
+            if st and st not in pads:
+                pads[st] = self.new_label()
+        saved = self.cleanup_stack
+        for st, pad in pads.items():
+            self.label(pad)
+            self.cleanup_stack = []
+            self.emit(f"lea {-size}(%rbp), %rsp")
+            self.emit("sub $16, %rsp")
+            self.emit("mov %rax, (%rsp)")
+            self.depth = 2
+            for call in reversed(st):
+                self.gen_expr(call)
+                self.discard_value(call.ty)
+            self.emit("mov (%rsp), %rdi")
+            self.emit("call _Unwind_Resume@PLT")
+            self.depth = 0
+        self.cleanup_stack = saved
+        lsda = self.new_label()
+        self.out.insert(start_idx + 1, f"  .cfi_lsda 0x1b, {lsda}")
+        self.out.insert(start_idx + 1, "  .cfi_personality 0x1b, __gcc_personality_v0")
+        self.directive(".pushsection .gcc_except_table,\"a\",@progbits")
+        self.directive(".align 4")
+        self.label(lsda)
+        cs, cse = self.new_label(), self.new_label()
+        self.directive(".byte 0xff")
+        self.directive(".byte 0xff")
+        self.directive(".byte 0x1")
+        self.directive(f".uleb128 {cse}-{cs}")
+        self.label(cs)
+        bounds = [r[0] for r in regions] + [end]
+        for i, (lab, st) in enumerate(regions):
+            self.directive(f".uleb128 {lab}-{start}")
+            self.directive(f".uleb128 {bounds[i + 1]}-{lab}")
+            self.directive(f".uleb128 {pads[st] + '-' + start if st else 0}")
+            self.directive(".uleb128 0")
+        self.label(cse)
+        self.directive(".popsection")
 
     def run_cleanups(self, depth: int) -> None:
         """Emit the cleanup calls pushed above `depth`, innermost first."""

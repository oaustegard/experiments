diff --git a/hcc/selftest/cleanup_forced_unwind.c b/hcc/selftest/cleanup_forced_unwind.c
new file mode 100644
index 00000000..caa6beb4
--- /dev/null
+++ b/hcc/selftest/cleanup_forced_unwind.c
@@ -0,0 +1,19 @@
+// EXPECT-EXIT: 0
+// A forced unwind runs __attribute__((cleanup)) handlers (needs CFI + LSDA).
+#include <unwind.h>
+#include <stdlib.h>
+#include <string.h>
+static _Unwind_Reason_Code stop(int v, _Unwind_Action a, _Unwind_Exception_Class c,
+    struct _Unwind_Exception *e, struct _Unwind_Context *x, void *p)
+{ if (a & _UA_END_OF_STACK) abort(); return _URC_NO_REASON; }
+static void handler(void *p) { exit(0); }
+static void doit(void)
+{
+  char d __attribute__((cleanup(handler)));
+  struct _Unwind_Exception *e = malloc(sizeof *e);
+  memset(&e->exception_class, 0, sizeof e->exception_class);
+  e->exception_cleanup = 0;
+  _Unwind_ForcedUnwind(e, stop, 0);
+  abort();
+}
+int main(void) { doit(); abort(); }

@@ -0,0 +1,3 @@
+// EXPECT-ERROR: second argument to 'va_arg' is a function type
+#include <stdarg.h>
+void foo(int s, ...) { va_list ap; va_start(ap, s); int e = va_arg(ap, int(void))(); va_end(ap); }

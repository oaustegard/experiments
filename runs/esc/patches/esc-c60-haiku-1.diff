index 00000000..92953ede
--- /dev/null
+++ b/hcc/selftest/parser_array_elem_align.c
@@ -0,0 +1,5 @@
+// EXPECT-ERROR: [parse]
+// Array elements whose alignment exceeds their size are invalid (GCC: alignment of array elements is greater than element size).
+typedef int A __attribute__((aligned (2 * sizeof (int))));
+A a[4];
+int main(void) { return 0; }

+++ b/hcc/selftest/decl_block_extern_incomplete.c
@@ -0,0 +1,7 @@
+// EXPECT-ERROR: incomplete
+// A block-scope `extern T a[];` keeps its incomplete type even when a complete file-scope a exists.
+int a[1] = { 0 };
+int main(void) {
+    extern int a[];
+    return (int)sizeof(a);
+}

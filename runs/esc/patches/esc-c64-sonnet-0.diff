diff --git a/hcc/parser/enums.py b/hcc/parser/enums.py
index 1c1f776f..8dd58af6 100644
--- a/hcc/parser/enums.py
+++ b/hcc/parser/enums.py
@@ -7,6 +7,7 @@ to (unsigned) long when values don't fit in 32 bits.
 """
 from __future__ import annotations
 
+from hcc.parser.attributes import MODE_SIZES
 from hcc.parser.scope import VarAttr
 from hcc.tokens import TokenKind
 from hcc import typesys as T
@@ -117,7 +118,17 @@ class EnumMixin:
             ty.is_unsigned = False
         elif hi >= 1 << 32:
             ty.size = ty.align = 8
-        self.parse_attributes(attr if attr is not None else VarAttr())   # `enum {..} __attribute__((mode(word)))`
+        tail = attr if attr is not None else VarAttr()
+        self.parse_attributes(tail)   # `enum {..} __attribute__((mode(word)))`
+        msize = MODE_SIZES.get(tail.mode) if tail.mode else None
+        if msize is not None and fixed is None:
+            bits = msize * 8
+            if lo < 0:
+                ok = lo >= -(1 << (bits - 1)) and hi < (1 << (bits - 1))
+            else:
+                ok = hi < (1 << bits)
+            if not ok:
+                self.error("specified mode too small for enumerated values", self.tok)
         if tag is not None:
             self.scopes[-1].tags[tag.text] = ty
         return ty

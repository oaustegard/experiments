+// EXPECT-ERROR: [sema] increment of pointer to an incomplete type
+struct a *q;
+void f(void) { q++; }
diff --git a/hcc/sema/arith.py b/hcc/sema/arith.py
index d4dd6206..9760459a 100644
--- a/hcc/sema/arith.py
+++ b/hcc/sema/arith.py
@@ -207,6 +207,11 @@ def inc_dec(lhs, delta: int, is_post: bool, loc, new_temp):
     afterwards: the store may wrap (e.g. a 1-bit bit-field), so `new - delta`
     is wrong in general.  The lvalue address is evaluated only once."""
     add_type(lhs)
+    if lhs.ty.kind == TypeKind.PTR and lhs.ty.base is not None:

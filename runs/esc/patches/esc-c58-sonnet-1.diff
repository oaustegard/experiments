new file mode 100644
index 00000000..dffa161f
--- /dev/null
+++ b/hcc/parser/redecl.py
@@ -0,0 +1,26 @@
+"""Conflicting-type diagnostics for file-scope redeclarations (C11 6.7p4)."""
+from hcc import typesys as T
+from hcc.sema.compat import is_compatible
+
+_C23_STDS = ("c23", "gnu23", "c2x", "gnu2x")
+
+
+class RedeclMixin:
+    def _promotion_affected(self, t) -> bool:
+        t = t.unqual()
+        return t.kind == T.TypeKind.FLOAT or (
+            t.kind in (T.TypeKind.CHAR, T.TypeKind.SHORT, T.TypeKind.BOOL))
+
+    def check_fn_redecl(self, old, new, name) -> None:
+        ok = is_compatible(old, new)
+        if ok and old.has_proto != new.has_proto:
+            std = getattr(self.opts, "std", "gnu17") if self.opts is not None else "gnu17"
+            if std not in _C23_STDS:
+                proto = new if new.has_proto else old
+                ok = not any(self._promotion_affected(p) for p in proto.params)
+        if not ok:
+            self.error(f"conflicting types for '{name.text}'", name.loc)
+
+    def check_var_redecl(self, old, new, name) -> None:
+        if not is_compatible(old, new):
+            self.error(f"conflicting types for '{name.text}'", name.loc)

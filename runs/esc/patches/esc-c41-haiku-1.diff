diff --git a/hcc/parser/scalar_check.py b/hcc/parser/scalar_check.py
new file mode 100644
index 00000000..c337bd13
--- /dev/null
+++ b/hcc/parser/scalar_check.py
@@ -0,0 +1,22 @@
+"""C11 6.5.4 / 6.8.4 / 6.5.13: struct and union values are not scalars.
+
+Used by condition contexts (if/while/for/do, ?:, &&, ||, !) and by casts to a
+scalar type: an aggregate operand there is a hard error, as in gcc.
+"""
+from hcc.typesys import TypeKind, is_scalar
+
+
+def _is_plain_aggregate(ty) -> bool:
+    return ty.kind in (TypeKind.STRUCT, TypeKind.UNION) and not ty.is_complex
+
+
+def require_scalar_operand(parser, node, loc) -> None:
+    """Error if `node` (already typed) is a struct or union value."""
+    if _is_plain_aggregate(node.ty):
+        parser.error("used struct type value where scalar is required", loc)
+
+
+def check_scalar_cast(parser, operand, target, loc) -> None:
+    """Error for a cast of a struct or union value to a scalar type."""
+    if _is_plain_aggregate(operand.ty) and (is_scalar(target) or target.kind == TypeKind.BOOL):
+        parser.error("used struct type value where scalar is required", loc)

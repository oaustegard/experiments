@@ -0,0 +1,13 @@
+// EXPECT-EXIT: 7
+/* #pragma weak on a tentative definition: the symbol must be .weak and
+   must not also be emitted as a common (.comm) symbol. */
+#pragma weak wvar
+int wvar;
+int later;
+#pragma weak later
+
+int main(void) {
+    wvar = 3;
+    later = 4;
+    return wvar + later;
+}

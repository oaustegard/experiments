@@ -24,7 +24,8 @@ class DataMixin:
         size = max(ty.size, 0)
         if var.init_data is None:
             if not var.is_static and not var.is_tls and not var.section \
-                    and not var.is_weak and not var.is_nocommon:
+                    and not var.is_weak and not var.is_nocommon \
+                    and sym not in self.asm_weak_syms:
                 # Tentative definition (C11 6.9.2): emit as a common symbol so
                 # that it merges with a real definition in another object.
                 self.directive(f".comm {sym},{max(size, 1)},{align}")
diff --git a/hcc/selftest/codegen_pragma_weak_tentative.c b/hcc/selftest/codegen_pragma_weak_tentative.c
new file mode 100644
index 00000000..f93ee654
--- /dev/null
+++ b/hcc/selftest/codegen_pragma_weak_tentative.c
@@ -0,0 +1,8 @@
+// EXPECT-EXIT: 0
+// A `#pragma weak` placed before a tentative definition makes the symbol weak:
+// it must go to .bss, not .comm (the assembler rejects weak + common).
+#pragma weak wvar
+int wvar;
+int main(void) {
+    return wvar;
+}

diff --git a/hcc/selftest/complex_incdec.c b/hcc/selftest/complex_incdec.c
new file mode 100644
index 00000000..be44f0f1
--- /dev/null
+++ b/hcc/selftest/complex_incdec.c
@@ -0,0 +1,22 @@
+// EXPECT-EXIT: 0
+// Increment and decrement on complex lvalues (pre and post forms).
+_Complex float a;
+double _Complex d[2];
+int calls;
+double _Complex *pick(void) { calls++; return &d[1]; }
+int main(void) {
+    _Complex float old;
+    a = 1.0f + 2.0f * 1.0fi;
+    ++a;
+    if (__real__ a != 2.0f || __imag__ a != 2.0f) return 1;
+    old = a++;
+    if (__real__ old != 2.0f || __real__ a != 3.0f) return 2;
+    old = a--;
+    if (__real__ old != 3.0f || __real__ a != 2.0f) return 3;
+    old = --a;
+    if (__real__ old != 1.0f || __real__ a != 1.0f) return 4;
+    d[1] = 5.0 + 0.0 * 1.0i;
+    old = (*pick())++;
+    if (calls != 1 || __real__ old != 5.0 || __real__ d[1] != 6.0) return 5;
+    return 0;
+}

diff --git a/hcc/parser/complex_incdec.py b/hcc/parser/complex_incdec.py
new file mode 100644
index 00000000..ad8a8287
--- /dev/null
+++ b/hcc/parser/complex_incdec.py
@@ -0,0 +1,30 @@
+"""`++a`, `a++`, `--a`, `a--` on a complex operand (C23 / GCC: allowed).
+
+The value is `a op= 1` (op is + or -), lowered through complex_compound so the
+parser's complex arithmetic does the work. The post forms save the old value in
+a temporary first. Scalar operands go to sema.arith.inc_dec unchanged.
+"""
+from __future__ import annotations
+
+from hcc import nodes as N
+from hcc.sema.arith import _addressed_place, inc_dec
+from hcc.typesys import TY_INT
+
+
+class ComplexIncDecMixin:
+    def inc_dec_node(self, operand, delta, is_post, loc):
+        if not self.typed(operand).ty.is_complex:
+            return inc_dec(operand, delta, is_post, loc, self.new_temp)
+        op = "+" if delta > 0 else "-"
+        one = N.IntLit(loc, 1, ty=TY_INT)
+        if not is_post:
+            return self.complex_compound(op, operand, one, loc)
+        pre, place = _addressed_place(operand, loc, self.new_temp)
+        old = self.new_temp(operand.ty)
+        save = self.typed(N.Assign(loc, self.typed(N.VarRef(loc, old)), place()))
+        update = self.complex_compound(op, place(), one, loc)
+        read = self.typed(N.VarRef(loc, old))
+        result = self.typed(N.Comma(loc, save, self.typed(N.Comma(loc, update, read))))
+        for e in reversed(pre):
+            result = self.typed(N.Comma(loc, e, result))
+        return result

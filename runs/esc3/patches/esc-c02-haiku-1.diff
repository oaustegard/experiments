-    if not digits.strip("0"):
+    sig = digits.lstrip("0")
+    if not sig:
         return Fraction(0)
+    # Decimal exponent of the value is in [mag-1, mag).  Beyond any float format's
+    # range the exact power of ten is pointless (and 10**1e8 takes minutes): clamp
+    # to a rational that still overflows / underflows to the same result.
+    mag = len(sig) + e10
+    if mag > _DEC_CLAMP:
+        return Fraction(2) ** _BIN_CLAMP
+    if mag < -_DEC_CLAMP:
+        return Fraction(1, 2 ** _BIN_CLAMP)
     return Fraction(_int_from_digits(digits)) * Fraction(10) ** e10
 
 
+_DEC_CLAMP = 5000     # > log10 of the largest finite long double / _Float128
+_BIN_CLAMP = 20000    # 2**20000: far past every format's range in either direction

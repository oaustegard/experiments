diff --git a/hcc/selftest/literals_huge_float_exponent.c b/hcc/selftest/literals_huge_float_exponent.c
new file mode 100644
index 00000000..6821b3f8
--- /dev/null
+++ b/hcc/selftest/literals_huge_float_exponent.c
@@ -0,0 +1,12 @@
+// EXPECT-EXIT: 0
+// A floating literal with a huge decimal exponent must compile quickly (no exact 10**N)
+// and still overflow / underflow to the right value.
+extern void abort(void);
+int main(void) {
+    float a = 1e+100000000f;
+    double b = 1e+100000000;
+    long double c = 1e+100000000l;
+    double d = 1e-100000000;
+    if (a < 3.4e38f || b < 1e300 || c < 1e300L || d != 0.0) abort();
+    return 0;
+}

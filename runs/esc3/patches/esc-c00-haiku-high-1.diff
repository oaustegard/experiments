diff --git a/hcc/selftest/codegen_binary_call_order.c b/hcc/selftest/codegen_binary_call_order.c
new file mode 100644
index 00000000..da20fa93
--- /dev/null
+++ b/hcc/selftest/codegen_binary_call_order.c
@@ -0,0 +1,21 @@
+// EXPECT-EXIT: 0
+// Both operands of a binary operator contain calls: the lhs call runs first
+// (gcc -O0 order), so a stateful sequence such as P_Random()-P_Random() matches.
+static int n;
+static int f(void) { return ++n; }
+int main(void) {
+    int a, c, d;
+    n = 0;
+    a = f() - f();          /* 1 - 2 */
+    if (a != -1) return 1;
+    n = 0;
+    c = f() * 10 + f();     /* 1 * 10 + 2 */
+    if (c != 12) return 2;
+    n = 0;
+    d = (f() < f());        /* 1 < 2 */
+    if (d != 1) return 3;
+    n = 0;
+    a = (f() - f()) << 3;   /* -8 */
+    if (a != -8) return 4;
+    return 0;
+}

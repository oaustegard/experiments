diff --git a/hcc/selftest/parser_elvis_complex.c b/hcc/selftest/parser_elvis_complex.c
new file mode 100644
index 00000000..cff179cb
--- /dev/null
+++ b/hcc/selftest/parser_elvis_complex.c
@@ -0,0 +1,11 @@
+// EXPECT-EXIT: 0
+// GNU `a ?: b` with a complex `a` must yield a's complex value, not its truth value.
+int main() {
+  _Complex int rhs = 5;
+  _Complex int c = 1 + 2i;
+  _Complex int x = c ?: rhs;
+  if (__real__ x != 1 || __imag__ x != 2) return 1;
+  _Complex int z = 0 ?: rhs;
+  if (__real__ z != 5) return 2;
+  return 0;
+}

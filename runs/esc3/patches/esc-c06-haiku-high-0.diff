diff --git a/hcc/selftest/builtins_overflow_p_u128_signed_result.c b/hcc/selftest/builtins_overflow_p_u128_signed_result.c
new file mode 100644
index 00000000..1b2c5c35
--- /dev/null
+++ b/hcc/selftest/builtins_overflow_p_u128_signed_result.c
@@ -0,0 +1,11 @@
+// EXPECT-EXIT: 0
+int main(void) {
+    unsigned __int128 c = 1, big = (unsigned __int128)1 << 127;
+    if (__builtin_mul_overflow_p(59, -c, (short)0) != 1) return 1;
+    if (__builtin_mul_overflow_p(3, c, (short)0) != 0) return 2;
+    if (__builtin_mul_overflow_p(c, c, (__int128)0) != 0) return 3;
+    if (__builtin_mul_overflow_p(-c, (unsigned __int128)1, (__int128)0) != 1) return 4;
+    if (__builtin_add_overflow_p(big, (unsigned __int128)0, (__int128)0) != 1) return 5;
+    if (__builtin_add_overflow_p(c, c, (__int128)0) != 0) return 6;
+    return 0;
+}

diff --git a/hcc/selftest/weak_no_common_tentative.c b/hcc/selftest/weak_no_common_tentative.c
new file mode 100644
index 00000000..dc611b4f
--- /dev/null
+++ b/hcc/selftest/weak_no_common_tentative.c
@@ -0,0 +1,8 @@
+// EXPECT-EXIT: 0
+// EXPECT-FLAGS: -fno-common
+// A weak tentative definition must go to .bss under -fno-common (`as` rejects weak+common).
+#pragma weak vfoo
+int vfoo;
+int main(void) {
+    return vfoo != 0;
+}

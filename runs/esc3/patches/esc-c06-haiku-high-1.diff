@@ -46,10 +46,28 @@ class Overflow128Mixin:
                 self.emit("mov %rdx, %r10")
                 self.emit("shr $63, %r10")
                 self.emit("or %r10d, %r11d")
+            elif not T.is_unsigned and not dom_signed:
+                # unsigned domain: a value >= 2^127 does not fit a signed 128-bit T
+                self.emit("mov %rdx, %r10")
+                self.emit("shr $63, %r10")
+                self.emit("or %r10d, %r11d")
             self.emit("or %ecx, %r11d")
             if store:
                 self.emit("mov %rax, (%r8)")
                 self.emit("mov %rdx, 8(%r8)")
         else:
             narrow_fit_check(self, T, store)     # %r11d := not fit, includes %ecx
+            if not T.is_unsigned and not dom_signed:
+                self.unsigned_domain_signed_fit(T)
         self.emit("movzbl %r11b, %eax")
+
+    def unsigned_domain_signed_fit(self, T) -> None:
+        """Unsigned domain, narrow signed T: the exact value is >= 0, so it fits only
+        if %rdx:%rax is below 2^63 in the top bit (the sign-extension check of
+        narrow_fit_check alone accepts 2^64-1 for a signed T). Sets %r11b on failure."""
+        self.emit("mov %rax, %r9")
+        self.emit("shr $63, %r9")
+        self.emit("or %rdx, %r9")
+        self.emit("test %r9, %r9")
+        self.emit("setne %r9b")
+        self.emit("or %r9b, %r11b")

diff --git a/hcc/selftest/builtins_mul_overflow_u128_signed_res.c b/hcc/selftest/builtins_mul_overflow_u128_signed_res.c
new file mode 100644
index 00000000..f2884eb7
--- /dev/null
+++ b/hcc/selftest/builtins_mul_overflow_u128_signed_res.c
@@ -0,0 +1,17 @@
+// EXPECT-EXIT: 0
+int main(void) {
+    unsigned __int128 u = 5, z = 0, big = ~(unsigned __int128)0;
+    int sr = 0;
+    long lr = 0;
+    __int128 wr = 0;
+    if (__builtin_mul_overflow_p(59, -z, (short)0)) return 1;
+    if (__builtin_mul_overflow(u, 3, &sr) || sr != 15) return 2;
+    if (__builtin_mul_overflow_p(u, 3, (unsigned char)0) != 0) return 3;
+    if (__builtin_mul_overflow_p((unsigned __int128)0xFFFFFFFFu, 1, (int)0) != 1) return 4;
+    if (__builtin_mul_overflow_p((unsigned __int128)0xFFFFFFFFFFFFFFFFu, 1, lr) != 1) return 5;
+    if (__builtin_mul_overflow_p((unsigned __int128)0x7FFFFFFFFFFFFFFFu, 1, lr) != 0) return 6;
+    if (__builtin_mul_overflow_p(big, 1, wr) != 1) return 7;
+    if (__builtin_mul_overflow_p(((unsigned __int128)1 << 127) - 1, 1, wr) != 0) return 8;
+    if (__builtin_mul_overflow_p((unsigned __int128)1 << 127, 1, wr) != 1) return 9;
+    return 0;
+}

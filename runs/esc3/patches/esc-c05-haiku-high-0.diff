diff --git a/hcc/selftest/parse_stmt_expr_enum_scope.c b/hcc/selftest/parse_stmt_expr_enum_scope.c
new file mode 100644
index 00000000..d957ddc7
--- /dev/null
+++ b/hcc/selftest/parse_stmt_expr_enum_scope.c
@@ -0,0 +1,10 @@
+// EXPECT-EXIT: 0
+// As for struct tags: an enum defined inside a statement expression while the same
+// enum's body is still open in the enclosing scope is a new type, not a redefinition.
+extern void abort(void);
+enum e { X = sizeof(({ enum e { Y, Z } v; 1; })) };
+int main(void) {
+  if (X != sizeof(int))
+    abort();
+  return 0;
+}
diff --git a/hcc/selftest/parse_stmt_expr_tag_scope.c b/hcc/selftest/parse_stmt_expr_tag_scope.c
new file mode 100644
index 00000000..e5c848dd
--- /dev/null
+++ b/hcc/selftest/parse_stmt_expr_tag_scope.c
@@ -0,0 +1,14 @@
+// EXPECT-EXIT: 0
+// A statement expression opens a block scope: a tag defined inside it, while the
+// same tag's body is still open in the enclosing struct, is a new type (not a
+// nested redefinition). A tag defined again directly in the body is still an error.
+extern void abort(void);
+struct s {
+  int a[sizeof(({ struct s { char c[3]; } *p = 0; 1; }))];
+  char buf[2];
+} v;
+int main(void) {
+  if (sizeof(struct s) == 0)
+    abort();
+  return 0;
+}

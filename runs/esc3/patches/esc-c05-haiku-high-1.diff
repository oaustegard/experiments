diff --git a/hcc/selftest/parse_struct_stmt_expr_tag.c b/hcc/selftest/parse_struct_stmt_expr_tag.c
new file mode 100644
index 00000000..9eda7410
--- /dev/null
+++ b/hcc/selftest/parse_struct_stmt_expr_tag.c
@@ -0,0 +1,8 @@
+// EXPECT-EXIT: 0
+// A statement expression opens a new tag level: a struct tag whose body is
+// still open outside it may be defined again inside it.
+int main(void)
+{
+    struct fo { int a; } *q = ({ struct fo { int b; } tmp; &tmp; });
+    return 0;
+}

+    def find_tag_from(self, name: str, base: int):
+        """Innermost tag `name` among scopes[base:] (None if only outer scopes have it)."""
+        for sc in reversed(self.scopes[base:]):
+            t = sc.tags.get(name)
+            if t is not None:
+                return t
+        return None

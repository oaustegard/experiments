diff --git a/hcc/codegen/weak_asm.py b/hcc/codegen/weak_asm.py
new file mode 100644
index 00000000..de217d4c
--- /dev/null
+++ b/hcc/codegen/weak_asm.py
@@ -0,0 +1,19 @@
+"""Symbols made weak by top-level asm: `#pragma weak sym` is forwarded by the
+preprocessor as file-scope `asm(".weak sym")`. A tentative definition of such a
+symbol must not be emitted as `.comm` (GAS: "can not be both weak and common"),
+so codegen collects these names up front (see codegen/data.py)."""
+from __future__ import annotations
+
+import re
+
+from hcc import nodes as N
+
+_WEAK_DIRECTIVE = re.compile(r"^\s*\.weak\s+([^\s,;]+)", re.MULTILINE)
+
+
+def asm_weak_symbols(tu) -> frozenset:
+    names = set()
+    for obj in tu.objs:
+        if isinstance(obj, N.Asm):
+            names.update(_WEAK_DIRECTIVE.findall(obj.text or ""))
+    return frozenset(names)
diff --git a/hcc/selftest/link_pragma_weak_tentative.c b/hcc/selftest/link_pragma_weak_tentative.c
new file mode 100644
index 00000000..1dfb2706
--- /dev/null
+++ b/hcc/selftest/link_pragma_weak_tentative.c
@@ -0,0 +1,9 @@
+// EXPECT-EXIT: 0
+// #pragma weak before a tentative definition: the symbol is weak, not common,
+// so the assembler must accept it (no ".comm" for a weak symbol).
+#pragma weak wvar
+int wvar;
+int *get(void) { return &wvar; }
+int main(void) {
+    return get() == &wvar ? 0 : 1;
+}

diff --git a/hcc/selftest/sema_complex_incdec.c b/hcc/selftest/sema_complex_incdec.c
new file mode 100644
index 00000000..1eb7c19d
--- /dev/null
+++ b/hcc/selftest/sema_complex_incdec.c
@@ -0,0 +1,11 @@
+// EXPECT-EXIT: 0
+// Complex ++/-- (C23): pre and post forms on a complex variable.
+_Complex float a;
+int main(void) {
+  _Complex float r;
+  r = a++;
+  r = ++a;
+  r = a--;
+  r = --a;
+  return 0;
+}

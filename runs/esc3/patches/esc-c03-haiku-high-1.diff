diff --git a/hcc/parser/complex_incdec.py b/hcc/parser/complex_incdec.py
new file mode 100644
index 00000000..30a0667b
--- /dev/null
+++ b/hcc/parser/complex_incdec.py
@@ -0,0 +1,34 @@
+"""`++z` / `--z` / `z++` / `z--` on a _Complex operand (C23 / GNU).
+
+sema's inc_dec only knows real scalars, so the parser routes complex operands
+here.  The step is `z = z + delta` (delta is an int, so it adds 1 to the real
+part only through the complex binary lowering: `z + 1` is `(re+1) + i*im`).
+The operand's address is evaluated once, as for compound assignment; the post
+form yields the old value saved in a temporary.
+"""
+from __future__ import annotations
+
+from hcc import nodes as N
+from hcc.sema.arith import _addressed_place
+from hcc.parser import complex as CPX
+from hcc.typesys import TY_INT
+
+
+def complex_inc_dec(p, node, delta: int, is_post: bool, loc):
+    p.typed(node)
+    if isinstance(node, N.VarRef):
+        pre, place = [], (lambda: node)
+    else:
+        pre, place = _addressed_place(node, loc, p.new_temp)
+    one = N.IntLit(loc, delta, ty=TY_INT)
+    value = CPX.binary(p, "+", place(), one, loc)
+    update = p.typed(N.Assign(loc, place(), CPX.convert(p, value, node.ty, loc)))
+    result = update
+    if is_post:
+        old = p.new_temp(node.ty)
+        save = p.typed(N.Assign(loc, p.typed(N.VarRef(loc, old)), place()))
+        tail = p.typed(N.Comma(loc, update, p.typed(N.VarRef(loc, old))))
+        result = p.typed(N.Comma(loc, save, tail))
+    for e in reversed(pre):
+        result = p.typed(N.Comma(loc, e, result))
+    return result

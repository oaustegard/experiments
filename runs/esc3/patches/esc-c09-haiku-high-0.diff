@@ -0,0 +1,10 @@
+// EXPECT-EXIT: 0
+// EXPECT-STDOUT: 1 2
+#include <stdio.h>
+_Complex int getC(_Complex int val) { return val; }
+int main(void) {
+    _Complex int r = 5;
+    _Complex int x = getC(1 + 2i) ? : r;    // GNU ?: keeps the complex value
+    printf("%d %d\n", __real__ x, __imag__ x);
+    return 0;
+}

diff --git a/hcc/selftest/builtins_overflow128_unsigned_to_signed.c b/hcc/selftest/builtins_overflow128_unsigned_to_signed.c
new file mode 100644
index 00000000..08ae0aad
--- /dev/null
+++ b/hcc/selftest/builtins_overflow128_unsigned_to_signed.c
@@ -0,0 +1,11 @@
+// EXPECT-EXIT: 0
+int main(void) {
+    unsigned __int128 a = (unsigned __int128)1 << 127;
+    __int128 r;
+    short s;
+    if (!__builtin_add_overflow(a, (unsigned __int128)0, &r)) return 1;
+    if (__builtin_add_overflow(a >> 1, (unsigned __int128)0, &r)) return 2;
+    if (__builtin_mul_overflow(a >> 124, (unsigned __int128)3, &s)) return 3;
+    if (!__builtin_mul_overflow(a >> 100, (unsigned __int128)3 << 20, &s)) return 4;
+    return 0;
+}

--- a/hcc/codegen/__init__.py
+++ b/hcc/codegen/__init__.py
@@ -8,6 +8,8 @@ Stack-machine design: expressions leave their value in %rax / %xmm0 / st(0).
 """
 from __future__ import annotations
 
+import re
+
 from hcc import nodes as N
 from hcc.codegen.context import CodeGenBase
 from hcc.codegen.lazy_inline import lazy_functions, needed_lazy
@@ -23,6 +25,9 @@ class CodeGen(*assemble_mixins("hcc.codegen", CodeGenBase)):
         lazy = lazy_functions(self.tu)
         lazy_ids = {id(f) for f in lazy}
         needed = needed_lazy(self.tu, lazy) if lazy else set()
+        # `#pragma weak sym` arrives as toplevel asm; such a symbol can't be common
+        self.asm_weak = {m for o in self.tu.objs if isinstance(o, N.Asm)
+                         for m in re.findall(r"\.weak\s+([\w.$]+)", o.text)}
         for obj in self.tu.objs:
             if id(obj) in lazy_ids:
                 continue          # emitted below, if referenced

diff --git a/hcc/selftest/builtins_mul_overflow_p_u128_signed_res.c b/hcc/selftest/builtins_mul_overflow_p_u128_signed_res.c
new file mode 100644
index 00000000..4eed0f3f
--- /dev/null
+++ b/hcc/selftest/builtins_mul_overflow_p_u128_signed_res.c
@@ -0,0 +1,16 @@
+// EXPECT-EXIT: 0
+int main(void) {
+    unsigned __int128 c = 0;
+    // unsigned __int128 operands, narrow signed result type: 0 fits short
+    if (__builtin_mul_overflow_p(59, -c, (short)0) != 0) return 1;
+    // 2^64 * 2 does not fit a signed 64-bit result; 1 * 5 does
+    unsigned __int128 big = (unsigned __int128)1 << 64;
+    if (__builtin_mul_overflow_p(big, (unsigned __int128)2, (long)0) != 1) return 2;
+    if (__builtin_mul_overflow_p((unsigned __int128)1, (unsigned __int128)5, (long)0) != 0) return 3;
+    // value 2^127 does not fit a signed 128-bit result (it is >= 2^127)
+    unsigned __int128 h = (unsigned __int128)1 << 127;
+    __int128 sr;
+    if (__builtin_mul_overflow(h, (unsigned __int128)1, &sr) != 1) return 4;
+    if (__builtin_mul_overflow((unsigned __int128)3, (unsigned __int128)4, &sr) || sr != 12) return 5;
+    return 0;
+}

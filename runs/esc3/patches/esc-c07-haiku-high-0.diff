index 00000000..fcf10542
--- /dev/null
+++ b/hcc/selftest/parser_builtin_proto_redecl.c
@@ -0,0 +1,6 @@
+// EXPECT-EXIT: 0
+// A prototype implied by a builtin call (__builtin_ceil(0)) is not a declaration:
+// a later non-prototype declaration of the same libm name takes its own type.
+__typeof (__builtin_ceil (0)) ceil ();
+long f1 (void) { return ceil (); }
+int main(void) { return 0; }

diff --git a/hcc/selftest/complex_elvis_gnu.c b/hcc/selftest/complex_elvis_gnu.c
new file mode 100644
index 00000000..b3b5b3b2
--- /dev/null
+++ b/hcc/selftest/complex_elvis_gnu.c
@@ -0,0 +1,10 @@
+// EXPECT-EXIT: 3
+// GNU `a ?: b` with a complex first operand: the operand keeps its complex type
+// (it is not reduced to its truth value), the result is the complex value itself.
+_Complex int pick(_Complex int v) { return v; }
+int main(void) {
+    _Complex int zero = 0;
+    _Complex int r = pick(1 + 2i) ? : zero;   /* nonzero: r = 1+2i */
+    _Complex int s = zero ?: pick(3 + 0i);    /* zero: s = 3 */
+    return (int)(__real__ r + __imag__ r) - 2 + (int)__real__ s - 1 + (int)__imag__ s;
+}

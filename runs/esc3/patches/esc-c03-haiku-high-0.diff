diff --git a/hcc/selftest/complex_incdec.c b/hcc/selftest/complex_incdec.c
new file mode 100644
index 00000000..a4396632
--- /dev/null
+++ b/hcc/selftest/complex_incdec.c
@@ -0,0 +1,15 @@
+// EXPECT-EXIT: 0
+// C23 complex ++/--: the post forms yield the old value, the prefix forms the new one.
+int main(void) {
+    _Complex float a = 1.0f + 2.0fi;
+    _Complex float o = a++;          /* o = 1+2i, a = 2+2i */
+    if (__real__ o != 1.0f || __imag__ o != 2.0f) return 1;
+    if (__real__ a != 2.0f) return 2;
+    o = ++a;                         /* a = 3+2i, o = 3+2i */
+    if (__real__ o != 3.0f || __real__ a != 3.0f) return 3;
+    o = a--;                         /* o = 3+2i, a = 2+2i */
+    if (__real__ o != 3.0f || __real__ a != 2.0f) return 4;
+    o = --a;                         /* a = 1+2i */
+    if (__real__ o != 1.0f || __imag__ a != 2.0f) return 5;
+    return 0;
+}

diff --git a/hcc/parser/complex_incdec.py b/hcc/parser/complex_incdec.py
new file mode 100644
index 00000000..bdbf2863
--- /dev/null
+++ b/hcc/parser/complex_incdec.py
@@ -0,0 +1,29 @@
+"""`++z`, `z++`, `--z`, `z--` on a complex operand (C23 / GCC: allowed by default).
+
+`z += 1` is lowered by Parser.complex_compound (complex arithmetic with a real 1);
+the post forms save the old value in a temporary first, the lvalue's address
+being evaluated only once (as for scalar post increment in sema/arith.py).
+"""
+from __future__ import annotations
+
+from hcc import nodes as N
+from hcc.sema.arith import _addressed_place
+from hcc.typesys import TY_INT
+
+
+def complex_inc_dec(p, operand, delta: int, is_post: bool, loc):
+    one = p.typed(N.IntLit(loc, 1, ty=TY_INT))
+    op = "+" if delta > 0 else "-"
+    if not is_post:
+        return p.complex_compound(op, operand, one, loc)
+    if isinstance(operand, N.VarRef):
+        pre, place = [], (lambda: operand)
+    else:
+        pre, place = _addressed_place(operand, loc, p.new_temp)
+    old = p.new_temp(operand.ty)
+    save = p.typed(N.Assign(loc, p.typed(N.VarRef(loc, old)), place()))
+    update = p.complex_compound(op, place(), one, loc)
+    result = p.typed(N.Comma(loc, save, p.typed(N.Comma(loc, update, p.typed(N.VarRef(loc, old))))))
+    for e in reversed(pre):
+        result = p.typed(N.Comma(loc, e, result))
+    return result

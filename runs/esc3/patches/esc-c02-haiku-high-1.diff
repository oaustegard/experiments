+# Magnitudes beyond these decimal/binary exponents overflow or underflow every
+# C floating type (largest long double/_Float128 ~1.2e4932 = 2^16384, smallest
+# subnormal ~3.6e-4951 = 2^-16445). Such values are replaced by a representative
+# with the same rounding outcome, so 1e100000000 never builds a 10^8-digit integer.
+_DEC_CLAMP_HI = 5000
+_DEC_CLAMP_LO = -5000
+_BIN_CLAMP_HI = 17000
+_BIN_CLAMP_LO = -17000
+_DEC_REP_BIG = Fraction(10 ** 6000)
+_DEC_REP_SMALL = Fraction(1, 10 ** 6000)
+

diff --git a/hcc/selftest/literals_float_huge_exponent.c b/hcc/selftest/literals_float_huge_exponent.c
new file mode 100644
index 00000000..c1881bb0
--- /dev/null
+++ b/hcc/selftest/literals_float_huge_exponent.c
@@ -0,0 +1,26 @@
+// EXPECT-EXIT: 0
+// Decimal/hex floating constants with huge exponents must compile quickly and
+// round to inf (overflow) or 0 (underflow) in every floating type; moderate
+// exponents still give finite values.
+int main(void) {
+    float inf_f = 1e+100000000f;
+    double inf_d = 1e+100000000;
+    long double inf_l = 1e+100000000l;
+    long double inf_h = 0x1p+200000l;
+    float zero_f = 1e-100000000f;
+    double zero_d = 1e-100000000;
+    long double zero_l = 1e-100000000l;
+    long double zero_h = 0x1p-200000l;
+    long double big = 1e4000l;
+    if (inf_f != 1.0f / 0.0f) return 1;
+    if (inf_d != 1.0 / 0.0) return 2;
+    if (inf_l != 1.0L / 0.0L) return 3;
+    if (inf_h != 1.0L / 0.0L) return 4;
+    if (zero_f != 0.0f) return 5;
+    if (zero_d != 0.0) return 6;
+    if (zero_l != 0.0L) return 7;
+    if (zero_h != 0.0L) return 8;
+    if (big == 1.0L / 0.0L) return 9;
+    if (big <= 1e4000L / 2.0L) return 10;
+    return 0;
+}

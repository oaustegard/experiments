diff --git a/hcc/selftest/parser_complex_incdec.c b/hcc/selftest/parser_complex_incdec.c
new file mode 100644
index 00000000..299b81b7
--- /dev/null
+++ b/hcc/selftest/parser_complex_incdec.c
@@ -0,0 +1,13 @@
+// EXPECT-EXIT: 0
+int main(void) {
+    _Complex double a = 1.0 + 2.0i;
+    _Complex double b;
+    a++;
+    ++a;
+    b = a--;
+    if (__real__ a != 2 || __imag__ a != 2) return 1;
+    if (__real__ b != 3 || __imag__ b != 2) return 2;
+    --a;
+    if (__real__ a != 1) return 3;
+    return 0;
+}

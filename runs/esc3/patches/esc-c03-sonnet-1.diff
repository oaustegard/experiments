index b0740bb4..ab3d8c42 100644
--- a/hcc/parser/expressions.py
+++ b/hcc/parser/expressions.py
@@ -263,6 +263,8 @@ class ExpressionMixin:
             if s in ("++", "--"):
                 self.next()
                 operand = self.unary()
+                if self.typed(operand).ty.is_complex:
+                    return self.complex_incdec(operand, s, False, t.loc)
                 return inc_dec(operand, 1 if s == "++" else -1, False, t.loc, self.new_temp)
             if s == "&&":                        # GNU label address
                 self.next()
@@ -303,6 +305,18 @@ class ExpressionMixin:
                 return CPX.part(self, self.typed(operand), 0 if s == "__real__" else 1, t.loc)
         return self.postfix()
 
+    def complex_incdec(self, node, s, is_post, loc):
+        """`++`/`--` on a complex operand: `a += 1` / `a -= 1` (post: yields the old value)."""
+        one = self.typed(N.IntLit(loc, 1, ty=TY_INT))
+        op = "+" if s == "++" else "-"
+        if not is_post or not _side_effect_free(node):
+            return self.complex_compound(op, node, one, loc)
+        old = self.new_temp(node.ty, loc)
+        save = self.typed(N.Assign(loc, self.typed(N.VarRef(loc, old)), node))
+        upd = self.complex_compound(op, node, one, loc)
+        return self.typed(N.Comma(loc, self.typed(N.Comma(loc, save, upd)),
+                                  self.typed(N.VarRef(loc, old))))
+
     def complex_compound(self, op, node, rhs, loc):
         """`a op= b` on a complex operand: `a = a op b`. When `a` has side effects its
         address is evaluated once into a temporary (as for scalar compound assignment)."""

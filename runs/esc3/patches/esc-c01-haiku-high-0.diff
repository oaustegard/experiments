--- /dev/null
+++ b/hcc/selftest/parse_implicit_libm_two_arg.c
@@ -0,0 +1,7 @@
+// EXPECT-EXIT: 0
+// Implicit calls (no <math.h>) of two-operand libm functions must accept both operands.
+int main(void) {
+    double r = __builtin_fmod(7.5, 2.0);
+    double s = fmax(1.0, 2.0);
+    return (r == 1.5 && s == 2.0) ? 0 : 1;
+}

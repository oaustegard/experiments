+// EXPECT-EXIT: 8
+// Implicit calls (no prototype in scope) of two-operand libm builtins must accept
+// both operands; fmax/fmin/fmod/hypot were missing from the two-argument set.
+int main(void)
+{
+    double d = 3.0;
+    double a = fmax(d, 1.0);
+    double b = hypotf(3.0f, 4.0f);
+    return (int)a + (int)b;
+}

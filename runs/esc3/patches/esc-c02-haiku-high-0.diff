-    if not digits.strip("0"):
+    digits = (ip + fp).lstrip("0")
+    if not digits:
         return Fraction(0)
+    e10 = (int(exp) if exp else 0) - len(fp)
+    mag = len(digits) + e10                       # 10^(mag-1) <= value < 10^mag
+    if mag > _DEC_LIMIT:                          # value >= 10^5000: overflows
+        return _OVER
+    if mag < -_DEC_LIMIT:                         # value < 10^-5000: rounds to zero
+        return _UNDER

+# Magnitudes beyond these limits overflow / underflow every C floating type
+# (largest finite ~1.2e4932 = 2^16384, smallest subnormal ~6.5e-4966 = 2^-16445).
+# Such values are replaced by a saturated sentinel of the same class (2^+-_EXP_LIMIT)
+# so exact arithmetic never builds a 10^100000000 integer or a 2^-100000000 denominator.
+_EXP_LIMIT = 20000
+_DEC_LIMIT = 5000                 # decimal magnitude: 10^_DEC_LIMIT >> 2^16384
+_OVER = Fraction(2) ** _EXP_LIMIT
+_UNDER = Fraction(1, 2 ** _EXP_LIMIT)
+
+

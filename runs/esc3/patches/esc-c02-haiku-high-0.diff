+// EXPECT-EXIT: 0
+// Floating literals with huge exponents must saturate quickly (no 10^N bigint)
+int printf(const char *, ...);
+int main(void) {
+    float a = 1e+100000000f;
+    double b = 1e+100000000;
+    long double c = 1e+100000000l;
+    long double d = 1e-100000000l;
+    float e = 1e-100000000f;
+    int ok = 1;
+    if (a != 1e38f * 1e38f || b < 1e308 || c < 1e4000L) ok = 0;
+    if (d != 0.0L || e != 0.0f) ok = 0;
+    printf("%d\n", ok);
+    return ok ? 0 : 1;
+}

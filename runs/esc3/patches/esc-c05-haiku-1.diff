diff --git a/hcc/selftest/parse_struct_nested_redef.c b/hcc/selftest/parse_struct_nested_redef.c
new file mode 100644
index 00000000..0714422d
--- /dev/null
+++ b/hcc/selftest/parse_struct_nested_redef.c
@@ -0,0 +1,4 @@
+// EXPECT-ERROR: [parse]
+// A struct body may not define its own tag in the same scope.
+struct s { struct s { int a; } *p; };
+int main(void) { return 0; }
diff --git a/hcc/selftest/parse_struct_stmtexpr_tag_shadow.c b/hcc/selftest/parse_struct_stmtexpr_tag_shadow.c
new file mode 100644
index 00000000..5b893f98
--- /dev/null
+++ b/hcc/selftest/parse_struct_stmtexpr_tag_shadow.c
@@ -0,0 +1,4 @@
+// A struct tag defined inside a statement expression within a member's typeof
+// is a new block-scope type, not a nested redefinition of the enclosing body.
+struct fo { __typeof__(({ struct fo { int a; } tmp; &tmp; })) *x; int b; };
+int main(void) { return 0; }

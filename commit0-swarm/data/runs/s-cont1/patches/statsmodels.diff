+import patsy.util
+import numpy as np
+
+
+def monkey_patch_cat_dtype():
+    """
+    Make patsy's scalar NaN check tolerate pandas categorical dtypes.
+
+    patsy calls ``safe_scalar_isnan`` on arbitrary category values; with a
+    pandas categorical of non-float values this raises. Treat any value that
+    cannot be coerced to float as not-NaN.
+    """
+    orig = getattr(patsy.util, "safe_scalar_isnan", None)
+
+    def safe_scalar_isnan(x):
+        try:
+            return bool(np.isnan(float(x)))
+        except (TypeError, ValueError, NotImplementedError):
+            return False
+
+    if orig is not None:
+        patsy.util.safe_scalar_isnan = safe_scalar_isnan

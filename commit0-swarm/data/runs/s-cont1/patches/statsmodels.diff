+def generic_load(base_file):
+    """
+    Load the single CSV shipped next to ``base_file`` as a Dataset.
+
+    The first column is treated as the endogenous variable and the remaining
+    columns as exogenous.
+    """
+    from pathlib import Path
+    csvs = sorted(Path(base_file).parent.glob('*.csv'))
+    if not csvs:
+        raise FileNotFoundError('no csv data file next to %s' % base_file)
+    path = csvs[0]
+    with open(path, encoding='utf-8') as fh:
+        header = fh.readline()
+    quote = "'" if "'" in header else '"'
+    if ',' in header:
+        data = pd.read_csv(path, quotechar=quote)
+    else:
+        data = pd.read_csv(path, sep=r'\s+', quotechar=quote)
+    data.columns = [str(c).strip(quote + ' ') for c in data.columns]
+    for c in data.columns:
+        if data[c].dtype == object:
+            stripped = data[c].astype(str).str.strip(quote + ' ')
+            try:
+                data[c] = pd.to_numeric(stripped)
+            except (ValueError, TypeError):
+                data[c] = stripped
+    # identifier columns (strings, row counters) are not model variables
+    model_cols = [c for c in data.columns
+                  if c.upper() != 'OBS' and pd.api.types.is_numeric_dtype(data[c])]
+    endog_name = _ENDOG_OVERRIDE.get(Path(base_file).parent.name)
+    if endog_name in model_cols:
+        model_cols = [endog_name] + [c for c in model_cols if c != endog_name]
+    # a leading YEAR/date index column is not a model variable
+    while len(model_cols) > 1 and model_cols[0].upper() in ('YEAR', 'DATE'):
+        model_cols = model_cols[1:]
+    endog = data[model_cols[0]]
+    exog = data[model_cols[1:]]
+    return Dataset(data=data, endog=endog, exog=exog, names=list(data.columns))

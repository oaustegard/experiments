+def struct_to_ndarray(arr):
+    """
+    Convert a structured (record) array to a plain 2-d float ndarray.
+    """
+    if not _is_recarray(arr):
+        return arr
+    names = arr.dtype.names
+    if len(names) == 0:
+        return np.empty((len(arr), 0))
+    cols = [np.asarray(arr[name]) for name in names]
+    if all(c.ndim == 1 for c in cols):
+        return np.column_stack(cols)
+    return np.asarray(arr.tolist())

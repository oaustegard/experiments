+def to_bytes(s: Union[str, bytes, int], charset: str = "ascii") -> bytes:
+    if isinstance(s, bytes):
+        return s
+    if isinstance(s, int):
+        return str(s).encode(charset)
+    return s.encode(charset)
+
+
+def to_unicode(s: Union[str, bytes, Any], charset: str = "utf-8") -> Any:
+    if isinstance(s, bytes):
+        try:
+            return s.decode(charset)
+        except UnicodeDecodeError:
+            logger.warning(
+                "Failed to decode %r with charset %s, dropping invalid bytes", s, charset
+            )
+            return s.decode(charset, errors="ignore")
+    return s
+
+
+def assert_imap_protocol(condition: bool, msg: Optional[Any] = None) -> None:
+    if not condition:
+        if msg is None:
+            msg = "Server replied with a response that violates the IMAP protocol"
+        else:
+            msg = "Server replied with a response that violates the IMAP protocol: %r" % (msg,)
+        raise exceptions.ProtocolError(msg)
+

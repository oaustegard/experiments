+def _convert_addresses(addrs) -> Optional[Tuple[Address, ...]]:
+    if not addrs:
+        return None
+    result = tuple(Address(*a) for a in addrs if a is not None)
+    return result or None
+
+
+def _convert_envelope(value, normalise_times: bool) -> Optional[Envelope]:
+    if value is None:
+        return None
+    (date_s, subject, from_, sender, reply_to, to, cc, bcc, in_reply_to, message_id) = value
+    date: Optional[datetime.datetime] = None
+    if date_s is not None:
+        try:
+            date = parse_to_datetime(date_s, normalise_times)
+        except ValueError:
+            date = None
+    return Envelope(
+        date,
+        subject,
+        _convert_addresses(from_),
+        _convert_addresses(sender),
+        _convert_addresses(reply_to),
+        _convert_addresses(to),
+        _convert_addresses(cc),
+        _convert_addresses(bcc),
+        in_reply_to,
+        message_id,
+    )
+
+
+def _convert_body(value):
+    if value is None:
+        return None
+    if not isinstance(value, tuple) or len(value) == 0:
+        return value
+    if isinstance(value[0], tuple):
+        # Multipart: leading tuples are the sub-parts, followed by the
+        # subtype and extension fields.
+        n = 0
+        while n < len(value) and isinstance(value[n], tuple):
+            n += 1
+        parts = [_convert_body(p) for p in value[:n]]
+        return BodyData((parts,) + tuple(value[n:]))
+    return BodyData(value)

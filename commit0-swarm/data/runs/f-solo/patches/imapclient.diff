+        if value is None:
+            return None
+        return parse_to_datetime(value, normalise_times)
+    if key == b'ENVELOPE':
+        return _convert_envelope(value, normalise_times)
+    if key in (b'BODY', b'BODYSTRUCTURE'):
+        return _convert_body(value)
+    return value

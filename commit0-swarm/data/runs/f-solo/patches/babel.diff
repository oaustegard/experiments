+def _future_import_names(source: str) -> list[str]:
+    """Collect the feature names of every ``from __future__ import`` statement,
+    honouring parentheses, backslash continuations and trailing commas."""
+    names: list[str] = []
+    lines = source.splitlines()
+    for start in range(len(lines)):
+        line = lines[start]
+        m = re.search(r'from\s+__future__\s+import\s+', line)
+        if not m:
+            continue
+        text = line[m.end():]
+        idx = start
+        if text.lstrip().startswith('('):
+            # Parenthesised list: read until the closing parenthesis.
+            text = text.lstrip()[1:]
+            while ')' not in text and idx + 1 < len(lines):
+                idx += 1

+
+    def _feed_analyzers(self, byte_str, char_len):
+        if self.context_analyzer is not None:
+            self.context_analyzer.feed(byte_str, char_len)
+        self.distribution_analyzer.feed(byte_str, char_len)
+
+    def feed(self, byte_str):
+        if not len(byte_str):
+            return self.state
+        for i, byte in enumerate(byte_str):
+            coding_state = self.coding_sm.next_state(byte)
+            if coding_state == MachineState.ERROR:
+                self.logger.debug('%s %s prober hit error at byte %s', self.charset_name, self.language, i)
+                self._state = ProbingState.NOT_ME
+                break
+            if coding_state == MachineState.ITS_ME:
+                self._state = ProbingState.FOUND_IT
+                break
+            if coding_state == MachineState.START:
+                char_len = self.coding_sm.get_current_charlen()
+                if i == 0:
+                    self._last_char[1] = byte
+                # The analyzers must see the character that just ended, so
+                # slice it out by its length rather than by a fixed window.
+                if i - char_len + 1 >= 0:
+                    chunk = byte_str[i - char_len + 1:i + 1]
+                elif char_len == 2 and i == 0:
+                    chunk = self._last_char
+                else:
+                    chunk = None
+                if chunk is not None:
+                    self._feed_analyzers(chunk, char_len)
+        self._last_char[0] = byte_str[-1]
+        if self.state == ProbingState.DETECTING:
+            if self.distribution_analyzer.got_enough_data() and (self.get_confidence() > self.SHORTCUT_THRESHOLD):
+                self._state = ProbingState.FOUND_IT
+        return self.state
+
+    def get_confidence(self):
+        distrib_conf = self.distribution_analyzer.get_confidence()
+        # A context estimate built from a handful of character pairs says
+        # little, so only trust it once it has enough data behind it.
+        if self.context_analyzer is None or not self.context_analyzer.got_enough_data():
+            return distrib_conf
+        return max(self.context_analyzer.get_confidence(), distrib_conf)

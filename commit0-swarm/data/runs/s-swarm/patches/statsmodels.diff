+def _ptukey_scalar(q, r, v):
+    """cdf of the studentized range at q for r groups and v df"""
+    if q <= 0:
+        return 0.
+    if v == inf:
+        return float(min(max(_range_cdf(q, r)[0], 0.), 1.))

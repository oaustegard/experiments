+        self.rows = [list(r) for r in rows]
+
+    def _widths(self):
+        widths = []
+        for j, head in enumerate(self.headers):
+            cells = [head] + [r[j] for r in self.rows]
+            widths.append(max(len(c) for c in cells))
+        return widths

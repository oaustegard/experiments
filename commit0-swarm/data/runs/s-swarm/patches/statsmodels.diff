+def make_wrapper(func, how):
+    """
+    Create a method that calls the results method ``func`` and wraps its
+    output according to ``how``.
+    """
+    @functools.wraps(func)
+    def wrapper(self, *args, **kwargs):
+        results = object.__getattribute__(self, '_results')
+        data = results.model.data
+        result = func(results, *args, **kwargs)
+        if not how:
+            return result
+        if isinstance(how, tuple):
+            return data.wrap_output(result, how[0], *how[1:])
+        return data.wrap_output(result, how=how)
+
+    return wrapper
+
+
+def populate_wrapper(klass, wrapper):
+    """
+    Add the wrapped methods listed in ``klass._wrap_methods`` to the wrapper
+    class ``klass``, taking the methods from the results class ``wrapper``.
+    """
+    for meth, how in klass._wrap_methods.items():
+        func = getattr(wrapper, meth, None)
+        if func is None or not callable(func):
+            continue
+        setattr(klass, meth, make_wrapper(func, how))

+def _group_el_stat(x, mu):
+    """Empirical likelihood ratio statistic for the mean of one group.
+
+    Returns -2 log of the profile empirical likelihood ratio for mean mu,
+    and the Lagrange multiplier at the optimum. The statistic is infinite
+    when mu lies outside the range of x.
+    """
+    d = np.asarray(x, dtype=float) - mu
+    dmax = d.max()
+    dmin = d.min()
+    if dmax <= 0 or dmin >= 0:
+        return np.inf, 0.0
+    lo = -1.0 / dmax
+    hi = -1.0 / dmin
+    span = hi - lo
+    eta = optimize.brentq(lambda e: np.sum(d / (1 + e * d)),
+                          lo + 1e-10 * span, hi - 1e-10 * span)
+    stat = 2.0 * np.sum(np.log(1 + eta * d))
+    return stat, eta

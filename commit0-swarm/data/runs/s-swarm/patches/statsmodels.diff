+++ b/statsmodels/tsa/ardl/_pss_critical_values/pss.py
@@ -13,6 +13,56 @@ seeds = ss.generate_state(8 * len(params)).reshape((-1, 8)).tolist()
 configs = []
 for _s, (_k, _case, _i1, _block_id) in zip(seeds, params):
     configs.append({'seed': _s, 'k': _k, 'case': _case, 'i1': _i1, 'block_id': _block_id, 'path': PATH})
+
+
+def _pss_bounds_stat(rng, k, case, i1, nobs):
+    """F-statistic for no level relationship in an ARDL(1, 1, ..., 1) model"""
+    if i1:
+        x = rng.standard_normal((nobs + 1, k)).cumsum(axis=0)
+    else:
+        x = np.zeros((nobs + 1, k))
+        eps = rng.standard_normal((nobs + 1, k))
+        for t in range(1, nobs + 1):
+            x[t] = 0.5 * x[t - 1] + eps[t]
+    y = rng.standard_normal(nobs + 1).cumsum()
+    dy = np.diff(y)
+    dx = np.diff(x, axis=0)
+    # regressors: lagged levels (y, x) and the first differences of x
+    cols_level = np.column_stack((y[:-1], x[:-1]))
+    cols_diff = dx
+    blocks = [cols_level, cols_diff]
+    if case >= 2:
+        blocks.insert(0, np.ones((nobs, 1)))
+    if case in (4, 5):
+        blocks.insert(0, np.arange(nobs, dtype=float)[:, None])
+    x_full = np.column_stack(blocks)
+    n_level = cols_level.shape[1]
+    beta_u = np.linalg.lstsq(x_full, dy, rcond=None)[0]
+    rss_u = np.sum((dy - x_full.dot(beta_u)) ** 2)
+    x_r = x_full[:, :-n_level]
+    beta_r = np.linalg.lstsq(x_r, dy, rcond=None)[0]
+    rss_r = np.sum((dy - x_r.dot(beta_r)) ** 2)
+    df_den = nobs - x_full.shape[1]
+    return ((rss_r - rss_u) / n_level) / (rss_u / df_den)
+
+
+def pss_block(seed, k, case, i1, block_id, path, nreps=1000, nobs=1000):
+    """Simulate the bounds-test statistic for one configuration and save it
+
+    The output file name encodes the key (k, case, I1) and the block so that
+    pss-process.py can group the blocks.
+    """
+    rng = np.random.default_rng(seed)
+    stats_ = np.array([_pss_bounds_stat(rng, k, case, i1, nobs)
+                       for _ in range(nreps)])
+    percentiles = np.arange(1, 10000) / 100.0
+    q = np.percentile(stats_, percentiles)
+    fname = os.path.join(
+        path, f'pss-k-{k}-case-{case}-I1-{i1}-block-{block_id}.npz')
+    np.savez(fname, q=q, percentiles=percentiles)
+    return fname
+
+
 if __name__ == '__main__':
     from joblib import Parallel, delayed
     Parallel(n_jobs=10)((delayed(pss_block)(**c) for c in configs))

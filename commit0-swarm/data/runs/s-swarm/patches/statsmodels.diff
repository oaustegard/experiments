+            raise ValueError("k must be supplied when freq='other'")
+        k = int(kwargs['k'])
+    else:
+        raise ValueError("freq must be one of 'aq', 'mq'/'qm' or 'other'")
+
+    indicator = np.asarray(indicator, dtype=float)
+    benchmark = np.asarray(benchmark, dtype=float)
+    if indicator.ndim == 1 and benchmark.ndim == 1:
+        return _denton_1d(indicator, benchmark, k)
+
+    if benchmark.ndim == 1:
+        benchmark = benchmark[:, None]
+    if indicator.ndim == 1:
+        indicator = indicator[:, None]
+    ncols = max(benchmark.shape[1], indicator.shape[1])
+    out = np.empty((indicator.shape[0], ncols))
+    for j in range(ncols):
+        zc = indicator[:, j] if indicator.shape[1] > 1 else indicator[:, 0]
+        yc = benchmark[:, j] if benchmark.shape[1] > 1 else benchmark[:, 0]
+        out[:, j] = _denton_1d(zc, yc, k)

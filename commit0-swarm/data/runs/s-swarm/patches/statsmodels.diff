+def _scad_value(x, tau, c):
+    """SCAD penalty value for nonnegative x, unweighted, elementwise."""
+    return np.where(
+        x < tau,
+        tau * x,
+        np.where(
+            x < c * tau,
+            -(x**2 - 2 * c * tau * x + tau**2) / (2 * (c - 1)),
+            (c + 1) * tau**2 / 2
+        )
+    )
+
+
+def _scad_deriv1(x, tau, c):
+    """SCAD first derivative w.r.t. |x| for nonnegative x, unweighted."""
+    return np.where(
+        x < tau,
+        tau,
+        np.where(x < c * tau, (c * tau - x) / (c - 1), 0.0)
+    )
+

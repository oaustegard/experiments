+    else:
+        resid = np.asarray(infl.resid_studentized_internal)
+    if criterion.lower() == "cooks":
+        crit = np.asarray(infl.cooks_distance[0])
+    elif criterion.lower() == "dffits":
+        crit = np.abs(np.asarray(infl.dffits[0]))
+    else:
+        raise ValueError("criterion must be 'DFFITS' or 'Cooks'")
+    cnorm = crit / crit.max() if crit.max() > 0 else crit
+    # marker areas (points^2) range from 5 to 10**2 with the criterion
+    sizes = 5 + cnorm * (10 ** 2 - 5)
+    ax.scatter(leverage, resid, s=sizes, alpha=plot_alpha, **kwargs)

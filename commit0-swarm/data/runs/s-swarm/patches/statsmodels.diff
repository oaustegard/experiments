+def _count_logpmf(y, mu, family, alpha=None, p=2):
+    if family == 'poisson':
+        return stats.poisson.logpmf(y, mu)
+    n, prob = _nb_n_prob(mu, alpha, p)
+    return stats.nbinom.logpmf(y, n, prob)

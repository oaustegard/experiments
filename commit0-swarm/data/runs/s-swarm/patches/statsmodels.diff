 import numpy as np
 
+
+def _knockoff_w(z):
+    """Knockoff statistics W_j = max(z_j, z_{p+j}) * sign(z_j - z_{p+j})
+
+    ``z`` holds the effect sizes of the p original and p knockoff columns,
+    stacked as in the extended design [X X'].
+    """
+    nvar = len(z) // 2
+    z1 = z[:nvar]
+    z2 = z[nvar:]
+    return np.maximum(z1, z2) * np.sign(z1 - z2)
+
+

+def _prepare_data_corr_plot(lags, zero):
+    """
+    Resolve the lags to plot for a correlation plot.
+
+    Returns the lags as an int array (None when `lags` is None), the `nlags`
+    argument for the correlation function, and whether the lags are
+    irregular.
+    """
+    if lags is None:
+        lags_arr, nlags, irregular = None, None, False
+    elif np.isscalar(lags):
+        nlags = int(lags)
+        lags_arr, irregular = np.arange(nlags + 1), False
+    else:
+        lags_arr = np.asarray(lags, dtype=int)
+        nlags, irregular = int(lags_arr.max()), True
+    if lags_arr is not None and not zero:
+        lags_arr = lags_arr[lags_arr != 0]
+    return lags_arr, nlags, irregular
+
+
+def _plot_corr(ax, title, corr, confint, lags, use_vlines, vlines_kwargs,
+               auto_ylims, **kwargs):
+    """Draw a correlation function on `ax`."""
+    if vlines_kwargs is None:
+        vlines_kwargs = {}
+    ax.set_title(title)
+    marker_keys = ('marker', 'markersize')
+    axhline_kwargs = {k: v for k, v in kwargs.items() if k not in marker_keys}
+    if use_vlines:
+        ax.vlines(lags, [0], corr, **vlines_kwargs)
+    ax.axhline(**axhline_kwargs)
+    line_kwargs = dict(kwargs)
+    line_kwargs.setdefault('marker', 'o')
+    line_kwargs.setdefault('markersize', 5)
+    if 'ls' not in line_kwargs and 'linestyle' not in line_kwargs:
+        line_kwargs['linestyle'] = 'None'
+    ax.plot(lags, corr, **line_kwargs)
+    if confint is not None:
+        # confidence band centered on zero
+        ax.fill_between(lags, confint[:, 0] - corr, confint[:, 1] - corr,
+                        alpha=0.25)
+    if auto_ylims:
+        low = min(np.min(corr), 0)
+        high = max(np.max(corr), 0)
+        margin = 0.1 * (high - low) if high > low else 0.1
+        ax.set_ylim(low - margin, high + margin)
+    else:
+        ax.set_ylim(-1, 1)
+    if len(lags):
+        ax.set_xlim(lags[0] - 1, lags[-1] + 1)
+

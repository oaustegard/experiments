+def _extract_parameters(docstring: str, names: Sequence[str], indent: int) -> str:
+    """Return the numpydoc entries for ``names`` from ``docstring``, indented"""
+    import inspect
+    import re
+
+    blocks: dict[str, list[str]] = {}
+    current = None
+    for line in inspect.cleandoc(docstring).split('\n'):
+        match = re.match(r'^(\w+)\s*:', line)
+        if match:
+            current = match.group(1)
+            blocks[current] = [line]
+        elif current is not None and (line.strip() == '' or line.startswith(' ')):
+            blocks[current].append(line)
+        else:
+            current = None
+    pad = ' ' * indent
+    out: list[str] = []
+    for name in names:
+        block = blocks[name]
+        while block and block[-1].strip() == '':
+            block = block[:-1]
+        out.extend(pad + line if line.strip() else '' for line in block)
+    return '\n'.join(out)
+

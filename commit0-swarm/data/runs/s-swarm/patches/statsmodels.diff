+def fitquantilesgmm(distfn, data, start, pquant=None, frozen=None):
+    """estimate distribution parameters by matching quantiles with GMM
+
+    Parameters
+    ----------
+    distfn : distribution instance
+        needs to have ppf method, as in scipy.stats
+    data : ndarray, 1d
+        sample used to compute the empirical quantiles
+    start : array_like
+        starting values for the parameters
+    pquant : array_like or None
+        probabilities of the quantiles to match, default is [0.1, 0.9]
+    frozen : None
+        not used yet
+
+    Returns
+    -------
+    paramest : ndarray
+        estimated parameters
+    """
+    if pquant is None:
+        pquant = np.array([0.1, 0.9])
+    pquant = np.asarray(pquant, dtype=float)
+    xquant = np.percentile(np.asarray(data, dtype=float), pquant * 100)
+
+    def gmmobj(params):
+        diff = distfn.ppf(pquant, *params) - xquant
+        return diff.dot(diff)
+
+    return optimize.fmin(gmmobj, np.asarray(start, dtype=float), disp=0)
+
+def hess_ndt(fun, pars, args, options):
+    """numerical Hessian and gradient of ``fun(pars, *args)``
+
+    Returns
+    -------
+    he : ndarray
+        Hessian matrix
+    h : ndarray
+        gradient at ``pars``
+    """
+    from statsmodels.tools.numdiff import approx_fprime, approx_hess
+    pars = np.asarray(pars, dtype=float)
+    epsilon = options.get('stepFix', None) if options else None
+
+    def f(p):
+        return fun(p, *args)
+
+    he = approx_hess(pars, f, epsilon=epsilon)
+    h = approx_fprime(pars, f)
+    return he, h
+

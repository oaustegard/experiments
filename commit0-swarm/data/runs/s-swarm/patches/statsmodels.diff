+def _numdiff_jac(func, params, eps=1e-6):
+    """Central difference Jacobian of a vector valued function of params."""
+    params = np.asarray(params, dtype=float)
+    out = None
+    for j in range(params.size):
+        h = eps * max(1.0, abs(params[j]))
+        p_up = params.copy()
+        p_up[j] += h
+        p_dn = params.copy()
+        p_dn[j] -= h
+        diff = (np.asarray(func(p_up)) - np.asarray(func(p_dn))) / (2 * h)
+        if out is None:
+            out = np.empty((diff.shape[0], params.size))
+        out[:, j] = diff.reshape(diff.shape[0], -1)[:, 0] if diff.ndim > 1 else diff

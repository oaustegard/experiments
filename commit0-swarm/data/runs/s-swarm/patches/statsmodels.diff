+# Numerical evaluation of the studentized range distribution.
+#
+# Q = R / S, where R is the range of r independent standard normal samples
+# and S = sqrt(chi2_v / v) is independent of R. The cdf is the expectation
+# over S of the range cdf, both integrals by composite Gauss-Legendre rules.
+_gl_nodes, _gl_weights = np.polynomial.legendre.leggauss(16)
+
+
+def _panel_nodes(edges):
+    """Gauss-Legendre nodes and weights over consecutive panels"""
+    a = np.asarray(edges[:-1])[:, None]
+    b = np.asarray(edges[1:])[:, None]
+    x = ((b - a) / 2. * _gl_nodes + (a + b) / 2.).ravel()
+    w = ((b - a) / 2. * _gl_weights).ravel()
+    return x, w
+
+
+def _range_cdf(w, r):
+    """cdf of the range of r standard normal samples, w is array_like"""
+    w = np.atleast_1d(np.asarray(w, dtype=float))
+    x, wx = _panel_nodes(np.linspace(-9., 9., 7))
+    phi = scipy.stats.norm.pdf(x)
+    cdf_x = scipy.special.ndtr(x)
+    diff = scipy.special.ndtr(x[None, :] + w[:, None]) - cdf_x[None, :]
+    diff = np.clip(diff, 0., None)
+    integrand = phi[None, :] * diff ** (r - 1.)
+    return r * integrand.dot(wx)
+

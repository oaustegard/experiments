+def getnist(fn):
+    """Read a NIST StRD one-way ANOVA data file.
+
+    Returns
+    -------
+    groups : ndarray
+        treatment label of each observation
+    response : ndarray
+        response of each observation
+    cert : ndarray
+        certified [F, prob, R-squared, residual std]
+    certified : ndarray
+        certified [F, R-squared, residual std] as listed in the file
+    caty : ndarray
+        the unique treatment labels
+    """
+    filepath = os.path.join(os.path.dirname(os.path.abspath(__file__)),
+                            'data', fn)
+    with open(filepath) as fh:
+        lines = fh.read().splitlines()
+    cert_f = cert_r2 = cert_std = np.nan
+    for line in lines:
+        if line.lstrip().startswith('Between Treatment'):
+            cert_f = float(line.split()[-1])
+        elif 'Certified R-Squared' in line:
+            cert_r2 = float(line.split()[-1])
+        elif 'Standard Deviation' in line and np.isnan(cert_std):
+            cert_std = float(line.split()[-1])
+    start = [i for i, line in enumerate(lines)
+             if line.startswith('Data:') and 'Treatment' in line][0]
+    rows = []
+    for line in lines[start + 1:]:
+        parts = line.split()
+        if len(parts) == 2:
+            rows.append((float(parts[0]), float(parts[1])))
+    arr = np.asarray(rows)
+    groups = arr[:, 0]
+    response = arr[:, 1]
+    caty = np.unique(groups)
+    nobs, ngroups = len(response), len(caty)
+    prob = stats.f.sf(cert_f, ngroups - 1, nobs - ngroups)
+    cert = np.array([cert_f, prob, cert_r2, cert_std])
+    certified = np.array([cert_f, cert_r2, cert_std])
+    return groups, response, cert, certified, caty
+
+
+def anova_ols(response, groups):
+    """One-way ANOVA with statsmodels OLS on the group dummies.
+
+    Returns the F statistic, its p-value, R-squared and residual std.
+    """
+    response = np.asarray(response, dtype=float)
+    dummies = data2dummy(groups, returnall=True)
+    res = OLS(response, dummies).fit()
+    nobs, k_groups = dummies.shape
+    sst = np.sum((response - response.mean()) ** 2)
+    fstat = ((sst - res.ssr) / (k_groups - 1)) / (res.ssr / (nobs - k_groups))
+    prob = stats.f.sf(fstat, k_groups - 1, nobs - k_groups)
+    rsquared = 1 - res.ssr / sst
+    resstd = np.sqrt(res.ssr / (nobs - k_groups))
+    return np.array([fstat, prob, rsquared, resstd])

+        sw = self._stub_width()
+        total = sw + sum(1 + w for w in widths)
+        lines = ['=' * total]
+        head = ' ' * sw
+        for h, w in zip(self.headers, widths):
+            pad = w - len(h)
+            left = (pad + 1) // 2
+            head += ' ' + ' ' * left + h + ' ' * (pad - left)
+        lines.append(head)

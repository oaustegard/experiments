+def _denton_1d(z, Y, k):
+    """
+    Proportional first-difference Denton benchmarking for one series.
+
+    Minimizes sum((u[t] - u[t-1])**2) where u = x / z, subject to the
+    block sums of x (blocks of length k) matching Y. Indicator observations
+    beyond the last benchmarked block carry the last ratio forward.
+    """
+    z = np.asarray(z, dtype=float)
+    Y = np.asarray(Y, dtype=float)
+    nobs = len(z)
+    m = len(Y)
+    if m * k > nobs:
+        raise ValueError('benchmark covers more observations than indicator')
+    diff = zeros((max(nobs - 1, 0), nobs))
+    rows = np.arange(nobs - 1)
+    diff[rows, rows] = -1
+    diff[rows, rows + 1] = 1
+    cons = zeros((m, nobs))
+    for i in range(m):
+        cons[i, i * k:(i + 1) * k] = z[i * k:(i + 1) * k]
+    kkt = np.block([[2 * dot(diff.T, diff), cons.T],
+                    [cons, zeros((m, m))]])
+    rhs = np.concatenate([zeros(nobs), Y])
+    u = solve(kkt, rhs)[:nobs]
+    return z * u
+

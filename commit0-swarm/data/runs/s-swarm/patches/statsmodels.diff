+    """score test with nuisance scores, partitioned into tested and nuisance
+
+    The tested score is orthogonalized with respect to the nuisance score
+    using the derivative blocks a_cu and a_uu (robust, Wooldridge type).
+    Returns the statistic and the chisquare p-value with df = len(s_c).
+    """
+    s_c = np.asarray(s_c, dtype=float).ravel()
+    q = s_c.shape[0]
+    if s_u is None or np.size(s_u) == 0:
+        s_adj = s_c
+        var_adj = np.asarray(om_cc, dtype=float)
+    else:

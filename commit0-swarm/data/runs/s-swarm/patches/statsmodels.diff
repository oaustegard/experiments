+def _solve_lagrange_multiplier(est_vect, maxiter=500, tol=1e-10):
+    """
+    Solve the empirical likelihood dual for the Lagrange multiplier.
+
+    Finds eta maximizing sum(log(1 + est_vect @ eta)) with a damped Newton
+    method that keeps every 1 + est_vect @ eta strictly positive.
+
+    Parameters
+    ----------
+    est_vect : ndarray (nobs, k)

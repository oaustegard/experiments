+def _main_distribution(model, params, exog=None, exposure=None, offset=None):
+    """frozen distribution of the main count model of a truncated model"""
+    if exog is None and exposure is None and offset is None:
+        return model.model_main.get_distribution(params)
+    off = 0.0 if offset is None else np.asarray(offset, dtype=float)
+    if exposure is not None:
+        off = off + np.log(np.asarray(exposure, dtype=float))
+    return model.model_main.get_distribution(params, exog=exog, offset=off)

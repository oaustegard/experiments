+def _broadcast_params(value, k):
+    """Broadcast a scalar or array of parameters to length `k`."""
+    value = np.asarray(value, dtype=float)
+    return np.broadcast_to(value, (k,)).copy()
+
+
+def _lag_poly(params, lags, max_order, negate):
+    """
+    Build a lag polynomial coefficient array from parameters.
+
+    Coefficients are ordered from lowest to highest degree. The entry at
+    degree `lag` is `-param` for AR-type polynomials (`negate=True`) and
+    `param` for MA-type polynomials. Entries at degrees that are not lags are
+    zero, and the entry at degree 0 is one.
+    """
+    coef = np.zeros(max_order + 1)
+    coef[0] = 1
+    idx = np.asarray(lags, dtype=int)
+    coef[idx] = -params if negate else params
+    return coef
+
+
+def _validate_poly(value, lags, max_order, title):
+    """
+    Validate a user-supplied lag polynomial and return its coefficients.
+
+    The polynomial must have length `max_order + 1`, start with 1, and have
+    zero coefficients at degrees that are not lags.
+    """
+    if isinstance(value, Polynomial):
+        coef = np.asarray(value.coef, dtype=float)
+    else:
+        coef = np.asarray(value, dtype=float)
+    if coef.ndim != 1 or coef.shape[0] != max_order + 1:
+        raise ValueError('The %s lag polynomial must be a 1-dimensional array'
+                         ' of length %d.' % (title, max_order + 1))
+    if coef[0] != 1:
+        raise ValueError('The %s lag polynomial must begin with 1.' % title)
+    allowed = np.zeros(max_order + 1, dtype=bool)
+    allowed[0] = True
+    allowed[np.asarray(lags, dtype=int)] = True
+    if np.any(coef[~allowed] != 0):
+        raise ValueError('The %s lag polynomial has non-zero coefficients at'
+                         ' degrees that are not lags of the model.' % title)
+    return coef
+
 

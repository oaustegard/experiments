+def _get_kernel(kernel_type, kernel_dict):
+    if callable(kernel_type):
+        return kernel_type
+    try:
+        return kernel_dict[kernel_type]
+    except KeyError:
+        raise ValueError('unknown kernel_type %r' % (kernel_type,))
+
+
+def _kernel_estimate(kernel, x, sample, bw, weights, batch_size):
+    """Average kernel components over the sample, batched over x."""
+    x_arr = np.asarray(x, dtype=float)
+    sample = np.asarray(sample, dtype=float).ravel()
+    nobs = len(sample)
+    if weights is None:
+        weights = np.full(nobs, 1.0 / nobs)
+    else:
+        weights = np.asarray(weights, dtype=float)
+
+    xf = x_arr.ravel()
+    est = np.empty(xf.shape[0])
+    # limit the size of the intermediate (batch, nobs) array
+    bsize = max(1, int(batch_size * 1000 // nobs))
+    for start in range(0, xf.shape[0], bsize):
+        comp = kernel(xf[start:start + bsize], sample, bw)
+        est[start:start + bsize] = comp @ weights
+    if x_arr.ndim == 0:
+        return float(est[0])
+    return est.reshape(x_arr.shape)
+
+
+def _gamma_shape(x, bw, correct):
+    """Shape of the gamma kernel, with optional boundary correction."""
+    shape = x / bw + 1
+    if correct:
+        shape = np.where(x < 2 * bw, 1 + x ** 2 / (2 * bw ** 2), shape)
+    return shape
+
+
+def _beta_shapes(x, bw, correct):
+    """Shapes of the beta kernel, with optional boundary correction."""
+    a = x / bw + 1
+    c = (1 - x) / bw + 1
+    if correct:
+        def rho(t):
+            arg = 4 * bw ** 4 + 6 * bw ** 2 + 2.25 - t ** 2 - t / bw
+            return 2 * bw ** 2 + 2.5 - np.sqrt(np.maximum(arg, 0))
+        a = np.where(x < 2 * bw, rho(x), a)
+        c = np.where(x > 1 - 2 * bw, rho(1 - x), c)
+    return a, c
+
+
+def _as_pairs(x, sample):
+    """Broadcast evaluation points against the sample along the last axis."""
+    x = np.asarray(x, dtype=float)[..., None]
+    return x, np.asarray(sample, dtype=float)

+def sample_ols(X, beta=np.array([1., 0.1, 10.]), sige=3.):
+    """simulate sample for OLS, no endogeneity
+
+    Returns endog, exog and the instrument, which equals exog here.
+    """
+    nobs = X.shape[0]
+    u = sige * np.random.randn(nobs)
+    endog = np.dot(X, beta) + u
+    return endog, X, X
+
+
+def sample_iv(X, beta=np.array([1., 0.1, 10.]), sige=3., corrfactor=0.025):
+    """simulate sample with the first column of X endogenous
+
+    The error is correlated with the first regressor through a common
+    shock, and two excluded instruments are generated for it.
+    """
+    nobs = X.shape[0]
+    z = np.random.randn(nobs, 2)
+    v = np.random.randn(nobs)
+    u = sige * np.random.randn(nobs) + corrfactor * sige * v
+    endog = np.dot(X, beta) + u
+    # observed endogenous regressor is contaminated by the shock v
+    exog = X.copy()
+    exog[:, 0] = X[:, 0] + v
+    instrument = np.column_stack((z, X[:, 1:]))
+    return endog, exog, instrument
+
+
+def sample_ivfake(X, beta=np.array([1., 0.1, 10.]), sige=3., corrfactor=0.025):
+    """simulate sample with endogeneity and weak, fake instruments
+
+    The instruments are unrelated to the endogenous regressor.
+    """
+    nobs = X.shape[0]
+    z = np.random.randn(nobs, 2)
+    v = np.random.randn(nobs)
+    u = sige * np.random.randn(nobs) + corrfactor * sige * v
+    endog = np.dot(X, beta) + u
+    exog = X.copy()
+    exog[:, 0] = X[:, 0] + v
+    instrument = np.column_stack((z, X[:, 1:]))
+    return endog, exog, instrument
+
+

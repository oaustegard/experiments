+        return '\n'.join(lines)
+
+    def html(self):
+        out = ['<table>']
+        out.append('<tr><th></th>' +
+                   ''.join('<th>%s</th>' % h for h in self.headers) +
+                   '</tr>')
+        for stub, row in zip(self.stubs, self.rows):
+            out.append('<tr><td>%s</td>' % stub +
+                       ''.join('<td>%s</td>' % c for c in row) + '</tr>')
+        out.append('</table>')
+        return '\n'.join(out)

+        The Lagrange multiplier at the optimum.
+    """
+    k = est_vect.shape[1]
+
+    def neg_objective(eta):
+        d = 1 + np.dot(est_vect, eta)
+        if np.any(d <= 0):
+            return np.inf
+        return -np.sum(np.log(d))
+
+    eta = np.zeros(k)
+    fval = neg_objective(eta)
+    for _ in range(maxiter):

-    pass
+    width, height = sprite.size
+    print(f'{path}: {width}x{height} {sprite.color_mode.name}, {len(sprite.frames)} frame(s)')
+    for tag in sprite.tags:
+        print(f'tag {tag.name}: {tag.from_frame}-{tag.to_frame} {tag.direction.name}')
+    print('layers:')
+    for layer in sprite.layers:
+        indent = '  ' * (1 + layer.child_level)
+        print(f'{indent}{layer.name} ({layer.kind.name})')
+
 if __name__ == '__main__':
     raise SystemExit(main())

     """
-    pass
+    parser = argparse.ArgumentParser(prog='python -m aseprite')
+    commands = parser.add_subparsers(dest='command', required=True)
+    info = commands.add_parser('info', help='print sprite structure')
+    info.add_argument('path', type=Path)
+    export = commands.add_parser('export', help='export one frame as an image')
+    export.add_argument('source', type=Path)
+    export.add_argument('dest', type=Path)
+    export.add_argument('--frame', type=int, default=0)
+    args = parser.parse_args(argv)
+    try:
+        sprite = Sprite.open(args.path if args.command == 'info' else args.source)
+        if args.command == 'info':
+            _print_info(sprite, args.path)
+            return 0
+        sprite.image(args.frame).save(args.dest)
+        return 0
+    except (AsepriteError, OSError, ImportError, IndexError, ValueError) as exc:
+        print(f'error: {exc}', file=sys.stderr)
+        return 1
 

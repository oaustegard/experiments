+    for item in items:
+        if item.line.index == owner:
+            return item.line.lead
+    return ''
+
+def _raw_text(line: _Line) -> str:
+    return line.content
+
+def _line_of(text: str, position: int) -> int:
+    """Номер строки (с 0), в которой стоит позиция."""
+    return len(_NEWLINE.findall(text[:position]))
+
+def _region_lines(text: str, regions) -> tuple[set[int], set[int]]:
+    """Строки, выводимые как есть (области правки), и строки вставок (без переформатирования)."""
+    raw: set[int] = set()
+    verbatim: set[int] = set()
+    total = len(_split_lines(text))
+    for region in regions:
+        first = _line_of(text, region.start)
+        last = _line_of(text, max(region.start, region.end - 1))
+        if region.kind == 'удаление':
+            raw.update(range(first, last + 1))
+            continue
+        raw.add(first)
+        if region.closed:
+            closer = _line_of(text, region.closing_start)
+            raw.add(closer)
+            verbatim.update(range(first + 1, closer))
+        else:
+            verbatim.update(range(first + 1, total))
+    return raw, verbatim
+
+def format_text(text: str, max_depth: int | None) -> str:
+    """Расставить отступы блоков и продолжений по структуре модуля.
+
+    Структура видна в активном виде кода: строки #Удаление выводятся как есть
+    и не учитываются, тела #Вставка — учитываются, но тоже выводятся как есть.
+    """
+    regions = _patch_regions(text)
+    view = _active_source(text, 'удаление')[0] if regions else text
+    raw_lines = _split_lines(text)
+    raw, verbatim = _region_lines(text, regions)
+    lines = _analyze(view)
+    for line in lines:
+        original = raw_lines[line.index] if line.index < len(raw_lines) else line.content + line.ending
+        line.content = original[:len(original) - len(line.ending)] if line.ending else original
+        if line.index in raw:
+            line.kind = 'raw'
+        if line.index in verbatim:
+            line.verbatim = True
+    return _Structure(lines, max_depth).run()
+
+def line_kinds(text: str) -> list[str]:
+    """Виды строк текста: нужны для проверок директив и областей правки."""
+    return [line.kind for line in _analyze(text)]

+        line.prefix = prefix
+        line.lead = lead
+        line.body = rest
+        line.comment = comment
+        line.gap = gap if comment else ''
+        masked_body = masked_lines[index][:code_end] if index < len(masked_lines) else ''
+        line.masked = masked_body.replace(_BOM, ' ').strip(_BLANK)
+        if index in owners:
+            line.kind = 'literal'
+            line.owner = owners[index]
+        elif not rest and not comment:
+            line.kind = 'blank'
+        elif not rest:
+            line.kind = 'comment'
+        elif rest.startswith('#'):
+            line.kind = 'directive'
+        lines.append(line)

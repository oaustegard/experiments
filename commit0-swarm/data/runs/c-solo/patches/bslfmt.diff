+class _Structure:
+    """Построчный проход: стек блоков, инструкции, комментарии и директивы."""
+
+    def __init__(self, lines: list[_Line], max_depth: int | None) -> None:
+        self.lines = lines
+        self.max_depth = max_depth
+        self.stack: list[tuple[str, int]] = []
+        self.out: list[tuple[str, str]] = []
+        self.pending: _Pending | None = None
+        self.deferred: list[_Item] = []
+        self.conditionals: list[tuple[tuple[str, ...], int]] = []
+        self.value_depth: int | None = None
+        self.default_ending = next((line.ending for line in self.lines if line.ending), '\n')
+
+    def run(self) -> str:
+        for line in self.lines:
+            kind = line.kind
+            if kind == 'blank':
+                if self.pending is not None:
+                    if self.pending.role == 'decl':
+                        self.finish()
+                    else:
+                        continue
+                self.deferred.append(_Item(line, 'blank'))
+            elif kind == 'comment':
+                if self.pending is not None and self.pending.role == 'decl':
+                    self.finish()
+                if self.pending is not None:
+                    self.pending.items.append(_Item(line, 'comment'))
+                else:
+                    self.deferred.append(_Item(line, 'comment'))
+            elif kind == 'directive':
+                if self.pending is not None and self.pending.role == 'decl' and self.pending.bracket == 0:
+                    self.finish()
+                name = self.directive(line)
+                if self.pending is not None:
+                    self.pending.items.append(_Item(line, 'directive'))
+                    if name in _CONDITIONAL_CLOSE and self.pending.bracket == 0 and self.pending.role not in ('open', 'branch'):
+                        self.finish()
+                else:
+                    self.flush_raw()
+                    self.out.append((line.prefix + line.body + (line.gap + line.comment if line.comment else ''), line.ending))
+            elif kind == 'raw':
+                if self.pending is not None and self.pending.role == 'decl' and self.pending.bracket == 0:
+                    self.finish()
+                if self.pending is not None:
+                    self.pending.items.append(_Item(line, 'raw'))
+                else:
+                    self.flush_raw()
+                    self.out.append((line.content, line.ending))
+            elif kind == 'opaque':
+                self.finish()
+                self.flush_raw()
+                self.out.append((line.content, line.ending))
+            else:
+                if line.verbatim and line.kind == 'code':
+                    self.finish()
+                    self.scan_verbatim(line)
+                    self.flush_raw()
+                    self.out.append((line.content, line.ending))
+                    continue
+                if line.kind == 'literal' and line.masked:
+                    words = _WORD.findall(_fold_text(line.masked))
+                    if words and (words[0] in _CLOSE_WORDS or words[0] in _BRANCH_WORDS or words[0] in _OPEN_WORDS):
+                        raise FormatError("структурный код после многострочной строки", line.index + 1)
+                if self.pending is not None and not self.continues(line):
+                    self.finish()
+                if self.pending is None:
+                    role, family, _ = _classify(line.masked if line.kind == 'code' else '')
+                    self.pending = _Pending(line, role, family)
+                    self.pending.first_word = _classify(line.masked)[2]
+                self.pending.items.append(_Item(line, kind))
+                self.pending.update(line.masked)

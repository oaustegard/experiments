+                    raise FormatError("ветвь вне своего блока", line.index + 1)
+            elif word in _CLOSE_WORDS:
+                if not self.stack or self.stack[-1][0] != _CLOSE_WORDS[word]:
+                    raise FormatError("лишний или неверный конец блока", line.index + 1)
+                self.stack.pop()
+
+    def snapshot(self) -> tuple[tuple[str, ...], int]:
+        return tuple(family for family, _ in self.stack), self.pending.bracket if self.pending else 0
+
+    def directive(self, line: _Line) -> None:
+        words = _WORD.findall(_fold_text(line.body[1:]))
+        name = words[0] if words else ''
+        if name in _CONDITIONAL_CLOSE:
+            self.value_depth = None
+        if name in _CONDITIONAL_OPEN:
+            self.conditionals.append((self.snapshot(), line.index))
+        elif name in _CONDITIONAL_BRANCH or name in _CONDITIONAL_CLOSE:
+            if not self.conditionals:
+                raise FormatError("директива без открывающей #Если", line.index + 1)
+            start, _opened = self.conditionals[-1]
+            if self.snapshot() != start:
+                raise FormatError("ветви #Если с разным структурным состоянием", line.index + 1)
+            if name in _CONDITIONAL_CLOSE:
+                self.conditionals.pop()
+        self.conditionals_line = line.index
+        return name
+
+    def flush_raw(self) -> None:
+        for item in self.deferred:
+            self.out.append((item.line.content if item.kind == 'blank' else _raw_text(item.line), item.line.ending))
+        self.deferred = []
+
+    def continues(self, line: _Line) -> bool:
+        pending = self.pending
+        masked = line.masked
+        words = _WORD.findall(_fold_text(masked))
+        first = words[0] if words else ''
+        if pending.role == 'decl':
+            if pending.bracket > 0:
+                return True
+            if pending.last_word in DECLARATIONS or pending.last_word in ASYNC_WORDS or pending.last_word == '':
+                return True
+            return first in ('экспорт', 'export')
+        if pending.bracket > 0:
+            return True
+        if not masked:
+            return True
+        if first in _CLOSE_WORDS or first in _BRANCH_WORDS:
+            return False
+        if masked[0] in '&~':
+            return False
+        if first in _DECL_WORDS or first in _OPEN_WORDS:
+            return False
+        if first in _OPERATOR_WORDS or first in THEN_WORDS or first in LOOP_WORDS:
+            return True
+        if pending.role in ('open', 'branch') and pending.family in ('if', 'loop'):
+            return True

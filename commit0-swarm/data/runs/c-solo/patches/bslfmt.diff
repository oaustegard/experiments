+                    self.finish()
+        self.finish()
+        self.flush_raw()
+        if self.stack:
+            raise FormatError("не закрыт блок", self.stack[-1][1] + 1)
+        if self.conditionals:
+            raise FormatError("не закрыта директива условной компиляции", self.conditionals[-1][1] + 1)
+        return ''.join(text + ending for text, ending in self.out)
+
+    conditionals_line = 0
+
+    def scan_verbatim(self, line: _Line) -> None:
+        """Строка без переформатирования: блоки меняют стек по ключевым словам по порядку."""
+        for match in _WORD.finditer(line.masked):
+            word = match.group().lower()
+            if line.masked[:match.start()].rstrip(_BLANK).endswith('.'):
+                continue
+            if word in _OPEN_WORDS:
+                family = _OPEN_WORDS[word][1]
+                self.stack.append((family, line.index))
+                if self.max_depth is not None and len(self.stack) > self.max_depth:
+                    raise FormatError("слишком большая вложенность блоков", line.index + 1)
+            elif word in _BRANCH_WORDS:

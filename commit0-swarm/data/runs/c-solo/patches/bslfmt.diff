+
+class _Item:
+    """Строка внутри инструкции: исходная строка и её новый вид."""
+    __slots__ = ('line', 'kind')
+
+    def __init__(self, line: _Line, kind: str) -> None:
+        self.line = line
+        self.kind = kind
+
+class _Pending:
+    """Инструкция, которая ещё не закончилась."""
+
+    def __init__(self, line: _Line, role: str, family: str | None) -> None:
+        self.items: list[_Item] = []
+        self.first_line = line.index
+        self.role = role
+        self.family = family
+        self.bracket = 0
+        self.words: list[str] = []
+        self.last_char = ''

+            return False
+        return True
+
+    def completes(self, line: _Line) -> bool:
+        pending = self.pending
+        if pending.bracket > 0:
+            return False
+        role = pending.role
+        last = pending.last_char
+        if role == 'decl':
+            return False
+        if last == ';':
+            return True
+        if role == 'open' and pending.family == 'if':
+            return pending.last_word in THEN_WORDS
+        if role == 'open' and pending.family == 'loop':
+            return pending.last_word in LOOP_WORDS
+        if role == 'branch' and pending.first_word in ('иначеесли', 'elsif'):
+            return pending.last_word in THEN_WORDS
+        if role in ('open', 'branch', 'close', 'annot', 'label'):
+            return True
+        return False
+
+    def finish(self) -> None:
+        pending = self.pending
+        if pending is None:
+            return
+        self.pending = None
+        if pending.role in ('open', 'branch') and pending.family in ('if', 'loop') and not pending.done:
+            raise FormatError("незавершённый заголовок блока", pending.first_line + 1)
+        self.emit(pending)
+
+    def emit(self, pending: _Pending) -> None:
+        role, family = pending.role, pending.family
+        line_number = pending.first_line + 1
+        if role == 'close':
+            if not self.stack or self.stack[-1][0] != family:
+                raise FormatError("лишний или неверный конец блока", line_number)
+            self.stack.pop()
+            depth = len(self.stack)
+        elif role == 'branch':
+            if not self.stack or self.stack[-1][0] != family:
+                raise FormatError("ветвь вне своего блока", line_number)
+            depth = len(self.stack) - 1
+        elif role in ('open', 'decl'):
+            depth = len(self.stack)
+            self.stack.append((family, pending.first_line))
+            if self.max_depth is not None and len(self.stack) > self.max_depth:
+                raise FormatError("слишком большая вложенность блоков", line_number)
+        else:

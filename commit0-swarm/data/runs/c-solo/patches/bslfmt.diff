+        return self.words[-1] if self.words else ''
+
+def _fold_text(text: str) -> str:
+    return text.lower()
+
+def _ends_operand(body: str) -> bool:
+    """Строка кода кончается операндом: следующее слово с нового начала — новая инструкция."""
+    text = body.rstrip(_BLANK)
+    if not text:
+        return False
+    last = text[-1]
+    if last in ')]"':
+        return True
+    if last.isalnum() or last == '_':
+        match = _TRAILING_WORD.search(text)
+        before = text[:match.start()].rstrip(_BLANK)
+        if before.endswith('.'):
+            return True
+        folded = match.group().lower()
+        return folded not in _KEYWORDS or folded in _OPERAND_KEYWORDS
+    return False
+
+def _classify(masked: str) -> tuple[str, str | None, str]:
+    """Роль первой строки инструкции: (роль, семейство блока, первое слово)."""
+    words = _WORD.findall(_fold_text(masked))
+    if masked.startswith('&'):

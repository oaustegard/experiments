+def _lead_width(lead: str) -> int:
+    """Ширина отступа в колонках: табуляция — до кратного TAB_WIDTH."""
+    width = 0
+    for char in lead:
+        if char == '\t':
+            width += TAB_WIDTH - width % TAB_WIDTH
+        else:
+            width += 1
+    return width
+
+def _lead_text(width: int) -> str:
+    """Отступ шириной width колонок: табы и остаток пробелами."""
+    return '\t' * (width // TAB_WIDTH) + ' ' * (width % TAB_WIDTH)
+
+def _shift_lead(lead: str, delta: int) -> str:
+    """Сдвинуть отступ на delta колонок, сохранив его вид (вправо — табы перед ним)."""
+    if delta == 0:
+        return lead
+    if delta > 0:
+        return '\t' * (delta // TAB_WIDTH) + ' ' * (delta % TAB_WIDTH) + lead
+    return _lead_text(max(0, _lead_width(lead) + delta))

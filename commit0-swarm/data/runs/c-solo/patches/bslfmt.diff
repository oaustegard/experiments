+_BRANCH_WORDS = {'иначеесли': 'if', 'elsif': 'if', 'иначе': 'if', 'else': 'if', 'исключение': 'try', 'except': 'try'}
+_CLOSE_WORDS = {'конецпроцедуры': 'proc', 'конецфункции': 'proc', 'endprocedure': 'proc', 'endfunction': 'proc', 'конецесли': 'if', 'endif': 'if', 'конеццикла': 'loop', 'enddo': 'loop', 'конецпопытки': 'try', 'endtry': 'try'}
+_DECL_WORDS = frozenset({'процедура', 'функция', 'procedure', 'function'})
+_TRAILING_OPERATORS = '+-*/%=<>,.'
+_LINE_START_CONTINUATION = ')],.[+-*/%=<>?'
+_CONDITIONAL_OPEN = ('если', 'if')
+_CONDITIONAL_BRANCH = ('иначе', 'else', 'иначеесли', 'elsif')
+_CONDITIONAL_CLOSE = ('конецесли', 'endif')

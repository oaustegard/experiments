+def assert_imap_protocol(condition: object, message: Optional[Union[bytes, str]] = None) -> None:
+    """Raise ProtocolError if condition is false.
+
+    The optional message (normally the offending server data) is
+    included in the exception to help diagnose the problem.
+    """
+    if not condition:
+        if message is None:
+            raise exceptions.ProtocolError("Protocol error")
+        raise exceptions.ProtocolError("Protocol error: %r" % (message,))
+
+
+def chunk(lst: Sequence[T], size: int) -> Iterator[Sequence[T]]:
+    """Yield successive size-sized slices of lst."""
+    for i in range(0, len(lst), size):
+        yield lst[i:i + size]
+
+
+def to_bytes(s: Union[str, bytes, int], charset: Optional[str] = 'ascii') -> bytes:
+    """Return s as bytes.
+
+    Text is encoded with charset, integers are written in decimal and
+    bytes are returned unchanged.
+    """
+    if isinstance(s, bytes):
+        return s
+    if isinstance(s, int):
+        s = str(s)
+    return s.encode(charset or 'ascii')
+
+
+def to_unicode(s: Union[str, bytes, None]) -> Union[str, None]:
+    """Return s as text.
+
+    Bytes are decoded as ASCII. Non-ASCII bytes cannot be represented
+    faithfully, so they are dropped and a warning is logged rather than
+    failing the whole response. Anything that is not bytes, including
+    None, is returned unchanged.
+    """
+    if isinstance(s, bytes):
+        try:
+            return s.decode('ascii')
+        except UnicodeDecodeError:
+            logger.warning('Ignoring non-ASCII bytes in IMAP response value %r', s)
+            return s.decode('ascii', 'ignore')
+    return s

+                        help='INI file with the connection details (see the '
+                             'configuration file format in the documentation)')
+    parser.add_argument('-H', '--host', default=S, help='IMAP server hostname')
+    parser.add_argument('-p', '--port', type=int, default=S,
+                        help='server port (default 993 with SSL, 143 without)')
+    parser.add_argument('-u', '--username', default=S, help='username to log in as')
+    parser.add_argument('-P', '--password', default=S,
+                        help='password (prompted for if not given)')
+    parser.add_argument('--ssl', action='store_true', default=S,
+                        help='use SSL/TLS (the default for interactive sessions)')
+    parser.add_argument('--no-ssl', dest='ssl', action='store_false', default=S,
+                        help='do not use SSL/TLS')
+    parser.add_argument('--starttls', action='store_true', default=S,
+                        help='use STARTTLS to upgrade the connection')
+    parser.add_argument('-t', '--timeout', type=float, default=S,
+                        help='timeout for I/O operations, in seconds')
+    parser.add_argument('--oauth2', action='store_true', default=S,
+                        help='authenticate with OAUTH2 (the password is ignored)')
+    parser.add_argument('--oauth2-client-id', default=S, help='OAUTH2 client id')
+    parser.add_argument('--oauth2-client-secret', default=S, help='OAUTH2 client secret')
+    parser.add_argument('--oauth2-refresh-token', default=S, help='OAUTH2 refresh token')
+    parser.add_argument('--ssl-ca-file', default=S,
+                        help='certificate authority file to validate the server with')
+    parser.add_argument('--no-ssl-check-hostname', dest='ssl_check_hostname',
+                        action='store_false', default=S,
+                        help="don't check the certificate against the host name")
+    parser.add_argument('--no-ssl-verify-cert', dest='ssl_verify_cert',
+                        action='store_false', default=S,
+                        help="don't verify the server certificate")
+    return parser
+
+
+def build_config(args: dict) -> dict:
+    """Merge the defaults, the config file (if any) and the command line options,
+    in increasing order of precedence. TLS is on unless turned off.
+    """
+    config_file = args.pop('file')
+    config = dict(get_config_defaults())
+    config['ssl'] = True
+    if config_file is not None:
+        config.update(vars(parse_config_file(config_file)))
+    config.update(args)
+    return config

+def _parse_tuple(tokens: List[Tuple[bytes, Optional[bytes]]], open_pos: int) -> Tuple[Tuple[_Atom, ...], int]:
+    """Parse the parenthesised list opened at tokens[open_pos].
+
+    Returns the parsed tuple and the index just past the closing paren.
+    """
+    items: List[_Atom] = []
+    pos = open_pos + 1
+    while pos < len(tokens):
+        token, literal = tokens[pos]
+        if token == b')':
+            return tuple(items), pos + 1
+        if token == b'(':
+            value, pos = _parse_tuple(tokens, pos)
+        else:
+            value = _convert_atom(token, literal)
+            pos += 1
+        items.append(value)

+def _convert_atom(token: bytes, literal: Optional[bytes]) -> _Atom:
+    if literal is not None:
+        return literal
+    if len(token) >= 2 and token.startswith(b'"'):
+        # The lexer keeps the surrounding quotes and has already unescaped the content.
+        return token[1:-1]
+    if token.upper() == b'NIL':
+        return None
+    if token.isdigit() and (token == b'0' or not token.startswith(b'0')):
+        return int(token)

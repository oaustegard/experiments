+    """Ask for the username and password when they were not supplied.
+    OAUTH2 logins use tokens rather than a password, so only the username
+    is needed there.
+    """
+    if not config.get('username'):
+        config['username'] = input('Username: ')
+    if not config.get('oauth2') and not config.get('password'):
+        config['password'] = getpass('Password: ')
+
+
+def start_shell(namespace: dict) -> None:
+    """Embed an interactive shell in which *namespace* is the global scope.
+
+    IPython is used when it is installed, otherwise the standard library's
+    code.interact() is used.
+    """
+    try:
+        from IPython import embed
+    except ImportError:
+        code.interact(banner=BANNER, local=namespace)
+    else:
+        embed(banner1=BANNER, user_ns=namespace)

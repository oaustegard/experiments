+def _to_body_data(value: _Atom) -> object:
+    """Turn a raw BODY/BODYSTRUCTURE tuple into BodyData, recursing into
+    multipart parts. A multipart body becomes (list_of_parts, subtype, ...)."""
+    if not isinstance(value, tuple):
+        return value
+    if value and isinstance(value[0], tuple):
+        parts: List[object] = []
+        index = 0
+        while index < len(value) and isinstance(value[index], tuple):
+            parts.append(_to_body_data(value[index]))
+            index += 1
+        return BodyData((parts,) + value[index:])  # type: ignore[arg-type]
+    return BodyData(value)  # type: ignore[arg-type]
+
+def _convert_envelope(value: _Atom, normalise_times: bool) -> Optional[Envelope]:
+    if value is None:
+        return None
+    if not isinstance(value, tuple) or len(value) != 10:
+        raise ProtocolError('Malformed ENVELOPE response: %r' % (value,))
+    date, subject, from_, sender, reply_to, to, cc, bcc, in_reply_to, message_id = value
+    return Envelope(
+        _parse_date(date, normalise_times),
+        subject,  # type: ignore[arg-type]
+        _convert_addresses(from_),
+        _convert_addresses(sender),
+        _convert_addresses(reply_to),
+        _convert_addresses(to),
+        _convert_addresses(cc),
+        _convert_addresses(bcc),
+        in_reply_to,  # type: ignore[arg-type]
+        message_id,  # type: ignore[arg-type]
+    )
+
+def _convert_addresses(value: _Atom) -> Optional[Tuple[Address, ...]]:
+    if value is None:
+        return None
+    # NIL entries inside an address list are group delimiters placeholders; skip them.
+    return tuple(Address(*addr) for addr in value if addr is not None)  # type: ignore[union-attr]
+
+def _parse_date(value: _Atom, normalise_times: bool) -> Optional[datetime.datetime]:
+    if value is None:
+        return None
+    if not isinstance(value, bytes):
+        raise ProtocolError('Expected date string, got %r' % (value,))
+    try:
+        return parse_to_datetime(value, normalise_times)
+    except ValueError:
+        return None

+def _convert_fetch_value(name: bytes, value: _Atom, normalise_times: bool) -> object:
+    if name in (b'BODY', b'BODYSTRUCTURE'):
+        return _to_body_data(value)
+    if name == b'ENVELOPE':
+        return _convert_envelope(value, normalise_times)
+    if name == b'INTERNALDATE':
+        return _parse_date(value, normalise_times)

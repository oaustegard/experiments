+def build_parser() -> argparse.ArgumentParser:
+    """Command line options. Options left at their default are not set on the
+    namespace at all, so only what the user actually typed overrides the
+    config file (and the config defaults).
+    """
+    S = argparse.SUPPRESS
+    parser = argparse.ArgumentParser(
+        prog='python -m imapclient.interact',
+        description='Connect an IMAPClient and start an interactive shell '

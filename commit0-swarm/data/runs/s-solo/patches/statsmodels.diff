+def _extend_index(index, steps):
+    """Return ``index`` extended by ``steps`` future values."""
+    import pandas as _pd
+    steps = int(steps)
+    if steps <= 0:
+        return index
+    if isinstance(index, _pd.RangeIndex):
+        step = index.step
+        return _pd.RangeIndex(index.start, index.start + (len(index) + steps) * step, step)
+    if isinstance(index, _pd.DatetimeIndex):
+        freq = index.freq
+        if freq is None:
+            freq = _pd.infer_freq(index) if len(index) > 2 else None
+        if freq is None:
+            step = index[-1] - index[-2] if len(index) > 1 else _pd.Timedelta(days=1)
+            new = [index[-1] + step * (i + 1) for i in range(steps)]
+            return index.append(_pd.DatetimeIndex(new))
+        extra = _pd.date_range(start=index[-1], periods=steps + 1, freq=freq)[1:]
+        return index.append(extra)
+    if isinstance(index, _pd.PeriodIndex):
+        extra = _pd.period_range(start=index[-1] + 1, periods=steps, freq=index.freq)
+        return index.append(extra)
+    # integer-valued Index
+    arr = np.asarray(index)
+    step = arr[-1] - arr[-2] if len(arr) > 1 else 1
+    new = arr[-1] + step * np.arange(1, steps + 1)
+    return _pd.Index(np.concatenate([arr, new]))
+

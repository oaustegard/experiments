+def forg(x, prec=3):
+    """Format a float with ``prec`` significant digits, stripping trailing zeros."""
+    x = float(x)
+    if x == 0:
+        return '0'
+    s = '%#.*g' % (prec, x)
+    if 'e' not in s and '.' in s:
+        s = s.rstrip('0').rstrip('.')
+    return s

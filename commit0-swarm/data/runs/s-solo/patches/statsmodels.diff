+    arrays.update(kwargs)
+    present = {k: v for k, v in arrays.items() if v is not None}
+    out = {k: v for k, v in arrays.items() if v is None}
+
+    if missing == 'none':
+        out.update(present)
+        return out, None
+
+    nan_mask = _nan_rows(endog, exog)
+    if missing == 'raise':
+        if nan_mask.any():
+            raise MissingDataError('NaNs were encountered in the data')

+def union_dicts(*dicts):
+    """Merge dictionaries left to right; later entries win."""
+    result = {}
+    for d in dicts:
+        result.update(d)
+    return result
+
+
+def make_wrapper(func, how):
+    """
+    Wrap a method of a results class so that its output is reattached to
+    the model's data metadata according to ``how``.
+    """
+    @functools.wraps(func)
+    def wrapper(self, *args, **kwargs):
+        results = object.__getattribute__(self, "_results")
+        data = results.model.data
+        obj = func(results, *args, **kwargs)
+        if how and isinstance(how, tuple):
+            return data.wrap_output(obj, how[0], *how[1:])
+        elif how:
+            return data.wrap_output(obj, how=how)
+        return obj
+
+    return wrapper
+
+
+def populate_wrapper(klass, wrapping):
+    """
+    Attach wrapped methods to ``klass`` based on ``klass._wrap_methods``.
+    """
+    for meth, how in klass._wrap_methods.items():
+        if not hasattr(wrapping, meth):
+            # the wrapped results class does not implement this method (yet)
+            continue
+        func = getattr(wrapping, meth)
+        wrapper_func = make_wrapper(func, how)
+        wrapper_func.__doc__ = getattr(func, "__doc__", None)
+        setattr(klass, meth, wrapper_func)
